<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The member shell's client half: a Razor class library, not a WASM app entry. A
       Blazor Web App has exactly ONE WASM entry project (Crest.Client), which
       references this library alongside Admin's and Site's and runs the one Program.cs.
       A third shell is therefore a theme, a client library, a route bucket and an
       App.razor branch - NOT a third build output. See plans/shells-and-themes.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>Crest.Member.Client</AssemblyName>
    <RootNamespace>Crest.Member</RootNamespace>
    <OrchardCoreCompatibilityVersion>4.0.0</OrchardCoreCompatibilityVersion>
    <CrestSecurityPatch>0</CrestSecurityPatch>
    <CrestBugPatch>0</CrestBugPatch>
    <CrestVersion>$(OrchardCoreCompatibilityVersion).$(CrestSecurityPatch).$(CrestBugPatch)</CrestVersion>
    <VersionPrefix>$(OrchardCoreCompatibilityVersion)</VersionPrefix>
    <PackageVersion>$(OrchardCoreCompatibilityVersion)</PackageVersion>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>
    <AssemblyInformationalVersion>$(CrestVersion)</AssemblyInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Watch Include="**\*.cs;**\*.razor;wwwroot\**\*" Exclude="bin\**;obj\**;**\bin\**;**\obj\**" />
    <Watch Remove="bin\**;obj\**;**\bin\**;**\obj\**" />
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

  <!-- No InternalsVisibleTo until Crest.Member.Tests exists. A friend-assembly
       reference is compiled into the binary, and the WASM loader resolves it at load
       time: naming a test assembly that does not exist makes this client unloadable, and
       because every shell shares the one WASM payload, that stops the whole runtime from
       booting - admin login included. -->

  <ItemGroup>
    <!-- Same rationale as the admin client: the WebAssembly package (not the full
         BlazorWebAssembly SDK), because this assembly also loads server-side for SSR
         route discovery. -->
    <PackageReference Include="Microsoft.AspNetCore.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Crest.Components\Crest.Components.csproj" />
    <ProjectReference Include="..\..\Crest.Icons\Crest.Icons.csproj" />
    <!-- The shell runtime: the lazy-module loader and the shell filter for its router. -->
    <ProjectReference Include="..\..\Crest.Shell\Crest.Shell.csproj" />
    <!-- No module references here: the member theme never references a module. Module
         member-wasm libraries reach the payload through the app's own glob
         (Crest.Client.csproj), and the member router loads them per shell
         through CrestLazyModules. -->
  </ItemGroup>

</Project>

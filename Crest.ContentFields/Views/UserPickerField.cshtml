@model Crest.ContentFields.ViewModels.DisplayUserPickerFieldViewModel
@using Crest.ContentFields
@using Crest.Mvc.Utilities
@using Crest.Localization.Data
@inject IDataLocalizer D
@{
    var name = (Model.PartFieldDefinition.PartDefinition.Name + "-" + Model.PartFieldDefinition.Name).HtmlClassify();
    var users = await @Platform.GetUsersByIdsAsync(Model.UserIds);
    string localizedFieldName = D[Model.PartFieldDefinition.DisplayName(), DataLocalizationContext.ContentField(Model.PartFieldDefinition.PartDefinition.Name)];
}

<div class="field field-type-userpickerfield field-name-@name">
    <span class="name">@localizedFieldName</span>
    @if (users.Any())
    {
        foreach (var user in users)
        {
            <span class="value">@user.UserName</span>
            if (user != users.Last())
            {
                <span>,</span>
            }
        }
    }
    else
    {
        <span class="value">@T["No users."]</span>
    }
</div>

<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
     <!-- NuGet properties-->
    <Title>Grove GraphQL Apis</Title>
    <Description>$(OCFrameworkDescription)

    Provies apis using the GraphQL Specification.</Description>
    <PackageTags>$(PackageTags) PlatformFramework</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GraphQL" />
    <PackageReference Include="GraphQL.DataLoader" />
    <PackageReference Include="GraphQL.MicrosoftDI" />
    <PackageReference Include="GraphQL.SystemTextJson" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YesSql.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grove.Admin.Abstractions\Grove.Admin.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Apis.GraphQL.Abstractions\Grove.Apis.GraphQL.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.DisplayManagement\Grove.DisplayManagement.csproj" />
    <ProjectReference Include="..\Grove.Module.Targets\Grove.Module.Targets.csproj" />
    <ProjectReference Include="..\Grove.Navigation\Grove.Navigation.csproj" />
    <ProjectReference Include="..\Grove.ResourceManagement\Grove.ResourceManagement.csproj" />
  </ItemGroup>

</Project>

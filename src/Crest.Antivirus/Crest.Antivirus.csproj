<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <Title>Crest Antivirus ClamAV</Title>
    <Description>$(OCCMSDescription)

    Provides a ClamAV-backed antivirus scanner for Crest uploads.</Description>
    <PackageTags>$(PackageTags) PlatformCMS ContentManagement Security</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Crest.FileStorage.Abstractions\Crest.FileStorage.Abstractions.csproj" />
    <ProjectReference Include="..\Crest.Module.Targets\Crest.Module.Targets.csproj" />
  </ItemGroup>

</Project>

@model ContentAuditTrailSettingsViewModel
@using Crest.Contents.AuditTrail.ViewModels

<section>
    <div class="ocat-wrapper" asp-validation-class-for="ExcludedContentTypes">
        <label asp-for="ExcludedContentTypes" class="ocat-label">@T["Excluded content types"]</label>
        <div class="ocat-end">
            @await Component.InvokeAsync("SelectContentTypes", new { selectedContentTypes = Model.ExcludedContentTypes, htmlName = Html.NameFor(m => m.ExcludedContentTypes) })
            <span asp-validation-for="ExcludedContentTypes"></span>
            <span class="hint">@T["The types of content whose events are not recorded. Every other type is."]</span>
        </div>
    </div>
</section>

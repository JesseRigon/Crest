  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grove.Module.Targets\Grove.Module.Targets.csproj" />
  </ItemGroup>

</Project>

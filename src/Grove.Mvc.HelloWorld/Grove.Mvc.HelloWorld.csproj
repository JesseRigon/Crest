<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <!-- NuGet properties-->
    <Title>Grove Hello World MVC module </Title>
    <Description>
      $(OCFrameworkDescription)

      Sample Grove Framework module for MVC.
    </Description>
    <PackageTags>$(PackageTags) PlatformFramework</PackageTags>

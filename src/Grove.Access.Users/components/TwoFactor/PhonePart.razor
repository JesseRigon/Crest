@namespace Grove.Access.Users.Components
@inject HttpClient Http
@inject IServiceProvider Services

@* The SMS method: confirm a phone number with a code sent to it (the number is changed only once
   the code checks out). *@

@if (Editing)
{
    <GroveStack Gap="0.5rem" data-testid="two-factor-phone">
        @if (!CodeSent)
        {
            <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                <GroveTextBox @bind-Value="Number" Disabled="@(!AllowChanging)" autocomplete="tel" Placeholder="@L("Phone number")" data-testid="two-factor-phone-number" />
                <GroveButton Text="@L("Send code")" Size="ButtonSize.Small" Click="SendAsync" Disabled="Busy" data-testid="two-factor-phone-send" />
                <GroveButton Text="@L("Cancel")" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => Editing = false)" />
            </GroveStack>
        }
        else
        {
            <GroveText TextStyle="TextStyle.Body2" Text="@string.Format(CultureInfo.CurrentCulture, L("Enter the code sent to {0}."), Number)" />
            <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                <GroveTextBox @bind-Value="Code" autocomplete="one-time-code" inputmode="numeric" Placeholder="@L("Verification code")" data-testid="two-factor-phone-code" />
                <GroveButton Text="@L("Verify")" Size="ButtonSize.Small" Click="VerifyAsync" Disabled="Busy" data-testid="two-factor-phone-verify" />
                <GroveButton Text="@L("Send again")" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="SendAsync" Disabled="Busy" />
            </GroveStack>
        }
        @if (Message is { Length: > 0 })
        {
            <GroveText TextStyle="TextStyle.Caption" Text="@Message" Style="@(Failed ? "color: var(--grove-color-danger, #b3261e);" : null)" />
        }
    </GroveStack>
}
else if (IsEnabled)
{
    <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
        <GroveText TextStyle="TextStyle.Body2" Text="@string.Format(CultureInfo.CurrentCulture, L("Codes are sent to {0}."), PhoneNumber)" />
        @if (AllowChanging)
        {
            <GroveButton Text="@L("Edit")" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="Edit" data-testid="two-factor-phone-edit" />
        }
    </GroveStack>
}
else
{
    <GroveButton Text="@L("Verify phone number")" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="Edit" data-testid="two-factor-phone-add" />
}

@code {
    [Parameter]
    public bool IsEnabled { get; set; }

    [Parameter]
    public string? PhoneNumber { get; set; }

    /// <summary>Whether the user may set another number (the login settings, or no valid number yet).</summary>
    [Parameter]
    public bool AllowChanging { get; set; }

    [Parameter]
    public EventCallback<TwoFactorActionResult> Changed { get; set; }

    private bool Editing { get; set; }
    private bool CodeSent { get; set; }
    private string? Number { get; set; }
    private string? Code { get; set; }
    private string? Message { get; set; }
    private bool Failed { get; set; }
    private bool Busy { get; set; }

    private void Edit()
    {
        Number = PhoneNumber;
        Code = null;
        Message = null;
        CodeSent = false;
        Editing = true;
    }

    private async Task SendAsync()
    {
        Busy = true;
        try
        {
            var result = await TwoFactorApi.PostAsync(Http, "phone/send", new { PhoneNumber = Number });
            (Failed, Message, CodeSent) = (!result.Succeeded, result.Message, CodeSent || result.Succeeded);
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task VerifyAsync()
    {
        Busy = true;
        try
        {
            var result = await TwoFactorApi.PostAsync(Http, "phone/verify", new { PhoneNumber = Number, Code });
            if (!result.Succeeded)
            {
                (Failed, Message) = (true, result.Message);
                return;
            }

            Editing = false;
            await Changed.InvokeAsync(result);
        }
        finally
        {
            Busy = false;
        }
    }

    private string L(string text) => (Services.GetService(typeof(ILocalizer)) as ILocalizer)?.Get(text, CultureInfo.CurrentUICulture) ?? text;
}

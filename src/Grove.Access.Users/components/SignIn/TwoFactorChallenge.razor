@namespace Grove.Access.Users.Components
@inject HttpClient Http
@inject IServiceProvider Services

@* The second sign-in step (docs/MVC/parity.md › TwoFactorChallenge): the code of the account's
   method - typed from an authenticator app, or sent by email or SMS on request - or one of the
   account's recovery codes. The password step left who is signing in in the two-factor cookie;
   this only finishes it (api/grove/auth/two-factor). Part of the login pages of every shell. *@

<GroveStack Gap="0.75rem" Style="width: 22rem; max-width: 100%;" data-testid="two-factor-challenge">
    <GroveText TextStyle="TextStyle.H5" Text="@L("Two-factor authentication")" />
    @if (State is null)
    {
        <GroveText TextStyle="TextStyle.Body2" Text="@(Loaded ? L("The sign-in has expired. Sign in again.") : L("Loading…"))" data-testid="two-factor-expired" />
        @if (Loaded)
        {
            <GroveButton Text="@L("Sign in again")" ButtonStyle="ButtonStyle.Light" Click="@(() => Restart.InvokeAsync())" />
        }
    }
    else if (Recovery)
    {
        <GroveText TextStyle="TextStyle.Body2" Text="@L("Enter one of the recovery codes you saved when you set up two-factor authentication.")" />
        <GroveFormField Text="@L("Recovery code")" Style="width: 100%;">
            <GroveTextBox @bind-Value="Code" autocomplete="off" Style="width: 100%;" data-testid="two-factor-recovery-code" />
        </GroveFormField>
        <GroveButton Text="@L("Log in")" Click="SubmitAsync" Disabled="@(Busy || !RendererInfo.IsInteractive)" data-testid="two-factor-submit" />
        <a href="" class="rz-link" @onclick="@(() => SwitchMode(false))" @onclick:preventDefault="true">@L("Use a verification code instead")</a>
    }
    else
    {
        <GroveText TextStyle="TextStyle.Body2" Text="@L("Your login is protected with a second authentication method.")" />
        @if (State.Providers.Length > 1)
        {
            <GroveFormField Text="@L("Method")" Style="width: 100%;">
                <GroveDropDown TValue="string" Data="@Methods" TextProperty="Text" ValueProperty="Value" @bind-Value="Provider" Style="width: 100%;" data-testid="two-factor-method" />
            </GroveFormField>
        }
        @if (TwoFactorMethods.SendsCode(Provider))
        {
            <GroveButton Text="@(Provider == TwoFactorMethods.Email ? L("Email me a code") : L("Text me a code"))" ButtonStyle="ButtonStyle.Light" Click="SendCodeAsync" Disabled="@(Busy || !RendererInfo.IsInteractive)" data-testid="two-factor-send-code" />
        }
        <GroveFormField Text="@L("Verification code")" Style="width: 100%;">
            <GroveTextBox @bind-Value="Code" autocomplete="one-time-code" inputmode="numeric" Style="width: 100%;" data-testid="two-factor-code" />
        </GroveFormField>
        @if (State.AllowRememberDevice)
        {
            <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <GroveCheckBox @bind-Value="RememberDevice" Name="RememberDevice" />
                <label class="rz-label" for="RememberDevice" style="margin: 0; cursor: pointer;">@L("Remember this device")</label>
            </GroveStack>
        }
        <GroveButton Text="@L("Log in")" Click="SubmitAsync" Disabled="@(Busy || !RendererInfo.IsInteractive)" data-testid="two-factor-submit" />
        <a href="" class="rz-link" @onclick="@(() => SwitchMode(true))" @onclick:preventDefault="true" data-testid="two-factor-use-recovery">@L("Don't have access to your device? Log in with a recovery code")</a>
    }

    @if (Message is { Length: > 0 })
    {
        <GroveText TextStyle="TextStyle.Caption" Text="@Message" data-testid="two-factor-message" />
    }
    @foreach (var error in Errors)
    {
        <GroveText TextStyle="TextStyle.Caption" Text="@error" Style="color: var(--grove-color-danger, #b3261e);" data-testid="two-factor-error" />
    }
</GroveStack>

@code {
    /// <summary>Whether the session outlives the browser, as the password step asked.</summary>
    [Parameter]
    public bool RememberMe { get; set; }

    /// <summary>Start with the recovery code rather than the method's code.</summary>
    [Parameter]
    public bool RecoveryCode { get; set; }

    /// <summary>Raised with the signed-in user; the page goes where it goes after a sign-in.</summary>
    [Parameter]
    public EventCallback<SignInAnswer> SignedIn { get; set; }

    /// <summary>Raised when the pending sign-in is gone and the user must start again.</summary>
    [Parameter]
    public EventCallback Restart { get; set; }

    private TwoFactorChallengeState? State { get; set; }
    private bool Loaded { get; set; }
    private bool Busy { get; set; }
    private bool Recovery { get; set; }
    private string? Provider { get; set; }
    private string? Code { get; set; }
    private bool RememberDevice { get; set; }
    private string? Message { get; set; }
    private string[] Errors { get; set; } = [];

    private IEnumerable<MethodOption> Methods => (State?.Providers ?? []).Select(provider => new MethodOption(provider, L(TwoFactorMethods.DisplayName(provider))));

    protected override async Task OnInitializedAsync()
    {
        Recovery = RecoveryCode;

        // The pending sign-in lives in a cookie the browser sends: read it once interactive.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        State = await SignInApi.GetAsync<TwoFactorChallengeState>(Http, "api/grove/auth/two-factor");
        Provider = State?.Provider ?? State?.Providers.FirstOrDefault();
        Loaded = true;
    }

    private void SwitchMode(bool recovery)
    {
        Recovery = recovery;
        Code = null;
        Errors = [];
        Message = null;
    }

    private async Task SendCodeAsync()
    {
        Busy = true;
        try
        {
            var (sent, refusal) = await SignInApi.PostAsync<TwoFactorCodeSent, TwoFactorCodeSent>(Http, "api/grove/auth/two-factor/send-code", new { Provider });
            Message = (sent ?? refusal)?.Message ?? L("The code could not be sent.");
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task SubmitAsync()
    {
        Busy = true;
        Errors = [];
        try
        {
            var (answer, refusal) = Recovery
                ? await SignInApi.PostAsync<SignInAnswer, SignInRefusal>(Http, "api/grove/auth/two-factor/recovery", new { Code })
                : await SignInApi.PostAsync<SignInAnswer, SignInRefusal>(Http, "api/grove/auth/two-factor", new { Provider, Code, RememberMe, RememberDevice });

            if (answer is { IsAuthenticated: true })
            {
                await SignedIn.InvokeAsync(answer);
                return;
            }

            Errors = refusal?.Errors is { Length: > 0 } errors ? errors : [L("Invalid verification code.")];
        }
        finally
        {
            Busy = false;
        }
    }

    private sealed record MethodOption(string Value, string Text);

    private string L(string text) => (Services.GetService(typeof(ILocalizer)) as ILocalizer)?.Get(text, CultureInfo.CurrentUICulture) ?? text;
}

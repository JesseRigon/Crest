@page "/ResetPassword"

@* Sets a new password from the emailed link (UserEmailService links here with the code). *@

<PageTitle>Reset your password</PageTitle>

<div style="max-width: 32rem; margin: 2rem auto; padding: 0 1rem;" data-testid="site-reset-password-page">
    <PasswordResetForm Code="@Code" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "code")]
    public string? Code { get; set; }
}

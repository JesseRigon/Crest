@page "/RegistrationPending"

@* Where a registration waiting for moderation lands (UserModerationLoginFormEvent). *@

<PageTitle>Registration pending</PageTitle>

<div style="max-width: 32rem; margin: 2rem auto; padding: 0 1rem;" data-testid="site-registration-pending-page">
    <GroveStack Gap="0.75rem">
        <GroveText TextStyle="TextStyle.H5" Text="Registration pending" />
        <GroveText TextStyle="TextStyle.Body1" Text="Your account was created. An administrator must approve it before you can sign in." />
    </GroveStack>
</div>

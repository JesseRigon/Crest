@page "/ResetPasswordConfirmation"

@* After a password was reset. *@

<PageTitle>Reset your password</PageTitle>

<div style="max-width: 32rem; margin: 2rem auto; padding: 0 1rem;" data-testid="site-reset-password-confirmation-page">
    <GroveStack Gap="0.75rem">
        <GroveText TextStyle="TextStyle.H5" Text="Your password has been reset" />
        <GroveText TextStyle="TextStyle.Body1" Text="Sign in with your new password." />
    </GroveStack>
</div>

<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <PropertyGroup>
    <!-- NuGet properties-->
    <Title>Grove OpenApi</Title>
    <Description>$(OCCMSDescription)

    Provides OpenApi functionality.
    </Description>
    <PackageTags>$(PackageTags) PlatformCMS Api</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore.ReDoc" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grove.Module.Targets\Grove.Module.Targets.csproj" />
    <ProjectReference Include="..\Grove.DisplayManagement\Grove.DisplayManagement.csproj" />
    <ProjectReference Include="..\Grove.ContentManagement\Grove.ContentManagement.csproj" />
    <ProjectReference Include="..\Grove.Navigation\Grove.Navigation.csproj" />
    <ProjectReference Include="..\Grove.ResourceManagement\Grove.ResourceManagement.csproj" />
    <ProjectReference Include="..\Grove.Contents\Grove.Contents.csproj" />
    <ProjectReference Include="..\Grove.Infrastructure.Abstractions\Grove.Infrastructure.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.OpenApi.Abstractions\Grove.OpenApi.Abstractions.csproj" />
  </ItemGroup>
</Project>

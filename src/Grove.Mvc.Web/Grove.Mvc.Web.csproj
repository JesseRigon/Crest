<Project ToolsVersion="15.0" Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>$(CommonTargetFrameworks)</TargetFrameworks>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn> <!-- Disable XML comment warning on single file Program -->
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <Target Name="EnsureWwwRootExists" BeforeTargets="Build;Publish">
    <MakeDir Directories="$(MSBuildProjectDirectory)\wwwroot" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Grove.Application.Mvc.Targets\Grove.Application.Mvc.Targets.csproj" />
    <ProjectReference Include="..\Grove.HealthChecks\Grove.HealthChecks.csproj" />
    <ProjectReference Include="..\Grove.Mvc.HelloWorld\Grove.Mvc.HelloWorld.csproj" />
  </ItemGroup>

  <!-- Necessary as we reference the Project and not the Package -->
  <Import Project="..\Grove.Application.Targets\Grove.Application.Targets.targets" />

  <Import Project="..\Grove.Build\Grove.Commons.targets" />

</Project>

<Project>
  <!--
    The platform: the projects imported from OrchardCore, under src/ beside Grove's own modules.
    Directory.Build.props uses these lists to give them the platform's build settings (Commons,
    analyzers, module/theme targets) that their former folder grouping used to give them. A new platform project is added to the right list.
  -->
  <PropertyGroup>
    <PlatformLibraryProjects>;Grove.Abstractions;Grove.Access.Abstractions;Grove.Admin.Abstractions;Grove.AdminMenu.Abstractions;Grove.Apis.GraphQL.Abstractions;Grove.Apis.GraphQL.Client;Grove.Application.Cms.Core.Targets;Grove.Application.Cms.Targets;Grove.Application.Mvc.Targets;Grove.Application.Targets;Grove.AuditTrail.Abstractions;Grove.Configuration.KeyVault;Grove.ContentLocalization.Abstractions;Grove.ContentManagement;Grove.Contents.Abstractions;Grove.ContentManagement.Abstractions;Grove.ContentManagement.Display;Grove.ContentManagement.GraphQL;Grove.ContentPreview.Abstractions;Grove.ContentTypes.Abstractions;Grove.Contents.TagHelpers;Grove.Data;Grove.Data.Abstractions;Grove.Data.Types;Grove.Data.YesSql;Grove.Data.YesSql.Abstractions;Grove.Deployment.Abstractions;Grove.DisplayManagement;Grove.DisplayManagement.Abstractions;Grove.DisplayManagement.Liquid;Grove.DynamicCache.Abstractions;Grove.Email.Abstractions;Grove.Feeds.Abstractions;Grove.FileStorage.Abstractions;Grove.FileStorage.AmazonS3;Grove.FileStorage.AzureBlob;Grove.FileStorage.FileSystem;Grove.HealthChecks.Abstractions;Grove.Indexing.Abstractions;Grove.Infrastructure;Grove.Infrastructure.Abstractions;Grove.Liquid.Abstractions;Grove.Localization.Abstractions;Grove.Logging.NLog;Grove.Logging.Serilog;Grove.Markdown.Abstractions;Grove.Media.Abstractions;Grove.Mvc.Abstractions;Grove.MetaWeblog.Abstractions;Grove.Module.Targets;Grove.Mvc;Grove.Notifications.Abstractions;Grove.Queries.Abstractions;Grove.Recipes.Abstractions;Grove.Redis.Abstractions;Grove.ResourceManagement;Grove.ResourceManagement.Abstractions;Grove.Roles.Abstractions;Grove.Rules.Abstractions;Grove.Scripting.JavaScript;Grove.Search.Abstractions;Grove.Search.Elasticsearch.Abstractions;Grove.Search.Lucene.Abstractions;Grove.Seo.Abstractions;Grove.Setup.Abstractions;Grove.Shells.Azure;Grove.Shortcodes.Abstractions;Grove.Sitemaps.Abstractions;Grove.Sms.Abstractions;Grove.SourceGenerators;Grove.Theme.Targets;Grove.UrlRewriting.Abstractions;Grove.Users.Abstractions;Grove.Workflows.Abstractions;Grove.XmlRpc.Abstractions;Grove.Autoroute.Abstractions;Grove.AzureAI.Abstractions;Grove.ContentFields.Abstractions;Grove.Elasticsearch.Abstractions;Grove.Features.Abstractions;Grove.Flows.Abstractions;Grove.Html.Abstractions;Grove.Lucene.Abstractions;Grove.OpenApi.Abstractions;Grove.OpenId.Abstractions;Grove.RateLimits.Abstractions;Grove.ReCaptcha.Abstractions;Grove.Settings.Abstractions;Grove.Sharing.Abstractions;Grove.Server.Abstractions;Grove.Taxonomies.Abstractions;Grove.Navigation.Abstractions;</PlatformLibraryProjects>
    <PlatformModuleProjects>;Grove.Access;Grove.Admin;Grove.AdminDashboard;Grove.AdminMenu;Grove.Alias;Grove.Antivirus;Grove.Apis.GraphQL;Grove.ArchiveLater;Grove.AuditTrail;Grove.AutoSetup;Grove.Autoroute;Grove.AzureAI;Grove.BackgroundTasks;Grove.ContentFields;Grove.ContentLocalization;Grove.ContentPreview;Grove.ContentTypes;Grove.Contents;Grove.Cors;Grove.CustomSettings;Grove.DataLocalization;Grove.DataProtection.Azure;Grove.Demo;Grove.Deployment;Grove.Deployment.Remote;Grove.Diagnostics;Grove.DynamicCache;Grove.Elasticsearch;Grove.Email;Grove.Email.Azure;Grove.Email.Smtp;Grove.Facebook;Grove.Features;Grove.Feeds;Grove.Flows;Grove.GitHub;Grove.Google;Grove.HealthChecks;Grove.HomeRoute;Grove.Html;Grove.Https;Grove.Indexing;Grove.Layers;Grove.Liquid;Grove.Lists;Grove.Localization;Grove.Lucene;Grove.Markdown;Grove.Media;Grove.Media.AmazonS3;Grove.Media.Azure;Grove.Media.ImageSharpV3;Grove.Media.Indexing.OpenXML;Grove.Media.Indexing.Pdf;Grove.Media.Scanning;Grove.Menu;Grove.Microsoft.Authentication;Grove.MiniProfiler;Grove.Mvc.HelloWorld;Grove.Navigation;Grove.Notifications;Grove.OpenApi;Grove.OpenId;Grove.Placements;Grove.PublishLater;Grove.Queries;Grove.RateLimits;Grove.ReCaptcha;Grove.Recipes;Grove.Redis;Grove.Resources;Grove.ResponseCompression;Grove.ReverseProxy;Grove.Roles;Grove.Rules;Grove.Scripting;Grove.Search;Grove.Security;Grove.Seo;Grove.Settings;Grove.Setup;Grove.Sharing;Grove.Shortcodes;Grove.SignalR;Grove.SignalR.Azure;Grove.SignalR.Redis;Grove.Sitemaps;Grove.Sms;Grove.Sms.Azure;Grove.Spatial;Grove.Taxonomies;Grove.Templates;Grove.Tenants;Grove.Themes;Grove.Title;Grove.Twitter;Grove.UrlRewriting;Grove.Users;Grove.XmlRpc;</PlatformModuleProjects>

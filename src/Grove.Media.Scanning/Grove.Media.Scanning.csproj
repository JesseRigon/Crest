<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <RootNamespace>Grove.Media.Scanning</RootNamespace>
    <Nullable>enable</Nullable>
    <!-- NuGet properties-->
    <Title>Grove Media Scanning</Title>
    <Description>$(OCCMSDescription)

    Upload security: the quarantine, host-level scanners and type detection (ClamAV, libmagic), offsite providers and their verdict callback.</Description>
    <PackageTags>$(PackageTags) PlatformCMS Media Security</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="YesSql.Core" />
    <PackageReference Include="Mime" />
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Grove.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grove.Media.Abstractions\Grove.Media.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Antivirus\Grove.Antivirus.csproj" />
    <ProjectReference Include="..\Grove.Module.Targets\Grove.Module.Targets.csproj" />
    <ProjectReference Include="..\Grove.Infrastructure.Abstractions\Grove.Infrastructure.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Data.YesSql.Abstractions\Grove.Data.YesSql.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Settings.Abstractions\Grove.Settings.Abstractions.csproj" />
  </ItemGroup>

</Project>

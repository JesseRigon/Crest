    <ProjectReference Include="..\Crest.Settings\Crest.Settings.csproj" />
    <ProjectReference Include="..\Crest.Deployment.Abstractions\Crest.Deployment.Abstractions.csproj" />
    <ProjectReference Include="..\Crest.Infrastructure.Abstractions\Crest.Infrastructure.Abstractions.csproj" />
    <ProjectReference Include="..\Crest.Infrastructure\Crest.Infrastructure.csproj" />
    <ProjectReference Include="..\Crest.Recipes.Abstractions\Crest.Recipes.Abstractions.csproj" />
    <ProjectReference Include="..\Crest.RateLimits.Abstractions\Crest.RateLimits.Abstractions.csproj" />
  </ItemGroup>

</Project>

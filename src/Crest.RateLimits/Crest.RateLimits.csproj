<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <Title>Crest RateLimits</Title>
    <Description>
      $(OCCMSDescription)

      Provides global and route-based rate limiting for Crest applications.
    </Description>
    <PackageTags>$(PackageTags) PlatformCMS Security</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Crest.DisplayManagement\Crest.DisplayManagement.csproj" />
    <ProjectReference Include="..\Crest.Module.Targets\Crest.Module.Targets.csproj" />
    <ProjectReference Include="..\Crest.Navigation.Core\Crest.Navigation.Core.csproj" />
    <ProjectReference Include="..\Crest.RateLimits.Core\Crest.RateLimits.Core.csproj" />
    <ProjectReference Include="..\Crest.Settings.Core\Crest.Settings.Core.csproj" />
  </ItemGroup>

</Project>

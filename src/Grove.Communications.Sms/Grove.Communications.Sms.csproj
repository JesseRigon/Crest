<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- NuGet properties-->
    <Title>Grove Sms</Title>
    <Description>
      $(OCCMSDescription)

      The SMS module provides a way to send SMS messages.
    </Description>
    <PackageTags>$(PackageTags) PlatformCMS</PackageTags>
  </PropertyGroup>

  <!-- The SMS test page is its own WASM library (blazor-wasm/, Grove.Communications.Sms.BlazorWasm). -->
  <ItemGroup>
    <Compile Remove="blazor-wasm/**/*.cs" />
    <Content Remove="blazor-wasm/**" />
    <None Remove="blazor-wasm/**" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grove.Display.Management\Grove.Display.Management.csproj" />
    <ProjectReference Include="..\Grove.Module.Targets\Grove.Module.Targets.csproj" />
    <ProjectReference Include="..\Grove.Display.Navigation\Grove.Display.Navigation.csproj" />
    <ProjectReference Include="..\Grove.Display.Resources.Management\Grove.Display.Resources.Management.csproj" />
    <ProjectReference Include="..\Grove.Workflows\Abstractions\Grove.Workflows.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Workflows\engine\src\modules\Grove.Workflows.Core\Grove.Workflows.Core.csproj" />
    <ProjectReference Include="..\Grove.Workflows\engine\src\modules\Grove.Workflows.Engine\Grove.Workflows.Engine.csproj" />
    <ProjectReference Include="..\Grove.Infrastructure.Abstractions\Grove.Infrastructure.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Communications.Abstractions\Grove.Communications.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Communications.Sms.Abstractions\Grove.Communications.Sms.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Infrastructure.Server.Abstractions\Grove.Infrastructure.Server.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Access.Users\Grove.Access.Users.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

</Project>

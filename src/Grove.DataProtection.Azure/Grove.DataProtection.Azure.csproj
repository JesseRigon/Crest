<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- NuGet properties-->
    <Title>Grove Azure DataProtection</Title>
    <Description>$(OCFrameworkDescription)

    Provides Azure Blob Storage for data protection key rings.</Description>
    <PackageTags>$(PackageTags) PlatformFramework</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grove.Liquid.Abstractions\Grove.Liquid.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Module.Targets\Grove.Module.Targets.csproj" />
  </ItemGroup>

</Project>

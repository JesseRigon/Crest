<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- NuGet properties-->
    <Title>Grove Contents</Title>
    <Description>
      $(OCCMSDescription)

      Provides Content Management services.
    </Description>
    <PackageTags>$(PackageTags) PlatformCMS ContentManagement</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Grove.Tests" />
    <InternalsVisibleTo Include="Grove.Contents.OptionLists.Tests" />
  </ItemGroup>

  <!-- The Option lists page is its own WASM library (blazor-wasm/,
       Grove.Contents.OptionLists.BlazorWasm); its tests are tests/. -->
  <ItemGroup>
    <Compile Remove="blazor-wasm/**/*.cs;tests/**/*.cs" />
    <Content Remove="blazor-wasm/**;tests/**" />
    <None Remove="blazor-wasm/**;tests/**" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grove.Contents.Types\Grove.Contents.Types.csproj" />
    <ProjectReference Include="..\Grove.Infrastructure.Server.Abstractions\Grove.Infrastructure.Server.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Infrastructure.Shells.Admin.Abstractions\Grove.Infrastructure.Shells.Admin.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Contents.AdminMenu.Abstractions\Grove.Contents.AdminMenu.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.AuditTrail.Abstractions\Grove.AuditTrail.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Contents.Fields\Grove.Contents.Fields.csproj" />
    <ProjectReference Include="..\Grove.Contents.Management.GraphQL\Grove.Contents.Management.GraphQL.csproj" />
    <ProjectReference Include="..\Grove.Access.Abstractions\Grove.Access.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Access.Sharing.Abstractions\Grove.Access.Sharing.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Access.Roles.Abstractions\Grove.Access.Roles.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Contents.Abstractions\Grove.Contents.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Contents.Management\Grove.Contents.Management.csproj" />
    <ProjectReference Include="..\Grove.Contents.Management.Display\Grove.Contents.Management.Display.csproj" />
    <ProjectReference Include="..\Grove.Contents.Types.Abstractions\Grove.Contents.Types.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Deployment.Abstractions\Grove.Deployment.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Deployment\Grove.Deployment.csproj" />
    <ProjectReference Include="..\Grove.Data.Feeds.Abstractions\Grove.Data.Feeds.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Data.Indexing.Abstractions\Grove.Data.Indexing.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Module.Targets\Grove.Module.Targets.csproj" />
    <ProjectReference Include="..\Grove.Display.Liquid.Abstractions\Grove.Display.Liquid.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Data.Localization.Abstractions\Grove.Data.Localization.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Display.Navigation\Grove.Display.Navigation.csproj" />
    <ProjectReference Include="..\Grove.Infrastructure.Recipes.Abstractions\Grove.Infrastructure.Recipes.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Display.Resources.Management\Grove.Display.Resources.Management.csproj" />
    <ProjectReference Include="..\Grove.Infrastructure.Settings\Grove.Infrastructure.Settings.csproj" />
    <ProjectReference Include="..\Grove.Seo.Sitemaps.Abstractions\Grove.Seo.Sitemaps.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Access.Users.Abstractions\Grove.Access.Users.Abstractions.csproj" />
    <!-- The Grove.Contents.OptionLists feature: part lists plug into the option picker as a
         source through its abstractions only (Grove.Contents.OptionPicker references this module),
         and ship shared global sets through Grove.Data.Global. -->
    <ProjectReference Include="..\Grove.Contents.OptionPicker.Abstractions\Grove.Contents.OptionPicker.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Data.Global\Grove.Data.Global.csproj" />
  </ItemGroup>

</Project>

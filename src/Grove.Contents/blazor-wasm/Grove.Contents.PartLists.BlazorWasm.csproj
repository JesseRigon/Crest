<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The client library of the Grove.Contents.PartLists feature (the Content Part Lists
         page). The *.BlazorWasm suffix is the routing convention the server and the admin
         client load module pages by; the name before it is the feature that owns the
         library, so its pages are served only while that feature is enabled. -->
    <AssemblyName>Grove.Contents.PartLists.BlazorWasm</AssemblyName>
    <RootNamespace>Grove.Contents.PartLists.BlazorWasm</RootNamespace>
  </PropertyGroup>

  <!-- Plain component-model packages, no WASM-only APIs - works under every host:
       WASM, Blazor Server, and SSR (mirrors Grove.Parties.BlazorWasm). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Grove.Display.Components\Grove.Display.Components.csproj" />
  </ItemGroup>
</Project>

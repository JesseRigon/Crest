<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Grove.Access</RootNamespace>
    <Nullable>enable</Nullable>
    <!-- NuGet properties-->
    <Title>Grove Access Abstractions</Title>
    <Description>$(OCCMSDescription)

    The access contracts every read and write goes through: the caller, the decision, the scope and the audit.</Description>
    <PackageTags>$(PackageTags) PlatformCMS Access Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grove.Abstractions\Grove.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Kinds\Grove.Kinds.csproj" />
  </ItemGroup>

</Project>

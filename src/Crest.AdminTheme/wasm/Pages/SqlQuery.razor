@page "/Queries/Sql/Query"
@attribute [PageEntry("ManageSqlQueries", Id = "run-sql-query", Parent = "queries", Caption = "Run SQL Query")]
@using System.Text.Json
@using System.Text.Json.Nodes
@using Crest.AdminTheme.Api
@using Crest.Components.Primitives
@inject IApi Api
@inject NavigationManager Navigation
@inject Crest.Components.Theme.CrestApiLocalizer T

@* The SQL runner: a SELECT-only template, run through the query pipeline like a saved Sql
   query (scoped to the caller, paged, capped, never committed). The stock screen's
   ?query=<base64> link (the "Run" link on a saved Sql query) prefills it. *@

<CrestStack Gap="1rem" data-testid="sql-query-page">
    <CrestStack Gap="0.25rem">
        <CrestText TextStyle="TextStyle.H4" Text="@T["Run SQL Query"]" />
        <CrestText TextStyle="TextStyle.Body2" Text="@T["SELECT statements only. Values bind as parameters (@name); the results are limited to what you may see."]" />
    </CrestStack>

    <CrestCard>
        <CrestStack Gap="1rem">
            <CrestFormField Text="@T["Query"]" Style="width: 100%;">
                <CrestTextArea @bind-Value="Sql" Rows="10" Style="width: 100%; font-family: var(--rz-code-font-family, monospace);" data-testid="sql-query-text" />
            </CrestFormField>
            <CrestFormField Text="@T["Parameters (JSON object)"]" Style="width: 100%;">
                <CrestTextArea @bind-Value="Parameters" Rows="4" Style="width: 100%; font-family: var(--rz-code-font-family, monospace);" />
            </CrestFormField>
            <CrestStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="0.5rem">
                <CrestText TextStyle="TextStyle.Caption" Text="@(Result?.FactoryName is { Length: > 0 } factory ? T["Connection: {0}", factory] : string.Empty)" />
                <CrestButton Text="@T["Run query"]" Icon="play_arrow" Click="RunAsync" Disabled="@IsRunning" data-testid="sql-query-run" />
            </CrestStack>
        </CrestStack>
    </CrestCard>

    @if (InputError is not null)
    {
        <CrestAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@InputError</CrestAlert>
    }

    @if (IsRunning)
    {
        <CrestProgressBar Mode="ProgressBarMode.Indeterminate" />
    }
    else if (Result is not null)
    {
        @foreach (var error in Result.Errors)
        {
            <CrestAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@error</CrestAlert>
        }

        @if (!string.IsNullOrWhiteSpace(Result.RawSql))
        {
            <CrestCard>
                <CrestStack Gap="0.5rem">
                    <CrestText TextStyle="TextStyle.H6" Text="@T["Statement as run"]" />
                    <pre style="white-space: pre-wrap; margin: 0;">@Result.RawSql</pre>
                </CrestStack>
            </CrestCard>
        }

        @if (Result.Errors.Length == 0)
        {
            <CrestCard data-testid="sql-query-results">
                <CrestStack Gap="0.5rem">
                    <CrestText TextStyle="TextStyle.Body2" Text="@T["{0} rows in {1} ms", Rows.Count, Math.Round(Result.ElapsedMilliseconds)]" />
                    @if (Rows.Count > 0)
                    {
                        <div style="overflow-x: auto;">
                            <table class="rz-grid-table rz-grid-table-fixed" style="width: auto; min-width: 100%;">
                                <thead><tr>@foreach (var column in Result.Columns) { <th style="text-align: left; padding: 0.25rem 0.5rem;">@column</th> }</tr></thead>
                                <tbody>
                                    @foreach (var row in Rows)
                                    {
                                        <tr>@foreach (var column in Result.Columns) { <td style="padding: 0.25rem 0.5rem; vertical-align: top;">@Cell(row, column)</td> }</tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </CrestStack>
            </CrestCard>
        }
    }
</CrestStack>

@code {
    private string Sql { get; set; } = "SELECT * FROM ContentItemIndex";
    private string Parameters { get; set; } = "{ }";
    private SqlRun? Result { get; set; }
    private List<JsonNode?> Rows { get; set; } = [];
    private bool IsRunning { get; set; }
    private string? InputError { get; set; }

    protected override void OnInitialized()
    {
        var query = new Uri(Navigation.Uri).Query.TrimStart('?')
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(pair => pair.Split('=', 2))
            .FirstOrDefault(pair => string.Equals(pair[0], "query", StringComparison.OrdinalIgnoreCase) && pair.Length == 2);

        if (query is not null)
        {
            try { Sql = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(Uri.UnescapeDataString(query[1]))); }
            catch (FormatException) { }
        }
    }

    private async Task RunAsync()
    {
        InputError = null;
        JsonObject? parameters;
        try { parameters = string.IsNullOrWhiteSpace(Parameters) ? null : JsonNode.Parse(Parameters) as JsonObject; }
        catch (JsonException) { parameters = null; }

        if (parameters is null && !string.IsNullOrWhiteSpace(Parameters))
        {
            InputError = T["Parameters must be a JSON object."];
            return;
        }

        IsRunning = true;
        try
        {
            Result = await Api.Crest.Rest.Queries.RunSqlAsync(new SqlRunRequest(Sql, parameters));
            Rows = Result.Rows.ToList();
            if (Result.Parameters.Count > 0) Parameters = Result.Parameters.ToJsonString(new() { WriteIndented = true });
        }
        catch (Exception exception) { Result = SqlRun.Failed(exception.Message); Rows = []; }
        finally { IsRunning = false; }
    }

    private static string Cell(JsonNode? row, string column) => row is JsonObject values && values.TryGetPropertyValue(column, out var value)
        ? value switch { null => "NULL", JsonValue scalar => scalar.ToString(), _ => value.ToJsonString() }
        : string.Empty;
}

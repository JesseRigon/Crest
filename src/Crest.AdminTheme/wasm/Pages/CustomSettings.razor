@page "/CustomSettings"
@page "/CustomSettings/{Type}"
@attribute [PageEntry("AccessAdminPanel")]
@using System.Text.Json.Nodes
@using Crest.AdminTheme.Display
@using Crest.Components.Primitives
@using Crest.DisplayManagement.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject NotificationService Notifications
@inject Crest.Components.Theme.CrestApiLocalizer T

@* Custom settings (Crest.CustomSettings) on the content editor tree: each settings type is a
   content type kept as one item in the site settings; the server lays out its editors as for any
   content item and this page saves what the tree's ContentEditor publishes. *@
<CrestStack Gap="1rem" data-testid="custom-settings-page">
    <CrestStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Stretch">
        <CrestModelList TItem="SettingsType" Title="@T["Custom settings"]" Items="@(Types ?? [])" SelectedKey="@Type"
                        KeySelector="@(type => type.Name)" TextSelector="@(type => type.DisplayName)" ShowCreate="false" ShowSearch="false"
                        Select="@(type => Navigation.NavigateTo($"CustomSettings/{Uri.EscapeDataString(type.Name)}"))"
                        EmptyText="@T["No custom settings types are available to you."]" IsBusy="@(Types is null)" />
        <div style="flex: 1; min-width: 0;">
            @if (Error is { } error) { <CrestAlert AlertStyle="AlertStyle.Danger" AllowClose="false">@error</CrestAlert> }
            @if (Tree is not null)
            {
                <DisplayTreeRenderer @key="State" Node="Tree.Root" State="State" />
                <CrestStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                    <CrestButton Text="@T["Save"]" Icon="save" Click="SaveAsync" Disabled="IsSaving" data-testid="custom-settings-save" />
                </CrestStack>
            }
            else if (Type is not null && Error is null)
            {
                <CrestProgressBar Mode="ProgressBarMode.Indeterminate" />
            }
        </div>
    </CrestStack>
</CrestStack>

@code {
    private const string Api = "api/crest/custom-settings";

    [Parameter] public string? Type { get; set; }

    private SettingsType[]? Types;
    private DisplayTree? Tree;
    private DisplayState State = new();
    private string? Error;
    private bool IsSaving;

    protected override async Task OnInitializedAsync()
    {
        try { Types = await Http.GetFromJsonAsync<SettingsType[]>(Api) ?? []; }
        catch (Exception exception) { Error = exception.Message; }
    }

    protected override async Task OnParametersSetAsync()
    {
        Tree = null;
        State = new DisplayState();
        Error = null;
        if (string.IsNullOrWhiteSpace(Type)) return;
        try { Tree = await Http.GetFromJsonAsync<DisplayTree>($"{Api}/{Uri.EscapeDataString(Type)}/editor"); }
        catch (Exception exception) { Error = exception.Message; }
    }

    private JsonObject? EditedContent()
    {
        var editor = Tree is null ? null : DisplayTreeValidator.Walk(Tree.Root).FirstOrDefault(node => node.Component == "ContentEditor");
        if (editor is null) return null;
        return (State.GetOutput(editor.Id, "ContentChanged") ?? (editor.Properties.TryGetValue("Content", out var content) ? content?.DeepClone() : null)) as JsonObject;
    }

    private async Task SaveAsync()
    {
        IsSaving = true;
        Error = null;
        try
        {
            using var response = await Http.PutAsJsonAsync($"{Api}/{Uri.EscapeDataString(Type!)}", new { Content = EditedContent() });
            if (!response.IsSuccessStatusCode) { Error = await response.Content.ReadAsStringAsync(); return; }
            Notifications.Notify(NotificationSeverity.Success, T["Settings saved"], T["The settings were saved."]);
        }
        finally { IsSaving = false; }
    }

    private sealed record SettingsType(string Name, string DisplayName);
}

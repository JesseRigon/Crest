@page "/Roles/Index"
@using Crest.AdminTheme.Api
@using Crest.Components.Access
@inject IApi Api
@inject HttpClient Http
@inject Crest.Components.Theme.CrestApiLocalizer T

@* The role editor (docs/permissions.md › Layers, Editors): a role holds permission sets and
   loose permissions; one role name serves the tenant and every organization, what it yields
   depending on the reach and the ceilings. *@

<CrestStack Gap="1rem" data-testid="roles-page">
    <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Wrap="FlexWrap.Wrap">
        <CrestStack Gap="0.25rem">
            <CrestText TextStyle="TextStyle.H4" Text="@T["Roles"]" />
            <CrestText TextStyle="TextStyle.Body2" Text="@T["A role holds permission sets and loose permissions. Groups give roles to users."]" />
        </CrestStack>
        <CrestButton Text="@T["Refresh"]" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="LoadAsync" Disabled="@IsLoading" />
    </CrestStack>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <CrestAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</CrestAlert>
    }

    <CrestRow Gap="1rem">
        <CrestColumn Size="12" SizeLG="4">
            <CrestModelList TItem="Role"
                            Title="@T["Roles"]"
                            Items="@AllRoles"
                            SelectedKey="@SelectedRoleName"
                            KeySelector="@(role => role.Name)"
                            TextSelector="@(role => role.Name)"
                            DescriptionSelector="@(role => role.Description)"
                            SearchPredicate="MatchesSearch"
                            Select="SelectRoleAsync"
                            ShowCreate="false"
                            IsBusy="@IsLoading"
                            EmptyText="@T["No roles are available."]" />
            <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem" Style="margin-top: 0.5rem;">
                <CrestTextBox @bind-Value="NewRoleName" Placeholder="@T["New role name"]" Style="flex: 1 1 auto;" />
                <CrestButton Text="@T["Add"]" Icon="add" Click="CreateAsync" Disabled="@string.IsNullOrWhiteSpace(NewRoleName)" data-testid="role-create" />
            </CrestStack>
        </CrestColumn>
        <CrestColumn Size="12" SizeLG="8">
            @if (Detail is null)
            {
                <CrestCard><CrestText Text="@T["Select a role."]" /></CrestCard>
            }
            else
            {
                <CrestCard data-testid="role-detail">
                    <CrestStack Gap="1rem">
                        <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.Center">
                            <CrestText TextStyle="TextStyle.H5" Text="@Detail.Name" />
                            <CrestBadge Text="@(Detail.IsSystem ? T["System role"] : T["Custom role"])" BadgeStyle="@(Detail.IsSystem ? BadgeStyle.Info : BadgeStyle.Secondary)" />
                            @if (Detail.IsAdmin)
                            {
                                <CrestBadge Text="@T["Administrator: holds every permission"]" BadgeStyle="BadgeStyle.Success" />
                            }
                        </CrestStack>
                        <CrestFormField Text="@T["Description"]"><CrestTextBox @bind-Value="DraftDescription" Style="width: 100%;" /></CrestFormField>

                        <CrestText TextStyle="TextStyle.Subtitle2" Text="@T["Permission sets"]" />
                        <CrestStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap">
                            @foreach (var set in Sets)
                            {
                                var name = set.Name;
                                <label style="display: inline-flex; gap: 0.25rem; align-items: center;" title="@string.Join(", ", set.Permissions)">
                                    <CrestCheckBox TValue="bool" Value="@DraftSets.Contains(name)" Change="@((bool on) => Toggle(DraftSets, name, on))" />
                                    @name
                                </label>
                            }
                        </CrestStack>

                        <CrestText TextStyle="TextStyle.Subtitle2" Text="@T["Loose permissions"]" />
                        <CrestTextBox @bind-Value="PermissionFilter" Placeholder="@T["Filter permissions"]" Style="width: 100%;" />
                        @foreach (var category in Catalog.Where(Matches).GroupBy(permission => permission.Category ?? string.Empty))
                        {
                            <CrestText TextStyle="TextStyle.Caption" Text="@(category.Key.Length == 0 ? T["General"] : category.Key)" />
                            <CrestStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap">
                                @foreach (var permission in category)
                                {
                                    var name = permission.Name;
                                    <label style="display: inline-flex; gap: 0.25rem; align-items: center;" title="@permission.Description">
                                        <CrestCheckBox TValue="bool" Value="@DraftPermissions.Contains(name)" Change="@((bool on) => Toggle(DraftPermissions, name, on))" />
                                        @name
                                    </label>
                                }
                            </CrestStack>
                        }

                        <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            <CrestButton Text="@T["Save role"]" Icon="save" Click="SaveAsync" Disabled="@IsLoading" data-testid="role-save" />
                            @if (!Detail.IsSystem)
                            {
                                <CrestButton Text="@T["Delete role"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Click="DeleteAsync" Disabled="@IsLoading" />
                            }
                        </CrestStack>
                    </CrestStack>
                </CrestCard>
            }
        </CrestColumn>
    </CrestRow>
</CrestStack>

@code {
    private Role[] AllRoles { get; set; } = [];
    private List<PermissionSetInfo> Sets { get; set; } = [];
    private List<PermissionInfo> Catalog { get; set; } = [];
    private RoleDetail? Detail { get; set; }
    private string? SelectedRoleName { get; set; }
    private string? DraftDescription { get; set; }
    private HashSet<string> DraftSets { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> DraftPermissions { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    private string? PermissionFilter { get; set; }
    private string? NewRoleName { get; set; }
    private bool IsLoading { get; set; }
    private string? ErrorMessage { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            AllRoles = await Api.Crest.Rest.Roles.ListAsync();
            Sets = await Http.GetFromJsonAsync<List<PermissionSetInfo>>("api/crest/permission-sets") ?? [];
            Catalog = await Http.GetFromJsonAsync<List<PermissionInfo>>("api/crest/permission-catalog") ?? [];
            SelectedRoleName = AllRoles.Any(role => string.Equals(role.Name, SelectedRoleName, StringComparison.OrdinalIgnoreCase))
                ? SelectedRoleName
                : AllRoles.FirstOrDefault()?.Name;
            await LoadDetailAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadDetailAsync()
    {
        Detail = SelectedRoleName is null ? null : await Http.GetFromJsonAsync<RoleDetail>($"api/crest/roles/{Uri.EscapeDataString(SelectedRoleName)}");
        DraftDescription = Detail?.Description;
        DraftSets = new HashSet<string>(Detail?.Sets ?? [], StringComparer.OrdinalIgnoreCase);
        DraftPermissions = new HashSet<string>(Detail?.Permissions ?? [], StringComparer.OrdinalIgnoreCase);
    }

    private async Task SelectRoleAsync(Role role)
    {
        SelectedRoleName = role.Name;
        await LoadDetailAsync();
    }

    private bool Matches(PermissionInfo permission) =>
        string.IsNullOrWhiteSpace(PermissionFilter)
        || permission.Name.Contains(PermissionFilter, StringComparison.OrdinalIgnoreCase)
        || (permission.Description?.Contains(PermissionFilter, StringComparison.OrdinalIgnoreCase) ?? false);

    private static void Toggle(HashSet<string> set, string name, bool on)
    {
        if (on) set.Add(name); else set.Remove(name);
    }

    private async Task CreateAsync()
    {
        await RunAsync(() => Http.PostAsJsonAsync("api/crest/roles", new RoleWrite(NewRoleName!.Trim(), null, [], [])));
        SelectedRoleName = NewRoleName?.Trim();
        NewRoleName = null;
        await LoadAsync();
    }

    private async Task SaveAsync()
    {
        await RunAsync(() => Http.PutAsJsonAsync($"api/crest/roles/{Uri.EscapeDataString(Detail!.Name)}", new RoleWrite(Detail.Name, DraftDescription, [.. DraftSets], [.. DraftPermissions])));
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        await RunAsync(() => Http.DeleteAsync($"api/crest/roles/{Uri.EscapeDataString(Detail!.Name)}"));
        SelectedRoleName = null;
        await LoadAsync();
    }

    private async Task RunAsync(Func<Task<HttpResponseMessage>> call)
    {
        ErrorMessage = null;
        using var response = await call();
        if (!response.IsSuccessStatusCode)
        {
            ErrorMessage = await AccessApi.ErrorAsync(response);
        }
    }

    private static bool MatchesSearch(Role role, string term) =>
        role.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
        || role.Description.Contains(term, StringComparison.OrdinalIgnoreCase);
}

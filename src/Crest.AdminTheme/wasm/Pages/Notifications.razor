@page "/notifications"
@using System.Net.Http.Json
@using Crest.Components.Primitives
@inject HttpClient Http
@inject Crest.Components.Theme.CrestApiLocalizer T

@* The signed-in user's notifications in full (Crest.Notifications portal API): the title-bar bell
   shows the latest; this page pages through all of them, filters to unread, marks read or unread
   and deletes. Only ever the caller's own. *@
<CrestStack Gap="1rem" data-testid="notifications-page">
    <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
        <div>
            <CrestText TextStyle="TextStyle.H4" Text="@T["Notifications"]" />
            @if (List is not null) { <CrestText TextStyle="TextStyle.Body2">@T["{0} unread of {1}", List.Unread, List.Total]</CrestText> }
        </div>
        <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
            <CrestCheckBox TValue="bool" Value="UnreadOnly" ValueChanged="@(async (bool value) => { UnreadOnly = value; await LoadAsync(0); })" Name="notifications-unread-only" />
            <label for="notifications-unread-only">@T["Unread only"]</label>
            <CrestButton Text="@T["Mark all read"]" Icon="done_all" ButtonStyle="ButtonStyle.Light" Click="ReadAllAsync" Disabled="Busy" data-testid="notifications-read-all" />
        </CrestStack>
    </CrestStack>
    @if (Error is { } error) { <CrestAlert AlertStyle="AlertStyle.Danger" AllowClose="false">@error</CrestAlert> }
    @if (List is null)
    {
        <CrestProgressBar Mode="ProgressBarMode.Indeterminate" />
    }
    else if (List.Items.Length == 0)
    {
        <CrestCard><CrestText>@T["No notifications."]</CrestText></CrestCard>
    }
    else
    {
        @foreach (var item in List.Items)
        {
            <CrestCard data-notification="@item.Id" Style="@(item.IsRead ? null : "border-left: 3px solid var(--rz-primary)")">
                <CrestStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
                    <div>
                        <CrestText TextStyle="TextStyle.Subtitle1" class="rz-m-0">@item.Subject</CrestText>
                        <CrestText TextStyle="TextStyle.Body2">@item.Summary</CrestText>
                        <CrestText TextStyle="TextStyle.Caption">@item.CreatedUtc.ToLocalTime().ToString("g")</CrestText>
                    </div>
                    <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                        <CrestButton Text="@(item.IsRead ? T["Mark unread"] : T["Mark read"])" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => ToggleAsync(item))" Disabled="Busy" />
                        <CrestButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => DeleteAsync(item))" Disabled="Busy" />
                    </CrestStack>
                </CrestStack>
            </CrestCard>
        }
        <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
            <CrestButton Text="@T["Newer"]" ButtonStyle="ButtonStyle.Light" Disabled="@(Skip == 0 || Busy)" Click="@(() => LoadAsync(Math.Max(0, Skip - PageSize)))" />
            <CrestButton Text="@T["Older"]" ButtonStyle="ButtonStyle.Light" Disabled="@(Skip + PageSize >= CurrentTotal || Busy)" Click="@(() => LoadAsync(Skip + PageSize))" />
        </CrestStack>
    }
</CrestStack>

@code {
    private const string Api = "api/crest/notifications";
    private const int PageSize = 20;

    private ListModel? List;
    private int Skip;
    private bool UnreadOnly;
    private bool Busy;
    private string? Error;

    private int CurrentTotal => List is null ? 0 : UnreadOnly ? List.Unread : List.Total;

    protected override Task OnInitializedAsync() => LoadAsync(0);

    private async Task LoadAsync(int skip)
    {
        Busy = true;
        try
        {
            Skip = skip;
            List = await Http.GetFromJsonAsync<ListModel>($"{Api}?skip={skip}&take={PageSize}&unreadOnly={UnreadOnly.ToString().ToLowerInvariant()}");
            Error = null;
        }
        catch (Exception exception) { Error = exception.Message; }
        finally { Busy = false; }
    }

    private async Task ToggleAsync(ItemModel item)
    {
        await SendAsync(Http.PostAsync($"{Api}/{Uri.EscapeDataString(item.Id)}/{(item.IsRead ? "unread" : "read")}", null));
    }

    private async Task DeleteAsync(ItemModel item) => await SendAsync(Http.DeleteAsync($"{Api}/{Uri.EscapeDataString(item.Id)}"));

    private async Task ReadAllAsync() => await SendAsync(Http.PostAsync($"{Api}/read-all", null));

    private async Task SendAsync(Task<HttpResponseMessage> request)
    {
        Busy = true;
        try
        {
            using var response = await request;
            if (!response.IsSuccessStatusCode) { Error = await response.Content.ReadAsStringAsync(); return; }
        }
        finally { Busy = false; }

        await LoadAsync(Skip);
    }

    private sealed record ItemModel(string Id, string Subject, string Summary, DateTime CreatedUtc, bool IsRead, DateTime? ReadUtc);
    private sealed record ListModel(int Unread, int Total, ItemModel[] Items);
}

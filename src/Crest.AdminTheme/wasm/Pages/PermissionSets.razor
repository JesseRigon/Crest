@page "/PermissionSets"
@attribute [PageEntry("ReadPermissionSets", Id = "permission-sets", Parent = "accessControl", Caption = "Permission Sets")]
@using Crest.Components.Access
@inject HttpClient Http
@inject Crest.Components.Theme.CrestApiLocalizer T

@* Permission sets (docs/permissions.md › Layers): tenant-defined named lists of permissions
   that roles hold. Modules ship defaults; the tenant edits them here. A change reaches every
   role holding the set, and every organization, on the next request. *@

<CrestStack Gap="1rem" data-testid="permission-sets-page">
    <CrestStack Gap="0.25rem">
        <CrestText TextStyle="TextStyle.H4" Text="@T["Permission sets"]" />
        <CrestText TextStyle="TextStyle.Body2" Text="@T["Named lists of permissions that roles hold."]" />
    </CrestStack>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <CrestAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</CrestAlert>
    }

    <CrestRow Gap="1rem">
        <CrestColumn Size="12" SizeLG="4">
            <CrestModelList TItem="PermissionSetInfo"
                            Title="@T["Sets"]"
                            Items="@Sets"
                            SelectedKey="@SelectedName"
                            KeySelector="@(set => set.Name)"
                            TextSelector="@(set => set.Name)"
                            DescriptionSelector="@(set => set.Description ?? string.Empty)"
                            Select="@((PermissionSetInfo set) => Select(set))"
                            ShowCreate="false"
                            IsBusy="@IsLoading"
                            EmptyText="@T["No permission sets yet."]" />
            <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem" Style="margin-top: 0.5rem;">
                <CrestTextBox @bind-Value="NewName" Placeholder="@T["New set name"]" Style="flex: 1 1 auto;" />
                <CrestButton Text="@T["Add"]" Icon="add" Click="CreateAsync" Disabled="@string.IsNullOrWhiteSpace(NewName)" data-testid="permission-set-create" />
            </CrestStack>
        </CrestColumn>
        <CrestColumn Size="12" SizeLG="8">
            @if (SelectedName is null)
            {
                <CrestCard><CrestText Text="@T["Select a set."]" /></CrestCard>
            }
            else
            {
                <CrestCard data-testid="permission-set-detail">
                    <CrestStack Gap="0.75rem">
                        <CrestText TextStyle="TextStyle.H5" Text="@SelectedName" />
                        <CrestFormField Text="@T["Description"]"><CrestTextBox @bind-Value="DraftDescription" Style="width: 100%;" /></CrestFormField>
                        <CrestTextBox @bind-Value="Filter" Placeholder="@T["Filter permissions"]" Style="width: 100%;" />
                        @foreach (var category in Catalog.Where(Matches).GroupBy(permission => permission.Category ?? string.Empty))
                        {
                            <CrestText TextStyle="TextStyle.Caption" Text="@(category.Key.Length == 0 ? T["General"] : category.Key)" />
                            <CrestStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap">
                                @foreach (var permission in category)
                                {
                                    var name = permission.Name;
                                    <label style="display: inline-flex; gap: 0.25rem; align-items: center;" title="@permission.Description">
                                        <CrestCheckBox TValue="bool" Value="@Draft.Contains(name)" Change="@((bool on) => { if (on) Draft.Add(name); else Draft.Remove(name); })" />
                                        @name
                                    </label>
                                }
                            </CrestStack>
                        }
                        <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            <CrestButton Text="@T["Save set"]" Icon="save" Click="SaveAsync" data-testid="permission-set-save" />
                            <CrestButton Text="@T["Delete set"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Click="DeleteAsync" />
                        </CrestStack>
                    </CrestStack>
                </CrestCard>
            }
        </CrestColumn>
    </CrestRow>
</CrestStack>

@code {
    private List<PermissionSetInfo> Sets { get; set; } = [];
    private List<PermissionInfo> Catalog { get; set; } = [];
    private string? SelectedName { get; set; }
    private string? DraftDescription { get; set; }
    private HashSet<string> Draft { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    private string? Filter { get; set; }
    private string? NewName { get; set; }
    private bool IsLoading { get; set; }
    private string? ErrorMessage { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            Sets = await Http.GetFromJsonAsync<List<PermissionSetInfo>>("api/crest/permission-sets") ?? [];
            Catalog = await Http.GetFromJsonAsync<List<PermissionInfo>>("api/crest/permission-catalog") ?? [];
            if (Sets.FirstOrDefault(set => set.Name == SelectedName) is { } selected)
            {
                Select(selected);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void Select(PermissionSetInfo set)
    {
        SelectedName = set.Name;
        DraftDescription = set.Description;
        Draft = new HashSet<string>(set.Permissions, StringComparer.OrdinalIgnoreCase);
    }

    private bool Matches(PermissionInfo permission) =>
        string.IsNullOrWhiteSpace(Filter) || permission.Name.Contains(Filter, StringComparison.OrdinalIgnoreCase);

    private async Task CreateAsync()
    {
        SelectedName = NewName!.Trim();
        await PutAsync(SelectedName, null, []);
        NewName = null;
    }

    private Task SaveAsync() => PutAsync(SelectedName!, DraftDescription, [.. Draft]);

    private async Task PutAsync(string name, string? description, List<string> permissions)
    {
        using var response = await Http.PutAsJsonAsync($"api/crest/permission-sets/{Uri.EscapeDataString(name)}", new PermissionSetInfo(name, description, permissions));
        ErrorMessage = response.IsSuccessStatusCode ? null : await AccessApi.ErrorAsync(response);
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        using var response = await Http.DeleteAsync($"api/crest/permission-sets/{Uri.EscapeDataString(SelectedName!)}");
        ErrorMessage = response.IsSuccessStatusCode ? null : await AccessApi.ErrorAsync(response);
        SelectedName = null;
        await LoadAsync();
    }
}

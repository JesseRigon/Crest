@page "/DeploymentPlan/Import/Index"
@attribute [PageEntry("Import", Id = "deployment-package-import", Parent = "deployments", Caption = "Package Import", Position = "2")]
@using Crest.AdminTheme.Api
@using Microsoft.AspNetCore.Components.Forms
@using Crest.Components.Primitives
@inject IApi Api
@inject NotificationService Notifications
@inject Crest.Components.Theme.CrestApiLocalizer T

<CrestStack Gap="1rem" data-testid="deployment-import-page">
    <CrestStack Gap="0.25rem">
        <CrestText TextStyle="TextStyle.H4" Text="@T["Package Import"]" />
        <CrestText TextStyle="TextStyle.Body2" Text="@T["Import a deployment package (.zip) or a recipe (.json) into this tenant. The upload passes the tenant's file checks first."]" />
    </CrestStack>

    @if (Outcome is not null)
    {
        <CrestAlert AlertStyle="@(Outcome.Succeeded ? AlertStyle.Success : AlertStyle.Danger)" ShowIcon="true" AllowClose="false">@Outcome.Message</CrestAlert>
    }

    <CrestCard>
        <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
            <label class="rz-button rz-button-md rz-button-primary"><span class="rzi rzi-upload"></span> @T["Choose a package"]<InputFile hidden accept=".zip,.json" OnChange="ImportAsync" disabled="@IsImporting" /></label>
            @if (IsImporting)
            {
                <CrestProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                <CrestText Text="@T["Importing {0}...", FileName ?? string.Empty]" />
            }
        </CrestStack>
    </CrestCard>
</CrestStack>

@code {
    private DeploymentResult? Outcome { get; set; }
    private bool IsImporting { get; set; }
    private string? FileName { get; set; }

    private async Task ImportAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        FileName = file.Name;
        IsImporting = true;
        Outcome = null;
        try
        {
            await using var stream = file.OpenReadStream(256L * 1024 * 1024);
            Outcome = await Api.Crest.Rest.Deployment.ImportPackageAsync(file.Name, stream);
            if (Outcome.Succeeded) Notifications.Notify(NotificationSeverity.Success, T["Package Import"], T["{0} imported.", file.Name]);
        }
        catch (Exception exception) { Outcome = new(false, exception.Message); }
        finally { IsImporting = false; }
    }
}

@page "/Recipes"
@using Crest.AdminTheme.Api
@using Crest.Components.Primitives
@using Crest.Components.Primitives
@inject IApi Api
@inject Crest.Components.Theme.CrestApiLocalizer T
<CrestStack Gap="1rem" data-testid="recipes-page"><CrestText TextStyle="TextStyle.H4" Text="@T["Recipes"]"/>@if(Model is null){<CrestProgressBar Mode="ProgressBarMode.Indeterminate"/>}else{<CrestDataGrid Data="Model" TItem="Recipe"><Columns><CrestDataGridColumn TItem="Recipe" Property="DisplayName" Title="@T["Recipe"]"/><CrestDataGridColumn TItem="Recipe" Property="Description" Title="@T["Description"]"/><CrestDataGridColumn TItem="Recipe" Title="@T["Actions"]"><Template Context="recipe"><CrestButton Text="@T["Run"]" Click="@(()=>Run(recipe))"/></Template></CrestDataGridColumn></Columns></CrestDataGrid>}</CrestStack>
@code { Recipe[]? Model; protected override async Task OnInitializedAsync()=>Model=await Api.Crest.Rest.Recipes.ListAsync(); async Task Run(Recipe x){await Api.Crest.Rest.Recipes.ExecuteAsync(new(x.BasePath,x.FileName));} }

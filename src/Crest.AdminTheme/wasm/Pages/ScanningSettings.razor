@page "/Settings/uploadScanning"
@using Crest.AdminTheme.Api
@using Crest.Components.Primitives
@inject IApi Api
@inject Crest.Components.Theme.CrestApiLocalizer T

@* The tenant's upload scanning choice (docs/media.md § 2, requirement 90): its own external
   scanner, and whether the host's scanners still run beside it. The secret is write-only:
   the server stores it protected and only says whether one is set. *@
<CrestStack Gap="1rem" data-testid="scanning-settings-page">
    <CrestText TextStyle="TextStyle.H4" Text="@T["Upload Scanning"]" />
    @if (Model is null)
    {
        <CrestProgressBar Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
        <CrestFieldset Text="@T["External scanner"]">
            <CrestLabel Text="@T["Scanner address"]" Component="scanner-url" />
            <CrestTextBox @bind-Value="Url" Name="scanner-url" Placeholder="https://" Style="width:100%" data-testid="scanning-url" /><br />
            <CrestLabel Text="@(Model.HasSecret ? T["New secret (leave empty to keep the current one)"] : T["Secret"])" Component="scanner-secret" />
            <CrestPassword @bind-Value="Secret" Name="scanner-secret" Style="width:100%" data-testid="scanning-secret" /><br />
            @if (Model.HasSecret)
            {
                <CrestCheckBox @bind-Value="ClearSecret" Name="clear-secret" /><label for="clear-secret"> @T["Remove the stored secret"]</label><br />
            }
            <CrestCheckBox @bind-Value="Bypass" Name="bypass-host" /><label for="bypass-host"> @T["Use only this scanner (the host's scanners do not run)"]</label>
        </CrestFieldset>
        <CrestButton Text="@T["Save"]" Icon="save" Click="SaveAsync" data-testid="scanning-save" />
        @if (!string.IsNullOrWhiteSpace(Error)) { <CrestText TextStyle="TextStyle.Body2" Style="color: var(--rz-danger)">@Error</CrestText> }
    }
</CrestStack>

@code {
    private ScanningSettingsModel? Model;
    private string? Url;
    private string? Secret;
    private bool ClearSecret;
    private bool Bypass;
    private string? Error;

    protected override async Task OnInitializedAsync() => Load(await Api.Crest.Rest.ScanningSettings.GetAsync());

    private void Load(ScanningSettingsModel? settings)
    {
        Model = settings;
        Url = settings?.ExternalScannerUrl;
        Bypass = settings?.BypassHostScanners ?? false;
        Secret = null;
        ClearSecret = false;
    }

    private async Task SaveAsync()
    {
        if (Model is null) return;
        Error = null;
        var (saved, error) = await Api.Crest.Rest.ScanningSettings.SaveAsync(new CrestScanningSettingsUpdate(Url, Secret, ClearSecret, Bypass));
        if (saved is null) Error = string.IsNullOrWhiteSpace(error) ? T["The scanning settings could not be saved."] : error;
        else Load(saved);
    }
}

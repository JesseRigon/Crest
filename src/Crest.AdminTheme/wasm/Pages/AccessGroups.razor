@page "/Groups"
@using Crest.AdminTheme.Api
@using Crest.Components.Access
@inject IApi Api
@inject HttpClient Http
@inject Crest.Components.Theme.CrestApiLocalizer T

@* The tenant's groups (docs/permissions.md › Layers, Editors): staff hold their roles at tenant
   reach through these, with per-user overrides. Below them, the organization defaults: the
   tenant groups a new organization is cloned with, the roles an organization's admins may
   assign, and the permissions only an organization's owner account holds. *@

<CrestStack Gap="1rem" data-testid="access-groups-page">
    <CrestStack Gap="0.25rem">
        <CrestText TextStyle="TextStyle.H4" Text="@T["Groups"]" />
        <CrestText TextStyle="TextStyle.Body2" Text="@T["Groups give roles to users. Select a member to edit their overrides."]" />
    </CrestStack>

    <CrestAccessGroupsEditor Users="@Users" Roles="@RoleNames" />

    <CrestCard data-testid="organization-defaults">
        <CrestStack Gap="0.75rem">
            <CrestText TextStyle="TextStyle.H5" Text="@T["Organization defaults"]" />
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <CrestAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</CrestAlert>
            }

            <CrestText TextStyle="TextStyle.Subtitle2" Text="@T["Groups a new organization starts with"]" />
            <CrestStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap">
                @foreach (var group in TenantGroups)
                {
                    var id = group.Id;
                    <label style="display: inline-flex; gap: 0.25rem; align-items: center;">
                        <CrestCheckBox TValue="bool" Value="@Defaults.DefaultGroupIds.Contains(id)" Change="@((bool on) => Toggle(Defaults.DefaultGroupIds, id, on))" />
                        @group.Name
                    </label>
                }
            </CrestStack>

            <CrestText TextStyle="TextStyle.Subtitle2" Text="@T["Roles an organization may assign"]" />
            <CrestStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap">
                @foreach (var role in RoleNames)
                {
                    var name = role;
                    <label style="display: inline-flex; gap: 0.25rem; align-items: center;">
                        <CrestCheckBox TValue="bool" Value="@Defaults.AssignableRoles.Contains(name)" Change="@((bool on) => Toggle(Defaults.AssignableRoles, name, on))" />
                        @name
                    </label>
                }
            </CrestStack>

            <CrestFormField Text="@T["Owner-locked permissions (one per line)"]">
                <CrestTextArea @bind-Value="OwnerLocked" Rows="4" Style="width: 100%;" />
            </CrestFormField>

            <CrestButton Text="@T["Save organization defaults"]" Icon="save" Click="SaveDefaultsAsync" data-testid="organization-defaults-save" />
        </CrestStack>
    </CrestCard>
</CrestStack>

@code {
    private IReadOnlyList<UserChoice> Users { get; set; } = [];
    private IReadOnlyList<string> RoleNames { get; set; } = [];
    private List<AccessGroupInfo> TenantGroups { get; set; } = [];
    private OrganizationAccessDefaults Defaults { get; set; } = new();
    private string? OwnerLocked { get; set; }
    private string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            RoleNames = (await Api.Crest.Rest.Roles.ListAsync()).Select(role => role.Name).ToArray();
            var users = await Http.GetFromJsonAsync<UserListResult>("api/crest/users?pageSize=100");
            Users = (users?.Items ?? []).Select(user => new UserChoice(user.Id, user.UserName ?? user.Email ?? user.Id)).ToArray();
            await LoadDefaultsAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private async Task LoadDefaultsAsync()
    {
        TenantGroups = await Http.GetFromJsonAsync<List<AccessGroupInfo>>("api/crest/access/groups") ?? [];
        Defaults = await Http.GetFromJsonAsync<OrganizationAccessDefaults>("api/crest/access/organization-defaults") ?? new();
        OwnerLocked = string.Join('\n', Defaults.OwnerLockedPermissions);
    }

    private static void Toggle(List<string> list, string value, bool on)
    {
        list.Remove(value);
        if (on) list.Add(value);
    }

    private async Task SaveDefaultsAsync()
    {
        Defaults.OwnerLockedPermissions = (OwnerLocked ?? string.Empty).Split(['\n', '\r', ','], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        using var response = await Http.PutAsJsonAsync("api/crest/access/organization-defaults", Defaults);
        ErrorMessage = response.IsSuccessStatusCode ? null : await AccessApi.ErrorAsync(response);
        await LoadDefaultsAsync();
    }
}

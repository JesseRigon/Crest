@page "/OpenId/Application"
@attribute [PageEntry("ManageApplications", Id = "openid-applications", Parent = "openid", Caption = "Applications")]
@using Crest.AdminTheme.Api
@using Crest.Components.Primitives
@inject IApi Api
@inject NavigationManager Navigation
@inject NotificationService Notifications
@inject Crest.Components.Theme.CrestApiLocalizer T

@* The OpenID Connect applications (step 7: the MVC Application screens are retired). *@

<CrestStack Gap="1rem" data-testid="openid-applications-page">
    <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
        <CrestStack Gap="0.25rem">
            <CrestText TextStyle="TextStyle.H4" Text="@T["OpenID Connect applications"]" />
            <CrestText TextStyle="TextStyle.Body2" Text="@T["Clients allowed to request tokens from this tenant."]" />
        </CrestStack>
        <CrestButton Text="@T["Add application"]" Icon="add" Click="@(() => Navigation.NavigateTo("OpenId/Application/Create"))" data-testid="openid-application-add" />
    </CrestStack>

    @if (Error is not null)
    {
        <CrestAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@Error</CrestAlert>
    }

    <CrestCard>
        @if (Items is null)
        {
            <CrestProgressBar Mode="ProgressBarMode.Indeterminate" />
        }
        else if (Items.Length == 0)
        {
            <CrestText TextStyle="TextStyle.Body2" Text="@T["No applications yet."]" />
        }
        else
        {
            <CrestDataGrid Data="@Items" TItem="OpenIdApplicationListItem" AllowPaging="true" PageSize="20">
                <Columns>
                    <CrestDataGridColumn TItem="OpenIdApplicationListItem" Property="DisplayName" Title="@T["Name"]" />
                    <CrestDataGridColumn TItem="OpenIdApplicationListItem" Property="ClientId" Title="@T["Client id"]" />
                    <CrestDataGridColumn TItem="OpenIdApplicationListItem" Property="Type" Title="@T["Type"]" />
                    <CrestDataGridColumn TItem="OpenIdApplicationListItem" Title="@T["Actions"]" Width="10rem">
                        <Template Context="item">
                            <CrestStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                                <CrestButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => Navigation.NavigateTo($"OpenId/Application/Edit/{Uri.EscapeDataString(item.Id)}"))" title="@T["Edit"]" />
                                <CrestButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="@(() => DeleteAsync(item))" title="@T["Delete"]" />
                            </CrestStack>
                        </Template>
                    </CrestDataGridColumn>
                </Columns>
            </CrestDataGrid>
        }
    </CrestCard>
</CrestStack>

@code {
    private OpenIdApplicationListItem[]? Items { get; set; }
    private string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Items = await Api.Crest.Rest.OpenId.ListApplicationsAsync();
        if (Items is null)
        {
            Error = T["The applications could not be loaded."];
            Items = [];
        }
    }

    private async Task DeleteAsync(OpenIdApplicationListItem item)
    {
        if (await Api.Crest.Rest.OpenId.DeleteApplicationAsync(item.Id))
        {
            Notifications.Notify(NotificationSeverity.Success, T["Application deleted"], item.DisplayName ?? item.ClientId ?? item.Id);
            Items = [.. Items!.Where(candidate => candidate.Id != item.Id)];
        }
        else
        {
            Notifications.Notify(NotificationSeverity.Error, T["Delete failed"], T["The application could not be deleted."]);
        }
    }
}

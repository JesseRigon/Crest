@page "/Settings/files"
@using Crest.Components.Files
@using Crest.Components.Primitives
@inject HttpClient Http
@inject Crest.Components.Theme.CrestApiLocalizer T

@* The file system's tenant settings (docs/media.md § 3 and § 7): which drive types the tenant
   uses (requirement 18), the role an organization's admins hold (17), and administrator access
   to personal drives - notice, delay, override and durations (24-28). Turning a drive type off
   makes its drives inactive; turning it on reactivates them, keeping or resetting their
   sharing (22), and creates drives for everyone who has none. Tenant administrators only. *@
<CrestStack Gap="1rem" data-testid="file-settings-page">
    <CrestText TextStyle="TextStyle.H4" Text="@T["Files"]" />
    @if (Model is null)
    {
        @if (Error is { } loadError) { <CrestText Style="color: var(--rz-danger)">@loadError</CrestText> }
        else { <CrestProgressBar Mode="ProgressBarMode.Indeterminate" /> }
    }
    else
    {
        <CrestFieldset Text="@T["Drives"]">
            <CrestCheckBox @bind-Value="OrganizationDrives" Name="organization-drives" /><label for="organization-drives"> @T["Organization drives (one per organization)"]</label><br />
            <CrestCheckBox @bind-Value="PersonalDrives" Name="personal-drives" /><label for="personal-drives"> @T["Personal drives (one per staff user; members never have one)"]</label><br />
            <CrestLabel Text="@T["Role of an organization's admins (Drive Admin on its drive)"]" Component="organization-admin-role" />
            <CrestTextBox @bind-Value="OrganizationAdminRole" Name="organization-admin-role" Style="width:100%" /><br />
            <CrestCheckBox @bind-Value="ResetSharing" Name="reset-sharing" /><label for="reset-sharing"> @T["When a drive type is turned back on, reset its drives' sharing to the defaults"]</label>
        </CrestFieldset>

        <CrestFieldset Text="@T["Administrator access to personal drives"]">
            <CrestCheckBox @bind-Value="NoticeEmail" Name="notice-email" /><label for="notice-email"> @T["Notify the owner by email"]</label><br />
            <CrestCheckBox @bind-Value="NoticePortal" Name="notice-portal" /><label for="notice-portal"> @T["Notify the owner in the portal"]</label><br />
            <CrestLabel Text="@T["Delay after the notice, in minutes (needs a notice)"]" Component="notice-delay" />
            <CrestNumeric TValue="int" @bind-Value="DelayMinutes" Min="0" Name="notice-delay" /><br />
            <CrestCheckBox @bind-Value="AllowOverride" Name="allow-override" /><label for="allow-override"> @T["Allow the delay to be overridden, with a reason"]</label><br />
            <CrestLabel Text="@T["Durations offered, in minutes, comma separated (0 for until closed)"]" Component="durations" />
            <CrestTextBox @bind-Value="Durations" Name="durations" Style="width:100%" />
        </CrestFieldset>

        <CrestButton Text="@T["Save"]" Icon="save" Click="SaveAsync" data-testid="file-settings-save" />
        @if (Error is { } error) { <CrestText TextStyle="TextStyle.Body2" Style="color: var(--rz-danger)">@error</CrestText> }
        @if (Saved) { <CrestText TextStyle="TextStyle.Body2">@T["Saved."]</CrestText> }
    }
</CrestStack>

@code {
    private CrestFileSettings? Model;
    private bool OrganizationDrives;
    private bool PersonalDrives;
    private string? OrganizationAdminRole;
    private bool ResetSharing;
    private bool NoticeEmail;
    private bool NoticePortal;
    private int DelayMinutes;
    private bool AllowOverride;
    private string? Durations;
    private string? Error;
    private bool Saved;

    private CrestFilesClient Files => _files ??= new CrestFilesClient(Http);
    private CrestFilesClient? _files;

    protected override async Task OnInitializedAsync()
    {
        var loaded = await Files.GetSettingsAsync();
        Error = loaded.Error;
        if (loaded.Value is { } settings)
        {
            Load(settings);
        }
    }

    private void Load(CrestFileSettings settings)
    {
        Model = settings;
        OrganizationDrives = settings.Drives.OrganizationDrives;
        PersonalDrives = settings.Drives.PersonalDrives;
        OrganizationAdminRole = settings.Drives.OrganizationAdminRole;
        NoticeEmail = settings.PersonalDriveAccess.Notice.HasFlag(CrestPersonalDriveNotice.Email);
        NoticePortal = settings.PersonalDriveAccess.Notice.HasFlag(CrestPersonalDriveNotice.Portal);
        DelayMinutes = (int)settings.PersonalDriveAccess.Delay.TotalMinutes;
        AllowOverride = settings.PersonalDriveAccess.AllowDelayOverride;
        Durations = string.Join(", ", settings.PersonalDriveAccess.Durations.Select(duration => duration is { } span ? ((int)span.TotalMinutes).ToString() : "0"));
    }

    private async Task SaveAsync()
    {
        Error = null;
        Saved = false;
        var durations = new List<TimeSpan?>();
        foreach (var part in (Durations ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (!int.TryParse(part, out var minutes) || minutes < 0)
            {
                Error = T["Durations are whole minutes, 0 for until closed."];
                return;
            }

            durations.Add(minutes == 0 ? null : TimeSpan.FromMinutes(minutes));
        }

        if (durations.Count == 0)
        {
            Error = T["Offer at least one duration."];
            return;
        }

        var notice = (NoticeEmail ? CrestPersonalDriveNotice.Email : CrestPersonalDriveNotice.None) | (NoticePortal ? CrestPersonalDriveNotice.Portal : CrestPersonalDriveNotice.None);
        var settings = new CrestFileSettings(
            new CrestFileDriveSettings(OrganizationDrives, PersonalDrives, string.IsNullOrWhiteSpace(OrganizationAdminRole) ? "Member Administrator" : OrganizationAdminRole.Trim()),
            new CrestPersonalDriveAccessSettings(notice, TimeSpan.FromMinutes(Math.Max(0, DelayMinutes)), AllowOverride, durations));
        var saved = await Files.SaveSettingsAsync(settings, ResetSharing);
        if (!saved.Succeeded)
        {
            Error = saved.Error;
            return;
        }

        Load(settings);
        Saved = true;
    }
}

@page "/Error"
@page "/Error/{Status:int}"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

@* The admin shell's error page: the status code pages re-execute "/Error/{status}" inside the
   admin shell for an admin URL (CrestErrorPage). Anonymous, so it renders without the chrome. *@

<PageTitle>Error</PageTitle>

<Crest.Components.Errors.CrestErrorPage Status="@Status" />

@code {
    [Parameter]
    public int? Status { get; set; }
}

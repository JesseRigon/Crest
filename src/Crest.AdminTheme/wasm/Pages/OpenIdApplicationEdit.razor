@page "/OpenId/Application/Create"
@page "/OpenId/Application/Edit/{Id}"
@using Crest.AdminTheme.Api
@using Crest.Components.Primitives
@inject IApi Api
@inject NavigationManager Navigation
@inject NotificationService Notifications
@inject Crest.Components.Theme.CrestApiLocalizer T

@* An OpenID Connect application: client id, type and write-only secret, redirect URIs, the
   flows and endpoints it may use (only those the server allows are offered), and the roles
   and scopes it is granted. The secret is never read back: an edit keeps the stored one unless
   a new one is typed. *@

<CrestStack Gap="1rem" data-testid="openid-application-edit-page">
    <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
        <CrestText TextStyle="TextStyle.H4" Text="@(IsNew ? T["Add application"] : T["Edit {0}", Model.DisplayName ?? Model.ClientId ?? string.Empty])" />
        <CrestButton Text="@T["Back to applications"]" Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Click="@(() => Navigation.NavigateTo("OpenId/Application"))" />
    </CrestStack>

    @foreach (var message in FormErrors)
    {
        <CrestAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@message</CrestAlert>
    }

    @if (Editor is null)
    {
        <CrestCard><CrestProgressBar Mode="ProgressBarMode.Indeterminate" /></CrestCard>
    }
    else
    {
        <CrestCard>
            <CrestRow Gap="1rem">
                <CrestColumn Size="12" SizeMD="6"><CrestFormField Text="@T["Client id"]" Style="width: 100%;"><CrestTextBox @bind-Value="Model.ClientId" Style="width: 100%;" data-testid="openid-client-id" /></CrestFormField><FieldMessage Text="@ErrorFor(nameof(OpenIdApplicationModel.ClientId))" /></CrestColumn>
                <CrestColumn Size="12" SizeMD="6"><CrestFormField Text="@T["Display name"]" Style="width: 100%;"><CrestTextBox @bind-Value="Model.DisplayName" Style="width: 100%;" /></CrestFormField></CrestColumn>
                <CrestColumn Size="12" SizeMD="6">
                    <CrestFormField Text="@T["Type"]" Style="width: 100%;"><CrestDropDown @bind-Value="Model.Type" Data="@ClientTypes" TextProperty="Text" ValueProperty="Value" Style="width: 100%;" /></CrestFormField>
                </CrestColumn>
                <CrestColumn Size="12" SizeMD="6">
                    @if (!IsPublic)
                    {
                        <CrestFormField Text="@(Model.HasClientSecret ? T["Client secret (leave empty to keep the stored secret)"] : T["Client secret"])" Style="width: 100%;"><CrestPassword @bind-Value="Model.ClientSecret" Style="width: 100%;" data-testid="openid-client-secret" /></CrestFormField>
                        <FieldMessage Text="@ErrorFor(nameof(OpenIdApplicationModel.ClientSecret))" />
                    }
                </CrestColumn>
                <CrestColumn Size="12" SizeMD="6">
                    <CrestFormField Text="@T["Consent"]" Style="width: 100%;"><CrestDropDown @bind-Value="Model.ConsentType" Data="@ConsentTypes" TextProperty="Text" ValueProperty="Value" Style="width: 100%;" /></CrestFormField>
                </CrestColumn>
                <CrestColumn Size="12"><CrestFormField Text="@T["Redirect URIs (space-separated)"]" Style="width: 100%;"><CrestTextBox @bind-Value="Model.RedirectUris" Style="width: 100%;" /></CrestFormField><FieldMessage Text="@ErrorFor(nameof(OpenIdApplicationModel.RedirectUris))" /></CrestColumn>
                <CrestColumn Size="12"><CrestFormField Text="@T["Post-logout redirect URIs (space-separated)"]" Style="width: 100%;"><CrestTextBox @bind-Value="Model.PostLogoutRedirectUris" Style="width: 100%;" /></CrestFormField><FieldMessage Text="@ErrorFor(nameof(OpenIdApplicationModel.PostLogoutRedirectUris))" /></CrestColumn>
            </CrestRow>
        </CrestCard>

        <CrestCard>
            <CrestStack Gap="0.5rem">
                <CrestText TextStyle="TextStyle.H6" Text="@T["Flows and endpoints"]" />
                @if (Flows is null)
                {
                    <CrestText TextStyle="TextStyle.Body2" Text="@T["The OpenID server is not enabled on this tenant; the flows are stored as given."]" />
                }
                @if (Flows?.AuthorizationCode != false) { <SettingsSwitch @bind-Value="Model.AllowAuthorizationCodeFlow" Label="@T["Authorization code flow"]" /> }
                @if (Flows?.ClientCredentials != false) { <SettingsSwitch @bind-Value="Model.AllowClientCredentialsFlow" Label="@T["Client credentials flow"]" /> }
                @if (Flows?.Hybrid != false) { <SettingsSwitch @bind-Value="Model.AllowHybridFlow" Label="@T["Hybrid flow"]" /> }
                @if (Flows?.Implicit != false) { <SettingsSwitch @bind-Value="Model.AllowImplicitFlow" Label="@T["Implicit flow"]" /> }
                @if (Flows?.Password != false) { <SettingsSwitch @bind-Value="Model.AllowPasswordFlow" Label="@T["Password flow"]" /> }
                @if (Flows?.RefreshToken != false) { <SettingsSwitch @bind-Value="Model.AllowRefreshTokenFlow" Label="@T["Refresh token flow"]" /> }
                @if (Flows?.Logout != false) { <SettingsSwitch @bind-Value="Model.AllowLogoutEndpoint" Label="@T["Logout endpoint"]" /> }
                @if (Flows?.Introspection != false) { <SettingsSwitch @bind-Value="Model.AllowIntrospectionEndpoint" Label="@T["Introspection endpoint"]" /> }
                @if (Flows?.Revocation != false) { <SettingsSwitch @bind-Value="Model.AllowRevocationEndpoint" Label="@T["Revocation endpoint"]" /> }
                <SettingsSwitch @bind-Value="Model.RequireProofKeyForCodeExchange" Label="@T["Require PKCE"]" />
                <SettingsSwitch @bind-Value="Model.RequirePushedAuthorizationRequests" Label="@T["Require pushed authorization requests"]" />
            </CrestStack>
        </CrestCard>

        <CrestCard>
            <CrestRow Gap="1rem">
                <CrestColumn Size="12" SizeMD="6">
                    <CrestStack Gap="0.35rem">
                        <CrestText TextStyle="TextStyle.H6" Text="@T["Roles (client credentials)"]" />
                        @foreach (var role in Editor.Roles)
                        {
                            <SettingsSwitch Value="@Model.Roles.Contains(role)" ValueChanged="@((bool on) => Model.Roles = Toggle(Model.Roles, role, on))" Label="@role" />
                        }
                    </CrestStack>
                </CrestColumn>
                <CrestColumn Size="12" SizeMD="6">
                    <CrestStack Gap="0.35rem">
                        <CrestText TextStyle="TextStyle.H6" Text="@T["Scopes"]" />
                        @foreach (var scope in Editor.Scopes)
                        {
                            <SettingsSwitch Value="@Model.Scopes.Contains(scope)" ValueChanged="@((bool on) => Model.Scopes = Toggle(Model.Scopes, scope, on))" Label="@scope" />
                        }
                    </CrestStack>
                </CrestColumn>
            </CrestRow>
        </CrestCard>

        <CrestStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <CrestButton Text="@T["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="@(() => Navigation.NavigateTo("OpenId/Application"))" Disabled="@IsBusy" />
            <CrestButton Text="@T["Save"]" Icon="save" Click="SaveAsync" Disabled="@IsBusy" data-testid="openid-application-save" />
        </CrestStack>
    }
</CrestStack>

@code {
    [Parameter]
    public string? Id { get; set; }

    private OpenIdApplicationEditor? Editor { get; set; }
    private OpenIdApplicationModel Model { get; set; } = new();
    private OpenIdFieldError[] Errors { get; set; } = [];
    private bool IsBusy { get; set; }
    private bool IsNew => string.IsNullOrEmpty(Id);
    private bool IsPublic => string.Equals(Model.Type, "public", StringComparison.OrdinalIgnoreCase);
    private OpenIdServerFlows? Flows => Editor?.ServerFlows;

    private sealed record Choice(string Value, string Text);

    private Choice[] ClientTypes => [new("confidential", T["Confidential client"]), new("public", T["Public client"])];

    private Choice[] ConsentTypes =>
    [
        new("explicit", T["Explicit consent"]),
        new("implicit", T["Implicit consent"]),
        new("external", T["External consent"]),
        new("systematic", T["Systematic consent"]),
    ];

    private static readonly HashSet<string> Fields = new(StringComparer.OrdinalIgnoreCase)
    {
        nameof(OpenIdApplicationModel.ClientId), nameof(OpenIdApplicationModel.ClientSecret),
        nameof(OpenIdApplicationModel.RedirectUris), nameof(OpenIdApplicationModel.PostLogoutRedirectUris),
    };

    private IEnumerable<string> FormErrors => Errors.Where(error => !Fields.Contains(error.Key)).Select(error => error.Message);

    private string? ErrorFor(string key) => Errors.FirstOrDefault(error => string.Equals(error.Key, key, StringComparison.OrdinalIgnoreCase))?.Message;

    protected override async Task OnParametersSetAsync()
    {
        Editor = await Api.Crest.Rest.OpenId.GetApplicationEditorAsync(Id);
        if (Editor is null)
        {
            Errors = [new OpenIdFieldError(string.Empty, T["The application could not be loaded."])];
            return;
        }

        Model = Editor.Application ?? new OpenIdApplicationModel();
    }

    private static string[] Toggle(string[] values, string value, bool on) =>
        on ? [.. values.Append(value).Distinct(StringComparer.OrdinalIgnoreCase)] : [.. values.Where(candidate => !string.Equals(candidate, value, StringComparison.OrdinalIgnoreCase))];

    private async Task SaveAsync()
    {
        IsBusy = true;
        try
        {
            if (IsPublic)
            {
                Model.ClientSecret = null;
            }

            var result = await Api.Crest.Rest.OpenId.SaveApplicationAsync(Model);
            Errors = result.Errors;
            if (result.Succeeded)
            {
                Notifications.Notify(NotificationSeverity.Success, T["Application saved"], Model.DisplayName ?? Model.ClientId ?? string.Empty);
                Navigation.NavigateTo("OpenId/Application");
            }
        }
        finally
        {
            IsBusy = false;
        }
    }
}

@page "/BackgroundTasks"
@using System.Net.Http.Json
@using Crest.Components.Primitives
@inject HttpClient Http
@inject Crest.Components.Theme.CrestApiLocalizer T

@* Background tasks (Crest.BackgroundTasks): every registered task, enable or disable it, change its
   schedule and lock settings, or run it once now. *@
<CrestStack Gap="1rem" data-testid="background-tasks-page">
    <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
        <CrestText TextStyle="TextStyle.H4" Text="@T["Background tasks"]" />
        <CrestTextBox @bind-Value="Search" Placeholder="@T["Search"]" Style="width: 16rem" />
    </CrestStack>
    @if (Error is { } error) { <CrestAlert AlertStyle="AlertStyle.Danger" AllowClose="false">@error</CrestAlert> }
    @if (Tasks is null)
    {
        <CrestProgressBar Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
        @foreach (var task in Visible)
        {
            <CrestCard data-task="@task.Name">
                <CrestStack Gap="0.5rem">
                    <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                        <div>
                            <CrestText TextStyle="TextStyle.Subtitle1" class="rz-m-0">@(task.Title ?? task.Name)</CrestText>
                            <CrestText TextStyle="TextStyle.Caption">@task.Name · @(task.Enable ? T["enabled"] : T["disabled"]) · @task.Schedule</CrestText>
                        </div>
                        <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            <CrestButton Text="@(task.Enable ? T["Disable"] : T["Enable"])" ButtonStyle="ButtonStyle.Light" Click="@(() => SaveAsync(task, task with { Enable = !task.Enable }))" Disabled="Busy" />
                            <CrestButton Text="@T["Run now"]" Icon="play_arrow" ButtonStyle="ButtonStyle.Light" Click="@(() => RunAsync(task))" Disabled="Busy" data-testid="@($"task-run-{task.Name}")" />
                            <CrestButton Text="@T["Edit"]" Icon="edit" ButtonStyle="ButtonStyle.Light" Click="@(() => Editing = Editing?.Name == task.Name ? null : new Editor(task))" />
                        </CrestStack>
                    </CrestStack>
                    @if (!string.IsNullOrWhiteSpace(task.Description)) { <CrestText TextStyle="TextStyle.Body2">@task.Description</CrestText> }
                    @if (Results.TryGetValue(task.Name, out var result)) { <CrestText TextStyle="TextStyle.Caption">@result</CrestText> }
                    @if (Editing?.Name == task.Name)
                    {
                        <CrestLabel Text="@T["Schedule (cron; the default is {0})", task.DefaultSchedule]" Component="task-schedule" />
                        <CrestTextBox @bind-Value="Editing.Schedule" Name="task-schedule" Style="max-width: 16rem" />
                        <CrestLabel Text="@T["Description"]" Component="task-description" />
                        <CrestTextBox @bind-Value="Editing.Description" Name="task-description" Style="width: 100%" />
                        <CrestLabel Text="@T["Lock timeout and expiration (milliseconds; both above zero make the task atomic across instances)"]" Component="task-lock-timeout" />
                        <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            <CrestNumeric TValue="int" @bind-Value="Editing.LockTimeout" Min="0" Name="task-lock-timeout" />
                            <CrestNumeric TValue="int" @bind-Value="Editing.LockExpiration" Min="0" />
                        </CrestStack>
                        <div><CrestCheckBox @bind-Value="Editing.UsePipeline" Name="task-pipeline" /><label for="task-pipeline"> @T["Run with the tenant's request pipeline (needed by tasks that build URLs or render)"]</label></div>
                        <div><CrestButton Text="@T["Save"]" Icon="save" Click="@(() => SaveAsync(task, Editing.Apply(task)))" Disabled="Busy" /></div>
                    }
                </CrestStack>
            </CrestCard>
        }
    }
</CrestStack>

@code {
    private const string Api = "api/crest/background-tasks";

    private TaskModel[]? Tasks;
    private string? Search;
    private Editor? Editing;
    private string? Error;
    private bool Busy;
    private readonly Dictionary<string, string> Results = [];

    private IEnumerable<TaskModel> Visible => (Tasks ?? []).Where(task => string.IsNullOrWhiteSpace(Search)
        || (task.Title ?? task.Name).Contains(Search, StringComparison.OrdinalIgnoreCase)
        || (task.Description?.Contains(Search, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        try { Tasks = await Http.GetFromJsonAsync<TaskModel[]>(Api); }
        catch (Exception exception) { Error = exception.Message; }
    }

    private async Task SaveAsync(TaskModel task, TaskModel changed)
    {
        Busy = true;
        try
        {
            var response = await Http.PutAsJsonAsync($"{Api}/{Uri.EscapeDataString(task.Name)}", new { changed.Enable, changed.Schedule, changed.Description, changed.LockTimeout, changed.LockExpiration, changed.UsePipeline });
            if (!response.IsSuccessStatusCode) { Error = await response.Content.ReadAsStringAsync(); return; }
            var saved = await response.Content.ReadFromJsonAsync<TaskModel>();
            Tasks = Tasks!.Select(t => t.Name == task.Name && saved is not null ? saved : t).ToArray();
            Editing = null;
            Error = null;
        }
        finally { Busy = false; }
    }

    private async Task RunAsync(TaskModel task)
    {
        Busy = true;
        try
        {
            var response = await Http.PostAsync($"{Api}/{Uri.EscapeDataString(task.Name)}/run", null);
            var result = response.IsSuccessStatusCode ? await response.Content.ReadFromJsonAsync<RunResult>() : null;
            Results[task.Name] = result is null ? T["The task could not be run."]
                : result.Succeeded ? T["Ran in {0:0} ms.", result.Milliseconds] : T["Failed: {0}", result.Error ?? string.Empty];
        }
        finally { Busy = false; }
    }

    private sealed record TaskModel(string Name, string? Title, string? Description, bool Enable, string Schedule, string DefaultSchedule, int LockTimeout, int LockExpiration, bool UsePipeline);
    private sealed record RunResult(bool Succeeded, string? Error, double Milliseconds);

    private sealed class Editor(TaskModel task)
    {
        public string Name { get; } = task.Name;
        public string? Schedule { get; set; } = task.Schedule;
        public string? Description { get; set; } = task.Description;
        public int LockTimeout { get; set; } = task.LockTimeout;
        public int LockExpiration { get; set; } = task.LockExpiration;
        public bool UsePipeline { get; set; } = task.UsePipeline;

        public TaskModel Apply(TaskModel original) => original with { Schedule = Schedule ?? original.Schedule, Description = Description, LockTimeout = LockTimeout, LockExpiration = LockExpiration, UsePipeline = UsePipeline };
    }
}

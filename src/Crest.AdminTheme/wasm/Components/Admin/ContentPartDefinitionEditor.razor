@namespace Crest.AdminTheme.Components.Admin
@using System.Net.Http.Json
@using System.Text.Json.Nodes
@inject HttpClient Http
@inject Crest.Components.Theme.CrestApiLocalizer T

@* The rest of a content part's definition (the retired MVC ContentTypes part and field editors):
   the part's settings, each field's display name, order, removal and settings - settings as their
   stored JSON - and deleting the part when no type carries it. *@
<CrestFieldset Text="@T["Definition"]" AllowCollapse="true" Collapsed="true" data-testid="content-part-definition">
    @if (Error is { } error) { <CrestAlert AlertStyle="AlertStyle.Danger" AllowClose="false">@error</CrestAlert> }
    @if (Model is null)
    {
        <CrestProgressBar Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
        <CrestStack Gap="0.75rem">
            <CrestText TextStyle="TextStyle.Subtitle2" Text="@T["Part settings"]" />
            <DefinitionSettingsJson Url="@($"{Base}/settings")" Settings="Model.Settings" OnSaved="Changed" />

            <CrestText TextStyle="TextStyle.Subtitle2" Text="@T["Fields"]" />
            @for (var index = 0; index < Order.Count; index++)
            {
                var name = Order[index];
                var field = Model.Fields.First(candidate => candidate.Name == name);
                var at = index;
                <CrestFieldset Text="@($"{field.Name} · {field.FieldType}")" AllowCollapse="true" Collapsed="true" data-field="@field.Name">
                    <CrestStack Gap="0.5rem">
                        <CrestStack Orientation="Orientation.Horizontal" Gap="0.25rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
                            <CrestButton Icon="arrow_upward" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Click="@(() => MoveAsync(at, -1))" Disabled="@(Busy || at == 0)" />
                            <CrestButton Icon="arrow_downward" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" Click="@(() => MoveAsync(at, 1))" Disabled="@(Busy || at == Order.Count - 1)" />
                            <CrestFormField Text="@T["Display name"]"><CrestTextBox @bind-Value="DisplayNames[field.Name]" Style="width: 14rem" /></CrestFormField>
                            <CrestButton Text="@T["Rename"]" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => RenameAsync(field.Name))" Disabled="Busy" />
                            <CrestButton Text="@T["Remove field"]" Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Click="@(() => RemoveAsync(field.Name))" Disabled="Busy" data-testid="@($"remove-field-{field.Name}")" />
                        </CrestStack>
                        <DefinitionSettingsJson Url="@($"{Base}/fields/{Uri.EscapeDataString(field.Name)}/settings")" Settings="field.Settings" Rows="6" OnSaved="Changed" />
                    </CrestStack>
                </CrestFieldset>
            }

            @if (Model.UsedByTypes.Length == 0)
            {
                <div><CrestButton Text="@T["Delete part"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="DeleteAsync" Disabled="Busy" data-testid="content-part-delete" /></div>
            }
        </CrestStack>
    }
</CrestFieldset>

@code {
    [Parameter, EditorRequired] public string PartName { get; set; } = string.Empty;

    [Parameter] public EventCallback Changed { get; set; }

    [Parameter] public EventCallback Deleted { get; set; }

    private PartSettings? Model;
    private List<string> Order = [];
    private Dictionary<string, string?> DisplayNames = [];
    private string? Error;
    private bool Busy;
    private string? _loaded;

    private string Base => $"api/crest/content-types/parts/{Uri.EscapeDataString(PartName)}";

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded == PartName) return;
        _loaded = PartName;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            Model = await Http.GetFromJsonAsync<PartSettings>($"{Base}/settings");
            Order = Model?.Fields
                .OrderBy(field => decimal.TryParse(field.Settings["ContentPartFieldSettings"]?["Position"]?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var position) ? position : decimal.MaxValue)
                .Select(field => field.Name)
                .ToList() ?? [];
            DisplayNames = Model?.Fields.ToDictionary(field => field.Name, field => field.Settings["ContentPartFieldSettings"]?["DisplayName"]?.ToString() ?? field.Name) ?? [];
            Error = null;
        }
        catch (Exception exception) { Error = exception.Message; }
    }

    private Task MoveAsync(int index, int by)
    {
        (Order[index], Order[index + by]) = (Order[index + by], Order[index]);
        return SendAsync(() => Http.PutAsJsonAsync($"{Base}/fields/order", new { Names = Order }));
    }

    private Task RenameAsync(string field) =>
        SendAsync(() => Http.PutAsJsonAsync($"{Base}/fields/{Uri.EscapeDataString(field)}/display-name", new { DisplayName = DisplayNames.GetValueOrDefault(field) }));

    private Task RemoveAsync(string field) => SendAsync(() => Http.DeleteAsync($"{Base}/fields/{Uri.EscapeDataString(field)}"));

    private async Task DeleteAsync()
    {
        Busy = true;
        try
        {
            using var response = await Http.DeleteAsync(Base);
            if (!response.IsSuccessStatusCode) { Error = await response.Content.ReadAsStringAsync(); return; }
            await Deleted.InvokeAsync();
        }
        finally { Busy = false; }
    }

    private async Task SendAsync(Func<Task<HttpResponseMessage>> call)
    {
        Busy = true;
        try
        {
            using var response = await call();
            if (!response.IsSuccessStatusCode) { Error = await response.Content.ReadAsStringAsync(); return; }
            await LoadAsync();
            await Changed.InvokeAsync();
        }
        finally { Busy = false; }
    }

    private sealed record PartField(string Name, string FieldType, JsonObject Settings);
    private sealed record PartSettings(string Name, JsonObject Settings, PartField[] Fields, string[] UsedByTypes);
}

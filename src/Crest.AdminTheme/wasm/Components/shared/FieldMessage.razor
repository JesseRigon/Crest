@namespace Crest.AdminTheme.Components.Shared
@using Crest.Components.Primitives

@* A field's refusal under its input, rendering nothing when there is none - the native
   editors' counterpart of the MVC validation message tag helper. *@

@if (!string.IsNullOrEmpty(Text))
{
    <CrestText TextStyle="TextStyle.Caption" Text="@Text" Style="color: var(--crest-color-danger, #b3261e);" data-testid="field-message" />
}

@code {
    [Parameter]
    public string? Text { get; set; }
}

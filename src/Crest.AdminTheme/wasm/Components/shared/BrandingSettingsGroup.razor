@namespace Crest.AdminTheme.Components.Shared
@using Crest.AdminTheme.Api
@using Microsoft.AspNetCore.Components.Forms
@using Crest.Components.Primitives
@inject IApi Api
@inject NotificationService Notifications
@inject Crest.Components.Theme.CrestApiLocalizer T

@* The branding group of the tenant's settings (docs/branding.md › Editing branding): one row
   per registered rendition, generated from the registry; the display name is the Site name
   field above. Files go into Media; every surface reads them through the `site` query. *@

<CrestCard data-testid="branding-settings">
    <CrestStack Gap="1rem">
        <CrestStack Gap="0.25rem">
            <CrestText TextStyle="TextStyle.H5" Text="@T["Branding"]" />
            <CrestText TextStyle="TextStyle.Body2" Text="@T["The tenant's logos. An unset logo falls back to the site name or the default mark."]" />
        </CrestStack>

        @if (Error is not null)
        {
            <CrestAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@Error</CrestAlert>
        }

        @if (Settings is null)
        {
            <CrestProgressBar Mode="ProgressBarMode.Indeterminate" />
        }
        else
        {
            @foreach (var rendition in Settings.Renditions)
            {
                <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" data-testid="@($"branding-{rendition.Name}")">
                    <div style="width: 96px; height: 64px; display: flex; align-items: center; justify-content: center; border: 1px dashed var(--rz-base-300, #ccc); border-radius: 4px;">
                        @if (string.IsNullOrEmpty(rendition.Url))
                        {
                            <CrestText TextStyle="TextStyle.Caption" Text="@T["Not set"]" />
                        }
                        else
                        {
                            <img src="@rendition.Url" alt="@rendition.Label" style="max-width: 92px; max-height: 60px;" />
                        }
                    </div>
                    <CrestStack Gap="0.125rem" Style="flex: 1;">
                        <CrestText TextStyle="TextStyle.Subtitle2" Text="@(rendition.Reserved ? T["{0} (reserved)", rendition.Label] : rendition.Label)" />
                        <CrestText TextStyle="TextStyle.Caption" Text="@Hint(rendition)" />
                    </CrestStack>
                    <label class="rz-button rz-button-sm rz-button-light"><span class="rzi rzi-upload"></span> @T["Upload"]<InputFile hidden accept="@(rendition.Accept ?? "image/*")" OnChange="@(args => UploadAsync(rendition, args))" disabled="@IsBusy" /></label>
                    <CrestButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="@(() => ClearAsync(rendition))" Disabled="@(IsBusy || string.IsNullOrEmpty(rendition.Path))" title="@T["Clear"]" />
                </CrestStack>
            }
        }
    </CrestStack>
</CrestCard>

@code {
    private CrestBrandingSettings? Settings { get; set; }
    private bool IsBusy { get; set; }
    private string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Settings = await Api.Crest.Rest.Branding.GetAsync();
        if (Settings is null) Error = T["The branding settings could not be loaded."];
    }

    private string Hint(CrestBrandingRendition rendition) =>
        rendition.Width is { } width && rendition.Height is { } height
            ? T["{0}. About {1}×{2} px.", rendition.UsedBy, width, height]
            : rendition.UsedBy;

    private async Task UploadAsync(CrestBrandingRendition rendition, InputFileChangeEventArgs args)
    {
        IsBusy = true;
        Error = null;
        try
        {
            await using var stream = args.File.OpenReadStream(10 * 1024 * 1024);
            var (settings, error) = await Api.Crest.Rest.Branding.UploadAsync(rendition.Name, args.File.Name, stream);
            if (settings is null) { Error = error ?? T["The file could not be uploaded."]; return; }
            Settings = settings;
            Notifications.Notify(NotificationSeverity.Success, T["Branding"], T["{0} updated.", rendition.Label]);
        }
        catch (Exception exception) { Error = exception.Message; }
        finally { IsBusy = false; }
    }

    private async Task ClearAsync(CrestBrandingRendition rendition)
    {
        IsBusy = true;
        Error = null;
        try
        {
            var settings = await Api.Crest.Rest.Branding.ClearAsync(rendition.Name);
            if (settings is null) { Error = T["{0} could not be cleared.", rendition.Label]; return; }
            Settings = settings;
        }
        finally { IsBusy = false; }
    }
}

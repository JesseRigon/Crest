<Project>
  <!--
    The platform: the projects imported from OrchardCore, under src/ beside Crest's own modules.
    Directory.Build.props uses these lists to give them the platform's build settings (Commons,
    analyzers, module/theme targets) that their former folder grouping used to give them. A new platform project is added to the right list.
  -->
  <PropertyGroup>
    <PlatformLibraryProjects>;Crest.Abstractions;Crest.Admin.Abstractions;Crest.AdminMenu.Abstractions;Crest.Apis.GraphQL.Abstractions;Crest.Apis.GraphQL.Client;Crest.Application.Cms.Core.Targets;Crest.Application.Cms.Targets;Crest.Application.Mvc.Targets;Crest.Application.Targets;Crest.AuditTrail.Abstractions;Crest.Autoroute.Core;Crest.AzureAI.Core;Crest.Configuration.KeyVault;Crest.ContentFields.Core;Crest.ContentLocalization.Abstractions;Crest.ContentManagement;Crest.ContentManagement.Abstractions;Crest.ContentManagement.Display;Crest.ContentManagement.GraphQL;Crest.ContentPreview.Abstractions;Crest.ContentTypes.Abstractions;Crest.Contents.Core;Crest.Contents.TagHelpers;Crest.Core;Crest.Data;Crest.Data.Abstractions;Crest.Data.YesSql;Crest.Data.YesSql.Abstractions;Crest.Deployment.Abstractions;Crest.Deployment.Core;Crest.DisplayManagement;Crest.DisplayManagement.Abstractions;Crest.DisplayManagement.Liquid;Crest.DynamicCache.Abstractions;Crest.Elasticsearch.Core;Crest.Email.Abstractions;Crest.Email.Core;Crest.Features.Core;Crest.Feeds.Abstractions;Crest.Feeds.Core;Crest.FileStorage.Abstractions;Crest.FileStorage.AmazonS3;Crest.FileStorage.AzureBlob;Crest.FileStorage.FileSystem;Crest.Flows.Core;Crest.HealthChecks.Abstractions;Crest.Html.Core;Crest.Indexing.Abstractions;Crest.Indexing.Core;Crest.Infrastructure;Crest.Infrastructure.Abstractions;Crest.Liquid.Abstractions;Crest.Localization.Abstractions;Crest.Localization.Core;Crest.Logging.NLog;Crest.Logging.Serilog;Crest.Lucene.Core;Crest.Markdown.Abstractions;Crest.Media.Abstractions;Crest.Media.Core;Crest.MetaWeblog.Abstractions;Crest.Module.Targets;Crest.Mvc.Core;Crest.Navigation.Core;Crest.Notifications.Abstractions;Crest.Notifications.Core;Crest.OpenApi.Core;Crest.OpenId.Core;Crest.Queries.Abstractions;Crest.Queries.Core;Crest.RateLimits.Core;Crest.ReCaptcha.Core;Crest.Recipes.Abstractions;Crest.Recipes.Core;Crest.Redis.Abstractions;Crest.ResourceManagement;Crest.ResourceManagement.Abstractions;Crest.ResourceManagement.Core;Crest.Roles.Abstractions;Crest.Roles.Core;Crest.Rules.Abstractions;Crest.Rules.Core;Crest.Scripting.JavaScript;Crest.Search.Abstractions;Crest.Search.Elasticsearch.Abstractions;Crest.Search.Lucene.Abstractions;Crest.Seo.Abstractions;Crest.Settings.Core;Crest.Setup.Abstractions;Crest.Setup.Core;Crest.Shells.Azure;Crest.Shortcodes.Abstractions;Crest.Sitemaps.Abstractions;Crest.Sms.Abstractions;Crest.Sms.Core;Crest.SourceGenerators;Crest.Taxonomies.Core;Crest.Theme.Targets;Crest.UrlRewriting.Abstractions;Crest.UrlRewriting.Core;Crest.Users.Abstractions;Crest.Users.Core;Crest.Workflows.Platform.Abstractions;Crest.XmlRpc.Abstractions;</PlatformLibraryProjects>
    <PlatformModuleProjects>;Crest.Admin;Crest.AdminDashboard;Crest.AdminMenu;Crest.Alias;Crest.Antivirus;Crest.Apis.GraphQL;Crest.ArchiveLater;Crest.AuditTrail;Crest.AutoSetup;Crest.Autoroute;Crest.AzureAI;Crest.BackgroundTasks;Crest.ContentFields;Crest.ContentLocalization;Crest.ContentPreview;Crest.ContentTypes;Crest.Contents;Crest.Cors;Crest.CustomSettings;Crest.DataLocalization;Crest.DataProtection.Azure;Crest.Demo;Crest.Deployment;Crest.Deployment.Remote;Crest.Diagnostics;Crest.DynamicCache;Crest.Elasticsearch;Crest.Email;Crest.Email.Azure;Crest.Email.Smtp;Crest.Facebook;Crest.Features;Crest.Feeds;Crest.Flows;Crest.Forms;Crest.GitHub;Crest.Google;Crest.HealthChecks;Crest.HomeRoute;Crest.Html;Crest.Https;Crest.Indexing;Crest.Layers;Crest.Liquid;Crest.Lists;Crest.Localization;Crest.Lucene;Crest.Markdown;Crest.Media;Crest.Media.AmazonS3;Crest.Media.Azure;Crest.Media.ImageSharpV3;Crest.Media.Indexing.OpenXML;Crest.Media.Indexing.Pdf;Crest.Menu;Crest.Microsoft.Authentication;Crest.MiniProfiler;Crest.Mvc.HelloWorld;Crest.Navigation;Crest.Notifications;Crest.OpenApi;Crest.OpenId;Crest.Placements;Crest.PublishLater;Crest.Queries;Crest.RateLimits;Crest.ReCaptcha;Crest.Recipes;Crest.Redis;Crest.Resources;Crest.ResponseCompression;Crest.ReverseProxy;Crest.Roles;Crest.Rules;Crest.Scripting;Crest.Search;Crest.Security;Crest.Seo;Crest.Settings;Crest.Setup;Crest.Shortcodes;Crest.SignalR;Crest.SignalR.Azure;Crest.SignalR.Redis;Crest.Sitemaps;Crest.Sms;Crest.Sms.Azure;Crest.Spatial;Crest.Taxonomies;Crest.Templates;Crest.Tenants;Crest.Themes;Crest.Title;Crest.Twitter;Crest.UrlRewriting;Crest.Users;Crest.Widgets;Crest.XmlRpc;</PlatformModuleProjects>

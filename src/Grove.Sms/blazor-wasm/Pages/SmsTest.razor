@page "/Sms/Test"
@attribute [PageEntry("ManageSmsSettings", Id = "smstest", Parent = "testing", Caption = "SMS Test")]
@inject HttpClient Http
@inject Grove.Components.Theme.GroveApiLocalizer T

@* Sends a test SMS through an enabled provider (the default one when none is chosen), the SMS
   twin of the email test page. *@

<PageTitle>@T["SMS Test"]</PageTitle>

<GroveStack Gap="1rem" data-testid="sms-test-page">
    <GroveStack Gap="0.25rem">
        <GroveText TextStyle="TextStyle.H4" class="rz-m-0">@T["SMS Test"]</GroveText>
        <GroveText TextStyle="TextStyle.Body2">@T["Send a test message to check the SMS settings."]</GroveText>
    </GroveStack>

    <GroveCard>
        <GroveStack Gap="0.75rem">
            @if (Providers is { Length: 0 })
            {
                <GroveAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">@T["No SMS provider is enabled. Enable one in the SMS settings."]</GroveAlert>
            }
            <GroveFormField Text="@T["Provider"]">
                <GroveDropDown TValue="string" @bind-Value="Request.Provider" Data="@(Providers ?? [])" AllowClear="true" Placeholder="@T["The default provider"]" Style="max-width: 24rem" Name="sms-test-provider" />
            </GroveFormField>
            @FieldError("provider")
            <GroveFormField Text="@T["Phone number"]">
                <GroveTextBox @bind-Value="Request.PhoneNumber" Style="max-width: 24rem" Name="sms-test-phone" />
            </GroveFormField>
            @FieldError("phoneNumber")
            <div><GroveButton Text="@T["Send"]" Icon="send" Click="SendAsync" Disabled="IsSending" data-testid="sms-test-send" /></div>
            @if (Result is { } result)
            {
                <GroveAlert AlertStyle="@(result.Succeeded ? AlertStyle.Success : AlertStyle.Danger)" ShowIcon="true" AllowClose="true">
                    @(result.Succeeded ? T["The test SMS message has been successfully sent."] : T["The test SMS message failed to send. {0}", string.Join(" ", result.Errors)])
                </GroveAlert>
            }
        </GroveStack>
    </GroveCard>
</GroveStack>

@code {
    private string[]? Providers;
    private SmsTestRequest Request = new();
    private SmsTestResult? Result;
    private Dictionary<string, string[]> Errors = new(StringComparer.OrdinalIgnoreCase);
    private bool IsSending;

    protected override async Task OnInitializedAsync()
    {
        try { Providers = await Http.GetFromJsonAsync<string[]>(SmsTestApiPaths.Providers) ?? []; }
        catch { Providers = []; }
    }

    private async Task SendAsync()
    {
        IsSending = true;
        Result = null;
        Errors.Clear();
        try
        {
            using var response = await Http.PostAsJsonAsync(SmsTestApiPaths.Test, Request);
            if (response.IsSuccessStatusCode)
            {
                Result = await response.Content.ReadFromJsonAsync<SmsTestResult>();
                return;
            }

            var problem = await ReadProblemAsync(response);
            if (problem?.Errors is { Count: > 0 } errors) Errors = new(errors, StringComparer.OrdinalIgnoreCase);
            else Result = new SmsTestResult(false, [problem?.Detail ?? response.ReasonPhrase ?? string.Empty]);
        }
        finally { IsSending = false; }
    }

    private RenderFragment? FieldError(string key) => Errors.TryGetValue(key, out var messages)
        ? @<GroveText TextStyle="TextStyle.Caption" class="rz-color-danger">@string.Join(" ", messages)</GroveText>
        : null;

    private static async Task<Problem?> ReadProblemAsync(HttpResponseMessage response)
    {
        try { return await response.Content.ReadFromJsonAsync<Problem>(); }
        catch { return null; }
    }

    private sealed record Problem(string? Title, string? Detail, Dictionary<string, string[]>? Errors);
}

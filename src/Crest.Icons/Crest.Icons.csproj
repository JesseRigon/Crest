<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Crest.Icons</AssemblyName>
    <RootNamespace>Crest.Icons</RootNamespace>
    <!-- Generates this library's component catalog (Crest.DisplayManagement.Abstractions' buildTransitive targets). -->
    <ComponentCatalog>true</ComponentCatalog>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Providers\TenantMedia\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Content Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Crest.Iconify\Crest.Iconify.csproj" />
    <ProjectReference Include="..\Crest.Components\Crest.Components.csproj" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Grove.Kinds</AssemblyName>
    <RootNamespace>Grove.Kinds</RootNamespace>
  </PropertyGroup>
  <!-- Server-free: the kind-registry contract (a descriptor shape and the catalog that merges
       what the enabled features register), shared by server modules and the Domain
       assemblies their descriptors live in. Never reference Grove or ASP.NET. -->
</Project>

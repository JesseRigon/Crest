<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
     <!-- NuGet properties-->
    <Title>Grove GraphQL Apis</Title>
    <Description>$(OCFrameworkDescription)

    Provies apis using the GraphQL Specification.</Description>
    <PackageTags>$(PackageTags) PlatformFramework</PackageTags>
  </PropertyGroup>

  <!-- The admin's GraphiQL page is its own WASM library (blazor-wasm/, Grove.Data.Protocols.GraphQL.BlazorWasm). -->
  <ItemGroup>
    <Compile Remove="blazor-wasm/**/*.cs" />
    <Content Remove="blazor-wasm/**" />
    <None Remove="blazor-wasm/**" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GraphQL" />
    <PackageReference Include="GraphQL.DataLoader" />
    <PackageReference Include="GraphQL.MicrosoftDI" />
    <PackageReference Include="GraphQL.SystemTextJson" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YesSql.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grove.Infrastructure.Shells.Admin.Abstractions\Grove.Infrastructure.Shells.Admin.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Data.Protocols.GraphQL.Abstractions\Grove.Data.Protocols.GraphQL.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Display.Management\Grove.Display.Management.csproj" />
    <ProjectReference Include="..\Grove.Module.Targets\Grove.Module.Targets.csproj" />
    <ProjectReference Include="..\Grove.Display.Navigation\Grove.Display.Navigation.csproj" />
    <ProjectReference Include="..\Grove.Display.Resources.Management\Grove.Display.Resources.Management.csproj" />
  </ItemGroup>

</Project>

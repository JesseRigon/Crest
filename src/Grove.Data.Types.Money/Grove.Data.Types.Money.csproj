<Project Sdk="Microsoft.NET.Sdk.Razor">
  <Import Project="$(PlatformSrcDir)Grove.Module.Targets\Grove.Module.Targets.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Grove.Data.Types.Money</AssemblyName>
    <RootNamespace>Grove.Data.Types.Money</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs;Domain/**/*.cs" />
  </ItemGroup>

  <!-- The money content field and the currency table behind it. ISO 4217 minor units are
       reference data every application shares, so they live in the global store
       (Grove.Data.Global); a tenant chooses its default currency, never the units. -->
  <ItemGroup>
    <ProjectReference Include="$(PlatformSrcDir)Grove.Contents.Fields\Grove.Contents.Fields.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Contents.Management\Grove.Contents.Management.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Data\Grove.Data.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Module.Targets\Grove.Module.Targets.csproj" />
    <PackageReference Include="YesSql.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Grove.Infrastructure.Server/Grove.Infrastructure.Server.csproj" />
    <ProjectReference Include="../Grove.Contents.OptionPicker/Grove.Contents.OptionPicker.csproj" />
    <ProjectReference Include="../Grove.Data.Global/Grove.Data.Global.csproj" />
    <ProjectReference Include="Domain/Grove.Data.Types.Money.Domain.csproj" />
  </ItemGroup>
</Project>

@inject HttpClient Http
@inject Grove.Components.Theme.GroveApiLocalizer T

@* The trail as a table: one row per event, newest first, impersonated actions marked; a row
   opens the event's details (both attributions, the subject and the recorded data). Shared by
   the audit page, a record's history and an impersonation session. *@

<GroveStack Gap="0.75rem" data-testid="audit-event-table">
    <GroveTable GridLines="DataGridGridLines.Horizontal" AllowAlternatingRows="false">
        <GroveTableHeader>
            <GroveTableHeaderRow>
                <GroveTableHeaderCell>@T["When"]</GroveTableHeaderCell>
                <GroveTableHeaderCell>@T["Event"]</GroveTableHeaderCell>
                <GroveTableHeaderCell>@T["Acted by"]</GroveTableHeaderCell>
                <GroveTableHeaderCell>@T["Organization"]</GroveTableHeaderCell>
                <GroveTableHeaderCell>@T["Side"]</GroveTableHeaderCell>
                <GroveTableHeaderCell></GroveTableHeaderCell>
            </GroveTableHeaderRow>
        </GroveTableHeader>
        <GroveTableBody>
            @foreach (var item in Page.Items)
            {
                <GroveTableRow data-testid="audit-event" data-event-id="@item.EventId">
                    <GroveTableCell>@item.CreatedUtc.ToLocalTime().ToString("g")</GroveTableCell>
                    <GroveTableCell>
                        <div>@item.Summary</div>
                        @if (!string.IsNullOrEmpty(item.RecordId) && ShowRecordLinks)
                        {
                            <GroveLink Path="@RecordPath(item.RecordId)" Text="@T["History"]" />
                        }
                    </GroveTableCell>
                    <GroveTableCell>
                        @item.Actor
                        @if (item.IsImpersonated)
                        {
                            <GroveBadge BadgeStyle="BadgeStyle.Warning" Text="@T["impersonating"]" class="rz-ml-1" data-testid="audit-impersonated" />
                        }
                    </GroveTableCell>
                    <GroveTableCell>@item.OrganizationId</GroveTableCell>
                    <GroveTableCell>@item.Side</GroveTableCell>
                    <GroveTableCell>
                        <GroveButton Icon="info" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => OpenAsync(item))" />
                    </GroveTableCell>
                </GroveTableRow>
            }
        </GroveTableBody>
    </GroveTable>

    @if (Page.Items.Count == 0)
    {
        <GroveText TextStyle="TextStyle.Body2">@T["No events."]</GroveText>
    }

    <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <GroveButton Icon="chevron_left" ButtonStyle="ButtonStyle.Light" Disabled="@(Page.Skip == 0)" Click="@(() => PageChanged.InvokeAsync(Math.Max(0, Page.Skip - Page.Take)))" />
        <GroveText TextStyle="TextStyle.Caption">@T["{0}-{1} of {2}", Page.Total == 0 ? 0 : Page.Skip + 1, Page.Skip + Page.Items.Count, Page.Total]</GroveText>
        <GroveButton Icon="chevron_right" ButtonStyle="ButtonStyle.Light" Disabled="@(Page.Skip + Page.Items.Count >= Page.Total)" Click="@(() => PageChanged.InvokeAsync(Page.Skip + Page.Take))" />
    </GroveStack>

    @if (Selected is not null)
    {
        <GroveCard data-testid="audit-event-detail">
            <GroveStack Gap="0.5rem">
                <GroveStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                    <GroveText TextStyle="TextStyle.H6" class="rz-m-0">@Selected.Summary</GroveText>
                    <GroveButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => Selected = null)" />
                </GroveStack>
                <dl class="audit-detail">
                    <dt>@T["Acted by (audit)"]</dt><dd>@(Selected.UserName ?? Selected.UserId) (@Selected.ActorKind@(Selected.ClientId is null ? "" : $", {Selected.ClientId}"))</dd>
                    <dt>@T["On behalf of (functional)"]</dt><dd>@(Selected.FunctionalUserName ?? Selected.FunctionalUserId)</dd>
                    @if (Selected.IsImpersonated)
                    {
                        <dt>@T["Impersonating"]</dt><dd>@(Selected.ImpersonatedUserName ?? Selected.ImpersonatedUserId)</dd>
                        <dt>@T["Session"]</dt><dd>@Selected.SessionId</dd>
                    }
                    <dt>@T["Organization"]</dt><dd>@Selected.OrganizationId</dd>
                    <dt>@T["Record"]</dt><dd>@Selected.RecordType @Selected.RecordId</dd>
                    <dt>@T["Owner"]</dt><dd>@Selected.OwnerId</dd>
                    <dt>@T["Correlation"]</dt><dd>@Selected.CorrelationId</dd>
                    <dt>@T["Client IP"]</dt><dd>@Selected.ClientIpAddress</dd>
                </dl>
                @if (Selected.Category == "Content")
                {
                    @* The version this event recorded, as the site would display it, and its
                       restore (rework step 7: replaces the MVC AuditTrail/Content screen). *@
                    <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                        <GroveButton Icon="visibility" Text="@T["Show this version"]" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="ShowVersionAsync" Disabled="@VersionBusy" />
                        <GroveButton Icon="difference" Text="@T["Show the changes"]" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="ShowDiffAsync" Disabled="@VersionBusy" data-testid="audit-content-diff" />
                        <GroveButton Icon="restore" Text="@T["Restore this version"]" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small" Click="RestoreAsync" Disabled="@VersionBusy" />
                    </GroveStack>
                    @if (!string.IsNullOrEmpty(VersionMessage))
                    {
                        <GroveAlert AlertStyle="@(VersionFailed ? AlertStyle.Danger : AlertStyle.Success)" Detail="@VersionMessage" />
                    }
                    @if (Diff is not null)
                    {
                        <Grove.Components.Content.ContentDiff Before="Diff.Before" After="Diff.After" BeforeLabel="@T["Previous version"]" AfterLabel="@T["This version"]" />
                    }
                    @if (Version is not null)
                    {
                        <div class="audit-version" data-testid="audit-content-version">
                            <GroveText TextStyle="TextStyle.Subtitle2">@T["Version {0}", Version.VersionNumber]</GroveText>
                            <Grove.DisplayManagement.Components.DisplayTreeRenderer Node="Version.Tree.Root" />
                        </div>
                    }
                }
                @if (Selected.Data is not null)
                {
                    <pre class="audit-data" style="max-height: 24rem; overflow: auto; white-space: pre-wrap;">@Selected.Data.ToJsonString(new System.Text.Json.JsonSerializerOptions { WriteIndented = true })</pre>
                }
            </GroveStack>
        </GroveCard>
    }
</GroveStack>

@code {
    [Parameter, EditorRequired] public AuditEventPage Page { get; set; } = new([], 0, 0, 50);

    [Parameter] public EventCallback<int> PageChanged { get; set; }

    [Parameter] public bool ShowRecordLinks { get; set; } = true;

    private AuditEvent? Selected { get; set; }

    private static string RecordPath(string recordId) =>
        AuditTrailRoutes.RecordAdmin.TrimStart('/').Replace("{RecordId}", Uri.EscapeDataString(recordId));

    private AuditContentVersion? Version { get; set; }
    private bool VersionBusy { get; set; }
    private string? VersionMessage { get; set; }
    private bool VersionFailed { get; set; }

    private AuditContentDiff? Diff { get; set; }

    private async Task ShowDiffAsync()
    {
        VersionBusy = true;
        VersionMessage = null;
        try
        {
            Diff = await Http.GetFromJsonAsync<AuditContentDiff>(VersionApi + "/diff");
        }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException)
        {
            (VersionFailed, VersionMessage) = (true, exception.Message);
        }
        finally
        {
            VersionBusy = false;
        }
    }

    private string VersionApi => $"api/grove/audit/content/{Uri.EscapeDataString(Selected!.EventId)}";

    private async Task ShowVersionAsync()
    {
        VersionBusy = true;
        VersionMessage = null;
        try
        {
            Version = await Http.GetFromJsonAsync<AuditContentVersion>(VersionApi);
        }
        catch (HttpRequestException exception)
        {
            (VersionFailed, VersionMessage) = (true, exception.Message);
        }
        finally
        {
            VersionBusy = false;
        }
    }

    private async Task RestoreAsync()
    {
        VersionBusy = true;
        try
        {
            using var response = await Http.PostAsync(VersionApi + "/restore", null);
            var result = await response.Content.ReadFromJsonAsync<AuditContentRestoreResult>();
            (VersionFailed, VersionMessage) = response.IsSuccessStatusCode
                ? (false, T["The version has been restored."].ToString())
                : (true, T["The version was not restored: {0}", string.Join(", ", result?.Errors ?? [])].ToString());
        }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException)
        {
            (VersionFailed, VersionMessage) = (true, exception.Message);
        }
        finally
        {
            VersionBusy = false;
        }
    }

    private async Task OpenAsync(AuditEvent item)
    {
        Version = null;
        Diff = null;
        VersionMessage = null;
        Selected = await Http.GetFromJsonAsync<AuditEvent>($"{AuditTrailRoutes.Api}/events/{Uri.EscapeDataString(item.EventId)}") ?? item;
    }
}

@page "/Audit"
@attribute [PageEntry("ViewAuditTrail", Id = "audittrail-events", Parent = "audittrail", Caption = "Events", Position = "0")]
@inject HttpClient Http
@inject Grove.Display.Components.Theme.GroveApiLocalizer T

@* The audit page (docs/audit.md › step 4): the tenant's trail, filtered by actor, impersonated
   member, organization, category, record and date. Gated by the audit permission, as is the API
   behind it; members never reach it (the permission is under the member class ceiling). *@

<PageTitle>@T["Audit trail"]</PageTitle>

<GroveStack Gap="1rem" data-testid="audit-trail">
    <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Wrap="FlexWrap.Wrap">
        <div>
            <GroveText TextStyle="TextStyle.H4" class="rz-m-0">@T["Audit trail"]</GroveText>
            <GroveText TextStyle="TextStyle.Body2" class="rz-color-secondary">@T["Who did what, to which record, when, from where, and on whose behalf."]</GroveText>
        </div>
        <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <GroveLink Path="@AuditTrailRoutes.SessionsAdmin.TrimStart('/')" Text="@T["Impersonation sessions"]" />
            <GroveButton Icon="refresh" Text="@T["Refresh"]" ButtonStyle="ButtonStyle.Light" Click="@(() => LoadAsync(0))" Disabled="IsBusy" />
        </GroveStack>
    </GroveStack>

    <GroveCard>
        <GroveStack Orientation="Orientation.Horizontal" Gap="0.75rem" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.End">
            <GroveFormField Text="@T["Acted by (user name)"]"><GroveTextBox @bind-Value="Filter.UserName" Style="width: 12rem" data-testid="audit-filter-user" /></GroveFormField>
            <GroveFormField Text="@T["Impersonated member (user id)"]"><GroveTextBox @bind-Value="Filter.ImpersonatedUserId" Style="width: 12rem" /></GroveFormField>
            <GroveFormField Text="@T["Organization"]"><GroveTextBox @bind-Value="Filter.OrganizationId" Style="width: 12rem" /></GroveFormField>
            <GroveFormField Text="@T["Category"]"><GroveDropDown TValue="string" @bind-Value="Filter.Category" Data="Categories" TextProperty="Text" ValueProperty="Name" AllowClear="true" Placeholder="@T["All"]" Style="width: 12rem" /></GroveFormField>
            <GroveFormField Text="@T["Record"]"><GroveTextBox @bind-Value="Filter.RecordId" Style="width: 12rem" /></GroveFormField>
            <GroveFormField Text="@T["From"]"><GroveDatePicker TValue="DateTime?" @bind-Value="Filter.From" DateFormat="yyyy-MM-dd" AllowClear="true" Style="width: 10rem" /></GroveFormField>
            <GroveFormField Text="@T["To"]"><GroveDatePicker TValue="DateTime?" @bind-Value="Filter.To" DateFormat="yyyy-MM-dd" AllowClear="true" Style="width: 10rem" /></GroveFormField>
            <div>
                <GroveCheckBox TValue="bool" @bind-Value="Filter.ImpersonatedOnly" Name="audit-impersonated-only" />
                <GroveLabel Text="@T["Impersonated only"]" Component="audit-impersonated-only" />
            </div>
            <GroveButton Icon="search" Text="@T["Apply"]" Click="@(() => LoadAsync(0))" Disabled="IsBusy" data-testid="audit-filter-apply" />
        </GroveStack>
    </GroveCard>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <GroveAlert AlertStyle="AlertStyle.Danger" Summary="@T["Could not load the audit trail"]" Detail="@Error" />
    }

    @if (IsBusy)
    {
        <GroveProgressBar Mode="ProgressBarMode.Indeterminate" />
    }

    <AuditEventTable Page="Page" PageChanged="LoadAsync" />
</GroveStack>

@code {
    private AuditFilter Filter { get; } = new();
    private AuditEventPage Page { get; set; } = new([], 0, 0, 50);
    private IReadOnlyList<AuditCategory> Categories { get; set; } = [];
    private bool IsBusy { get; set; }
    private string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Categories = await Http.GetFromJsonAsync<AuditCategory[]>($"{AuditTrailRoutes.Api}/categories") ?? [];
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }

        await LoadAsync(0);
    }

    private async Task LoadAsync(int skip)
    {
        IsBusy = true;
        Error = null;
        try
        {
            Filter.Skip = skip;
            Page = await Http.GetFromJsonAsync<AuditEventPage>($"{AuditTrailRoutes.Api}/events?{Filter.ToQueryString()}") ?? Page;
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }
}

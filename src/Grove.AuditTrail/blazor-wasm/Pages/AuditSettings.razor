@page "/Audit/Settings"
@page "/Settings/AuditTrail"
@attribute [PageEntry("ManageAuditTrailSettings", Id = "audittrailSettings", Parent = "settings", Caption = "Audit Trail")]
@inject HttpClient Http
@inject Grove.Components.Theme.GroveApiLocalizer T

@* The audit trail settings: which events are recorded (mandatory ones always are), whether the
   client IP is recorded, and how long events are kept before the trimming task removes them. *@

<PageTitle>@T["Audit trail settings"]</PageTitle>

<GroveStack Gap="1rem" data-testid="audit-settings">
    <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
        <GroveText TextStyle="TextStyle.H4" class="rz-m-0">@T["Audit trail settings"]</GroveText>
        <GroveLink Path="@AuditTrailRoutes.TrailAdmin.TrimStart('/')" Text="@T["Audit trail"]" />
    </GroveStack>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <GroveAlert AlertStyle="AlertStyle.Danger" Summary="@T["Audit trail settings"]" Detail="@Error" />
    }

    @if (Model is null)
    {
        <GroveProgressBar Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
        <GroveCard>
            <GroveStack Gap="0.5rem">
                <GroveText TextStyle="TextStyle.Subtitle1" class="rz-m-0">@T["Trimming"]</GroveText>
                <GroveFormField Text="@T["Keep events for (days)"]"><GroveNumeric TValue="int" @bind-Value="RetentionDays" Min="0" data-testid="audit-retention" /></GroveFormField>
                <div><GroveCheckBox TValue="bool" @bind-Value="TrimmingDisabled" Name="audit-trimming-disabled" /> <GroveLabel Text="@T["Never remove events"]" Component="audit-trimming-disabled" /></div>
                <div><GroveCheckBox TValue="bool" @bind-Value="ClientIpAddressAllowed" Name="audit-client-ip" /> <GroveLabel Text="@T["Record the client IP address"]" Component="audit-client-ip" /></div>
                @if (Model.LastTrimmedUtc is { } last)
                {
                    <GroveText TextStyle="TextStyle.Caption">@T["Last trimmed {0:u}", last]</GroveText>
                }
            </GroveStack>
        </GroveCard>

        @foreach (var category in Model.Categories)
        {
            <GroveCard data-category="@category.Name">
                <GroveStack Gap="0.25rem">
                    <GroveText TextStyle="TextStyle.Subtitle1" class="rz-m-0">@category.DisplayName</GroveText>
                    @foreach (var auditEvent in category.Events)
                    {
                        var key = $"{auditEvent.Category}/{auditEvent.Name}";
                        <div title="@auditEvent.Description">
                            <GroveCheckBox TValue="bool" Value="@(auditEvent.IsMandatory || Enabled.Contains(key))" ValueChanged="@((bool on) => Toggle(key, on))" Disabled="auditEvent.IsMandatory" Name="@($"audit-event-{key}")" />
                            <GroveLabel Text="@(auditEvent.IsMandatory ? $"{auditEvent.DisplayName} ({T["always"]})" : auditEvent.DisplayName)" Component="@($"audit-event-{key}")" />
                        </div>
                    }
                </GroveStack>
            </GroveCard>
        }

        <div><GroveButton Icon="save" Text="@T["Save"]" Click="SaveAsync" Disabled="IsSaving" data-testid="audit-settings-save" /></div>
        @if (Saved) { <GroveText TextStyle="TextStyle.Body2">@T["Saved."]</GroveText> }
    }
</GroveStack>

@code {
    private SettingsModel? Model;
    private readonly HashSet<string> Enabled = new(StringComparer.Ordinal);
    private int RetentionDays;
    private bool TrimmingDisabled;
    private bool ClientIpAddressAllowed;
    private bool IsSaving;
    private bool Saved;
    private string? Error;

    private const string Url = AuditTrailRoutes.Api + "/settings";

    protected override async Task OnInitializedAsync()
    {
        try { Load(await Http.GetFromJsonAsync<SettingsModel>(Url)); }
        catch (Exception exception) { Error = exception.Message; }
    }

    private void Load(SettingsModel? model)
    {
        Model = model;
        if (model is null) return;
        Enabled.Clear();
        foreach (var auditEvent in model.Categories.SelectMany(category => category.Events).Where(auditEvent => auditEvent.IsEnabled))
        {
            Enabled.Add($"{auditEvent.Category}/{auditEvent.Name}");
        }

        RetentionDays = model.RetentionDays;
        TrimmingDisabled = model.TrimmingDisabled;
        ClientIpAddressAllowed = model.ClientIpAddressAllowed;
    }

    private void Toggle(string key, bool on)
    {
        if (on) Enabled.Add(key); else Enabled.Remove(key);
        Saved = false;
    }

    private async Task SaveAsync()
    {
        IsSaving = true;
        Error = null;
        try
        {
            var response = await Http.PutAsJsonAsync(Url, new { EnabledEvents = Enabled.ToArray(), ClientIpAddressAllowed, RetentionDays, TrimmingDisabled });
            if (!response.IsSuccessStatusCode) { Error = await response.Content.ReadAsStringAsync(); return; }
            Load(await response.Content.ReadFromJsonAsync<SettingsModel>());
            Saved = true;
        }
        finally { IsSaving = false; }
    }

    private sealed record EventModel(string Name, string Category, string DisplayName, string? Description, bool IsEnabled, bool IsMandatory);
    private sealed record CategoryModel(string Name, string DisplayName, EventModel[] Events);
    private sealed record SettingsModel(CategoryModel[] Categories, bool ClientIpAddressAllowed, int RetentionDays, bool TrimmingDisabled, DateTime? LastTrimmedUtc);
}

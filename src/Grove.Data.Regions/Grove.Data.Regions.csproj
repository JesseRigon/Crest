<Project Sdk="Microsoft.NET.Sdk.Razor">
  <Import Project="$(PlatformSrcDir)Grove.Module.Targets\Grove.Module.Targets.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Grove.Data.Regions</AssemblyName>
    <RootNamespace>Grove.Data.Regions</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs;blazor-wasm/**/*.cs;Domain/**/*.cs" />
  </ItemGroup>

  <!-- Regional Profiles, the geo tree and per-country addressing maps
       (plans/regions-and-locations.md). Geo standard data lives in the global store
       (Grove.Data.Global); this module declares its schema and the tenant overlay. -->
  <ItemGroup>
    <ProjectReference Include="$(PlatformSrcDir)Grove.Contents.Fields\Grove.Contents.Fields.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Contents.Management\Grove.Contents.Management.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Contents\Grove.Contents.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Data\Grove.Data.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Module.Targets\Grove.Module.Targets.csproj" />
    <PackageReference Include="YesSql.Abstractions" />
    <PackageReference Include="NetTopologySuite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Grove.Infrastructure.Server/Grove.Infrastructure.Server.csproj" />
    <ProjectReference Include="../Grove.Data.Global/Grove.Data.Global.csproj" />
    <ProjectReference Include="Domain/Grove.Data.Regions.Domain.csproj" />
  </ItemGroup>
</Project>

@page "/Parties"
@attribute [PageEntry(DeclaredBySource = true)]
@namespace Crest.Parties.BlazorWasm.Pages
@using Crest.Components.Model
@using Crest.Parties.BlazorWasm.Components
@using Crest.Parties.Constants
@using Crest.Parties.PartyTypes
@inject NavigationManager Navigation
@inject Crest.Components.Theme.CrestApiLocalizer T

<PageTitle>@T["All Parties"]</PageTitle>

@* The Parties menu's own page: the party-type registry on Crest's generic kind browser. The
   types down the left are the Parties menu's children, filtered by the same overlays the
   sidebar honours - the tenant's admin-menu layout hides a type for everyone, the browser's
   pane settings hide one for the signed-in user only. *@

<CrestKindBrowser TKind="PartyTypeModel"
                  KindsUrl="@($"{PartiesConstants.Routes.Api}/{PartiesConstants.Routes.Types}")"
                  KeySelector="@(type => type.Key)"
                  TextSelector="@(type => T[type.DisplayName])"
                  DescriptionSelector="@(type => type.Kind == PartyTypeKinds.Global ? T["Global catalogue"] : type.ContentType)"
                  MenuItemKeySelector="@(type => type.MenuItemKey)"
                  HiddenByUserSelector="@(type => type.HiddenByUser)"
                  Title="@T["All Parties"]"
                  Description="@T["Every kind of party this tenant works with: the people and organizations, and the roles composed on them."]"
                  ListTitle="@T["Party types"]"
                  EmptyText="@T["No party types are visible to you."]"
                  NoSelectionText="@T["Select a party type."]"
                  ErrorSummary="@T["Could not load party types"]"
                  InitialKey="@TypeQuery"
                  Actions="TypeActions"
                  TestId="all-parties"
                  Class="all-parties">
    <Pane Context="type"><PartyTypePane Type="@type" /></Pane>
</CrestKindBrowser>

@code {
    [SupplyParameterFromQuery(Name = "type")]
    public string? TypeQuery { get; set; }

    private IReadOnlyList<CrestModelListAction<PartyTypeModel>> TypeActions =>
    [
        new() { Icon = "open_in_new", Title = T["Open page"], Callback = EventCallback.Factory.Create<PartyTypeModel>(this, type => Navigation.NavigateTo(type.Route.TrimStart('/'))) },
    ];
}

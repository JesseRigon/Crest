<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Grove.Display.Management</RootNamespace>
    <Nullable>enable</Nullable>

    <!-- NuGet properties-->
    <Title>Grove DisplayManagement Abstractions</Title>
    <Description>$(OCFrameworkDescription)

    The display contracts shared by the server and the browser: the display tree, the component registry and the tree renderer.</Description>
    <PackageTags>$(PackageTags) PlatformFramework DisplayManagement Abstractions</PackageTags>
  </PropertyGroup>

  <!-- No server framework: the display contracts (the display tree, the component registry,
       the tree renderer) load in the browser as well as on the server. The MVC contracts that
       used to live here are in Grove.Mvc.Abstractions. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components" />
  </ItemGroup>

  <!-- The component catalog generator travels with the contracts it implements: consumers of
       this package (directly or through Grove.Display.Components) get it through buildTransitive. See
       buildTransitive/Grove.Display.Management.Abstractions.targets. The generator is built
       first through the analyzer reference Grove.Commons.props gives every platform project. -->
  <ItemGroup>
    <None Update="buildTransitive\Grove.Display.Management.Abstractions.targets" Pack="true" PackagePath="buildTransitive\" />
    <None Include="$(PlatformSrcDir)Grove.SourceGenerators\bin\$(Configuration)\netstandard2.0\Grove.SourceGenerators.dll" Pack="true" PackagePath="buildTransitive\analyzers\" Visible="false" />
  </ItemGroup>

</Project>

@using Grove.Components.Primitives.Documents.Spreadsheet
@inherits GroveSpreadsheetFormatToggleToolBase

@namespace Grove.Components.Primitives.Spreadsheet.Tools
<GroveToggleButton AriaLabel=@(Spreadsheet?.Localize(nameof(GroveStrings.Spreadsheet_Underline))) title=@(Spreadsheet?.Localize(nameof(GroveStrings.Spreadsheet_Underline))) Value=@IsToggled ValueChanged=@OnToggledChangedAsync Icon="format_underlined" Disabled=@IsDisabled Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
    ToggleVariant="Variant.Flat" ToggleButtonStyle="ButtonStyle.Primary" ToggleShade="Shade.Lighter" />

@code {
    protected override bool GetValue(Format format) => format.Underline;
    protected override Format WithValue(Format format, bool value) => format.WithUnderline(value);
}

@using Grove.Components.Primitives.Documents.Spreadsheet
@inherits GroveSpreadsheetFormatToggleToolBase

@namespace Grove.Components.Primitives.Spreadsheet.Tools
<GroveToggleButton AriaLabel=@(Spreadsheet?.Localize(nameof(GroveStrings.Spreadsheet_Strikethrough))) title=@(Spreadsheet?.Localize(nameof(GroveStrings.Spreadsheet_Strikethrough))) Value=@IsToggled ValueChanged=@OnToggledChangedAsync Icon="strikethrough_s" Disabled=@IsDisabled Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
    ToggleVariant="Variant.Flat" ToggleButtonStyle="ButtonStyle.Primary" ToggleShade="Shade.Lighter" />

@code {
    protected override bool GetValue(Format format) => format.Strikethrough;
    protected override Format WithValue(Format format, bool value) => format.WithStrikethrough(value);
}

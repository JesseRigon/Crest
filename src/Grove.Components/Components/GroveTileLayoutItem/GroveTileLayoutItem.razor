@inherits GroveComponent

@namespace Grove.Components.Primitives
@if (Layout != null && Visible)
{
    <div @ref=@Element id=@GetId() class=@GetCssClass() style=@GetTileStyle() @attributes=@Attributes>
        @if (ShowHeader)
        {
            <div class="rz-tile-layout-item-header @(Layout.CanMove ? "rz-tile-layout-item-header-draggable" : null)"
                 style=@GetHeaderStyle() @onpointerdown=@OnHeaderPointerDown @onpointerdown:preventDefault=@Layout.CanMove>
                @if (Layout.CanMove)
                {
                    <GroveIcon IconKey="iconify.mdi/current/default/drag" class="rz-tile-layout-item-drag-handle" Style=@GetDragHandleStyle() />
                }
                @if (HeaderTemplate != null)
                {
                    @HeaderTemplate
                }
                else
                {
                    @if (!string.IsNullOrEmpty(Icon))
                    {
                        <GroveIcon IconKey=@Icon class="rz-tile-layout-item-icon" Style=@GetIconStyle() />
                    }
                    <GroveText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="rz-tile-layout-item-title"
                               Style=@GetTitleStyle()>@Title</GroveText>
                }
            </div>
        }
        <div class="rz-tile-layout-item-content" style=@GetContentStyle()>
            @ChildContent
        </div>
        @if (Layout.CanResize)
        {
            <div class="rz-tile-layout-item-resize-handle" style=@GetResizeHandleStyle() @onpointerdown=@OnResizePointerDown
                 @onpointerdown:preventDefault=true></div>
        }
    </div>
}

@using Grove.Components.Primitives.Documents.Spreadsheet
@using Grove.Components.Primitives.Rendering
@namespace Grove.Components.Primitives.Spreadsheet
@foreach (var range in GetRanges())
{
    <CellSelectionItem Context=@Context Range=@range.Range Worksheet=@Worksheet FrozenRow=@range.FrozenRow FrozenColumn=@range.FrozenColumn Top=@range.Top Left=@range.Left Bottom=@range.Bottom Right=@range.Right />
}

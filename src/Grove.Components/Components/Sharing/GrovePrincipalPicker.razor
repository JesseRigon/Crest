@namespace Grove.Components.Sharing
@using System.Globalization
@using Grove.Components.Primitives
@inject HttpClient Http
@inject IServiceProvider Services

@* The sharing picker (docs/sharing.md § 8, requirement 46): Anyone, everyone signed in, roles of
   both kinds - derived (business) roles labelled - organizations and people, as the server offers
   them to this caller. System accounts are never offered. *@

<div class="grove-principal-picker" data-testid="principal-picker">
    <div class="grove-principal-picker__search">
        <input type="search" placeholder="@L("Search people, roles, organizations")" @bind="Text" @bind:event="oninput" @onkeyup="OnKeyAsync" aria-label="@L("Search people, roles, organizations")" />
        <GroveButton Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Icon="search" title="@L("Search")" Click="SearchAsync" />
    </div>
    @if (Error is { } error)
    {
        <div class="grove-principal-picker__error" role="alert">@error</div>
    }
    @if (Options.Count > 0)
    {
        <ul class="grove-principal-picker__results" role="listbox">
            @foreach (var option in Options)
            {
                <li role="option" aria-selected="@(Selected?.Principal == option.Principal)">
                    <button type="button" class="@(Selected?.Principal == option.Principal ? "is-selected" : null)" @onclick="@(() => PickAsync(option))" data-testid="principal-option">
                        <span class="grove-principal-picker__kind">@KindLabel(option)</span>
                        @option.DisplayName
                        @if (option.IsDerived)
                        {
                            <small class="grove-principal-picker__derived" title="@option.Description">@L("derived")</small>
                        }
                    </button>
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public EventCallback<GrovePrincipalOption> OnPick { get; set; }

    /// <summary>Hides Anyone (a rule or panel that may not grant it).</summary>
    [Parameter] public bool AllowAnyone { get; set; } = true;

    private GroveSharingClient Client => _client ??= new GroveSharingClient(Http);
    private GroveSharingClient? _client;
    private string? Text;
    private string? Error;
    private GrovePrincipalOption? Selected;
    private List<GrovePrincipalOption> Options = [];

    protected override Task OnInitializedAsync() => SearchAsync();

    private async Task OnKeyAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        var found = await Client.SearchPrincipalsAsync(Text);
        Error = found.Error;
        Options = [.. (found.Value ?? []).Where(option => AllowAnyone || option.Principal.Kind != GrovePrincipalKind.Anyone)];
    }

    private async Task PickAsync(GrovePrincipalOption option)
    {
        Selected = option;
        await OnPick.InvokeAsync(option);
    }

    private string KindLabel(GrovePrincipalOption option) => option.Principal.Kind switch
    {
        GrovePrincipalKind.Anyone => "🌐",
        GrovePrincipalKind.Tenant => "🏢",
        GrovePrincipalKind.Organization => "🏛",
        GrovePrincipalKind.Role => option.IsDerived ? "🔗" : "👥",
        _ => "👤",
    };

    private string L(string text) => (Services.GetService(typeof(ILocalizer)) as ILocalizer)?.Get(text, CultureInfo.CurrentUICulture) ?? text;
}

@namespace Grove.Components.Forms
@using System.Text.Json.Nodes
@using Grove.Components.Editors
@using Grove.Components.Models
@using Grove.Components.Primitives
@using Grove.DisplayManagement.Components
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services
@implements IDisposable

@* The form of an item laid out from its type's definition: a section per part, the editor each
   field's type declares (the registry's editor components, docs/blazor-display.md § 7), all
   writing into Content through one ContentEditorContext. The editor tree a server builds uses
   the same editors and the same context; this is that layout made on the client. *@

@if (Content is null)
{
    <GroveText TextStyle="TextStyle.Body2" class="rz-color-secondary">No content data is available for this item.</GroveText>
}
else if (Metadata?.Parts is { Length: > 0 } parts && _context is not null)
{
    <CascadingValue Value="_context" IsFixed="true">
        <GroveStack Gap="1rem" class="grove-form-manager">
            @foreach (var part in parts.Where(part => part.Fields.Length > 0))
            {
                <GroveFieldset Text="@part.DisplayName" AllowCollapse="true">
                    <GroveStack Gap="0.75rem">
                        @foreach (var field in part.Fields.OrderBy(field => field.Position ?? string.Empty, StringComparer.OrdinalIgnoreCase))
                        {
                            @RenderEditor(part.Name, field)
                        }
                    </GroveStack>
                </GroveFieldset>
            }
        </GroveStack>
    </CascadingValue>
}
else
{
    <GroveText TextStyle="TextStyle.Body2" class="rz-color-secondary">This content type does not expose editable field metadata yet.</GroveText>
}

@code {
    [Parameter] public JsonNode? Content { get; set; }
    [Parameter] public GroveContentItemMetadata? Metadata { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private ContentEditorContext? _context;
    private JsonNode? _contextContent;

    protected override void OnParametersSet()
    {
        // The context edits Content in place, so the page that handed it in saves it as is.
        if (!ReferenceEquals(_contextContent, Content) || _context?.Metadata != Metadata)
        {
            if (_context is not null)
            {
                _context.Changed -= OnChanged;
            }

            _contextContent = Content;
            _context = Content is null ? null : new ContentEditorContext(Content, Metadata, Services.GetService<HttpClient>());
            if (_context is not null)
            {
                _context.Changed += OnChanged;
            }
        }

        if (_context is not null)
        {
            _context.Disabled = Disabled;
        }
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public bool Validate() => _context?.Validate() ?? true;

    private RenderFragment RenderEditor(string partName, GroveContentFieldMetadata field) => builder =>
    {
        if (Services.GetService<IComponentRegistry>() is not { } registry || !registry.TryGetEditor(field.FieldType, out var editor) || editor.Type is null)
        {
            return;
        }

        builder.OpenComponent(0, editor.Type);
        builder.SetKey(ContentEditorContext.Key(partName, field.Name));
        builder.AddComponentParameter(1, nameof(FieldEditorBase.PartName), partName);
        builder.AddComponentParameter(2, nameof(FieldEditorBase.FieldName), field.Name);
        builder.CloseComponent();
    };

    public void Dispose()
    {
        if (_context is not null)
        {
            _context.Changed -= OnChanged;
        }
    }
}

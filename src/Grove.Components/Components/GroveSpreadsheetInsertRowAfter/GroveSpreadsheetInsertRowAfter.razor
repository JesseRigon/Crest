@using Grove.Components.Primitives.Spreadsheet
@using Grove.Components.Primitives.Documents.Spreadsheet
@inherits GroveSpreadsheetToolBase
@namespace Grove.Components.Primitives.Spreadsheet.Tools
<GroveButton aria-label=@(Spreadsheet?.Localize(nameof(GroveStrings.Spreadsheet_InsertRowBelow))) Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small" Click=@OnInsertRowAfterClick Icon="add_row_below" ButtonType="ButtonType.Button" Disabled=@IsDisabled
    title=@(Spreadsheet?.Localize(nameof(GroveStrings.Spreadsheet_InsertRowBelow)) ?? "Insert Row Below") />
@code {
    protected override SpreadsheetFeature? Feature => SpreadsheetFeature.Editing;

    private async Task OnInsertRowAfterClick()
    {
        if (Worksheet is null || Spreadsheet is null)
        {
            return;
        }

        await Spreadsheet.ExecuteAsync(new InsertRowCommand(Worksheet, Worksheet.Selection.Range.End.Row + 1));
    }
}

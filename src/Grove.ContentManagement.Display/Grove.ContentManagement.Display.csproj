<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <!-- NuGet properties-->
    <Title>Grove ContentManagement Display</Title>
    <Description>$(OCCMSDescription)

    DisplayManagement Library for ContentManagement. Provides implementation of DisplayManager for ContentItem and useful utilities classes for shapes, placement and Razor - related to ContentManagement.
    </Description>
    <PackageTags>$(PackageTags) PlatformCMS ContentManagement DisplayManagement</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grove.ContentManagement.Abstractions\Grove.ContentManagement.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.DisplayManagement\Grove.DisplayManagement.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Grove.Search.Lucene</RootNamespace>
    <!-- NuGet properties-->
    <Title>Grove Lucene Abstractions</Title>
    <Description>$(OCCMSDescription)

    Abstractions for Lucene.</Description>
    <PackageTags>$(PackageTags) PlatformCMS Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lucene.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grove.Data.Indexing.Abstractions\Grove.Data.Indexing.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Infrastructure.Abstractions\Grove.Infrastructure.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Data.Queries.Abstractions\Grove.Data.Queries.Abstractions.csproj" />
  </ItemGroup>
</Project>

@namespace Crest.Components.Account
@using Crest.Components.Primitives

@* The refusals of an account action, or its success line. *@

@foreach (var error in Errors)
{
    <CrestText TextStyle="TextStyle.Caption" Text="@error.Message" Style="color: var(--crest-color-danger, #b3261e);" data-testid="account-error" />
}
@if (Success && !string.IsNullOrEmpty(SuccessText))
{
    <CrestText TextStyle="TextStyle.Caption" Text="@SuccessText" data-testid="account-success" />
}

@code {
    [Parameter]
    public AccountFieldError[] Errors { get; set; } = [];

    [Parameter]
    public bool Success { get; set; }

    [Parameter]
    public string? SuccessText { get; set; }
}

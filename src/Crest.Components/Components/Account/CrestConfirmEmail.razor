@namespace Crest.Components.Account
@using System.Globalization
@using Crest.Components.Primitives
@inject HttpClient Http
@inject IServiceProvider Services

@* Confirms an email address from the link the confirmation email carries (step 7: the MVC
   EmailConfirmation screen is retired). Confirming changes data, so it runs once interactive,
   never during the prerender (a mail scanner's GET must not confirm on the user's behalf). *@

<CrestStack Gap="0.75rem" data-testid="confirm-email">
    @if (Result is null)
    {
        <CrestText TextStyle="TextStyle.Body2" Text="@L("Confirming your email…")" />
    }
    else if (Result.Succeeded)
    {
        <CrestText TextStyle="TextStyle.Body1" Text="@L("Thank you for confirming your email.")" data-testid="confirm-email-done" />
    }
    else
    {
        <Messages Errors="@(Result.Errors ?? [])" Success="false" />
    }
</CrestStack>

@code {
    [Parameter]
    public string? UserId { get; set; }

    [Parameter]
    public string? Code { get; set; }

    private AccountResult? Result { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive)
        {
            return;
        }

        Result = await AccountApi.SendAsync<AccountResult>(Http, HttpMethod.Post, $"{AccountApi.Root}/email/confirm", new { UserId, Code })
            ?? AccountResult.Failed(L("This confirmation link is not valid."));
        StateHasChanged();
    }

    private string L(string text) => (Services.GetService(typeof(ILocalizer)) as ILocalizer)?.Get(text, CultureInfo.CurrentUICulture) ?? text;
}

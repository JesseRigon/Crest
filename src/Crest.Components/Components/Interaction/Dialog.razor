@namespace Crest.Components.Interaction

<div class="crest-overlay-backdrop" @onclick="CloseAsync"></div>
<div class="crest-dialog" role="dialog" aria-modal="true" aria-label="@Title">
    <div class="crest-dialog__header">
        <span class="crest-dialog__title">@Title</span>
        <button type="button" class="crest-dialog__close" aria-label="Close" @onclick="CloseAsync">×</button>
    </div>
    <div class="crest-dialog__body">@ChildContent</div>
</div>

@namespace Crest.Components.Interaction

@if (Record is { } record)
{
    <dl class="crest-property-list">
        @foreach (var (name, value) in record)
        {
            <dt>@name</dt>
            <dd>@Text(value)</dd>
        }
    </dl>
}
else if (!string.IsNullOrEmpty(EmptyText))
{
    <p class="crest-property-list__empty">@EmptyText</p>
}

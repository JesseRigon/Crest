@namespace Crest.Components.Model
@typeparam TKind
@using System.Net.Http.Json
@using Crest.Components.Primitives
@inject HttpClient Http

@* One kind's own page (/Parties/customers, /Assets/items): the same pane the registry's "All"
   page shows, on its own route. Loads the registry's kinds, finds the one the route names
   (ignoring case) among those <see cref="Filter"/> admits, and renders its pane. *@

@if (!string.IsNullOrWhiteSpace(Error))
{
    <CrestAlert AlertStyle="AlertStyle.Danger" Summary="@ErrorSummary" Detail="@Error" />
}
else if (IsLoading)
{
    <CrestProgressBar Mode="ProgressBarMode.Indeterminate" />
}
else if (Kind is null)
{
    <CrestCard><CrestText TextStyle="TextStyle.Body1">@NotFoundText</CrestText></CrestCard>
}
else
{
    @Pane(Kind)
}

@code {
    [Parameter, EditorRequired] public string KindsUrl { get; set; } = string.Empty;

    /// <summary>The kind's key from the route.</summary>
    [Parameter, EditorRequired] public string KindKey { get; set; } = string.Empty;

    [Parameter, EditorRequired] public Func<TKind, string> KeySelector { get; set; } = default!;

    [Parameter, EditorRequired] public RenderFragment<TKind> Pane { get; set; } = default!;

    /// <summary>Which kinds this page serves (a kind with a page of its owner's is not one of them).</summary>
    [Parameter] public Func<TKind, bool>? Filter { get; set; }

    [Parameter] public string ErrorSummary { get; set; } = "Could not load the kinds";

    [Parameter] public string NotFoundText { get; set; } = "No such kind is registered.";

    /// <summary>Every kind the registry answered, for a pane that needs its siblings (conversions).</summary>
    [Parameter] public EventCallback<TKind[]> Loaded { get; set; }

    public TKind? Kind { get; private set; }

    private bool IsLoading { get; set; }
    private string? Error { get; set; }
    private string? _loadedKey;

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(_loadedKey, KindKey, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _loadedKey = KindKey;
        IsLoading = true;
        Error = null;
        try
        {
            var kinds = await Http.GetFromJsonAsync<TKind[]>(KindsUrl) ?? [];
            Kind = kinds.FirstOrDefault(kind => string.Equals(KeySelector(kind), KindKey, StringComparison.OrdinalIgnoreCase) && (Filter?.Invoke(kind) ?? true));
            await Loaded.InvokeAsync(kinds);
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }
}

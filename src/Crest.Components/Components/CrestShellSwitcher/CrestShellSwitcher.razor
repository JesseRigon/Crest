@namespace Crest.Components.Primitives
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject NavigationManager Navigation

@* The one switcher, the same in every shell (docs/shells-and-themes.md › Member sessions and
   sides): the tenants this DEVICE has signed in to on top, a separator, then the active
   tenant's organizations.

   Tenants are device data, never server data: the list lives in this browser
   (crestComponents.deviceAccounts), each tenant is added by signing in there, and one signed
   out of stays until removed - no server record links accounts across tenants, and an email
   address is never an identity link. Organizations are server data: only the active tenant's,
   from the user's own bindings, as the host passed them in. Choosing a tenant opens it;
   choosing an organization opens the member portal with it active. *@

<details class="crest-shell-switcher @Class" data-testid="crest-shell-switcher" @attributes="Attributes">
    <summary class="crest-shell-switcher__current" aria-label="@CurrentLabel">
        <span class="crest-shell-switcher__tenant">@TenantName</span>
        @if (ActiveOrganizationName is { Length: > 0 } activeOrganization)
        {
            <span class="crest-shell-switcher__organization">@activeOrganization</span>
        }
    </summary>

    <div class="crest-shell-switcher__menu" role="menu">
        <div class="crest-shell-switcher__heading">@TenantsHeading</div>
        @foreach (var account in _accounts)
        {
            var isCurrent = IsCurrent(account);
            <div class="crest-shell-switcher__row" role="none">
                <button type="button"
                        role="menuitem"
                        class="crest-shell-switcher__item @(isCurrent ? "crest-shell-switcher__item--current" : null)"
                        aria-current="@(isCurrent ? "true" : null)"
                        data-testid="crest-shell-switcher-tenant"
                        @onclick="@(() => OpenAccount(account))">
                    <span class="crest-shell-switcher__label">@account.TenantName</span>
                    <span class="crest-shell-switcher__detail">@account.UserName</span>
                </button>
                @if (!isCurrent)
                {
                    <button type="button"
                            class="crest-shell-switcher__remove"
                            title="@RemoveText"
                            aria-label="@($"{RemoveText}: {account.TenantName}")"
                            data-testid="crest-shell-switcher-remove"
                            @onclick="@(() => RemoveAsync(account))">&times;</button>
                }
            </div>
        }

        @if (AddAccountUrl is { Length: > 0 })
        {
            <button type="button" role="menuitem" class="crest-shell-switcher__item crest-shell-switcher__item--action"
                    data-testid="crest-shell-switcher-add"
                    @onclick="@(() => Navigation.NavigateTo(AddAccountUrl, forceLoad: true))">@AddAccountText</button>
        }

        @if (Organizations.Count > 0)
        {
            <hr class="crest-shell-switcher__separator" />
            <div class="crest-shell-switcher__heading">@OrganizationsHeading</div>
            @foreach (var organization in Organizations)
            {
                var isActive = string.Equals(organization.Id, ActiveOrganizationId, StringComparison.Ordinal);
                <button type="button"
                        role="menuitem"
                        class="crest-shell-switcher__item @(isActive ? "crest-shell-switcher__item--current" : null)"
                        aria-current="@(isActive ? "true" : null)"
                        data-testid="crest-shell-switcher-organization"
                        @onclick="@(() => OpenOrganizationAsync(organization))">
                    <span class="crest-shell-switcher__label">@organization.Name</span>
                </button>
            }
        }
    </div>
</details>

@code {
    /// <summary>The active tenant's display name.</summary>
    [Parameter, EditorRequired]
    public string TenantName { get; set; } = string.Empty;

    /// <summary>The active tenant's browser-absolute base path ("" or "/t2").</summary>
    [Parameter]
    public string TenantBase { get; set; } = string.Empty;

    /// <summary>The signed-in user on this tenant; empty when nobody is (nothing is remembered).</summary>
    [Parameter]
    public string? UserName { get; set; }

    /// <summary>Where this tenant opens when chosen from another tenant: this shell's own base.</summary>
    [Parameter]
    public string HomeUrl { get; set; } = string.Empty;

    /// <summary>Where "Add an account" goes: this shell's login.</summary>
    [Parameter]
    public string? AddAccountUrl { get; set; }

    /// <summary>The active tenant's organizations the user is bound to, with where each opens.</summary>
    [Parameter]
    public IReadOnlyList<CrestShellSwitcherOrganization> Organizations { get; set; } = [];

    [Parameter]
    public string? ActiveOrganizationId { get; set; }

    [Parameter]
    public string? ActiveOrganizationName { get; set; }

    /// <summary>
    /// Called before an organization's URL is opened (the member shell remembers the choice as
    /// the session's last one). Optional.
    /// </summary>
    [Parameter]
    public EventCallback<CrestShellSwitcherOrganization> OrganizationChosen { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string TenantsHeading { get; set; } = "Accounts on this device";

    [Parameter]
    public string OrganizationsHeading { get; set; } = "Organizations";

    [Parameter]
    public string AddAccountText { get; set; } = "Add an account";

    [Parameter]
    public string RemoveText { get; set; } = "Remove from this device";

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private IReadOnlyList<CrestDeviceAccount> _accounts = [];
    private string? _remembered;

    private string CurrentLabel => ActiveOrganizationName is { Length: > 0 } organization ? $"{TenantName} · {organization}" : TenantName;

    protected override void OnParametersSet()
    {
        if (_accounts.Count == 0)
        {
            // Before the device list loads (and during prerender), the active tenant alone.
            _accounts = [new CrestDeviceAccount { TenantName = TenantName, TenantBase = TenantBase, UserName = UserName ?? string.Empty, HomeUrl = HomeUrl }];
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The current account is remembered once per user and tenant: signing in somewhere is
        // what adds a tenant to this device's list.
        var key = $"{TenantBase}|{UserName}";
        if (!RendererInfo.IsInteractive || string.Equals(key, _remembered, StringComparison.Ordinal))
        {
            return;
        }

        _remembered = key;
        try
        {
            _accounts = string.IsNullOrWhiteSpace(UserName)
                ? await JS.InvokeAsync<CrestDeviceAccount[]>("crestComponents.deviceAccounts.list")
                : await JS.InvokeAsync<CrestDeviceAccount[]>("crestComponents.deviceAccounts.remember", new CrestDeviceAccount
                {
                    TenantName = TenantName,
                    TenantBase = TenantBase,
                    UserName = UserName,
                    HomeUrl = HomeUrl,
                });
            StateHasChanged();
        }
        catch (JSException)
        {
            // Storage blocked (private mode): the switcher shows the active tenant only.
        }
    }

    private bool IsCurrent(CrestDeviceAccount account) =>
        string.Equals(account.TenantBase, TenantBase, StringComparison.OrdinalIgnoreCase)
        && string.Equals(account.UserName, UserName ?? string.Empty, StringComparison.OrdinalIgnoreCase);

    private void OpenAccount(CrestDeviceAccount account)
    {
        if (!IsCurrent(account) && account.HomeUrl is { Length: > 0 } home)
        {
            Navigation.NavigateTo(home, forceLoad: true);
        }
    }

    private async Task RemoveAsync(CrestDeviceAccount account)
    {
        try
        {
            _accounts = await JS.InvokeAsync<CrestDeviceAccount[]>("crestComponents.deviceAccounts.remove", account.TenantBase, account.UserName);
        }
        catch (JSException)
        {
        }
    }

    private async Task OpenOrganizationAsync(CrestShellSwitcherOrganization organization)
    {
        if (string.Equals(organization.Id, ActiveOrganizationId, StringComparison.Ordinal))
        {
            return;
        }

        await OrganizationChosen.InvokeAsync(organization);
        Navigation.NavigateTo(organization.Url, forceLoad: true);
    }
}

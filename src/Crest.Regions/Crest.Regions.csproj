<Project Sdk="Microsoft.NET.Sdk.Razor">
  <Import Project="$(PlatformSrcDir)Crest.Module.Targets\Crest.Module.Targets.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Crest.Regions</AssemblyName>
    <RootNamespace>Crest.Regions</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs;blazor-wasm/**/*.cs;Domain/**/*.cs" />
  </ItemGroup>

  <!-- Regional Profiles, the geo tree and per-country addressing maps
       (plans/regions-and-locations.md). Geo standard data lives in the global store
       (Crest.Global); this module declares its schema and the tenant overlay. -->
  <ItemGroup>
    <ProjectReference Include="$(PlatformSrcDir)Crest.ContentFields\Crest.ContentFields.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Crest.ContentManagement\Crest.ContentManagement.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Crest.Contents\Crest.Contents.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Crest.Data\Crest.Data.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Crest.Module.Targets\Crest.Module.Targets.csproj" />
    <PackageReference Include="YesSql.Abstractions" />
    <PackageReference Include="NetTopologySuite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Crest.Server/Crest.Server.csproj" />
    <ProjectReference Include="../Crest.Global/Crest.Global.csproj" />
    <ProjectReference Include="Domain/Crest.Regions.Domain.csproj" />
  </ItemGroup>
</Project>

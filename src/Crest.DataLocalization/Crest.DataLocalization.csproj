<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <!-- NuGet properties-->
    <Title>Crest Data Localization</Title>
    <Description>$(OCFrameworkDescription)
    
    Provides the infrastructure necessary to support localized data string.
    </Description>
    <PackageTags>$(PackageTags) PlatformFramework Localization</PackageTags>

<Project Sdk="Microsoft.NET.Sdk.Razor">
  <Import Project="$(PlatformSrcDir)Grove.Module.Targets\Grove.Module.Targets.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The assembly is Grove.Server; the code and Razor components stay in Grove.* namespaces. -->
    <RootNamespace>Grove</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformCompatibilityVersion>4.0.0</PlatformCompatibilityVersion>
    <GroveSecurityPatch>0</GroveSecurityPatch>
    <GroveBugPatch>0</GroveBugPatch>
    <GroveVersion>$(PlatformCompatibilityVersion).$(GroveSecurityPatch).$(GroveBugPatch)</GroveVersion>
    <VersionPrefix>$(PlatformCompatibilityVersion)</VersionPrefix>
    <PackageVersion>$(PlatformCompatibilityVersion)</PackageVersion>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>
    <AssemblyInformationalVersion>$(GroveVersion)</AssemblyInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Themes\**" />
    <Content Remove="Themes\**" />
    <EmbeddedResource Remove="Themes\**" />
    <None Remove="Themes\**" />
    <RazorGenerate Remove="Themes\**" />
    <RazorComponent Remove="Themes\**" />
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

  <!-- Grove.Module.Targets (referenced below) sets EnableDefaultRazorGenerateItems
       to false project-wide, then only re-adds RazorGenerate for legacy *.cshtml views -
       it predates Blazor components and has no concept of *.razor. Without this, every
       *.razor file under Components/ (App.razor, Routes.razor, Pages/*.razor,
       _Imports.razor) is silently invisible to the compiler: not a RazorComponent, not
       even a Compile item. Re-declared explicitly here rather than patching the shared
       module targets, since this is the first Grove module project that hosts its own
       *.razor files instead of only consuming Components' compiled output. -->
  <ItemGroup>
    <RazorComponent Include="Components\**\*.razor" Exclude="Themes\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.ContentTypes\Grove.ContentTypes.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Server.Abstractions\Grove.Server.Abstractions.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Admin.Abstractions\Grove.Admin.Abstractions.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Admin\Grove.Admin.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.AdminMenu\Grove.AdminMenu.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.AdminMenu.Abstractions\Grove.AdminMenu.Abstractions.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.ContentManagement\Grove.ContentManagement.csproj" />
    <!-- TranslationsManager, for promoting an admin menu rename into the tenant's
         translation store (the same store IDataLocalizer reads at render time). -->
    <ProjectReference Include="$(PlatformSrcDir)Grove.DataLocalization\Grove.DataLocalization.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.ContentFields\Grove.ContentFields.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Contents\Grove.Contents.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.FileStorage.Abstractions\Grove.FileStorage.Abstractions.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Features\Grove.Features.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Menu\Grove.Menu.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Media.Abstractions\Grove.Media.Abstractions.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Media\Grove.Media.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Access\Grove.Access.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Access.Abstractions\Grove.Access.Abstractions.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Data.YesSql\Grove.Data.YesSql.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Module.Targets\Grove.Module.Targets.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Recipes.Abstractions\Grove.Recipes.Abstractions.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Recipes\Grove.Recipes.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Queries\Grove.Queries.csproj" />
    <!-- The native Settings > Debugging and Deployments pages' API (DebugSettingsController,
         DeploymentController). -->
    <ProjectReference Include="$(PlatformSrcDir)Grove.Settings\Grove.Settings.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.CustomSettings\Grove.CustomSettings.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Deployment\Grove.Deployment.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Deployment.Remote\Grove.Deployment.Remote.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Localization\Grove.Localization.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Indexing.Abstractions\Grove.Indexing.Abstractions.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Indexing\Grove.Indexing.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Lucene\Grove.Lucene.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Roles.Abstractions\Grove.Roles.Abstractions.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Themes\Grove.Themes.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Templates\Grove.Templates.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Layers\Grove.Layers.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Placements\Grove.Placements.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Tenants\Grove.Tenants.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Security\Grove.Security.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Users\Grove.Users.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Workflows\Abstractions\Grove.Workflows.Abstractions.csproj" />
    <PackageReference Include="YesSql.Abstractions" />
    <!-- AddInteractiveWebAssemblyComponents() (Startup.cs) is defined by this package,
         not by Microsoft.AspNetCore.App's shared framework - WASM-hosting-from-a-server
         support isn't part of it. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
  </ItemGroup>

  <!-- Server is the single Blazor Web App host: API endpoints (api/grove/*) and SSR
       document rendering machinery both live here, per plans/blazor hybrid
       conversion.md's decision to keep everything Blazor-hosting-related in one server
       rather than duplicating hosting per theme. Server only references Components -
       the shared, generic Blazor primitives/rendering machinery every Blazor-capable
       theme builds on - not any specific theme (Grove.SiteTheme, Grove.AdminTheme, or any future
       third-party Blazor theme). Themes are discovered dynamically at runtime via
       Grove's own extension/feature system, the same way BlazorAdminThemeMiddleware
       already detects "is the current theme Blazor-tagged" via IAdminThemeService
       instead of a hardcoded theme ID - a hardcoded ProjectReference to a specific
       theme here would defeat that and force a Server rebuild for every new
       Blazor-capable theme. No circular dependency - Components never references
       Server. -->
  <ItemGroup>
    <ProjectReference Include="..\Grove.Iconify\Grove.Iconify.csproj" />
    <ProjectReference Include="..\Grove.Components\Grove.Components.csproj" />
    <ProjectReference Include="..\Grove.Icons\Grove.Icons.csproj" />
    <!-- Providers/TenantMedia is excluded from Icons.csproj's own compile (needs
         server-side Grove media dependencies Icons itself doesn't reference) - this
         source-linking, not the ProjectReference above, is what actually compiles it,
         same as before this file's Blazor-hosting changes. -->
    <Compile Include="..\Grove.Icons\Providers\TenantMedia\**\*.cs" Link="Icons\Providers\TenantMedia\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Server references the theme client libraries it renders (SSR and InteractiveServer).
       The single WASM entry project (Program.Main) belongs to the HOST app, which
       references these same libraries plus the module client libraries it ships - see
       Grove.AdminTheme.Client's ClientWebAssemblyHost. Grove never references a host's modules:
       Startup.Configure's assembly scan (*.Client.dll / *.BlazorWasm.dll) picks up
       whatever the host brought into the app's output and feeds it to
       MapRazorComponents' route table. Which theme actually renders for a given request
       is still decided at runtime (the theme-dispatching Components/App.razor +
       BlazorAdminThemeMiddleware's theme check), never at build time. -->
  <ItemGroup>
    <ProjectReference Include="..\Grove.AdminTheme\wasm\Grove.AdminTheme.Client.csproj" />
    <ProjectReference Include="..\Grove.SiteTheme\wasm\Grove.SiteTheme.Client.csproj" />
    <ProjectReference Include="..\Grove.MemberTheme\wasm\Grove.MemberTheme.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Grove.Api" />
    <InternalsVisibleTo Include="Grove.Server.Tests" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <!-- NuGet properties-->
    <Title>Grove Liquid</Title>
    <Description>$(OCCMSDescription)

    The liquid module enables content items to have liquid syntax.</Description>
    <PackageTags>$(PackageTags) PlatformCMS</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grove.Admin.Abstractions\Grove.Admin.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.ContentTypes.Abstractions\Grove.ContentTypes.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Data.Abstractions\Grove.Data.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.DisplayManagement\Grove.DisplayManagement.csproj" />
    <ProjectReference Include="..\Grove.DisplayManagement.Liquid\Grove.DisplayManagement.Liquid.csproj" />
    <ProjectReference Include="..\Grove.Indexing.Abstractions\Grove.Indexing.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Module.Targets\Grove.Module.Targets.csproj" />
    <ProjectReference Include="..\Grove.Shortcodes.Abstractions\Grove.Shortcodes.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.ResourceManagement\Grove.ResourceManagement.csproj" />
    <ProjectReference Include="..\Grove.Abstractions\Grove.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AnyAscii" />
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Razor">
  <Import Project="$(PlatformSrcDir)Grove.Module.Targets\Grove.Module.Targets.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Grove.Money</AssemblyName>
    <RootNamespace>Grove.Money</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs;Domain/**/*.cs" />
  </ItemGroup>

  <!-- The money content field and the currency table behind it. ISO 4217 minor units are
       reference data every application shares, so they live in the global store
       (Grove.Data.Global); a tenant chooses its default currency, never the units. -->
  <ItemGroup>
    <ProjectReference Include="$(PlatformSrcDir)Grove.ContentFields\Grove.ContentFields.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.ContentManagement\Grove.ContentManagement.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Data\Grove.Data.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Grove.Module.Targets\Grove.Module.Targets.csproj" />
    <PackageReference Include="YesSql.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Grove.Server/Grove.Server.csproj" />
    <ProjectReference Include="../Grove.OptionPicker/Grove.OptionPicker.csproj" />
    <ProjectReference Include="../Grove.Data.Global/Grove.Data.Global.csproj" />
    <ProjectReference Include="Domain/Grove.Money.Domain.csproj" />
  </ItemGroup>
</Project>

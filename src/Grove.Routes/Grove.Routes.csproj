<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- NuGet properties-->
    <Title>Grove Routes</Title>
    <Description>
      $(OCCMSDescription)

      The tenant's route management: the page registry's routes, content routes, the home route,
      and the URL rewrite and redirect rules.
    </Description>
    <PackageTags>$(PackageTags) PlatformCMS</PackageTags>
  </PropertyGroup>

  <!-- The route management page is its own WASM library (blazor-wasm/, Grove.Routes.BlazorWasm). -->
  <ItemGroup>
    <Compile Remove="blazor-wasm/**/*.cs" />
    <Content Remove="blazor-wasm/**" />
    <None Remove="blazor-wasm/**" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grove.Module.Targets\Grove.Module.Targets.csproj" />
    <ProjectReference Include="..\Grove.Admin.Abstractions\Grove.Admin.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Recipes.Abstractions\Grove.Recipes.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Data.Abstractions\Grove.Data.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Infrastructure.Abstractions\Grove.Infrastructure.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Server.Abstractions\Grove.Server.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Autoroute.Abstractions\Grove.Autoroute.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Alias\Grove.Alias.csproj" />
    <ProjectReference Include="..\Grove.Routes.Abstractions\Grove.Routes.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YesSql.Abstractions" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Grove</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet properties-->
    <Title>Grove Server Abstractions</Title>
    <Description>$(OCCMSDescription)

    The contracts a module needs to register its surfaces with the server: the API endpoint
    registry (declared contributors and defined entries), the error contract and the request
    access helper; the page registry contracts.</Description>
    <PackageTags>$(PackageTags) PlatformCMS Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grove.Abstractions\Grove.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Infrastructure.Abstractions\Grove.Infrastructure.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.DisplayManagement.Abstractions\Grove.DisplayManagement.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.ContentManagement.Abstractions\Grove.ContentManagement.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Kinds\Grove.Kinds.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <!-- NuGet properties-->
    <Title>Grove FileStorage Amazon S3</Title>
    <Description>$(OCFrameworkDescription)

      Implementation for Amazon S3 FileStorage.</Description>
    <PackageTags>$(PackageTags) PlatformFramework Amazon</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grove.Abstractions\Grove.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.FileStorage.Abstractions\Grove.FileStorage.Abstractions.csproj" />
  </ItemGroup>

</Project>

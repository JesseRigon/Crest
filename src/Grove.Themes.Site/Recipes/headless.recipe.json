{
  "name": "Headless",
  "displayName": "Headless site",
  "description": "Creates a headless site with content management, GraphQL, and OpenId features.",
  "author": "The Grove Team",
  "website": "https://orchardcore.net",
  "version": "1.0.0",
  "issetuprecipe": true,
  "categories": [ "default" ],
  "tags": [ "headless" ],

  // The variables are evaluated the first time they are accessed, and reused across steps
  "variables": {
    // "now": "[js: new Date().toISOString()]"
  },

  "steps": [
    {
      "name": "feature",
      "enable": [
        // SaaS
        "Grove.HomeRoute",
        "Grove.Infrastructure.Shells.Admin",
        "Grove.Diagnostics",
        "Grove.Infrastructure.Features",
        "Grove.Display.Navigation",
        "Grove.Infrastructure.Recipes",
        "Grove.Display.Resources",
        "Grove.Access.Roles",
        "Grove.Security",
        "Grove.Infrastructure.Settings",
        "Grove.Themes",
        "Grove.Access.Users",

        // Content Management
        "Grove.Contents.Alias",
        "Grove.Data.Protocols.Html",
        "Grove.Contents.Fields",
        "Grove.Contents",
        "Grove.Contents.Types",
        "Grove.Infrastructure.CustomSettings",
        "Grove.Deployment",
        "Grove.Deployment.Remote",
        "Grove.Data.Protocols.GraphQL",
        "Grove.Contents.BagParts",
        "Grove.Data.Indexing",
        "Grove.Display.Layers",
        "Grove.Contents.Lists",
        "Grove.Contents.Markdown",
        "Grove.Media",
        "Grove.Contents.SiteMenu",
        "Grove.Access.OpenId",
        "Grove.Access.OpenId.Management",
        "Grove.Access.OpenId.Server",
        "Grove.Access.OpenId.Validation",
        "Grove.Data.Queries",
        "Grove.Contents.Title"

        // Themes
      ]
    },
    {
      "name": "Roles",
      "Roles": [
        {
          "Name": "Moderator",
          "Description": "Grants users the ability to moderate content.",
          "Permissions": []
        },
        {
          "Name": "Editor",
          "Description": "Grants users the ability to edit existing content.",
          "Permissions": []
        },
        {
          "Name": "Author",
          "Description": "Grants users the ability to create content.",
          "Permissions": []
        },
        {
          "Name": "Contributor",
          "Description": "Grants users the ability to contribute content.",
          "Permissions": []
        },
        {
          "Name": "Authenticated",
          "Description": "A system role representing all authenticated users.",
          "Permissions": [
            "ViewContent",
            "ExecuteGraphQL",
            "ExecuteApiAll"
          ]
        }
      ]
    },
    {
      "name": "settings",
      "HomeRoute": {
        "Action": "Index",
        "Controller": "Admin",
        "Area": "Grove.Infrastructure.Shells.Admin"
      }
    },
    {
      "name": "themes",
      "admin": "Grove.Themes.Admin",
      "site": ""
    }
  ]
}

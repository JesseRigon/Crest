    {
      "name": "Templates",
      "Templates": {
        "Content__Article": {
          "Source": "{% compose \"Content\" %}{% zone \"Header\" %}{% component \"GroveHeading\", text: Model.ContentItem.DisplayText, size: \"H1\" %}{% endzone %}{% zone \"Content\" %}{% children \"Content\" %}{% endzone %}{% zone \"Tags\" %}{% children \"Tags\" %}{% endzone %}{% endcompose %}",
          "Description": "An article: its title and body (sample site)."
        },
        "Content__BlogPost": {
          "Source": "{% compose \"Content\" %}{% zone \"Header\" %}{% component \"GroveHeading\", text: Model.ContentItem.DisplayText, size: \"H1\" %}{% endzone %}{% zone \"Content\" %}{% children \"Content\" %}{% endzone %}{% zone \"Tags\" %}{% children \"Tags\" %}{% endzone %}{% endcompose %}",
          "Description": "A blog post: its title, body and tags (sample site)."
        },
        "Content__Blog": {
          "Source": "{% compose \"Content\" %}{% zone \"Header\" %}{% component \"GroveHeading\", text: Model.ContentItem.DisplayText, size: \"H1\" %}{% endzone %}{% zone \"Content\" %}{% children \"Content\" %}{% endzone %}{% zone \"Tags\" %}{% children \"Tags\" %}{% endzone %}{% endcompose %}",
          "Description": "The blog: its title, description and posts (sample site)."
        }
      }
    },
    {
      "name": "lucene-index",
      "Indices": [
        {
          "Search": {
            "AnalyzerName": "standardanalyzer",
            "IndexLatest": false,
            "IndexedContentTypes": [

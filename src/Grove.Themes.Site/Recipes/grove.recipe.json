    {
      "name": "content",
      "Data": [
        {
          "ContentType": "Menu",
          "ContentItemId": "[js: variables('menuContentItemId')]",
          "DisplayText": "Main Menu",
          "Latest": true,
          "Published": true,
          "Menu": {},
          "Title": {
            "Title": { "Text": "Main Menu" }
          },
          "MenuItems": {
            "ContentItems": [
              {
                "ContentType": "LinkMenuItem",
                "ContentItemId": "[js: uuid()]",
                "DisplayText": "Home",
                "LinkMenuItem": {
                  "Url": { "Text": "~/home" },
                  "IconClass": {
                    "Text": "oi oi-home"
                  }
                }
              },
              {
                "ContentType": "LinkMenuItem",
                "ContentItemId": "[js: uuid()]",
                "DisplayText": "Blog",
                "LinkMenuItem": {
                  "Url": { "Text": "~/blog" },
                  "IconClass": {
                    "Text": "oi oi-rss-alt"
                  }
                }
              },
              {
                "ContentType": "LinkMenuItem",
                "ContentItemId": "[js: uuid()]",
                "DisplayText": "Counter",
                "LinkMenuItem": {
                  "Url": { "Text": "~/counter" },
                  "IconClass": {
                    "Text": "oi oi-plus"
                  }
                }
              },
              {
                "ContentType": "LinkMenuItem",
                "ContentItemId": "[js: uuid()]",
                "DisplayText": "About",
                "LinkMenuItem": {
                  "Url": { "Text": "~/about" },
                  "IconClass": {
                    "Text": "oi oi-info"
                  }
                }
              },
              {
                "ContentType": "LinkMenuItem",
                "ContentItemId": "[js: uuid()]",
                "DisplayText": "Contact",
                "LinkMenuItem": {
                  "Url": { "Text": "~/contact" },
                  "IconClass": {
                    "Text": "oi oi-envelope-closed"
                  }
                }
              },
              {
                "ContentType": "LinkMenuItem",
                "ContentItemId": "[js: uuid()]",
                "DisplayText": "Search",
                "LinkMenuItem": {
                  "Url": { "Text": "~/search" },
                  "IconClass": {
                    "Text": "oi oi-magnifying-glass"
                  }
                }
              }
            ]
          },
          "Alias": {
            "Alias": { "Text": "main-menu" }
          }
        },
        {
          "ContentItemId": "[js: variables('tagsContentItemId')]",
          "ContentType": "Taxonomy",
          "DisplayText": "Tags",
          "Latest": true,
          "Published": true,
          "Title": {
            "Title": { "Text": "Tags" }
          },
          "Alias": {
            "Alias": { "Text": "tags" }
          },
          "Terms": {
            "ContentItems": [
              {
                "ContentItemId": "[js: variables('earthTagContentItemId')]",
                "ContentType": "Tag",
                "DisplayText": "Earth",
                "Title": {
                  "Title": { "Text": "Earth" }
                },
                "Autoroute": {
                  "Path": { "Text": "earth" }
                },
                "Term": {
                  "TaxonomyContentItemId": { "Text": "[js: variables('tagsContentItemId')]" }
                }
              },
              {
                "ContentItemId": "[js: variables('explorationTagContentItemId')]",
                "ContentType": "Tag",
                "DisplayText": "Exploration",
                "Title": {
                  "Title": { "Text": "Exploration" }
                },
                "Autoroute": {
                  "Path": { "Text": "exploration" }
                },
                "Term": {
                  "TaxonomyContentItemId": { "Text": "[js: variables('tagsContentItemId')]" }
                }

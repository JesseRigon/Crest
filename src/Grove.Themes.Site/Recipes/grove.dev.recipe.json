    {
      "name": "themes",
      "admin": "Grove.Themes.Admin",
      "site": "Grove.Themes.Site"
    },
    {
      "name": "settings",
      "SiteName": "Grove Dev",
      "CurrentAdminThemeName": "Grove.Themes.Admin",
      "LocalizationSettings": {
        "DefaultCulture": "en-US",
        "SupportedCultures": [
          "en-US",
          "es-ES"
        ],
        "FallBackToParentCulture": true
      },
      "AdminSettings": {
        "DisplayThemeToggler": true,
        "DisplayMenuFilter": true,
        "DisplayNewMenu": true,
        "DisplayTitlesInTopbar": false
      }
    },
    {
      "name": "OpenIdServerSettings",
      "AccessTokenFormat": "JsonWebToken",
      "EnableTokenEndpoint": true,
      "AllowClientCredentialsFlow": true
    },
    {
      "name": "OpenIdValidationSettings"
    },
    {
      "name": "Roles",
      "Roles": [
        {
          "Name": "Editor",
          "Description": "Can edit site content.",
          "Permissions": [
            "EditContent",
            "ViewContent"
          ]
        },
        {
          "Name": "Author",
          "Description": "Can author site content.",
          "Permissions": [
            "EditOwnContent",
            "ViewContent"
          ]
        },
        {
          "Name": "Moderator",
          "Description": "Grants users the ability to moderate content.",
          "Permissions": []
        },
        {
          "Name": "Contributor",
          "Description": "Grants users the ability to contribute content.",
          "Permissions": []
        },
        {
          "Name": "WorkflowEditor",
          "Description": "Authors the tenant's own workflows: view, edit, publish and run; not the shipped templates or connections.",
          "Permissions": [
            "AccessAdminPanel",
            "ViewGroveWorkflows",
            "EditGroveWorkflows",
            "PublishGroveWorkflows",
            "RunGroveWorkflows"
          ]
        },
        {
          "Name": "WorkflowViewer",
          "Description": "Reads workflows, instances and journals; changes nothing.",
          "Permissions": [
            "AccessAdminPanel",
            "ViewGroveWorkflows"
          ]
        }
      ]
    },
    {
      "name": "GroveAdminMenuLayout",
      "file": "grove-dev-admin-menu-layout.json"
    },
    {
      "name": "Layers",
      "Layers": [
        {
          "Name": "Always",
          "Description": "Every site page",
          "LayerRule": {
            "Conditions": [
              {
                "Name": "BooleanCondition",
                "Value": true
              }
            ]
          }
        }
      ],
      "Placements": [
        {
          "Id": "dev-counter",
          "Layer": "Always",
          "Zone": "Footer",
          "Component": "GroveCounter",
          "Properties": {
            "StartValue": 5
          },
          "Position": 1,
          "Title": "Interactive counter (dev)"
        }
      ]
    }
  ]

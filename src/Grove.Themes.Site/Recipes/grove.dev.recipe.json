{
  "name": "GroveDev",
  "displayName": "Grove Dev",
  "description": "Development setup for Grove on its own: every Grove feature, the admin, site and member themes, a dev admin menu layout and layer. Grove.Cms.Web auto-sets up the Default tenant from it in Development.",
  "author": "Grove",
  "website": "",
  "version": "1.0.0",
  "issetuprecipe": true,
  "categories": [
    "default"
  ],
  "tags": [
    "dev",
    "grove",
    "sqlite"
  ],
  "excludedFeatures": {
    "Grove.Infrastructure.Setup": "Setup-only: it runs in the uninitialized shell that provisions a tenant (the host's setup features), never in a provisioned tenant.",
    "Grove.Infrastructure.Setup.Auto": "Setup-only: the host enables it for the uninitialized shell (AddSetupFeatures) to run this recipe; it has no role in a provisioned tenant."
  },

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Crest.Data.Types</RootNamespace>
    <Nullable>enable</Nullable>

    <!-- NuGet properties-->
    <Title>Crest Data Types</Title>
    <Description>$(OCFrameworkDescription)

    The value type registry: one place a value type is declared with its field type, editor, display primitive, query column type and workflow type.</Description>
    <PackageTags>$(PackageTags) PlatformFramework Data Types</PackageTags>
  </PropertyGroup>

  <!-- No server framework: the designer, the display schema and the query builder read the same
       registry on the server and in the browser. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>

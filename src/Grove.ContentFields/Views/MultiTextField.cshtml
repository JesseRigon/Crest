@model Grove.ContentFields.ViewModels.DisplayMultiTextFieldViewModel
@using Grove.ContentFields
@using Grove.Mvc.Utilities
@using Grove.ContentManagement.Metadata.Models
@using Grove.Localization.Data
@inject IDataLocalizer D
@{
    var name = (Model.PartFieldDefinition.PartDefinition.Name + "-" + Model.PartFieldDefinition.Name).HtmlClassify();
    string localizedFieldName = D[Model.PartFieldDefinition.DisplayName(), DataLocalizationContext.ContentField(Model.PartFieldDefinition.PartDefinition.Name)];
}

@if (Model.Values.Any())
{
<div class="field field-type-multitextfield field-name-@name">
    <span class="name">@localizedFieldName</span>
    @foreach (var value in Model.Values)
    {
        <span class="value">@value</span>if (value != Model.Values.Last()){@T[", "]}
    }
</div>
}

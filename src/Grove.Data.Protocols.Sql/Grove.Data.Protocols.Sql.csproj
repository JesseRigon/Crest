<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Grove.Data.Protocols.Sql</RootNamespace>
    <Nullable>enable</Nullable>
    <!-- NuGet properties-->
    <Title>Grove SQL Protocol</Title>
    <Description>$(OCCMSDescription)

    External databases for the connector engine: SQL Server, PostgreSQL, MySQL and SQLite over ADO.NET, with parameterized queries and transient-failure classification.</Description>
    <PackageTags>$(PackageTags) PlatformCMS Connectors Sql</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grove.Data.Connectors.Abstractions\Grove.Data.Connectors.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Data.Protocols.Http\Grove.Data.Protocols.Http.csproj" />
    <PackageReference Include="YesSql" />
  </ItemGroup>

</Project>

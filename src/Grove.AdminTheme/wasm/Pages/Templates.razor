@page "/Templates"
@attribute [PageEntry("ManageTemplates", Id = "templates", Parent = "design", Caption = "Templates", Icon = "@iconify:mdi:file-tree")]
@using Grove.AdminTheme.Api
@using Grove.DisplayManagement.Components
@inject IApi Api
@inject Grove.Components.Theme.GroveApiLocalizer T

@* Templates as content (docs/blazor-display.md § 5, rework step 4): Liquid whose tags emit
   display-tree nodes. A save makes a validated draft, publish makes it live, preview evaluates
   the draft (bound to its name for a content item, or on its own) and draws the tree with the
   one renderer. The designer (blazordesigner.md) will edit the same text. *@
<GroveStack Gap="1rem" data-testid="templates-page">
    <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Wrap="FlexWrap.Wrap">
        <GroveText TextStyle="TextStyle.H4" Text="@T["Templates"]" />
        <GroveButton Text="@T["New template"]" Icon="add" Click="New" data-testid="templates-new" />
    </GroveStack>

    @if (_editing is not null)
    {
        <GroveCard data-testid="templates-editor">
            <GroveStack Gap="0.75rem">
                <GroveStack Orientation="Orientation.Horizontal" Gap="0.75rem" Wrap="FlexWrap.Wrap">
                    <GroveTextBox @bind-Value="_editing.Name" Placeholder="@T["Shape or composite name"]" data-testid="templates-name" />
                    <GroveTextBox @bind-Value="_editing.Theme" Placeholder="@T["Theme (every theme when empty)"]" />
                    <GroveTextBox @bind-Value="_editing.DisplayType" Placeholder="@T["Display type (every one when empty)"]" />
                </GroveStack>
                <GroveTextBox @bind-Value="_editing.Description" Placeholder="@T["Description"]" />
                <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                    <GroveCheckBox @bind-Value="_editing.IsComposite" Name="isComposite" /> <label for="isComposite">@T["A component tenants place by name (composite)"]</label>
                </GroveStack>
                @if (_editing.IsComposite)
                {
                    <GroveStack Orientation="Orientation.Horizontal" Gap="0.75rem" Wrap="FlexWrap.Wrap">
                        <GroveTextBox @bind-Value="_editing.DisplayName" Placeholder="@T["Display name"]" />
                        <GroveTextBox @bind-Value="_editing.Category" Placeholder="@T["Category"]" />
                        <GroveTextBox @bind-Value="_editing.Icon" Placeholder="@T["Icon"]" />
                    </GroveStack>
                    <GroveTextArea @bind-Value="_editing.Inputs" Rows="4" Placeholder='[ { "name": "Title", "type": "string", "required": true } ]' Style="font-family: var(--grove-font-mono, monospace);" data-testid="templates-inputs" />
                    <GroveTextArea @bind-Value="_editing.Outputs" Rows="3" Placeholder='[ { "name": "Selected", "node": "list", "output": "selected_item" } ]' Style="font-family: var(--grove-font-mono, monospace);" data-testid="templates-outputs" />
                }
                <GroveTextArea @bind-Value="_editing.Source" Rows="16" Style="font-family: var(--grove-font-mono, monospace);" data-testid="templates-source" />
                <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    <GroveButton Text="@T["Validate"]" Icon="rule" ButtonStyle="ButtonStyle.Light" Click="ValidateAsync" />
                    <GroveButton Text="@T["Save draft"]" Icon="save" Click="SaveAsync" data-testid="templates-save" />
                    @if (_editing.Id is not null)
                    {
                        <GroveButton Text="@T["Publish"]" Icon="publish" ButtonStyle="ButtonStyle.Success" Click="PublishAsync" data-testid="templates-publish" />
                        <GroveButton Text="@T["Delete"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Click="DeleteAsync" />
                    }
                    <GroveButton Text="@T["Close"]" Icon="close" ButtonStyle="ButtonStyle.Light" Click="Close" />
                </GroveStack>

                @if (_message is not null)
                {
                    <GroveAlert AlertStyle="@(_diagnostics.Length > 0 ? AlertStyle.Warning : AlertStyle.Success)" ShowIcon="true" AllowClose="false">@_message</GroveAlert>
                }

                @if (_diagnostics.Length > 0)
                {
                    <ul class="grove-template-diagnostics" data-testid="templates-diagnostics">
                        @foreach (var diagnostic in _diagnostics)
                        {
                            <li><code>@diagnostic.Path</code> @diagnostic.Reason</li>
                        }
                    </ul>
                }

                <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                    <GroveTextBox @bind-Value="_previewItemId" Placeholder="@T["Content item id (optional)"]" />
                    <GroveButton Text="@T["Preview"]" Icon="visibility" ButtonStyle="ButtonStyle.Light" Click="PreviewAsync" data-testid="templates-preview" />
                </GroveStack>

                @if (_preview is not null)
                {
                    <div class="grove-display grove-template-preview" data-testid="templates-preview-tree">
                        <DisplayTreeRenderer @key="_previewVersion" Node="_preview.Root" />
                    </div>
                }
            </GroveStack>
        </GroveCard>
    }

    <GroveCard data-testid="templates-overrides">
        <GroveStack Gap="0.75rem">
            <GroveText TextStyle="TextStyle.H6" Text="@T["Variants and placement overrides"]" />
            <GroveText TextStyle="TextStyle.Caption" Text="@T["A variant saves a configured component under its own name; templates place it like a component. A placement override sets values for one node. Values bound to data are never overridden."]" />
            @foreach (var variant in _overrides?.Variants ?? [])
            {
                <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                    <strong>@variant.Name</strong> <span>← @variant.Base</span> <code>@variant.Values.ToJsonString()</code>
                    <GroveButton Icon="edit" ButtonStyle="ButtonStyle.Light" Click="@(() => EditVariant(variant))" />
                    <GroveButton Icon="delete" ButtonStyle="ButtonStyle.Light" Click="@(() => DeleteVariantAsync(variant.Name))" />
                </GroveStack>
            }
            <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <GroveTextBox @bind-Value="_variantName" Placeholder="@T["Variant name"]" data-testid="variant-name" />
                <GroveTextBox @bind-Value="_variantBase" Placeholder="@T["Base component"]" />
                <GroveTextBox @bind-Value="_variantDisplayName" Placeholder="@T["Display name"]" />
            </GroveStack>
            <GroveTextArea @bind-Value="_variantValues" Rows="3" Placeholder='{ "Size": "H2" }' Style="font-family: var(--grove-font-mono, monospace);" />
            <GroveButton Text="@T["Save variant"]" Icon="save" Click="SaveVariantAsync" data-testid="variant-save" />

            @foreach (var instance in _overrides?.Instances ?? [])
            {
                <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                    <code>@instance.InstanceId</code> <code>@instance.Values.ToJsonString()</code>
                    <GroveButton Icon="delete" ButtonStyle="ButtonStyle.Light" Click="@(() => DeleteInstanceAsync(instance.InstanceId))" />
                </GroveStack>
            }
            <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <GroveTextBox @bind-Value="_instanceId" Placeholder="@T["Node instance id"]" />
                <GroveTextBox @bind-Value="_instanceValues" Placeholder='{ "Text": "Hello" }' />
                <GroveButton Text="@T["Save placement override"]" Icon="save" Click="SaveInstanceAsync" />
            </GroveStack>
        </GroveStack>
    </GroveCard>

    <GroveDataGrid Data="@_items" TItem="Template" data-testid="templates-grid">
        <Columns>
            <GroveDataGridColumn TItem="Template" Property="Name" Title="@T["Name"]" />
            <GroveDataGridColumn TItem="Template" Property="Theme" Title="@T["Theme"]" />
            <GroveDataGridColumn TItem="Template" Property="DisplayType" Title="@T["Display type"]" />
            <GroveDataGridColumn TItem="Template" Title="@T["Status"]">
                <Template Context="template">@(template.Published ? (template.HasDraft ? T["Published, draft pending"] : T["Published"]) : T["Draft"])</Template>
            </GroveDataGridColumn>
            <GroveDataGridColumn TItem="Template" Title="@T["Actions"]">
                <Template Context="template"><GroveButton Icon="edit" ButtonStyle="ButtonStyle.Light" Click="@(() => Edit(template))" /></Template>
            </GroveDataGridColumn>
        </Columns>
    </GroveDataGrid>
</GroveStack>

@code {
    private Template[] _items = [];
    private Editing? _editing;
    private DisplayDiagnostic[] _diagnostics = [];
    private string? _message;
    private string? _previewItemId;
    private DisplayTree? _preview;
    private int _previewVersion;

    private GroveComponentOverrides? _overrides;
    private string? _variantName;
    private string? _variantBase;
    private string? _variantDisplayName;
    private string? _variantValues = "{}";
    private string? _instanceId;
    private string? _instanceValues = "{}";

    protected override async Task OnInitializedAsync()
    {
        _items = await Api.Grove.Rest.Templates.ListAsync();
        _overrides = await Api.Grove.Rest.Templates.GetOverridesAsync();
    }

    private void EditVariant(GroveComponentVariant variant)
    {
        (_variantName, _variantBase, _variantDisplayName) = (variant.Name, variant.Base, variant.DisplayName);
        _variantValues = variant.Values.ToJsonString();
    }

    private async Task SaveVariantAsync() =>
        await AfterOverrideAsync(await Api.Grove.Rest.Templates.SaveVariantAsync(new GroveComponentVariant(_variantName ?? string.Empty, _variantBase ?? string.Empty, _variantDisplayName, null, null, ParseObject(_variantValues))));

    private async Task DeleteVariantAsync(string name) => await AfterOverrideAsync(await Api.Grove.Rest.Templates.DeleteVariantAsync(name));

    private async Task SaveInstanceAsync() =>
        await AfterOverrideAsync(await Api.Grove.Rest.Templates.SaveInstanceOverrideAsync(new GroveInstanceOverride(_instanceId ?? string.Empty, ParseObject(_instanceValues))));

    private async Task DeleteInstanceAsync(string instanceId) => await AfterOverrideAsync(await Api.Grove.Rest.Templates.DeleteInstanceOverrideAsync(instanceId));

    private async Task AfterOverrideAsync(LayersResult result)
    {
        _message = result.Succeeded ? T["Saved."] : string.Join(" ", result.Errors);
        _diagnostics = [];
        _overrides = await Api.Grove.Rest.Templates.GetOverridesAsync();
    }

    private static System.Text.Json.Nodes.JsonObject ParseObject(string? json)
    {
        try
        {
            return System.Text.Json.Nodes.JsonNode.Parse(string.IsNullOrWhiteSpace(json) ? "{}" : json) as System.Text.Json.Nodes.JsonObject ?? [];
        }
        catch (System.Text.Json.JsonException)
        {
            return [];
        }
    }

    private void New() => Open(new Editing());

    private void Edit(Template template) => Open(new Editing
    {
        Id = template.Id,
        Name = template.Name,
        Theme = template.Theme,
        DisplayType = template.DisplayType,
        Description = template.Description,
        Source = template.Source,
        IsComposite = template.IsComposite,
        DisplayName = template.DisplayName,
        Category = template.Category,
        Icon = template.Icon,
        Inputs = template.Inputs?.ToJsonString() ?? "[]",
        Outputs = template.Outputs?.ToJsonString() ?? "[]",
    });

    private void Open(Editing editing)
    {
        _editing = editing;
        _diagnostics = [];
        _message = null;
        _preview = null;
    }

    private void Close() => _editing = null;

    private TemplateWrite Write() => new(
        _editing!.Name ?? string.Empty, _editing.Theme, _editing.DisplayType, _editing.Description, _editing.Source,
        _editing.IsComposite, _editing.DisplayName, _editing.Category, _editing.Icon,
        Parse(_editing.Inputs), Parse(_editing.Outputs));

    // A malformed list is sent as empty; the server reports what the template then lacks.
    private static System.Text.Json.Nodes.JsonArray? Parse(string? json)
    {
        try
        {
            return System.Text.Json.Nodes.JsonNode.Parse(string.IsNullOrWhiteSpace(json) ? "[]" : json) as System.Text.Json.Nodes.JsonArray;
        }
        catch (System.Text.Json.JsonException)
        {
            return null;
        }
    }

    private async Task ValidateAsync()
    {
        var result = await Api.Grove.Rest.Templates.ValidateAsync(Write());
        Show(result, T["The template is valid."]);
    }

    private async Task SaveAsync()
    {
        var result = await Api.Grove.Rest.Templates.SaveAsync(_editing!.Id, Write());
        if (result.Template is { } saved)
        {
            _editing.Id = saved.Id;
            Show(new TemplateValidation(true, []), T["Draft saved."]);
            _items = await Api.Grove.Rest.Templates.ListAsync();
        }
        else
        {
            Show(result.Validation, T["The draft was not saved."]);
        }
    }

    private async Task PublishAsync()
    {
        var result = await Api.Grove.Rest.Templates.PublishAsync(_editing!.Id!);
        Show(result, T["Published."]);
        _items = await Api.Grove.Rest.Templates.ListAsync();
    }

    private async Task DeleteAsync()
    {
        if (await Api.Grove.Rest.Templates.DeleteAsync(_editing!.Id!))
        {
            _editing = null;
            _items = await Api.Grove.Rest.Templates.ListAsync();
        }
    }

    private async Task PreviewAsync()
    {
        _preview = await Api.Grove.Rest.Templates.PreviewAsync(new(_editing!.Name ?? string.Empty, _editing.Source ?? string.Empty, string.IsNullOrWhiteSpace(_previewItemId) ? null : _previewItemId.Trim(), null));
        _previewVersion++;
        _message = _preview is null ? T["The preview could not be built."] : null;
    }

    private void Show(TemplateValidation? result, string success)
    {
        _diagnostics = result?.Diagnostics ?? [];
        _message = result is null ? T["The server refused the request."] : result.Valid ? success : T["The template has problems:"];
    }

    private sealed class Editing
    {
        public string? Id { get; set; }

        public string? Name { get; set; }

        public string? Theme { get; set; }

        public string? DisplayType { get; set; }

        public string? Description { get; set; }

        public string? Source { get; set; }

        public bool IsComposite { get; set; }

        public string? DisplayName { get; set; }

        public string? Category { get; set; }

        public string? Icon { get; set; }

        public string? Inputs { get; set; } = "[]";

        public string? Outputs { get; set; } = "[]";
    }
}

@page "/Settings/userRegistration"
@page "/Settings/userResetPassword"
@page "/Settings/userChangeEmail"
@attribute [PageEntry("ManageUsers", Route = "/Settings/userRegistration", Id = "user-registration", Parent = "settings-security", Caption = "Registration")]
@attribute [PageEntry("ManageUsers", Route = "/Settings/userResetPassword", Id = "user-reset-password", Parent = "settings-security", Caption = "Reset Password")]
@attribute [PageEntry("ManageUsers", Route = "/Settings/userChangeEmail", Id = "user-change-email", Parent = "settings-security", Caption = "Change Email")]
@using System.Net.Http.Json
@using Grove.Components.Primitives
@inject HttpClient Http
@inject NavigationManager Navigation
@inject Grove.Components.Theme.GroveApiLocalizer T

@* Settings › Users (Grove.Users): registration, password reset and email change - the
   userRegistration, userResetPassword and userChangeEmail settings groups, one route each. *@
<GroveStack Gap="1rem" data-testid="user-settings-page">
    <GroveText TextStyle="TextStyle.H4" Text="@Title" />
    @if (Error is { } error) { <GroveAlert AlertStyle="AlertStyle.Danger" AllowClose="false">@error</GroveAlert> }
    <GroveCard>
        @if (!Loaded)
        {
            <GroveProgressBar Mode="ProgressBarMode.Indeterminate" />
        }
        else if (Section == "registration" && Registration is not null)
        {
            <GroveStack Gap="0.5rem">
                <div><GroveCheckBox @bind-Value="Registration.UsersMustValidateEmail" Name="reg-validate" /><label for="reg-validate"> @T["Users must confirm their email address"]</label></div>
                <div><GroveCheckBox @bind-Value="Registration.UsersAreModerated" Name="reg-moderated" /><label for="reg-moderated"> @T["New users are disabled until an administrator enables them"]</label></div>
                <div><GroveCheckBox @bind-Value="Registration.UseSiteTheme" Name="reg-theme" /><label for="reg-theme"> @T["Show the registration page in the site theme"]</label></div>
                <GroveText TextStyle="TextStyle.Subtitle2" Text="@T["External sign-up"]" />
                <div><GroveCheckBox @bind-Value="Registration.External.DisableNewRegistrations" Name="ext-disable" /><label for="ext-disable"> @T["No new registrations through external sign-in"]</label></div>
                <div><GroveCheckBox @bind-Value="Registration.External.NoUsername" Name="ext-nouser" /><label for="ext-nouser"> @T["Don't ask for a user name"]</label></div>
                <div><GroveCheckBox @bind-Value="Registration.External.NoEmail" Name="ext-noemail" /><label for="ext-noemail"> @T["Don't ask for an email address"]</label></div>
                <div><GroveCheckBox @bind-Value="Registration.External.NoPassword" Name="ext-nopassword" /><label for="ext-nopassword"> @T["Don't ask for a password"]</label></div>
                <div><GroveCheckBox @bind-Value="Registration.External.UseScriptToGenerateUsername" Name="ext-script" /><label for="ext-script"> @T["Generate the user name with a script"]</label></div>
                @if (Registration.External.UseScriptToGenerateUsername)
                {
                    <GroveTextArea @bind-Value="Registration.External.GenerateUsernameScript" Rows="6" Style="width: 100%; font-family: monospace" />
                }
            </GroveStack>
        }
        else if (Section == "reset-password" && ResetPassword is not null)
        {
            <div><GroveCheckBox @bind-Value="ResetPassword.AllowResetPassword" Name="reset-allow" /><label for="reset-allow"> @T["Users can reset a forgotten password"]</label></div>
            <div><GroveCheckBox @bind-Value="ResetPassword.UseSiteTheme" Name="reset-theme" /><label for="reset-theme"> @T["Show the reset pages in the site theme"]</label></div>
        }
        else if (ChangeEmail is not null)
        {
            <div><GroveCheckBox @bind-Value="ChangeEmail.AllowChangeEmail" Name="change-email-allow" /><label for="change-email-allow"> @T["Users can change their email address"]</label></div>
        }
    </GroveCard>
    <div><GroveButton Text="@T["Save settings"]" Icon="save" Click="SaveAsync" Disabled="@(!Loaded || Busy)" data-testid="user-settings-save" /></div>
    @if (Saved) { <GroveText TextStyle="TextStyle.Body2">@T["Saved."]</GroveText> }
</GroveStack>

@code {
    private const string Api = "api/grove/settings/users";

    private string Section = "registration";
    private RegistrationModel? Registration;
    private ResetPasswordModel? ResetPassword;
    private ChangeEmailModel? ChangeEmail;
    private bool Loaded;
    private bool Busy;
    private bool Saved;
    private string? Error;

    private string Title => Section switch
    {
        "reset-password" => T["Reset password"],
        "change-email" => T["Change email"],
        _ => T["User registration"],
    };

    protected override async Task OnParametersSetAsync()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        Section = path.Contains("userResetPassword", StringComparison.OrdinalIgnoreCase) ? "reset-password"
            : path.Contains("userChangeEmail", StringComparison.OrdinalIgnoreCase) ? "change-email"
            : "registration";
        Loaded = false;
        Saved = false;
        try
        {
            switch (Section)
            {
                case "reset-password": ResetPassword = await Http.GetFromJsonAsync<ResetPasswordModel>($"{Api}/{Section}"); break;
                case "change-email": ChangeEmail = await Http.GetFromJsonAsync<ChangeEmailModel>($"{Api}/{Section}"); break;
                default: Registration = await Http.GetFromJsonAsync<RegistrationModel>($"{Api}/{Section}"); break;
            }

            Loaded = true;
        }
        catch (Exception exception) { Error = exception.Message; }
    }

    private async Task SaveAsync()
    {
        Busy = true;
        Error = null;
        try
        {
            object? body = Section switch { "reset-password" => ResetPassword, "change-email" => ChangeEmail, _ => Registration };
            using var response = await Http.PutAsJsonAsync($"{Api}/{Section}", body);
            if (!response.IsSuccessStatusCode) { Error = await response.Content.ReadAsStringAsync(); return; }
            Saved = true;
        }
        finally { Busy = false; }
    }

    private sealed class ExternalModel
    {
        public bool DisableNewRegistrations { get; set; }
        public bool NoPassword { get; set; }
        public bool NoUsername { get; set; }
        public bool NoEmail { get; set; }
        public bool UseScriptToGenerateUsername { get; set; }
        public string? GenerateUsernameScript { get; set; }
    }

    private sealed class RegistrationModel
    {
        public bool UsersMustValidateEmail { get; set; }
        public bool UsersAreModerated { get; set; }
        public bool UseSiteTheme { get; set; }
        public ExternalModel External { get; set; } = new();
    }

    private sealed class ResetPasswordModel
    {
        public bool AllowResetPassword { get; set; }
        public bool UseSiteTheme { get; set; }
    }

    private sealed class ChangeEmailModel
    {
        public bool AllowChangeEmail { get; set; }
    }
}

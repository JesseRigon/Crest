@page "/Queries/Index"
@attribute [PageEntry("ManageQueries", Id = "searchallqueries", Parent = "queries", Caption = "All Queries", Position = "1")]
@using System.Text.Json
@using System.Text.Json.Nodes
@using Grove.AdminTheme.Api
@using Grove.Components.Primitives
@using Grove.Components.Primitives
@inject IApi Api
@inject NotificationService Notifications
@inject Grove.Components.Theme.GroveApiLocalizer T

<GroveStack Gap="1rem" data-testid="queries-page">
    <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
        <GroveStack Gap="0.25rem">
            <GroveText TextStyle="TextStyle.H4" Text="@T["Queries"]" />
            <GroveText TextStyle="TextStyle.Body2" Text="@T["Manage queries through the query sources enabled for this tenant."]" />
        </GroveStack>
        <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <GroveButton Text="@T["Refresh"]" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="LoadAsync" Disabled="@IsBusy" />
            <GroveButton Text="@T["Delete selected ({0})", SelectedQueryNames.Count]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="ConfirmDeleteSelected" Disabled="@(SelectedQueryNames.Count == 0 || IsBusy)" />
            <GroveButton Text="@T["New query"]" Icon="add" Click="NewQuery" Disabled="@(Catalog.Sources.Length == 0 || IsBusy)" />
        </GroveStack>
    </GroveStack>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <GroveAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</GroveAlert>
    }

    <GroveCard>
        <GroveRow AlignItems="AlignItems.End" Gap="0.75rem">
            <GroveColumn Size="12" SizeMD="6"><GroveFormField Text="@T["Search"]" Style="width: 100%;"><GroveTextBox @bind-Value="Search" Placeholder="@T["Search query names"]" Style="width: 100%;" /></GroveFormField></GroveColumn>
            <GroveColumn Size="12" SizeMD="3"><GroveButton Text="@T["Search"]" Icon="search" ButtonStyle="ButtonStyle.Light" Click="LoadAsync" Disabled="@IsBusy" /></GroveColumn>
        </GroveRow>
    </GroveCard>

    @if (Editing)
    {
        <GroveCard data-testid="query-editor">
            <GroveStack Gap="1rem">
                <GroveText TextStyle="TextStyle.H5" Text="@(EditingName is null ? T["New query"] : T["Edit {0}", EditingName])" />
                <GroveAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">
                    @T["The source and metadata are provider-neutral. Provider modules may store any metadata shape in the JSON object below."]
                </GroveAlert>
                @if (!string.IsNullOrWhiteSpace(EditorError))
                {
                    <GroveAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@EditorError</GroveAlert>
                }
                <GroveRow Gap="1rem">
                    <GroveColumn Size="12" SizeMD="6"><GroveFormField Text="@T["Name"]" Style="width: 100%;"><GroveTextBox @bind-Value="DraftName" Style="width: 100%;" /></GroveFormField></GroveColumn>
                    <GroveColumn Size="12" SizeMD="6"><GroveFormField Text="@T["Source"]" Style="width: 100%;"><GroveDropDown @bind-Value="DraftSource" Data="@Catalog.Sources" Style="width: 100%;" /></GroveFormField></GroveColumn>
                    <GroveColumn Size="12"><GroveFormField Text="@T["Result schema (optional)"]" Style="width: 100%;"><GroveTextBox @bind-Value="DraftSchema" Style="width: 100%;" /></GroveFormField></GroveColumn>
                </GroveRow>
                <GroveCheckBox @bind-Value="DraftReturnContentItems" Name="return-content-items" /> <span>@T["Return Content Items"]</span>
                <GroveFormField Text="@T["Provider metadata (JSON object)"]" Style="width: 100%;"><GroveTextArea @bind-Value="DraftProperties" Rows="14" Style="width: 100%; font-family: var(--rz-code-font-family, monospace);" /></GroveFormField>
                <GroveStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <GroveButton Text="@T["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="CancelEdit" Disabled="@IsBusy" />
                    <GroveButton Text="@T["Save"]" Icon="save" Click="SaveAsync" Disabled="@IsBusy" />
                </GroveStack>
            </GroveStack>
        </GroveCard>
    }

    @if (DeletingNames.Length > 0)
    {
        <GroveAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
            <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
                <span>@(DeletingNames.Length == 1 ? T["Delete query {0}? This cannot be undone.", DeletingNames[0]] : T["Delete {0} selected queries? This cannot be undone.", DeletingNames.Length])</span>
                <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem"><GroveButton Text="@T["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="CancelDelete" /><GroveButton Text="@T["Delete"]" ButtonStyle="ButtonStyle.Danger" Click="DeleteAsync" Disabled="@IsBusy" /></GroveStack>
            </GroveStack>
        </GroveAlert>
    }

    <GroveCard>
        @if (IsLoading)
        {
            <GroveProgressBar Mode="ProgressBarMode.Indeterminate" />
        }
        else if (Catalog.Queries.Length == 0)
        {
            <GroveText TextStyle="TextStyle.Body2" Text="@T["No queries match this filter."]" />
        }
        else
        {
            <GroveDataGrid Data="@Catalog.Queries" TItem="GroveQuery" AllowPaging="true" PageSize="20">
                <Columns>
                    <GroveDataGridColumn TItem="GroveQuery" Width="3.5rem" Sortable="false" Filterable="false"><HeaderTemplate><GroveCheckBox Value="@(Catalog.Queries.Length > 0 && Catalog.Queries.All(query => SelectedQueryNames.Contains(query.Name)))" Change="@((bool value) => ToggleAll(value))" Name="select-all-queries" /></HeaderTemplate><Template Context="query"><GroveCheckBox Value="@SelectedQueryNames.Contains(query.Name)" Change="@((bool value) => ToggleSelection(query.Name, value))" Name="@($"query-{query.Name}")" /></Template></GroveDataGridColumn>
                    <GroveDataGridColumn TItem="GroveQuery" Property="Name" Title="@T["Name"]" />
                    <GroveDataGridColumn TItem="GroveQuery" Property="Source" Title="@T["Source"]" />
                    <GroveDataGridColumn TItem="GroveQuery" Property="Schema" Title="@T["Schema"]"><Template Context="query">@(string.IsNullOrWhiteSpace(query.Schema) ? "—" : query.Schema)</Template></GroveDataGridColumn>
                    <GroveDataGridColumn TItem="GroveQuery" Title="@T["Result"]"><Template Context="query">@(query.ReturnContentItems ? T["Content Items"] : T["Documents"])</Template></GroveDataGridColumn>
                    <GroveDataGridColumn TItem="GroveQuery" Title="@T["Actions"]" Width="10rem"><Template Context="query"><GroveStack Orientation="Orientation.Horizontal" Gap="0.25rem"><GroveButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => Edit(query))" title="@T["Edit"]" /><GroveButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="@(() => ConfirmDelete(query.Name))" title="@T["Delete"]" /></GroveStack></Template></GroveDataGridColumn>
                </Columns>
            </GroveDataGrid>
        }
    </GroveCard>
</GroveStack>

@code {
    private QueryCatalog Catalog { get; set; } = QueryCatalog.Empty;
    private string? Search { get; set; }
    private bool IsLoading { get; set; }
    private bool IsSaving { get; set; }
    private bool IsBusy => IsLoading || IsSaving;
    private string? ErrorMessage { get; set; }
    private bool Editing { get; set; }
    private string? EditingName { get; set; }
    private string DraftName { get; set; } = string.Empty;
    private string DraftSource { get; set; } = string.Empty;
    private string? DraftSchema { get; set; }
    private bool DraftReturnContentItems { get; set; }
    private string DraftProperties { get; set; } = "{}";
    private string? EditorError { get; set; }
    private HashSet<string> SelectedQueryNames { get; } = new(StringComparer.OrdinalIgnoreCase);
    private string[] DeletingNames { get; set; } = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try { Catalog = await Api.Grove.Rest.Queries.ListAsync(Search); }
        catch (Exception exception) { ErrorMessage = exception.Message; }
        finally { IsLoading = false; }
    }

    private void NewQuery()
    {
        Editing = true;
        EditingName = null;
        DraftName = string.Empty;
        DraftSource = Catalog.Sources.FirstOrDefault() ?? string.Empty;
        DraftSchema = null;
        DraftReturnContentItems = false;
        DraftProperties = "{}";
        EditorError = null;
    }

    private void Edit(GroveQuery query)
    {
        Editing = true;
        EditingName = query.Name;
        DraftName = query.Name;
        DraftSource = query.Source;
        DraftSchema = query.Schema;
        DraftReturnContentItems = query.ReturnContentItems;
        DraftProperties = query.Properties.ToJsonString(new() { WriteIndented = true });
        EditorError = null;
    }

    private void CancelEdit() { Editing = false; EditorError = null; }
    private void ConfirmDelete(string name) => DeletingNames = [name];
    private void ConfirmDeleteSelected() => DeletingNames = SelectedQueryNames.ToArray();
    private void CancelDelete() => DeletingNames = [];
    private void ToggleSelection(string name, bool value)
    {
        if (value is true) SelectedQueryNames.Add(name);
        else SelectedQueryNames.Remove(name);
    }
    private void ToggleAll(bool value)
    {
        if (value is true) foreach (var query in Catalog.Queries) SelectedQueryNames.Add(query.Name);
        else SelectedQueryNames.Clear();
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(DraftName) || string.IsNullOrWhiteSpace(DraftSource)) { EditorError = T["A query name and source are required."]; return; }
        if (JsonNode.Parse(DraftProperties) is not JsonObject properties) { EditorError = T["Provider metadata must be a JSON object."]; return; }

        IsSaving = true;
        EditorError = null;
        try
        {
            var write = new QueryWrite(DraftName, DraftSource, DraftSchema, DraftReturnContentItems, properties);
            var saved = EditingName is null ? await Api.Grove.Rest.Queries.CreateAsync(write) : await Api.Grove.Rest.Queries.SaveAsync(EditingName, write);
            if (saved is null) { EditorError = T["The query could not be saved. Check the provider metadata and try again."]; return; }
            Notifications.Notify(NotificationSeverity.Success, T["Query saved"], T["{0} was saved.", saved.Name]);
            Editing = false;
            await LoadAsync();
        }
        catch (JsonException) { EditorError = T["Provider metadata must contain valid JSON."]; }
        catch (Exception exception) { EditorError = exception.Message; }
        finally { IsSaving = false; }
    }

    private async Task DeleteAsync()
    {
        if (DeletingNames.Length == 0) return;
        IsSaving = true;
        try
        {
            var deleted = DeletingNames.Length == 1
                ? await Api.Grove.Rest.Queries.DeleteAsync(DeletingNames[0])
                : await Api.Grove.Rest.Queries.DeleteManyAsync(DeletingNames);
            if (deleted)
            {
                Notifications.Notify(NotificationSeverity.Success, T["Queries deleted"], DeletingNames.Length == 1 ? T["1 query deleted."] : T["{0} queries deleted.", DeletingNames.Length]);
                foreach (var name in DeletingNames) SelectedQueryNames.Remove(name);
                DeletingNames = [];
                await LoadAsync();
            }
        }
        finally { IsSaving = false; }
    }
}

@page "/Profile"
@attribute [PageEntry("AccessAdminPanel")]
@using Grove.AdminTheme.State
@inject NavigationManager Navigation
@inject Grove.Components.Theme.GroveApiLocalizer T

<GroveStack Gap="1rem" class="profile-page" data-testid="profile-page">
    <div>
        <GroveText TextStyle="TextStyle.H4" Text="@UserName" />
        <GroveText TextStyle="TextStyle.Body2" Text="@T["Your account."]" />
    </div>

    <GroveCard>
        <GroveStack Gap="0.5rem">
            <GroveText TextStyle="TextStyle.Subtitle1" Text="@T["Account"]" />
            <div class="profile-page__field">
                <GroveText TextStyle="TextStyle.Caption" Text="@T["User Name"]" />
                <GroveText TextStyle="TextStyle.Body1" Text="@UserName" />
            </div>
        </GroveStack>
    </GroveCard>

    <GroveButton Text="@T["Settings"]" Icon="settings" ButtonStyle="ButtonStyle.Light" Click="@(() => Navigation.NavigateTo("Profile/Settings"))" />
</GroveStack>

@code {
    [CascadingParameter] public AdminShellState? AdminShellState { get; set; }

    private string UserName => AdminShellState?.User.UserName ?? T["User"];
}

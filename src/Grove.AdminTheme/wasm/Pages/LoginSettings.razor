@page "/Settings/userLogin"
@attribute [PageEntry("ManageUsers", Id = "user-login", Parent = "settings-security", Caption = "User Login")]
@using Grove.AdminTheme.Api
@using Grove.Components.Primitives
@using Grove.Components.Primitives
@inject IApi Api
@inject Grove.Components.Theme.GroveApiLocalizer T
@inject HttpClient Http

<GroveStack Gap="1rem" data-testid="login-settings-page">
    <GroveText TextStyle="TextStyle.H4" Text="@T["User Login Settings"]" />
    @if (Model is null)
    {
        <GroveProgressBar Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
        <GroveFieldset Text="@T["General"]">
            <GroveCheckBox @bind-Value="Model.AllowRememberMe" Name="allow-remember-me" /><label for="allow-remember-me"> @T["Allow user to be remembered during login"]</label><br />
            <GroveCheckBox @bind-Value="Model.AllowChangingUsername" Name="allow-changing-username" /><label for="allow-changing-username"> @T["Allow user to change their username"]</label><br />
            <GroveCheckBox @bind-Value="Model.AllowChangingEmail" Name="allow-changing-email" /><label for="allow-changing-email"> @T["Allow user to change their email address"]</label><br />
            <GroveCheckBox @bind-Value="Model.AllowChangingPhoneNumber" Name="allow-changing-phone" /><label for="allow-changing-phone"> @T["Allow user to change their phone number"]</label><br />
            <GroveCheckBox @bind-Value="Model.DisableLocalLogin" Name="disable-local-login" /><label for="disable-local-login"> @T["Disable local password login."]</label>
        </GroveFieldset>
        <GroveFieldset Text="@T["Two-Factor Authentication"]">
            <GroveCheckBox @bind-Value="Model.AllowRememberClientTwoFactorAuthentication" Name="remember-two-factor" /><label for="remember-two-factor"> @T["Allow users to remember client"]</label><br />
            <GroveCheckBox @bind-Value="Model.RequireTwoFactorAuthentication" Name="require-two-factor" /><label for="require-two-factor"> @T["Require two-factor authentication"]</label><br />
            <GroveLabel Text="@T["Number of recovery codes to generate"]" Component="recovery-codes" />
            <GroveNumeric @bind-Value="Model.NumberOfRecoveryCodesToGenerate" Name="recovery-codes" Min="1" />
        </GroveFieldset>
        @* A section per enabled two-factor method (api/grove/settings/login/two-factor). *@
        @if (TwoFactor?.Roles is { } roles)
        {
            <GroveFieldset Text="@T["Roles"]" data-testid="two-factor-roles">
                <GroveCheckBox @bind-Value="roles.RequireTwoFactorAuthenticationForSpecificRoles" Name="two-factor-roles" /><label for="two-factor-roles"> @T["Require two-factor authentication for specific roles"]</label>
                @if (roles.RequireTwoFactorAuthenticationForSpecificRoles)
                {
                    <div style="margin-top: .5rem">
                        <GroveText TextStyle="TextStyle.Caption" Text="@T["Select the roles to require two-factor authentication for."]" />
                        @foreach (var role in roles.AvailableRoles ?? [])
                        {
                            var id = $"two-factor-role-{role}";
                            <div><GroveCheckBox Value="@roles.Roles.Contains(role, StringComparer.OrdinalIgnoreCase)" Change="@((bool value) => ToggleRole(roles, role, value))" Name="@id" /><label for="@id"> @role</label></div>
                        }
                    </div>
                }
            </GroveFieldset>
        }
        @if (TwoFactor?.AuthenticatorApp is { } app)
        {
            <GroveFieldset Text="@T["Authenticator App Settings"]" data-testid="two-factor-authenticator-app">
                <GroveCheckBox @bind-Value="app.UseEmailAsAuthenticatorDisplayName" Name="authenticator-email" /><label for="authenticator-email"> @T["Show email address in the app"]</label><br />
                <GroveText TextStyle="TextStyle.Caption" Text="@T["When selected, the users will see their email address in the authenticator app. Otherwise, the username will be displayed."]" />
                <GroveLabel Text="@T["Token Length"]" Component="authenticator-token-length" />
                <GroveDropDown TValue="int" @bind-Value="app.TokenLength" Data="@TokenLengths" TextProperty="Text" ValueProperty="Value" Name="authenticator-token-length" Style="max-width: 16rem" />
                <GroveText TextStyle="TextStyle.Caption" Text="@T["The length token length that the authenticator app should generate. Default is 6."]" />
            </GroveFieldset>
        }
        @if (TwoFactor?.Email is { } email)
        {
            <GroveFieldset Text="@T["Email Authenticator Settings"]" data-testid="two-factor-email">
                <GroveLabel Text="@T["Email Subject"]" Component="email-authenticator-subject" />
                <GroveTextBox @bind-Value="email.Subject" Name="email-authenticator-subject" Style="width: 100%" />
                <GroveText TextStyle="TextStyle.Caption" Text="@T["The subject to the email for sending the verification code. Liquid syntax is supported."]" />
                <GroveLabel Text="@T["Email Body"]" Component="email-authenticator-body" />
                <GroveTextArea @bind-Value="email.Body" Name="email-authenticator-body" Rows="5" Style="width: 100%" />
                <GroveText TextStyle="TextStyle.Caption" Text="@T["The body to the email for sending the verification code. Liquid syntax is supported."]" />
            </GroveFieldset>
        }
        @if (TwoFactor?.Sms is { } sms)
        {
            <GroveFieldset Text="@T["SMS Authenticator Settings"]" data-testid="two-factor-sms">
                <GroveLabel Text="@T["Message Body"]" Component="sms-authenticator-body" />
                <GroveTextArea @bind-Value="sms.Body" Name="sms-authenticator-body" Rows="3" Style="width: 100%" />
                <GroveText TextStyle="TextStyle.Caption" Text="@T["The body to the message for sending the verification code. Liquid syntax is supported."]" />
            </GroveFieldset>
        }
        <GroveFieldset Text="@T["External Login"]">
            <GroveCheckBox @bind-Value="Model.UseExternalProviderIfOnlyOneDefined" Name="use-external-provider" /><label for="use-external-provider"> @T["Use external provider for login."]</label><br />
            <GroveCheckBox @bind-Value="Model.UseScriptToSyncProperties" Name="sync-external-properties" /><label for="sync-external-properties"> @T["Use a script to sync user properties from external provider claims"]</label>
            @if (Model.UseScriptToSyncProperties)
            {
                <GroveTextArea @bind-Value="Model.SyncPropertiesScript" Rows="16" Style="width:100%; margin-top: .75rem" Placeholder="@T["External login synchronization script"]" />
            }
        </GroveFieldset>
        <GroveButton Text="@T["Save"]" Icon="save" Click="SaveAsync" />
        @if (!string.IsNullOrWhiteSpace(Error)) { <GroveText TextStyle="TextStyle.Body2" Style="color: var(--rz-danger)">@Error</GroveText> }
    }
</GroveStack>

@code {
    private GroveLoginSettings? Model;
    private string? Error;

    private TwoFactorModel? TwoFactor;
    private readonly TokenLength[] TokenLengths = [new(6, "Six digits"), new(8, "Eight digits")];

    protected override async Task OnInitializedAsync()
    {
        Model = await Api.Grove.Rest.LoginSettings.GetAsync();
        try { TwoFactor = await Http.GetFromJsonAsync<TwoFactorModel>("api/grove/settings/login/two-factor"); }
        catch (HttpRequestException) { TwoFactor = null; }
    }

    private async Task SaveAsync()
    {
        if (Model is null) return;
        Error = null;
        var saved = await Api.Grove.Rest.LoginSettings.SaveAsync(Model);
        if (saved is null) { Error = T["The login settings could not be saved."]; return; }
        Model = saved;

        if (TwoFactor is { AuthenticatorApp: not null } or { Email: not null } or { Sms: not null } or { Roles: not null })
        {
            using var response = await Http.PutAsJsonAsync("api/grove/settings/login/two-factor", TwoFactor);
            if (!response.IsSuccessStatusCode) { Error = await response.Content.ReadAsStringAsync(); return; }
            TwoFactor = await response.Content.ReadFromJsonAsync<TwoFactorModel>();
        }
    }

    private sealed record TokenLength(int Value, string Text);
    private sealed class TwoFactorModel
    {
        public AuthenticatorAppModel? AuthenticatorApp { get; set; }
        public EmailModel? Email { get; set; }
        public SmsModel? Sms { get; set; }
        public RolesModel? Roles { get; set; }
    }

    private sealed class RolesModel
    {
        public bool RequireTwoFactorAuthenticationForSpecificRoles { get; set; }
        public string[] Roles { get; set; } = [];
        public string[]? AvailableRoles { get; set; }
    }

    private static void ToggleRole(RolesModel model, string role, bool selected) =>
        model.Roles = selected
            ? [.. model.Roles.Append(role).Distinct(StringComparer.OrdinalIgnoreCase)]
            : [.. model.Roles.Where(name => !string.Equals(name, role, StringComparison.OrdinalIgnoreCase))];

    private sealed class AuthenticatorAppModel { public bool UseEmailAsAuthenticatorDisplayName { get; set; } public int TokenLength { get; set; } = 6; }
    private sealed class EmailModel { public string? Subject { get; set; } public string? Body { get; set; } }
    private sealed class SmsModel { public string? Body { get; set; } }
}

@page "/Profile/Settings"
@attribute [PageEntry("AccessAdminPanel")]
@attribute [Grove.Components.Modules.SetsAuthenticationCookie]
@using Grove.AdminTheme.Api
@using Grove.AdminTheme.State
@using Grove.Components.Primitives
@inject IApi Api
@inject NotificationService Notifications
@inject Grove.Components.Theme.GroveApiLocalizer T

<GroveStack Gap="1rem" class="profile-settings-page" data-testid="profile-settings-page">
    <div>
        <GroveText TextStyle="TextStyle.H4" Text="@T["Settings"]" />
        <GroveText TextStyle="TextStyle.Body2" Text="@T["Preferences for your own account. These never affect other users or tenant-wide settings."]" />
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <GroveAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</GroveAlert>
    }

    <GroveCard>
        <GroveStack Gap="0.75rem">
            <GroveText TextStyle="TextStyle.Subtitle1" Text="@T["Localization"]" />
            <GroveText TextStyle="TextStyle.Body2" Text="@T["Your default language. This is used whenever you sign in, unless you switch languages temporarily from the culture picker in the title bar."]" />

            @if (IsLoading)
            {
                <GroveProgressBar Mode="ProgressBarMode.Indeterminate" />
            }
            else
            {
                <GroveDropDown TValue="string"
                                Data="CultureOptions"
                                Value="@SelectedCulture"
                                ValueChanged="SelectCultureAsync"
                                TextProperty="@nameof(CultureOption.Label)"
                                ValueProperty="@nameof(CultureOption.Value)"
                                Placeholder="@T["Use the tenant default"]"
                                AllowFiltering="true"
                                FilterPlaceholder="@T["Filter cultures"]"
                                class="profile-settings-page__culture-dropdown" />
                <GroveText TextStyle="TextStyle.Caption" Text="@T["Leave unset to follow the tenant's default culture."]" />
            }
        </GroveStack>
    </GroveCard>

    @* Password, email and external logins (step 7: the MVC account screens are retired). *@
    <GroveCard data-testid="profile-settings-account">
        <Grove.Components.Account.GroveAccountSecurity />
    </GroveCard>
</GroveStack>

@code {
    [CascadingParameter] public AdminShellState? AdminShellState { get; set; }

    private bool IsLoading { get; set; } = true;
    private bool IsSaving { get; set; }
    private string? ErrorMessage { get; set; }
    private string? SelectedCulture { get; set; }

    private CultureOption[] CultureOptions => AdminShellState?.Manifest?.CultureSelector.Cultures ?? [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var current = await Api.Grove.Rest.Localization.GetMyCultureAsync();
            SelectedCulture = current?.Culture;
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SelectCultureAsync(string? value)
    {
        if (IsSaving)
        {
            return;
        }

        IsSaving = true;
        ErrorMessage = null;
        try
        {
            var saved = await Api.Grove.Rest.Localization.SetMyCultureAsync(new UserCulture(value));
            if (saved is null)
            {
                throw new InvalidOperationException(T["Unable to save your default culture."]);
            }

            SelectedCulture = saved.Culture;
            Notifications.Notify(NotificationSeverity.Success, T["Settings"], T["Your default language was saved."]);
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }
}

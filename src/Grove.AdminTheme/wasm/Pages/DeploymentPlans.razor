@page "/DeploymentPlan/Index"
@attribute [PageEntry("ManageDeploymentPlan", Id = "deployment-plans", Parent = "deployments", Caption = "Plans", Position = "1")]
@using Grove.AdminTheme.Api
@using Grove.Components.Primitives
@inject IApi Api
@inject NavigationManager Navigation
@inject NotificationService Notifications
@inject Grove.Components.Theme.GroveApiLocalizer T

<GroveStack Gap="1rem" data-testid="deployment-plans-page">
    <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
        <GroveStack Gap="0.25rem">
            <GroveText TextStyle="TextStyle.H4" Text="@T["Deployment Plans"]" />
            <GroveText TextStyle="TextStyle.Body2" Text="@T["A plan is an ordered list of steps that export this tenant's data and settings as a package."]" />
        </GroveStack>
        <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <GroveButton Text="@T["Delete selected ({0})", Selected.Count]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="DeleteSelectedAsync" Disabled="@(Selected.Count == 0 || IsBusy)" />
            <GroveButton Text="@T["New plan"]" Icon="add" Click="@(() => { Creating = true; DraftName = string.Empty; Error = null; })" Disabled="@IsBusy" />
        </GroveStack>
    </GroveStack>

    @if (Error is not null)
    {
        <GroveAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@Error</GroveAlert>
    }

    @if (Creating)
    {
        <GroveCard>
            <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.75rem">
                <GroveFormField Text="@T["Name"]" Style="flex: 1;"><GroveTextBox @bind-Value="DraftName" Style="width: 100%;" /></GroveFormField>
                <GroveButton Text="@T["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="@(() => Creating = false)" Disabled="@IsBusy" />
                <GroveButton Text="@T["Create"]" Icon="save" Click="CreateAsync" Disabled="@IsBusy" />
            </GroveStack>
        </GroveCard>
    }

    <GroveCard>
        <GroveRow AlignItems="AlignItems.End" Gap="0.75rem">
            <GroveColumn Size="12" SizeMD="6"><GroveFormField Text="@T["Search"]" Style="width: 100%;"><GroveTextBox @bind-Value="Search" Placeholder="@T["Search plan names"]" Style="width: 100%;" /></GroveFormField></GroveColumn>
            <GroveColumn Size="12" SizeMD="3"><GroveButton Text="@T["Search"]" Icon="search" ButtonStyle="ButtonStyle.Light" Click="LoadAsync" Disabled="@IsBusy" /></GroveColumn>
        </GroveRow>
    </GroveCard>

    <GroveCard>
        @if (Plans is null)
        {
            <GroveProgressBar Mode="ProgressBarMode.Indeterminate" />
        }
        else if (Plans.Length == 0)
        {
            <GroveText TextStyle="TextStyle.Body2" Text="@T["No deployment plans match this filter."]" />
        }
        else
        {
            <GroveDataGrid Data="@Plans" TItem="GroveDeploymentPlan" AllowPaging="true" PageSize="20">
                <Columns>
                    <GroveDataGridColumn TItem="GroveDeploymentPlan" Width="3.5rem" Sortable="false" Filterable="false"><Template Context="plan"><GroveCheckBox Value="@Selected.Contains(plan.Id)" Change="@((bool value) => { if (value) Selected.Add(plan.Id); else Selected.Remove(plan.Id); })" Name="@($"plan-{plan.Id}")" /></Template></GroveDataGridColumn>
                    <GroveDataGridColumn TItem="GroveDeploymentPlan" Property="Name" Title="@T["Name"]"><Template Context="plan"><a href="@($"DeploymentPlan/Display/{plan.Id}")">@plan.Name</a></Template></GroveDataGridColumn>
                    <GroveDataGridColumn TItem="GroveDeploymentPlan" Property="StepCount" Title="@T["Steps"]" Width="8rem" />
                    <GroveDataGridColumn TItem="GroveDeploymentPlan" Title="@T["Actions"]" Width="12rem"><Template Context="plan"><GroveStack Orientation="Orientation.Horizontal" Gap="0.25rem"><GroveButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => Navigation.NavigateTo($"DeploymentPlan/Display/{plan.Id}"))" title="@T["Open"]" /><GroveButton Icon="download" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => DeploymentDownload.SaveAsync(Api, Js, plan.Id, Notifications, T))" title="@T["Download package"]" /></GroveStack></Template></GroveDataGridColumn>
                </Columns>
            </GroveDataGrid>
        }
    </GroveCard>
</GroveStack>

@code {
    [Inject] private IJSRuntime Js { get; set; } = default!;

    private GroveDeploymentPlan[]? Plans { get; set; }
    private HashSet<long> Selected { get; } = [];
    private string? Search { get; set; }
    private bool IsBusy { get; set; }
    private bool Creating { get; set; }
    private string DraftName { get; set; } = string.Empty;
    private string? Error { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() => Plans = await Api.Grove.Rest.Deployment.ListPlansAsync(Search);

    private async Task CreateAsync()
    {
        IsBusy = true;
        Error = null;
        try
        {
            var result = await Api.Grove.Rest.Deployment.CreatePlanAsync(DraftName);
            if (!result.Succeeded) { Error = result.Message ?? T["The plan could not be created."]; return; }
            Navigation.NavigateTo($"DeploymentPlan/Display/{result.Message}");
        }
        finally { IsBusy = false; }
    }

    private async Task DeleteSelectedAsync()
    {
        IsBusy = true;
        try
        {
            if (await Api.Grove.Rest.Deployment.DeletePlansAsync(Selected.ToArray()))
            {
                Notifications.Notify(NotificationSeverity.Success, T["Deployment Plans"], T["{0} plans deleted.", Selected.Count]);
                Selected.Clear();
            }
            else Error = T["The selected plans could not be deleted."];
            await LoadAsync();
        }
        finally { IsBusy = false; }
    }
}

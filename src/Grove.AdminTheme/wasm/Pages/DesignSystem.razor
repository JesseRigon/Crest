@page "/DesignSystem"
@attribute [PageEntry("ManageSettings", Id = "design-system", Parent = "design", Caption = "Design System", Icon = "@iconify:mdi:palette")]
@using Grove.AdminTheme.Api
@using Grove.AdminTheme.Components.Admin
@using Grove.AdminTheme.State
@using Grove.Components.Primitives
@using Grove.Components.Primitives
@inject AdminShellState AdminShellState
@inject NotificationService Notifications
@inject Grove.Components.Theme.GroveApiLocalizer T

    <GroveStack Gap="1rem">
        <GroveStack Gap="0.25rem">
            <GroveText TextStyle="TextStyle.H4" Text="@T["Design System"]" />
            <GroveText TextStyle="TextStyle.Body2" Text="@T["Edit the design tokens for this site."]" />
        </GroveStack>

        <GroveCard>
            <GroveTemplateForm TItem="DesignSystemModel" Data="@Model" Submit="SaveAsync">
                <GroveStack Gap="1rem">
                    <GroveRow Gap="1rem">
                        <GroveColumn Size="12" SizeMD="6">
                            <GroveLabel Text="@T["Base theme"]" />
                            <GroveDropDown TValue="string" Data="@RadzenThemes" @bind-Value="Model.RadzenTheme" Style="width: 100%;" />
                        </GroveColumn>
                        <GroveColumn Size="12" SizeMD="6">
                            <GroveLabel Text="@T["Border radius"]" />
                            <GroveTextBox @bind-Value="Model.Radius" Placeholder="6px" Style="width: 100%;" />
                        </GroveColumn>
                    </GroveRow>

                    <GroveRow Gap="1rem">
                        <GroveColumn Size="12" SizeMD="3">
                            <GroveLabel Text="@T["Accent 1"]" />
                            <GroveColorPicker @bind-Value="Model.Primary" Style="width: 100%;" ShowRGBA="false" ShowColors="true" />
                        </GroveColumn>
                        <GroveColumn Size="12" SizeMD="3">
                            <GroveLabel Text="@T["Accent 2"]" />
                            <GroveColorPicker @bind-Value="Model.Secondary" Style="width: 100%;" ShowRGBA="false" ShowColors="true" />
                        </GroveColumn>
                        <GroveColumn Size="12" SizeMD="3">
                            <GroveLabel Text="@T["Surface 1"]" />
                            <GroveColorPicker @bind-Value="Model.Surface" Style="width: 100%;" ShowRGBA="false" ShowColors="true" />
                        </GroveColumn>
                        <GroveColumn Size="12" SizeMD="3">
                            <GroveLabel Text="@T["Surface 2"]" />
                            <GroveColorPicker @bind-Value="Model.Background" Style="width: 100%;" ShowRGBA="false" ShowColors="true" />
                        </GroveColumn>
                    </GroveRow>

                    <div class="design-system-preview">
                        <GroveText TextStyle="TextStyle.H6" Text="@T["Preview"]" />
                        <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" Style="flex-wrap: wrap;">
                            <GroveButton Text="@T["Primary Action"]" ButtonStyle="ButtonStyle.Primary" />
                            <GroveButton Text="@T["Secondary Action"]" ButtonStyle="ButtonStyle.Secondary" />
                            <GroveButton Text="@T["Light Action"]" ButtonStyle="ButtonStyle.Light" />
                        </GroveStack>
                    </div>

                    <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                        <GroveButton Text="@T["Save"]" Icon="save" ButtonType="ButtonType.Submit" Disabled="@AdminShellState.IsBusy" />
                        <GroveButton Text="@T["Reset defaults"]" Icon="restart_alt" ButtonStyle="ButtonStyle.Light" Click="ResetDefaults" ButtonType="ButtonType.Button" Disabled="@AdminShellState.IsBusy" />
                    </GroveStack>
                </GroveStack>
            </GroveTemplateForm>
        </GroveCard>
    </GroveStack>

@code {
    private static readonly string[] RadzenThemes =
    [
        "material-base",
        "material-dark-base",
        "standard-base",
        "standard-dark-base",
        "default",
        "dark",
        "software",
        "humanistic"
    ];

    private DesignSystemModel Model { get; set; } = new();

    protected override void OnInitialized()
    {
        Model = DesignSystemModel.From(AdminShellState.Theme);
    }

    private async Task SaveAsync()
    {
        var saved = await AdminShellState.UpdateThemeAsync(Model.ToSettings());
        if (saved is not null)
        {
            Model = DesignSystemModel.From(saved);
            Notifications.Notify(NotificationSeverity.Success, T["Design system saved"], T["The tenant design tokens were updated."]);
        }
        else
        {
            Notifications.Notify(NotificationSeverity.Error, T["Design system save failed"], T["The server could not save the design tokens."]);
        }
    }

    private void ResetDefaults()
    {
        Model = DesignSystemModel.From(ThemeSettings.Default);
    }

    private sealed class DesignSystemModel
    {
        public string RadzenTheme { get; set; } = ThemeSettings.Default.RadzenTheme;
        public string Primary { get; set; } = "#2f6f4e";
        public string Secondary { get; set; } = "#6d5d3f";
        public string Surface { get; set; } = "#ffffff";
        public string Background { get; set; } = "#f7f8f6";
        public string Radius { get; set; } = "6px";

        public static DesignSystemModel From(ThemeSettings settings) => new()
        {
            RadzenTheme = settings.RadzenTheme,
            Primary = Get(settings, "primary", "#2f6f4e"),
            Secondary = Get(settings, "secondary", "#6d5d3f"),
            Surface = Get(settings, "surface", "#ffffff"),
            Background = Get(settings, "background", "#f7f8f6"),
            Radius = Get(settings, "radius", "6px"),
        };

        public ThemeSettings ToSettings() => new(RadzenTheme, new(StringComparer.OrdinalIgnoreCase)
        {
            ["primary"] = Primary,
            ["secondary"] = Secondary,
            ["surface"] = Surface,
            ["background"] = Background,
            ["radius"] = Radius,
        });

        private static string Get(ThemeSettings settings, string key, string fallback) =>
            settings.Tokens.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value) ? value : fallback;
    }
}

@page "/Roles/Index"
@attribute [PageEntry("ReadRoles", Id = "roles", Parent = "accessControl", Caption = "Roles", Icon = "@iconify:mdi:account-key")]
@using Grove.AdminTheme.Api
@using Grove.Components.Access
@inject IApi Api
@inject HttpClient Http
@inject Grove.Components.Theme.GroveApiLocalizer T

@* The role editor (docs/permissions.md › Layers, Editors): a role holds permission sets and
   loose permissions; one role name serves the tenant and every organization, what it yields
   depending on the reach and the ceilings. *@

<GroveStack Gap="1rem" data-testid="roles-page">
    <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Wrap="FlexWrap.Wrap">
        <GroveStack Gap="0.25rem">
            <GroveText TextStyle="TextStyle.H4" Text="@T["Roles"]" />
            <GroveText TextStyle="TextStyle.Body2" Text="@T["A role holds permission sets and loose permissions. Groups give roles to users."]" />
        </GroveStack>
        <GroveButton Text="@T["Refresh"]" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="LoadAsync" Disabled="@IsLoading" />
    </GroveStack>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <GroveAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</GroveAlert>
    }

    <GroveRow Gap="1rem">
        <GroveColumn Size="12" SizeLG="4">
            <GroveModelList TItem="Role"
                            Title="@T["Roles"]"
                            Items="@AllRoles"
                            SelectedKey="@SelectedRoleName"
                            KeySelector="@(role => role.Name)"
                            TextSelector="@(role => role.Name)"
                            DescriptionSelector="@(role => role.Description)"
                            SearchPredicate="MatchesSearch"
                            Select="SelectRoleAsync"
                            ShowCreate="false"
                            IsBusy="@IsLoading"
                            EmptyText="@T["No roles are available."]" />
            <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" Style="margin-top: 0.5rem;">
                <GroveTextBox @bind-Value="NewRoleName" Placeholder="@T["New role name"]" Style="flex: 1 1 auto;" />
                <GroveButton Text="@T["Add"]" Icon="add" Click="CreateAsync" Disabled="@string.IsNullOrWhiteSpace(NewRoleName)" data-testid="role-create" />
            </GroveStack>
        </GroveColumn>
        <GroveColumn Size="12" SizeLG="8">
            @if (Detail is null)
            {
                <GroveCard><GroveText Text="@T["Select a role."]" /></GroveCard>
            }
            else
            {
                <GroveCard data-testid="role-detail">
                    <GroveStack Gap="1rem">
                        <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.Center">
                            <GroveText TextStyle="TextStyle.H5" Text="@Detail.Name" />
                            <GroveBadge Text="@(Detail.IsSystem ? T["System role"] : T["Custom role"])" BadgeStyle="@(Detail.IsSystem ? BadgeStyle.Info : BadgeStyle.Secondary)" />
                            @if (Detail.IsAdmin)
                            {
                                <GroveBadge Text="@T["Administrator: holds every permission"]" BadgeStyle="BadgeStyle.Success" />
                            }
                        </GroveStack>
                        <GroveFormField Text="@T["Description"]"><GroveTextBox @bind-Value="DraftDescription" Style="width: 100%;" /></GroveFormField>

                        <GroveText TextStyle="TextStyle.Subtitle2" Text="@T["Permission sets"]" />
                        <GroveStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap">
                            @foreach (var set in Sets)
                            {
                                var name = set.Name;
                                <label style="display: inline-flex; gap: 0.25rem; align-items: center;" title="@string.Join(", ", set.Permissions)">
                                    <GroveCheckBox TValue="bool" Value="@DraftSets.Contains(name)" Change="@((bool on) => Toggle(DraftSets, name, on))" />
                                    @name
                                </label>
                            }
                        </GroveStack>

                        <GroveText TextStyle="TextStyle.Subtitle2" Text="@T["Loose permissions"]" />
                        <GroveTextBox @bind-Value="PermissionFilter" Placeholder="@T["Filter permissions"]" Style="width: 100%;" />
                        @foreach (var category in Catalog.Where(Matches).GroupBy(permission => permission.Category ?? string.Empty))
                        {
                            <GroveText TextStyle="TextStyle.Caption" Text="@(category.Key.Length == 0 ? T["General"] : category.Key)" />
                            <GroveStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap">
                                @foreach (var permission in category)
                                {
                                    var name = permission.Name;
                                    <label style="display: inline-flex; gap: 0.25rem; align-items: center;" title="@permission.Description">
                                        <GroveCheckBox TValue="bool" Value="@DraftPermissions.Contains(name)" Change="@((bool on) => Toggle(DraftPermissions, name, on))" />
                                        @name
                                    </label>
                                }
                            </GroveStack>
                        }

                        <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            <GroveButton Text="@T["Save role"]" Icon="save" Click="SaveAsync" Disabled="@IsLoading" data-testid="role-save" />
                            <GroveTextBox @bind-Value="CloneName" Placeholder="@T["Copy as..."]" Style="width: 12rem" data-testid="role-clone-name" />
                            <GroveButton Text="@T["Clone"]" Icon="content_copy" ButtonStyle="ButtonStyle.Light" Click="CloneAsync" Disabled="@(IsLoading || string.IsNullOrWhiteSpace(CloneName))" data-testid="role-clone" />
                            @if (!Detail.IsSystem)
                            {
                                <GroveButton Text="@T["Delete role"]" Icon="delete" ButtonStyle="ButtonStyle.Danger" Click="DeleteAsync" Disabled="@IsLoading" />
                            }
                        </GroveStack>
                    </GroveStack>
                </GroveCard>
            }
        </GroveColumn>
    </GroveRow>
</GroveStack>

@code {
    private Role[] AllRoles { get; set; } = [];
    private List<PermissionSetInfo> Sets { get; set; } = [];
    private List<PermissionInfo> Catalog { get; set; } = [];
    private RoleDetail? Detail { get; set; }
    private string? SelectedRoleName { get; set; }
    private string? DraftDescription { get; set; }
    private HashSet<string> DraftSets { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> DraftPermissions { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    private string? PermissionFilter { get; set; }
    private string? NewRoleName { get; set; }
    private string? CloneName { get; set; }
    private bool IsLoading { get; set; }
    private string? ErrorMessage { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            AllRoles = await Api.Grove.Rest.Roles.ListAsync();
            Sets = await Http.GetFromJsonAsync<List<PermissionSetInfo>>("api/grove/permission-sets") ?? [];
            Catalog = await Http.GetFromJsonAsync<List<PermissionInfo>>("api/grove/permission-catalog") ?? [];
            SelectedRoleName = AllRoles.Any(role => string.Equals(role.Name, SelectedRoleName, StringComparison.OrdinalIgnoreCase))
                ? SelectedRoleName
                : AllRoles.FirstOrDefault()?.Name;
            await LoadDetailAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadDetailAsync()
    {
        Detail = SelectedRoleName is null ? null : await Http.GetFromJsonAsync<RoleDetail>($"api/grove/roles/{Uri.EscapeDataString(SelectedRoleName)}");
        DraftDescription = Detail?.Description;
        DraftSets = new HashSet<string>(Detail?.Sets ?? [], StringComparer.OrdinalIgnoreCase);
        DraftPermissions = new HashSet<string>(Detail?.Permissions ?? [], StringComparer.OrdinalIgnoreCase);
    }

    private async Task SelectRoleAsync(Role role)
    {
        SelectedRoleName = role.Name;
        await LoadDetailAsync();
    }

    private bool Matches(PermissionInfo permission) =>
        string.IsNullOrWhiteSpace(PermissionFilter)
        || permission.Name.Contains(PermissionFilter, StringComparison.OrdinalIgnoreCase)
        || (permission.Description?.Contains(PermissionFilter, StringComparison.OrdinalIgnoreCase) ?? false);

    private static void Toggle(HashSet<string> set, string name, bool on)
    {
        if (on) set.Add(name); else set.Remove(name);
    }

    private async Task CreateAsync()
    {
        await RunAsync(() => Http.PostAsJsonAsync("api/grove/roles", new RoleWrite(NewRoleName!.Trim(), null, [], [])));
        SelectedRoleName = NewRoleName?.Trim();
        NewRoleName = null;
        await LoadAsync();
    }

    // A clone is a new role with the source's description, permission sets and permissions as
    // stored (unsaved edits on the source are not copied).
    private async Task CloneAsync()
    {
        var name = CloneName?.Trim();
        if (Detail is null || string.IsNullOrWhiteSpace(name)) return;
        await RunAsync(() => Http.PostAsJsonAsync("api/grove/roles", new RoleWrite(name, Detail.Description, [.. Detail.Sets], [.. Detail.Permissions])));
        if (ErrorMessage is null)
        {
            SelectedRoleName = name;
            CloneName = null;
        }

        await LoadAsync();
    }

    private async Task SaveAsync()
    {
        await RunAsync(() => Http.PutAsJsonAsync($"api/grove/roles/{Uri.EscapeDataString(Detail!.Name)}", new RoleWrite(Detail.Name, DraftDescription, [.. DraftSets], [.. DraftPermissions])));
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        await RunAsync(() => Http.DeleteAsync($"api/grove/roles/{Uri.EscapeDataString(Detail!.Name)}"));
        SelectedRoleName = null;
        await LoadAsync();
    }

    private async Task RunAsync(Func<Task<HttpResponseMessage>> call)
    {
        ErrorMessage = null;
        using var response = await call();
        if (!response.IsSuccessStatusCode)
        {
            ErrorMessage = await AccessApi.ErrorAsync(response);
        }
    }

    private static bool MatchesSearch(Role role, string term) =>
        role.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
        || role.Description.Contains(term, StringComparison.OrdinalIgnoreCase);
}

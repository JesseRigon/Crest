@page "/Menus"
@page "/Menu"
@page "/Menu/List"
@page "/Contents/ContentItems/Menu"
@attribute [PageEntry("ManageMenu", Id = "menus", Parent = "content", Caption = "Menus", Icon = "@iconify:mdi:menu")]
@using Grove.AdminTheme.Api
@using Grove.Components.Primitives
@using Grove.Components.Primitives
@inject IApi Api
@inject NotificationService Notifications
@inject Grove.Components.Theme.GroveApiLocalizer T

<GroveStack Gap="1rem">
    <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
        <GroveStack Gap="0.25rem">
            <GroveText TextStyle="TextStyle.H4" Text="@T["Menus"]" />
            <GroveText TextStyle="TextStyle.Body2" Text="@T["Manage site menus and nested menu items."]" />
        </GroveStack>
        <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <GroveButton Text="@T["New menu"]" Icon="add" Click="StartCreateMenu" Disabled="@IsBusy" />
            <GroveButton Text="@T["Refresh"]" ButtonStyle="ButtonStyle.Light" Icon="refresh" Click="@LoadAsync" Disabled="@IsBusy" />
        </GroveStack>
    </GroveStack>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <GroveAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</GroveAlert>
    }

    @if (IsLoading)
    {
        <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
            <GroveProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
            <GroveText Text="@T["Loading menus..."]" />
        </GroveStack>
    }
    else
    {
        <GroveRow Gap="1rem">
            <GroveColumn Size="12" SizeLG="4">
                <GroveCard>
                    <GroveStack Gap="0.75rem">
                        <GroveText TextStyle="TextStyle.H6" Text="@T["Menus"]" />
                        <GroveTextBox @bind-Value="MenuSearch" Placeholder="@T["Search menus..."]" Style="width: 100%;" />
                        @if (FilteredMenus.Length == 0)
                        {
                            <GroveText Text="@T["No standard menus found."]" />
                        }
                        else
                        {
                            <GroveStack Gap="0.35rem">
                                @foreach (var menu in FilteredMenus)
                                {
                                    <div class="admin-menu-list-item @(menu.Id == SelectedMenuId ? "admin-menu-list-item--selected" : null) @(!menu.Published ? "admin-menu-list-item--disabled" : null)">
                                        <GroveButton Text="@menu.Name" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Click="@(() => SelectMenu(menu.Id))" Style="justify-content: flex-start; flex: 1; min-width: 0;" />
                                        <GroveBadge Text="@(menu.Published ? T["Published"] : T["Draft"])" BadgeStyle="@(menu.Published ? BadgeStyle.Success : BadgeStyle.Warning)" />
                                        <GroveButton Size="ButtonSize.Small" Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Click="@(() => StartMenuRename(menu))" Disabled="@IsBusy" title="@T["Rename menu"]" />
                                        <GroveButton Size="ButtonSize.Small" Icon="@(menu.Published ? "visibility_off" : "visibility")" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Click="@(() => ToggleMenuAsync(menu))" Disabled="@IsBusy" title="@T["Publish/unpublish menu"]" />
                                        <GroveButton Size="ButtonSize.Small" Icon="content_copy" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Click="@(() => DuplicateMenuAsync(menu))" Disabled="@IsBusy" title="@T["Duplicate menu"]" />
                                        <GroveButton Size="ButtonSize.Small" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Click="@(() => DeleteMenuAsync(menu))" Disabled="@IsBusy" title="@T["Delete menu"]" />
                                    </div>
                                }
                            </GroveStack>
                        }
                    </GroveStack>
                </GroveCard>
            </GroveColumn>

            <GroveColumn Size="12" SizeLG="8">
                @if (SelectedMenu is null)
                {
                    <GroveCard><GroveText Text="@T["Select a standard menu to edit its items."]" /></GroveCard>
                }
                else
                {
                    <GroveCard>
                        <GroveStack Gap="0.85rem">
                            <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
                                <GroveStack Gap="0.2rem">
                                    <GroveText TextStyle="TextStyle.H5" Text="@SelectedMenu.Name" />
                                    <GroveText TextStyle="TextStyle.Caption" Text="@T["Link and HTML menu items are editable here; content-picker menu items cannot be edited here yet."]" />
                                </GroveStack>
                                <GroveButton Text="@T["Add Menu Item"]" Icon="add" Click="StartCreateNode" Disabled="@(IsBusy || AvailableNodeTypes.Length == 0)" />
                            </GroveStack>

                            @if (SelectedMenu.Nodes.Length == 0)
                            {
                                <GroveAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">@T["This menu does not have any items yet."]</GroveAlert>
                            }
                            else
                            {
                                <ol class="admin-menu-tree__list admin-menu-tree__list--root">
                                    @foreach (var node in SelectedMenu.Nodes)
                                    {
                                        @MenuNode(node)
                                    }
                                </ol>
                            }
                        </GroveStack>
                    </GroveCard>
                }
            </GroveColumn>
        </GroveRow>
    }

    @if (MenuDialogModel is not null)
    {
        <div class="admin-menu-editor-dialog-backdrop">
            <GroveCard class="admin-menu-editor-dialog" Style="max-width: 32rem; width: min(32rem, calc(100vw - 2rem));">
                <GroveTemplateForm TItem="MenuFormModel" Data="@MenuDialogModel" Submit="@(_ => SaveMenuDialogAsync())">
                    <GroveStack Gap="1rem">
                        <GroveText TextStyle="TextStyle.H5" Text="@MenuDialogTitle" />
                        <GroveFormField Text="@T["Menu name"]" Style="width: 100%;"><GroveTextBox @bind-Value="MenuDialogModel.Name" Style="width: 100%;" /></GroveFormField>
                        <GroveStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                            <GroveButton Text="@T["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="CancelMenuDialog" />
                            <GroveButton Text="@T["Save"]" Icon="save" ButtonType="ButtonType.Submit" Disabled="@IsSaving" />
                        </GroveStack>
                    </GroveStack>
                </GroveTemplateForm>
            </GroveCard>
        </div>
    }

    @if (NodeDialogModel is not null)
    {
        <div class="admin-menu-editor-dialog-backdrop">
            <GroveCard class="admin-menu-editor-dialog" Style="max-width: 44rem; width: min(44rem, calc(100vw - 2rem));">
                <GroveTemplateForm TItem="NodeFormModel" Data="@NodeDialogModel" Submit="@(_ => SaveNodeDialogAsync())">
                    <GroveStack Gap="1rem">
                        <GroveText TextStyle="TextStyle.H5" Text="@NodeDialogTitle" />
                        <GroveRow Gap="1rem">
                            <GroveColumn Size="12" SizeMD="6"><GroveFormField Text="@T["Type"]" Style="width: 100%;"><GroveDropDown @bind-Value="NodeDialogModel.Type" Data="AvailableNodeTypes" TextProperty="DisplayName" ValueProperty="Type" Disabled="@(EditingNodeId is not null)" Style="width: 100%;" /></GroveFormField></GroveColumn>
                            <GroveColumn Size="12" SizeMD="6"><GroveFormField Text="@T["Parent"]" Style="width: 100%;"><GroveDropDown @bind-Value="NodeDialogModel.ParentNodeId" Data="ParentOptions" TextProperty="Text" ValueProperty="Id" AllowClear="true" Placeholder="@T["Root"]" Style="width: 100%;" /></GroveFormField></GroveColumn>
                            <GroveColumn Size="12"><GroveFormField Text="@T["Text"]" Style="width: 100%;"><GroveTextBox @bind-Value="NodeDialogModel.Text" Style="width: 100%;" /></GroveFormField></GroveColumn>
                            @if (string.Equals(NodeDialogModel.Type, "ContentMenuItem", StringComparison.OrdinalIgnoreCase))
                            {
                                <GroveColumn Size="12" SizeMD="8"><GroveFormField Text="@T["Content item id"]" Style="width: 100%;"><GroveTextBox @bind-Value="NodeDialogModel.ContentItemId" Style="width: 100%;" /></GroveFormField></GroveColumn>
                                <GroveColumn Size="12" SizeMD="4"><GroveFormField Text="@T["Check content permissions"]" Style="width: 100%;"><GroveCheckBox @bind-Value="NodeDialogModel.CheckContentPermissions" TValue="bool" /></GroveFormField></GroveColumn>
                            }
                            else
                            {
                                <GroveColumn Size="12" SizeMD="8"><GroveFormField Text="@T["Url"]" Style="width: 100%;"><GroveTextBox @bind-Value="NodeDialogModel.Url" Style="width: 100%;" /></GroveFormField></GroveColumn>
                                <GroveColumn Size="12" SizeMD="4"><GroveFormField Text="@T["Target"]" Style="width: 100%;"><GroveTextBox @bind-Value="NodeDialogModel.Target" Placeholder="_blank" Style="width: 100%;" /></GroveFormField></GroveColumn>
                            }
                            @if (string.Equals(NodeDialogModel.Type, "HtmlMenuItem", StringComparison.OrdinalIgnoreCase))
                            {
                                <GroveColumn Size="12"><GroveFormField Text="@T["Html"]" Style="width: 100%;"><GroveTextArea @bind-Value="NodeDialogModel.Html" Rows="5" Style="width: 100%;" /></GroveFormField></GroveColumn>
                            }
                            <GroveColumn Size="12"><GroveFormField Text="@T["Permission names"]" Style="width: 100%;"><GroveTextBox @bind-Value="NodeDialogModel.PermissionNamesText" Placeholder="@T["Comma-separated permission names"]" Style="width: 100%;" /></GroveFormField></GroveColumn>
                        </GroveRow>
                        <GroveStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                            <GroveButton Text="@T["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="CancelNodeDialog" />
                            <GroveButton Text="@T["Save"]" Icon="save" ButtonType="ButtonType.Submit" Disabled="@IsSaving" />
                        </GroveStack>
                    </GroveStack>
                </GroveTemplateForm>
            </GroveCard>
        </div>
    }
</GroveStack>

<style>
    .admin-menu-list-item { display: flex; align-items: center; gap: 0.25rem; border: 1px solid var(--rz-border-color); border-radius: var(--rz-border-radius); padding: 0.15rem; }
    .admin-menu-list-item--selected { border-color: var(--rz-primary); background: color-mix(in srgb, var(--rz-primary) 8%, transparent); }
    .admin-menu-list-item--disabled { opacity: 0.55; }
    .admin-menu-tree__list { list-style: none; margin: 0; padding-left: 1.25rem; }
    .admin-menu-tree__list--root { padding-left: 0; }
    .admin-menu-tree__item { margin: 0.45rem 0; }
    .admin-menu-node { border: 1px solid var(--rz-border-color); border-radius: var(--rz-border-radius); background: var(--rz-base-background-color); padding: 0.65rem; }
    .admin-menu-node__handle { color: var(--rz-text-secondary-color); border: 1px dashed var(--rz-border-color); border-radius: 999px; padding: 0.15rem 0.35rem; user-select: none; display: inline-flex; align-items: center; }
    .admin-menu-node__spacer { display: inline-block; width: 2rem; }
    .admin-menu-editor-dialog-backdrop { position: fixed; inset: 0; z-index: 2000; display: grid; place-items: center; padding: 1rem; background: rgba(15, 23, 42, 0.35); }
</style>

@code {
    private StandardMenusState State { get; set; } = StandardMenusState.Empty;
    private string? SelectedMenuId { get; set; }
    private string MenuSearch { get; set; } = string.Empty;
    private bool IsLoading { get; set; }
    private bool IsSaving { get; set; }
    private bool IsBusy => IsLoading || IsSaving;
    private string? ErrorMessage { get; set; }
    private MenuFormModel? MenuDialogModel { get; set; }
    private string? EditingMenuId { get; set; }
    private string MenuDialogTitle { get; set; } = "Menu";
    private NodeFormModel? NodeDialogModel { get; set; }
    private string? EditingNodeId { get; set; }
    private string NodeDialogTitle { get; set; } = "Menu item";

    private StandardMenuSummary? SelectedMenu => State.Menus.FirstOrDefault(menu => menu.Id == SelectedMenuId);
    private StandardMenuNodeType[] AvailableNodeTypes => State.AvailableNodeTypes.Length == 0 ? [new("LinkMenuItem", T["Link Menu Item"]), new("HtmlMenuItem", T["Html Menu Item"]), new("ContentMenuItem", T["Content Menu Item"])] : State.AvailableNodeTypes;
    private ParentOption[] ParentOptions => SelectedMenu is null ? [] : [new(null, T["Root"]), .. FlattenNodes(SelectedMenu.Nodes).Where(node => node.Id != EditingNodeId).Select(node => new ParentOption(node.Id, $"{new string('—', node.Depth)} {node.Text}"))];

    private StandardMenuSummary[] FilteredMenus => State.Menus
        .Where(menu => string.IsNullOrWhiteSpace(MenuSearch) || menu.Name.Contains(MenuSearch, StringComparison.OrdinalIgnoreCase))
        .OrderBy(menu => menu.Name, StringComparer.OrdinalIgnoreCase)
        .ToArray();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            State = await Api.Grove.Rest.Menus.ListAsync();
            SelectedMenuId = State.Menus.Any(menu => menu.Id == SelectedMenuId) ? SelectedMenuId : State.Menus.FirstOrDefault()?.Id;
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsLoading = false; }
    }

    private void SelectMenu(string menuId) => SelectedMenuId = menuId;
    private void StartCreateMenu() { EditingMenuId = null; MenuDialogTitle = T["Create menu"]; MenuDialogModel = new(); }
    private void StartMenuRename(StandardMenuSummary menu) { EditingMenuId = menu.Id; MenuDialogTitle = T["Rename menu: {0}", menu.Name]; MenuDialogModel = new() { Name = menu.Name, Published = menu.Published }; }
    private void CancelMenuDialog() { EditingMenuId = null; MenuDialogModel = null; }

    private async Task SaveMenuDialogAsync()
    {
        if (MenuDialogModel is null) return;
        IsSaving = true;
        var result = EditingMenuId is null
            ? await Api.Grove.Rest.Menus.CreateMenuAsync(MenuDialogModel.ToEditModel())
            : await Api.Grove.Rest.Menus.RenameMenuAsync(EditingMenuId, MenuDialogModel.ToEditModel());
        await ApplyMenuResultAsync(result);
        CancelMenuDialog();
        IsSaving = false;
    }

    private async Task ToggleMenuAsync(StandardMenuSummary menu) => await ApplyMenuResultAsync(await Api.Grove.Rest.Menus.ToggleMenuAsync(menu.Id));
    private async Task DuplicateMenuAsync(StandardMenuSummary menu) => await ApplyMenuResultAsync(await Api.Grove.Rest.Menus.DuplicateMenuAsync(menu.Id));
    private async Task DeleteMenuAsync(StandardMenuSummary menu)
    {
        if (await Api.Grove.Rest.Menus.DeleteMenuAsync(menu.Id))
        {
            State = State with { Menus = State.Menus.Where(existing => existing.Id != menu.Id).ToArray() };
            SelectedMenuId = State.Menus.FirstOrDefault()?.Id;
            Notifications.Notify(NotificationSeverity.Success, T["Menu deleted"], menu.Name);
        }
    }

    private void StartCreateNode()
    {
        EditingNodeId = null;
        NodeDialogTitle = T["Add Menu Item"];
        NodeDialogModel = new() { Type = AvailableNodeTypes.FirstOrDefault()?.Type ?? "LinkMenuItem" };
    }

    private void StartEditNode(StandardMenuNodeSummary node)
    {
        EditingNodeId = node.Id;
        NodeDialogTitle = $"Edit menu item: {node.Text}";
        NodeDialogModel = NodeFormModel.From(node);
    }

    private void CancelNodeDialog() { EditingNodeId = null; NodeDialogModel = null; }

    private async Task SaveNodeDialogAsync()
    {
        if (SelectedMenu is null || NodeDialogModel is null) return;
        IsSaving = true;
        var result = EditingNodeId is null
            ? await Api.Grove.Rest.Menus.CreateNodeAsync(SelectedMenu.Id, NodeDialogModel.ToEditModel())
            : await Api.Grove.Rest.Menus.UpdateNodeAsync(SelectedMenu.Id, EditingNodeId, NodeDialogModel.ToEditModel());
        await ApplyMenuResultAsync(result);
        CancelNodeDialog();
        IsSaving = false;
    }

    private async Task MoveNodeAsync(StandardMenuNodeSummary node, int delta)
    {
        if (SelectedMenu is null) return;
        await ApplyMenuResultAsync(await Api.Grove.Rest.Menus.MoveNodeAsync(SelectedMenu.Id, node.Id, new(node.ParentId, node.Order + delta)));
    }

    private async Task DuplicateNodeAsync(StandardMenuNodeSummary node)
    {
        if (SelectedMenu is null) return;
        await ApplyMenuResultAsync(await Api.Grove.Rest.Menus.DuplicateNodeAsync(SelectedMenu.Id, node.Id));
    }

    private async Task DeleteNodeAsync(StandardMenuNodeSummary node)
    {
        if (SelectedMenu is null) return;
        await ApplyMenuResultAsync(await Api.Grove.Rest.Menus.DeleteNodeAsync(SelectedMenu.Id, node.Id));
    }

    private async Task ApplyMenuResultAsync(StandardMenuSummary? result)
    {
        if (result is null) { Notifications.Notify(NotificationSeverity.Error, "Menu update failed"); return; }
        var menus = State.Menus.Any(menu => menu.Id == result.Id)
            ? State.Menus.Select(menu => menu.Id == result.Id ? result : menu).ToArray()
            : [.. State.Menus, result];
        State = State with { Menus = menus };
        SelectedMenuId = result.Id;
        Notifications.Notify(NotificationSeverity.Success, "Menu saved", result.Name);
        await Task.CompletedTask;
    }

    private RenderFragment MenuNode(StandardMenuNodeSummary node) => @<li class="admin-menu-tree__item">
        <div class="admin-menu-node">
            <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.75rem">
                <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.65rem">
                    <span class="admin-menu-node__handle" draggable="true" title="Drag to move"><GroveIcon IconKey="iconify.mdi/current/default/drag" /></span>
                    @if (node.Items.Length > 0) { <GroveButton Size="ButtonSize.Small" Icon="expand_more" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Disabled="true" /> }
                    else { <span class="admin-menu-node__spacer"></span> }
                    <GroveStack Gap="0.1rem" Style="flex: 1; min-width: 0;">
                        <GroveText TextStyle="TextStyle.Subtitle2" Text="@node.Text" />
                        <GroveText TextStyle="TextStyle.Caption" Text="@NodeMeta(node)" />
                    </GroveStack>
                </GroveStack>
                <GroveStack Orientation="Orientation.Horizontal" Gap="0.35rem">
                    <GroveButton Size="ButtonSize.Small" Icon="arrow_upward" ButtonStyle="ButtonStyle.Light" Click="@(() => MoveNodeAsync(node, -1))" Disabled="@(IsBusy || node.Order == 0)" title="Move up" />
                    <GroveButton Size="ButtonSize.Small" Icon="arrow_downward" ButtonStyle="ButtonStyle.Light" Click="@(() => MoveNodeAsync(node, 1))" Disabled="@IsBusy" title="Move down" />
                    <GroveButton Size="ButtonSize.Small" Icon="edit" ButtonStyle="ButtonStyle.Light" Click="@(() => StartEditNode(node))" Disabled="@(IsBusy || !CanEdit(node))" title="Edit menu item" />
                    <GroveButton Size="ButtonSize.Small" Icon="content_copy" ButtonStyle="ButtonStyle.Light" Click="@(() => DuplicateNodeAsync(node))" Disabled="@IsBusy" title="Duplicate menu item" />
                    <GroveButton Size="ButtonSize.Small" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="@(() => DeleteNodeAsync(node))" Disabled="@IsBusy" title="Delete menu item" />
                </GroveStack>
            </GroveStack>
        </div>
        @if (node.Items.Length > 0)
        {
            <ol class="admin-menu-tree__list">@foreach (var child in node.Items) { @MenuNode(child) }</ol>
        }
    </li>;

    private static bool CanEdit(StandardMenuNodeSummary node) => node.Type is "LinkMenuItem" or "HtmlMenuItem" or "ContentMenuItem";
    private static IEnumerable<StandardMenuNodeSummary> FlattenNodes(IEnumerable<StandardMenuNodeSummary> nodes) => nodes.SelectMany(node => new[] { node }.Concat(FlattenNodes(node.Items)));
    private static string NodeMeta(StandardMenuNodeSummary node) => string.Join(" • ", new[] { node.Type, node.Url, !string.IsNullOrWhiteSpace(node.Target) ? $"Target: {node.Target}" : null, node.PermissionNames.Length > 0 ? $"Permissions: {string.Join(", ", node.PermissionNames)}" : null }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private sealed class MenuFormModel
    {
        public string Name { get; set; } = string.Empty;
        public bool Published { get; set; } = true;
        public StandardMenuEditModel ToEditModel() => new(Name, Published);
    }

    private sealed class NodeFormModel
    {
        public string Type { get; set; } = "LinkMenuItem";
        public string Text { get; set; } = string.Empty;
        public string? Url { get; set; }
        public string? Target { get; set; }
        public string? Html { get; set; }
        public string? PermissionNamesText { get; set; }
        public string? ParentNodeId { get; set; }
        public int? Position { get; set; }
        public string? ContentItemId { get; set; }
        public bool CheckContentPermissions { get; set; }

        public static NodeFormModel From(StandardMenuNodeSummary node) => new() { Type = node.Type, Text = node.Text, Url = node.Url, Target = node.Target, Html = node.Html, PermissionNamesText = string.Join(", ", node.PermissionNames), ParentNodeId = node.ParentId, Position = node.Order, ContentItemId = node.ContentItemId, CheckContentPermissions = node.CheckContentPermissions };
        public StandardMenuNodeEditModel ToEditModel() => new(Type, Text, Url, Target, Html, PermissionNamesText?.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries) ?? [], ParentNodeId, Position, ContentItemId, CheckContentPermissions);
    }

    private sealed record ParentOption(string? Id, string Text);
}

@page "/Contents/ContentItems"
@attribute [PageEntry("AccessAdminPanel", Id = "content-items", Parent = "content", Caption = "Content Items", Position = "before", Icon = "@iconify:mdi:file-document-outline")]
@using Grove.AdminTheme.Api
@using Grove.Components.Primitives
@using Grove.Components.Primitives
@inject IApi Api
@inject NavigationManager Navigation
@inject NotificationService Notifications
@inject Grove.Components.Theme.GroveApiLocalizer T

<GroveStack Gap="1rem" data-testid="content-items-page">
    <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Wrap="FlexWrap.Wrap">
        <GroveStack Gap="0.25rem">
            <GroveText TextStyle="TextStyle.H4" Text="@PageHeading" />
            <GroveText TextStyle="TextStyle.Body2" Text="@T["Browse, filter, publish, unpublish, and remove content items."]" />
        </GroveStack>
        <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <GroveButton Text="@T["New content"]" Icon="add" Click="StartCreate" Disabled="@(IsBusy || CreatableTypes.Length == 0)" />
            <GroveButton Text="@T["Refresh"]" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="@(() => LoadAsync())" Disabled="@IsBusy" />
        </GroveStack>
    </GroveStack>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <GroveAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</GroveAlert>
    }

    <GroveCard>
        <GroveRow Gap="0.75rem">
            <GroveColumn Size="12" SizeMD="4"><GroveTextBox @bind-Value="SearchText" @oninput="OnSearchInput" Placeholder="@T["Search content titles..."]" Style="width: 100%;" /></GroveColumn>
            <GroveColumn Size="12" SizeMD="2"><GroveDropDown @bind-Value="SelectedGroup" Data="GroupOptions" TextProperty="Text" ValueProperty="Value" Change="@(_ => LoadAsync(1))" Style="width: 100%;" data-testid="content-items-group-filter" /></GroveColumn>
            <GroveColumn Size="12" SizeMD="2"><GroveDropDown @bind-Value="SelectedContentType" Data="ContentTypeOptions" TextProperty="Text" ValueProperty="Value" Change="@(_ => LoadAsync())" Style="width: 100%;" data-testid="content-items-type-filter" /></GroveColumn>
            <GroveColumn Size="12" SizeMD="2"><GroveDropDown @bind-Value="SelectedStatus" Data="StatusOptions" TextProperty="Text" ValueProperty="Value" Change="@(_ => LoadAsync())" Style="width: 100%;" /></GroveColumn>
            <GroveColumn Size="12" SizeMD="2"><GroveText Text="@(T["{0:n0} items", Result.Total])" TextStyle="TextStyle.Caption" Style="line-height: 2.5rem;" /></GroveColumn>
        </GroveRow>
    </GroveCard>

    @if (IsLoading)
    {
        <GroveProgressBar Mode="ProgressBarMode.Indeterminate" />
    }
    else if (Result.Items.Length == 0)
    {
        <GroveAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">@T["No content items match the current filters."]</GroveAlert>
    }
    else
    {
        <GroveDataGrid Data="@Result.Items" TItem="ContentItem" AllowPaging="false" Responsive="true" data-testid="content-items-grid">
            <Columns>
                <GroveDataGridColumn TItem="ContentItem" Title="@T["Title"]">
                    <Template Context="item"><GroveText TextStyle="TextStyle.Subtitle2" Text="@item.DisplayText" /><GroveText TextStyle="TextStyle.Caption" Text="@item.ContentItemId" /></Template>
                </GroveDataGridColumn>
                <GroveDataGridColumn TItem="ContentItem" Title="@T["Type"]"><Template Context="item">@item.ContentType</Template></GroveDataGridColumn>
                <GroveDataGridColumn TItem="ContentItem" Title="@T["Status"]"><Template Context="item"><GroveBadge Text="@(item.Published ? T["Published"] : T["Draft"])" BadgeStyle="@(item.Published ? BadgeStyle.Success : BadgeStyle.Warning)" /></Template></GroveDataGridColumn>
                <GroveDataGridColumn TItem="ContentItem" Title="@T["Modified"]"><Template Context="item">@(item.ModifiedUtc?.ToLocalTime().ToString("g") ?? T["—"])</Template></GroveDataGridColumn>
                <GroveDataGridColumn TItem="ContentItem" Title="@T["Actions"]" Sortable="false" Filterable="false" Width="17.5rem">
                    <Template Context="item">
                        <GroveStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                            @if (item.Published)
                            {
                                <GroveButton Icon="unpublished" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small" title="@T["Unpublish"]" Click="@(() => ChangePublicationAsync(item, false))" Disabled="@IsBusy" />
                            }
                            else
                            {
                                <GroveButton Icon="publish" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small" title="@T["Publish"]" Click="@(() => ChangePublicationAsync(item, true))" Disabled="@IsBusy" />
                            }
                            <GroveButton Icon="visibility" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small" title="@T["Display"]" Click="@(() => Display(item))" Disabled="@IsBusy" data-testid="content-item-display" />
                            <GroveButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small" title="@T["Edit"]" Click="@(() => Edit(item))" Disabled="@IsBusy" />
                            <GroveButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Size="ButtonSize.Small" title="@T["Delete"]" Click="@(() => RequestDelete(item))" Disabled="@IsBusy" />
                        </GroveStack>
                    </Template>
                </GroveDataGridColumn>
            </Columns>
        </GroveDataGrid>
        <GroveStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="0.75rem">
            <GroveButton Text="@T["Previous"]" ButtonStyle="ButtonStyle.Light" Click="PreviousPageAsync" Disabled="@(IsBusy || Result.Page <= 1)" />
            <GroveText Text="@(T["Page {0} of {1}", Result.Page, PageCount])" />
            <GroveButton Text="@T["Next"]" ButtonStyle="ButtonStyle.Light" Click="NextPageAsync" Disabled="@(IsBusy || Result.Page >= PageCount)" />
        </GroveStack>
    }

    @if (CreateDialogOpen)
    {
        <div class="content-items-dialog-backdrop"><GroveCard class="content-items-dialog"><GroveStack Gap="1rem"><GroveText TextStyle="TextStyle.H5" Text="@T["Create Content"]" /><GroveDropDown @bind-Value="CreateContentType" Data="CreatableTypes" TextProperty="Text" ValueProperty="Value" Style="width: 100%;" /><GroveStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem"><GroveButton Text="@T["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="CloseCreate" /><GroveButton Text="@T["Continue"]" Click="Create" Disabled="@string.IsNullOrWhiteSpace(CreateContentType)" /></GroveStack></GroveStack></GroveCard></div>
    }
    @if (DeleteCandidate is not null)
    {
        <div class="content-items-dialog-backdrop"><GroveCard class="content-items-dialog"><GroveStack Gap="1rem"><GroveText TextStyle="TextStyle.H5" Text="@T["Delete content item?"]" /><GroveText Text="@(T["This permanently removes {0}.", DeleteCandidate.DisplayText])" /><GroveStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem"><GroveButton Text="@T["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="CancelDelete" /><GroveButton Text="@T["Delete"]" ButtonStyle="ButtonStyle.Danger" Click="DeleteAsync" Disabled="@IsBusy" /></GroveStack></GroveStack></GroveCard></div>
    }
</GroveStack>

@code {
    // The Content-menu entries for designated types link here with ?type=<Name>
    // (query string, not a route segment, so the existing route registration and
    // its permission gate cover the filtered view). Navigating between two such
    // menu items reuses this component - only the query changes - so filter
    // changes land in OnParametersSetAsync, not OnInitializedAsync.
    [SupplyParameterFromQuery(Name = "type")]
    public string? TypeFilter { get; set; }
    private string? AppliedTypeFilter;

    // Group pages (tenant setting "content group pages in menu") link here with
    // ?group=<key>; a group is a set of content SOURCES the modules declared, so the
    // list is filtered server-side to whatever those sources cover.
    [SupplyParameterFromQuery(Name = "group")]
    public string? GroupFilter { get; set; }
    private string? AppliedGroupFilter;

    private ContentItemListResult Result { get; set; } = ContentItemListResult.Empty;
    private ContentType[] ContentTypes { get; set; } = [];
    private ContentGroup[] Groups { get; set; } = [];
    private string? SelectedContentType { get; set; }
    private string? SelectedGroup { get; set; }
    private string SelectedStatus { get; set; } = "latest";
    private string? SearchText { get; set; }
    private bool IsLoading { get; set; }
    private bool IsSaving { get; set; }
    private bool IsBusy => IsLoading || IsSaving;
    private string? ErrorMessage { get; set; }
    private bool CreateDialogOpen { get; set; }
    private string? CreateContentType { get; set; }
    private ContentItem? DeleteCandidate { get; set; }
    private CancellationTokenSource? SearchCancellation;

    private FilterOption[] StatusOptions => [new("latest", T["Latest"]), new("published", T["Published"]), new("draft", T["Unpublished"])];
    private FilterOption[] ContentTypeOptions => [new(string.Empty, T["All content types"]), .. ContentTypes.Select(type => new FilterOption(type.Name, type.DisplayName))];
    private FilterOption[] GroupOptions => [new(string.Empty, T["All groups"]), .. Groups.Where(group => !group.Hidden).Select(group => new FilterOption(group.Key, group.DisplayName))];
    private FilterOption[] CreatableTypes => ContentTypes.Select(type => new FilterOption(type.Name, type.DisplayName)).ToArray();
    private int PageCount => Math.Max(1, (int)Math.Ceiling(Result.Total / (double)Result.PageSize));

    private string PageHeading =>
        (string.IsNullOrWhiteSpace(TypeFilter)
            ? null
            : ContentTypes.FirstOrDefault(type => string.Equals(type.Name, TypeFilter, StringComparison.OrdinalIgnoreCase))?.DisplayName)
        ?? (string.IsNullOrWhiteSpace(GroupFilter)
            ? null
            : Groups.FirstOrDefault(group => string.Equals(group.Key, GroupFilter, StringComparison.OrdinalIgnoreCase))?.DisplayName)
        ?? T["Content Items"];

    protected override async Task OnInitializedAsync()
    {
        ContentTypes = await Api.Grove.Rest.Content.Types.ListAsync();
        Groups = await Api.Grove.Rest.ContentGroups.ListAsync();
        AppliedTypeFilter = TypeFilter;
        AppliedGroupFilter = GroupFilter;
        SelectedContentType = string.IsNullOrWhiteSpace(TypeFilter) ? SelectedContentType : TypeFilter;
        SelectedGroup = string.IsNullOrWhiteSpace(GroupFilter) ? SelectedGroup : GroupFilter;
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(TypeFilter, AppliedTypeFilter, StringComparison.Ordinal)
            && string.Equals(GroupFilter, AppliedGroupFilter, StringComparison.Ordinal))
        {
            return;
        }

        AppliedTypeFilter = TypeFilter;
        AppliedGroupFilter = GroupFilter;
        SelectedContentType = string.IsNullOrWhiteSpace(TypeFilter) ? null : TypeFilter;
        SelectedGroup = string.IsNullOrWhiteSpace(GroupFilter) ? null : GroupFilter;
        await LoadAsync(1);
    }

    private async Task LoadAsync(int? page = null)
    {
        IsLoading = true;
        ErrorMessage = null;
        try { Result = await Api.Grove.Rest.Content.Items.ListAsync(SelectedContentType, SelectedStatus, SearchText, page ?? Result.Page, Result.PageSize, SelectedGroup); }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsLoading = false; }
    }

    private async Task OnSearchInput(ChangeEventArgs args)
    {
        SearchText = args.Value?.ToString();
        SearchCancellation?.Cancel();
        SearchCancellation = new CancellationTokenSource();
        try { await Task.Delay(300, SearchCancellation.Token); await LoadAsync(1); }
        catch (OperationCanceledException) { }
    }

    private Task PreviousPageAsync() => LoadAsync(Result.Page - 1);
    private Task NextPageAsync() => LoadAsync(Result.Page + 1);
    private void StartCreate() { CreateContentType = CreatableTypes.FirstOrDefault()?.Value; CreateDialogOpen = true; }
    private void CloseCreate() => CreateDialogOpen = false;
    private void Create() { if (!string.IsNullOrWhiteSpace(CreateContentType)) Navigation.NavigateTo($"Contents/ContentTypes/{Uri.EscapeDataString(CreateContentType)}/Create"); }
    private void Edit(ContentItem item) => Navigation.NavigateTo($"Contents/ContentItems/{Uri.EscapeDataString(item.ContentItemId)}/Edit");
    private void Display(ContentItem item) => Navigation.NavigateTo($"Contents/ContentItems/{Uri.EscapeDataString(item.ContentItemId)}/Display");
    private void RequestDelete(ContentItem item) => DeleteCandidate = item;
    private void CancelDelete() => DeleteCandidate = null;

    private async Task ChangePublicationAsync(ContentItem item, bool publish)
    {
        IsSaving = true;
        try { var result = publish ? await Api.Grove.Rest.Content.Items.PublishAsync(item.ContentItemId) : await Api.Grove.Rest.Content.Items.UnpublishAsync(item.ContentItemId); if (!result) throw new InvalidOperationException(T["The publish state could not be changed."]); Notifications.Notify(NotificationSeverity.Success, T["Content Items"], T["{0} was {1}. ", item.DisplayText, publish ? T["Published"] : T["Unpublished"]]); await LoadAsync(); }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsSaving = false; }
    }

    private async Task DeleteAsync()
    {
        if (DeleteCandidate is null) return;
        IsSaving = true;
        try { if (!await Api.Grove.Rest.Content.Items.DeleteAsync(DeleteCandidate.ContentItemId)) throw new InvalidOperationException(T["The content item could not be deleted."]); Notifications.Notify(NotificationSeverity.Success, T["Content Items"], T["{0} was deleted.", DeleteCandidate.DisplayText]); DeleteCandidate = null; await LoadAsync(); }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsSaving = false; }
    }

    private sealed record FilterOption(string Value, string Text);
}

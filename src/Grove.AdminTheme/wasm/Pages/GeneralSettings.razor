@page "/Settings/general"
@attribute [PageEntry("ManageSettings", Id = "general", Parent = "settings", Caption = "General", Position = "before", Icon = "@iconify:mdi:cog-outline")]
@using Grove.AdminTheme.Api
@using Grove.AdminTheme.Components.Shared
@using Grove.Components.Primitives
@using Grove.Components.Primitives
@inject IApi Api
@inject NotificationService Notifications
@inject Grove.Components.Theme.GroveApiLocalizer T

<GroveStack Gap="1rem">
    <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
        <GroveStack Gap="0.25rem">
            <GroveText TextStyle="TextStyle.H4" Text="@T["General Settings"]" />
            <GroveText TextStyle="TextStyle.Body2" Text="@T["Manage site, resource, and cache settings."]" />
        </GroveStack>
        <GroveButton Text="@T["Refresh"]" ButtonStyle="ButtonStyle.Light" Icon="refresh" Click="@LoadAsync" Disabled="@IsBusy" />
    </GroveStack>

    <GroveCard>
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <GroveAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</GroveAlert>
        }
        else if (IsLoading)
        {
            <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                <GroveProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                <GroveText Text="@T["Loading settings..."]" />
            </GroveStack>
        }
        else
        {
            <GroveTemplateForm TItem="SiteSettingsModel" Data="@Model" Submit="@(_ => SaveAsync())">
                <GroveStack Gap="1rem">
                    <GroveMainContentTabs @bind-SelectedIndex="SelectedTabIndex" aria-label="@T["General settings sections"]">
                        <GroveTabsItem Text="@T["General"]" Icon="settings">
                            <GroveStack Gap="1rem">
                            <GroveText TextStyle="TextStyle.H5" Text="@T["General"]" />
                            <GroveRow Gap="1rem">
                                <GroveColumn Size="12" SizeMD="6"><GroveFormField Text="@T["Site name"]" Style="width: 100%;"><GroveTextBox @bind-Value="Model.SiteName" Style="width: 100%;" /></GroveFormField></GroveColumn>
                                <GroveColumn Size="12" SizeMD="6"><GroveFormField Text="@T["Base url"]" Style="width: 100%;"><GroveTextBox @bind-Value="Model.BaseUrl" Style="width: 100%;" /></GroveFormField></GroveColumn>
                                <GroveColumn Size="12"><GroveFormField Text="@T["Page title format"]" Style="width: 100%;"><GroveTextBox @bind-Value="Model.PageTitleFormat" Style="width: 100%;" /></GroveFormField></GroveColumn>
                                <GroveColumn Size="12" SizeMD="6"><GroveFormField Text="@T["Default Time Zone"]" Style="width: 100%;"><GroveTextBox @bind-Value="Model.TimeZoneId" Style="width: 100%;" /></GroveFormField></GroveColumn>
                                <GroveColumn Size="12" SizeMD="6"><GroveFormField Text="@T["Calendar"]" Style="width: 100%;"><GroveTextBox @bind-Value="Model.Calendar" Style="width: 100%;" /></GroveFormField></GroveColumn>
                                <GroveColumn Size="12" SizeMD="4"><GroveFormField Text="@T["Page Size"]" Style="width: 100%;"><GroveNumeric @bind-Value="Model.PageSize" Style="width: 100%;" /></GroveFormField></GroveColumn>
                                <GroveColumn Size="12" SizeMD="4"><GroveFormField Text="@T["Max page size"]" Style="width: 100%;"><GroveNumeric @bind-Value="Model.MaxPageSize" Style="width: 100%;" /></GroveFormField></GroveColumn>
                                <GroveColumn Size="12" SizeMD="4"><GroveFormField Text="@T["Max paged count"]" Style="width: 100%;"><GroveNumeric @bind-Value="Model.MaxPagedCount" Style="width: 100%;" /></GroveFormField></GroveColumn>
                            </GroveRow>
                            </GroveStack>
                        </GroveTabsItem>
                        <GroveTabsItem Text="@T["Resources"]" Icon="widgets">
                            <GroveStack Gap="1rem">
                            <GroveText TextStyle="TextStyle.H5" Text="@T["Resources"]" />
                            <SettingsSwitch Label="@T["Use resources cache busting"]" Hint="@T["Whether cache busting (append a version) is used for scripts and stylesheets"]" @bind-Value="Model.AppendVersion" />
                            <SettingsSwitch Label="@T["Use framework CDN (Content Delivery Network)"]" Hint="@T["Whether a framework CDN is used for registered scripts and stylesheets, such as jQuery, or their local version"]" @bind-Value="Model.UseCdn" />
                            <GroveFormField Text="@T["Site CDN (Content Delivery Network) base url"]" Style="width: 100%;"><GroveTextBox @bind-Value="Model.CdnBaseUrl" Style="width: 100%;" /></GroveFormField>
                            <GroveFormField Text="@T["Resource Debug Mode"]" Style="width: 100%; max-width: 48rem;"><GroveDropDown @bind-Value="Model.ResourceDebugMode" Data="ResourceDebugOptions" TextProperty="Text" ValueProperty="Value" Style="width: 100%;" /></GroveFormField>
                            <GroveText TextStyle="TextStyle.Caption" Text="@T["Determines whether scripts and stylesheets load in their debuggable or minified form."]" />
                            </GroveStack>
                        </GroveTabsItem>
                        <GroveTabsItem Text="@T["Cache"]" Icon="cached">
                            <GroveStack Gap="1rem">
                            <GroveText TextStyle="TextStyle.H5" Text="@T["Cache"]" />
                            <GroveFormField Text="@T["Cache Mode"]" Style="width: 100%; max-width: 48rem;"><GroveDropDown @bind-Value="Model.CacheMode" Data="CacheModeOptions" TextProperty="Text" ValueProperty="Value" Style="width: 100%;" /></GroveFormField>
                            <GroveText TextStyle="TextStyle.Caption" Text="@T["Determines whether caches are enabled or disabled."]" />
                            </GroveStack>
                        </GroveTabsItem>
                    </GroveMainContentTabs>

                    <GroveStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                        <GroveButton Text="@T["Save settings"]" Icon="save" ButtonType="ButtonType.Submit" Disabled="@IsSaving" />
                    </GroveStack>
                </GroveStack>
            </GroveTemplateForm>
        }
    </GroveCard>

    <BrandingSettingsGroup />

    @* Modules' own tenant-setting sections (Parties' Individual organizations, ...). *@
    <Grove.Components.Regions.GrovePageRegion Key="@Grove.Components.Regions.SettingsPageRegions.General" />
</GroveStack>

@code {
    // Properties (not static readonly fields) since they depend on T, which isn't set
    // yet during field initializer execution (constructor runs before [Inject]
    // properties are assigned).
    private SelectOption[] ResourceDebugOptions =>
    [
        new("FromConfiguration", T["From environment — disabled in Production, enabled otherwise"]),
        new("Enabled", T["Enabled — use debuggable version of resources"]),
        new("Disabled", T["Disabled — use minified version of resources"]),
    ];

    private SelectOption[] CacheModeOptions =>
    [
        new("FromConfiguration", T["From environment — enabled in Production, disabled otherwise"]),
        new("Enabled", T["Enabled"]),
        new("DebugEnabled", T["Enabled with cache debug mode"]),
        new("Disabled", T["Disabled"]),
    ];

    private int SelectedTabIndex { get; set; }
    private SiteSettingsModel Model { get; set; } = new();
    private bool IsLoading { get; set; }
    private bool IsSaving { get; set; }
    private bool IsBusy => IsLoading || IsSaving;
    private string? ErrorMessage { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try { Model = SiteSettingsModel.From(await Api.Grove.Rest.Site.GetAsync()); }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsLoading = false; }
    }

    private async Task SaveAsync()
    {
        IsSaving = true;
        try
        {
            var saved = await Api.Grove.Rest.Site.UpdateAsync(Model.ToUpdate());
            if (saved is not null)
            {
                Model = SiteSettingsModel.From(saved);
                Notifications.Notify(NotificationSeverity.Success, T["Settings saved"], T["General settings were updated."]);
            }
        }
        finally { IsSaving = false; }
    }

    private sealed record SelectOption(string Value, string Text);

    private sealed class SiteSettingsModel
    {
        public string SiteName { get; set; } = string.Empty;
        public string PageTitleFormat { get; set; } = string.Empty;
        public string BaseUrl { get; set; } = string.Empty;
        public string TimeZoneId { get; set; } = string.Empty;
        public string Calendar { get; set; } = string.Empty;
        public int PageSize { get; set; }
        public int MaxPageSize { get; set; }
        public int MaxPagedCount { get; set; }
        public bool AppendVersion { get; set; }
        public bool UseCdn { get; set; }
        public string CdnBaseUrl { get; set; } = string.Empty;
        public string ResourceDebugMode { get; set; } = "FromConfiguration";
        public string CacheMode { get; set; } = "FromConfiguration";

        public static SiteSettingsModel From(SiteSettings settings) => new()
        {
            SiteName = settings.SiteName,
            PageTitleFormat = settings.PageTitleFormat,
            BaseUrl = settings.BaseUrl,
            TimeZoneId = settings.TimeZoneId,
            Calendar = settings.Calendar,
            PageSize = settings.PageSize,
            MaxPageSize = settings.MaxPageSize,
            MaxPagedCount = settings.MaxPagedCount,
            AppendVersion = settings.AppendVersion,
            UseCdn = settings.UseCdn,
            CdnBaseUrl = settings.CdnBaseUrl,
            ResourceDebugMode = settings.ResourceDebugMode,
            CacheMode = settings.CacheMode,
        };

        public SiteSettingsUpdate ToUpdate() => new(SiteName, PageTitleFormat, BaseUrl, TimeZoneId, Calendar, PageSize, MaxPageSize, MaxPagedCount, AppendVersion, UseCdn, CdnBaseUrl, ResourceDebugMode, CacheMode);
    }
}

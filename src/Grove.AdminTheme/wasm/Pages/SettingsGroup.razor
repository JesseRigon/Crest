@page "/Settings/{GroupId}"
@attribute [PageEntry(DeclaredBySource = true)]
@using Grove.AdminTheme.Components.Admin
@using Grove.Components.Editors

@* Settings › any registered settings group (Grove.Settings' SettingsGroupPages declares one
   entry per group, gated at its concrete route): the generic settings form. A group the server
   does not serve this way is still a legacy page, shown in the legacy frame. *@
<SettingsForm GroupId="@GroupId">
    <NotFoundContent>
        <LegacyAdminFrame />
    </NotFoundContent>
</SettingsForm>

@code {
    [Parameter] public string GroupId { get; set; } = string.Empty;
}

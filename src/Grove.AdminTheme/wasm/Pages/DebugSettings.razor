@page "/Settings/debugging"
@attribute [PageEntry("ManageDebuggingSettings", Id = "debugging", Parent = "settings", Caption = "Debugging", Position = "after", Icon = "@iconify:mdi:bug")]
@using Grove.AdminTheme.Api
@using Grove.AdminTheme.Components.Shared
@using Grove.Components.Primitives
@inject IApi Api
@inject NotificationService Notifications
@inject Grove.Components.Theme.GroveApiLocalizer T

<GroveStack Gap="1rem" data-testid="debug-settings-page">
    <GroveStack Gap="0.25rem">
        <GroveText TextStyle="TextStyle.H4" Text="@T["Debugging"]" />
        <GroveText TextStyle="TextStyle.Body2" Text="@T["Diagnostics for the tenant's rendering."]" />
    </GroveStack>

    <GroveCard>
        @if (Model is null)
        {
            @if (LoadFailed)
            {
                <GroveAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@T["The debugging settings could not be loaded."]</GroveAlert>
            }
            else
            {
                <GroveProgressBar Mode="ProgressBarMode.Indeterminate" />
            }
        }
        else
        {
            <GroveStack Gap="1rem">
                <SettingsSwitch Label="@T["Write shape debug information"]" Hint="@T["Writes HTML comments around each rendered shape naming its type and the template that rendered it. Turn off in production."]" @bind-Value="WriteShapeDebugInformation" />
                <GroveStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                    <GroveButton Text="@T["Save settings"]" Icon="save" Click="SaveAsync" Disabled="@IsSaving" />
                </GroveStack>
            </GroveStack>
        }
    </GroveCard>
</GroveStack>

@code {
    private GroveDebugSettings? Model { get; set; }
    private bool WriteShapeDebugInformation { get; set; }
    private bool LoadFailed { get; set; }
    private bool IsSaving { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Model = await Api.Grove.Rest.DebugSettings.GetAsync();
        LoadFailed = Model is null;
        WriteShapeDebugInformation = Model?.WriteShapeDebugInformation ?? false;
    }

    private async Task SaveAsync()
    {
        IsSaving = true;
        try
        {
            var saved = await Api.Grove.Rest.DebugSettings.UpdateAsync(new GroveDebugSettings(WriteShapeDebugInformation));
            if (saved is null) { Notifications.Notify(NotificationSeverity.Error, T["Settings not saved"], T["The debugging settings could not be saved."]); return; }
            Model = saved;
            Notifications.Notify(NotificationSeverity.Success, T["Settings saved"], T["The debugging settings were saved."]);
        }
        finally { IsSaving = false; }
    }
}

@page "/Deployment/RemoteInstance/Index"
@attribute [PageEntry("ManageRemoteInstances", Id = "remote-instances", Parent = "deployments", Caption = "Remote Instances")]
@using Grove.AdminTheme.Api
@using Grove.Components.Primitives
@inject IApi Api
@inject NotificationService Notifications
@inject Grove.Components.Theme.GroveApiLocalizer T

@* Instances this tenant can send a deployment plan to. The API key is write-only: an
   edit shows whether one is stored and keeps it unless a new one is typed. *@

<GroveStack Gap="1rem" data-testid="remote-instances-page">
    <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
        <GroveStack Gap="0.25rem">
            <GroveText TextStyle="TextStyle.H4" Text="@T["Remote Instances"]" />
            <GroveText TextStyle="TextStyle.Body2" Text="@T["Other instances this tenant can send deployment plans to."]" />
        </GroveStack>
        <GroveButton Text="@T["Add remote instance"]" Icon="add" Click="New" Disabled="@IsBusy" />
    </GroveStack>

    @if (Error is not null)
    {
        <GroveAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@Error</GroveAlert>
    }

    @if (Editing)
    {
        <GroveCard data-testid="remote-instance-editor">
            <GroveStack Gap="1rem">
                <GroveText TextStyle="TextStyle.H5" Text="@(EditingId is null ? T["New remote instance"] : T["Edit {0}", DraftName])" />
                <GroveRow Gap="1rem">
                    <GroveColumn Size="12" SizeMD="6"><GroveFormField Text="@T["Name"]" Style="width: 100%;"><GroveTextBox @bind-Value="DraftName" Style="width: 100%;" /></GroveFormField></GroveColumn>
                    <GroveColumn Size="12" SizeMD="6"><GroveFormField Text="@T["Url"]" Style="width: 100%;"><GroveTextBox @bind-Value="DraftUrl" Placeholder="https://example.com/api/deployment/import" Style="width: 100%;" /></GroveFormField></GroveColumn>
                    <GroveColumn Size="12" SizeMD="6"><GroveFormField Text="@T["Client name"]" Style="width: 100%;"><GroveTextBox @bind-Value="DraftClientName" Style="width: 100%;" /></GroveFormField></GroveColumn>
                    <GroveColumn Size="12" SizeMD="6"><GroveFormField Text="@(DraftHasKey ? T["API key (leave empty to keep the stored key)"] : T["API key"])" Style="width: 100%;"><GrovePassword @bind-Value="DraftApiKey" Style="width: 100%;" /></GroveFormField></GroveColumn>
                </GroveRow>
                <GroveStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <GroveButton Text="@T["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="@(() => Editing = false)" Disabled="@IsBusy" />
                    <GroveButton Text="@T["Save"]" Icon="save" Click="SaveAsync" Disabled="@IsBusy" />
                </GroveStack>
            </GroveStack>
        </GroveCard>
    }

    <GroveCard>
        @if (Items is null)
        {
            <GroveProgressBar Mode="ProgressBarMode.Indeterminate" />
        }
        else if (Items.Length == 0)
        {
            <GroveText TextStyle="TextStyle.Body2" Text="@T["No remote instances yet."]" />
        }
        else
        {
            <GroveDataGrid Data="@Items" TItem="GroveRemoteInstance" AllowPaging="true" PageSize="20">
                <Columns>
                    <GroveDataGridColumn TItem="GroveRemoteInstance" Property="Name" Title="@T["Name"]" />
                    <GroveDataGridColumn TItem="GroveRemoteInstance" Property="Url" Title="@T["Url"]" />
                    <GroveDataGridColumn TItem="GroveRemoteInstance" Property="ClientName" Title="@T["Client name"]" />
                    <GroveDataGridColumn TItem="GroveRemoteInstance" Title="@T["Actions"]" Width="10rem"><Template Context="item"><GroveStack Orientation="Orientation.Horizontal" Gap="0.25rem"><GroveButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => Edit(item))" title="@T["Edit"]" /><GroveButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="@(() => DeleteAsync(item))" title="@T["Delete"]" /></GroveStack></Template></GroveDataGridColumn>
                </Columns>
            </GroveDataGrid>
        }
    </GroveCard>
</GroveStack>

@code {
    private GroveRemoteInstance[]? Items { get; set; }
    private bool IsBusy { get; set; }
    private string? Error { get; set; }
    private bool Editing { get; set; }
    private string? EditingId { get; set; }
    private string DraftName { get; set; } = string.Empty;
    private string DraftUrl { get; set; } = string.Empty;
    private string DraftClientName { get; set; } = string.Empty;
    private string? DraftApiKey { get; set; }
    private bool DraftHasKey { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() => Items = await Api.Grove.Rest.Deployment.ListRemoteInstancesAsync();

    private void New() { Editing = true; EditingId = null; DraftName = DraftUrl = DraftClientName = string.Empty; DraftApiKey = null; DraftHasKey = false; Error = null; }

    private void Edit(GroveRemoteInstance item) { Editing = true; EditingId = item.Id; DraftName = item.Name; DraftUrl = item.Url; DraftClientName = item.ClientName; DraftApiKey = null; DraftHasKey = item.HasApiKey; Error = null; }

    private async Task SaveAsync()
    {
        IsBusy = true;
        Error = null;
        try
        {
            var result = await Api.Grove.Rest.Deployment.SaveRemoteInstanceAsync(EditingId, new RemoteInstanceWrite(DraftName, DraftUrl, DraftClientName, DraftApiKey));
            if (!result.Succeeded) { Error = result.Message ?? T["The remote instance could not be saved."]; return; }
            Notifications.Notify(NotificationSeverity.Success, T["Remote Instances"], T["{0} was saved.", DraftName]);
            Editing = false;
            await LoadAsync();
        }
        finally { IsBusy = false; }
    }

    private async Task DeleteAsync(GroveRemoteInstance item)
    {
        IsBusy = true;
        try
        {
            if (await Api.Grove.Rest.Deployment.DeleteRemoteInstanceAsync(item.Id)) Notifications.Notify(NotificationSeverity.Success, T["Remote Instances"], T["{0} was deleted.", item.Name]);
            else Error = T["{0} could not be deleted.", item.Name];
            await LoadAsync();
        }
        finally { IsBusy = false; }
    }
}

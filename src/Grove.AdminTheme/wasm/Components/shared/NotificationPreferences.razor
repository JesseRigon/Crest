@namespace Grove.AdminTheme.Components.Shared
@inject HttpClient Http
@inject NotificationService Notifications
@inject Grove.Components.Theme.GroveApiLocalizer T

@* A user's notification methods (Grove.Notifications' notifications/preferences API): which methods
   the user receives notifications by, in priority order (the most important first). On the profile
   settings page for the signed-in user, on the user editor for the edited user. Absent while
   Grove.Notifications is disabled or no method is registered. *@
@if (Methods is { Count: > 0 })
{
    <GroveCard data-testid="notification-preferences">
        <GroveStack Gap="0.5rem">
            <GroveText TextStyle="TextStyle.Subtitle1" Text="@T["Notification Methods"]" />
            <GroveText TextStyle="TextStyle.Body2" Text="@T["Select all notification methods to receive."]" />
            @for (var index = 0; index < Methods.Count; index++)
            {
                var position = index;
                var method = Methods[position];
                var id = $"notification-method-{method.Method}";
                <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                    <GroveCheckBox Value="@method.Enabled" Change="@((bool value) => method.Enabled = value)" Name="@id" /><label for="@id" style="min-width: 10rem"> @method.Name</label>
                    <GroveButton Icon="arrow_upward" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small" title="@T["Move up"]" Click="@(() => Move(position, -1))" Disabled="@(position == 0)" />
                    <GroveButton Icon="arrow_downward" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small" title="@T["Move down"]" Click="@(() => Move(position, 1))" Disabled="@(position == Methods.Count - 1)" />
                </GroveStack>
            }
            <GroveText TextStyle="TextStyle.Caption" Text="@T["From the list above, you can sort the notification priority where the most important method is on the top."]" />
            <div><GroveButton Text="@T["Save notification methods"]" Icon="save" Click="SaveAsync" Disabled="IsSaving" data-testid="notification-preferences-save" /></div>
        </GroveStack>
    </GroveCard>
}

@code {
    /// <summary>The edited user's id; the signed-in user's own preferences when null.</summary>
    [Parameter] public string? UserId { get; set; }

    private List<MethodModel>? Methods;
    private bool IsSaving;
    private string? LoadedFor;

    private string Url => UserId is null ? "api/grove/notifications/preferences/me" : $"api/grove/notifications/preferences/users/{Uri.EscapeDataString(UserId)}";

    protected override async Task OnParametersSetAsync()
    {
        if (LoadedFor == Url) return;
        LoadedFor = Url;
        try
        {
            using var response = await Http.GetAsync(Url);
            Methods = response.IsSuccessStatusCode ? (await response.Content.ReadFromJsonAsync<PreferencesModel>())?.Methods.ToList() : null;
        }
        catch (HttpRequestException) { Methods = null; }
    }

    private void Move(int index, int offset)
    {
        if (Methods is null) return;
        var target = index + offset;
        if (target < 0 || target >= Methods.Count) return;
        (Methods[index], Methods[target]) = (Methods[target], Methods[index]);
    }

    private async Task SaveAsync()
    {
        if (Methods is null) return;
        IsSaving = true;
        try
        {
            using var response = await Http.PutAsJsonAsync(Url, new
            {
                Methods = Methods.Select(method => method.Method).ToArray(),
                Enabled = Methods.Where(method => method.Enabled).Select(method => method.Method).ToArray(),
            });
            if (!response.IsSuccessStatusCode)
            {
                Notifications.Notify(NotificationSeverity.Error, T["Notification Methods"], await response.Content.ReadAsStringAsync());
                return;
            }

            Methods = (await response.Content.ReadFromJsonAsync<PreferencesModel>())?.Methods.ToList();
            Notifications.Notify(NotificationSeverity.Success, T["Notification Methods"], T["The notification methods were saved."]);
        }
        finally { IsSaving = false; }
    }

    private sealed class MethodModel
    {
        public string Method { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public bool Enabled { get; set; }
    }

    private sealed record PreferencesModel(MethodModel[] Methods);
}

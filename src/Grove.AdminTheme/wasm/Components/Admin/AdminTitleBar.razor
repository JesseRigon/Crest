@using Grove.AdminTheme.Api
@using Grove.AdminTheme.State
@using Grove.AdminTheme.Options
@using Grove.Components.Inputs
@using Grove.Components.Display
@using Grove.Icons.Components
@using Microsoft.JSInterop
@using Grove.Components.Primitives
@using Grove.Components.Primitives
@inject NavigationManager Navigation
@inject RoutingOptions Routing
@inject IJSRuntime Js
@inject IApi Api
@inject NotificationService Notifications
@inject Grove.Components.Theme.GroveApiLocalizer T

<header class="admin-titlebar">
    @* Test-only hook (Playwright localization checks - docs/localization.md):
       AdminShellState.ResolvedCulture has no other reliable DOM signal, since the culture
       dropdown's visible label is optional (TitleBarSettings.DisplayCultureLabel) and
       its icon alone doesn't identify a specific culture unambiguously. *@
    <span data-testid="resolved-culture" hidden>@SelectedCulture</span>
    <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="admin-titlebar__left">
        @* The tenant chip shows the sidebar rendition (site › branding.sidebar) when one is set. *@
        <GroveAvatar ImageUrl="@(AdminShellState?.Branding?.Rendition("sidebar") is { Length: > 0 } sidebarLogo ? sidebarLogo : TitleBarSettings.TenantAvatarImageUrl)"
                     FallbackText="@TenantInitial"
                     AriaLabel="@T["{0} tenant", SelectedTenantName]"
                     BackgroundColor="var(--grove-color-accent-1, #2f6f4e)"
                     ForegroundColor="var(--grove-color-on-accent-1, #fff)"
                     Shape="@TenantAvatarShape"
                     ClipPath="@TitleBarSettings.TenantAvatarClipPath"
                     BorderRadius="@TitleBarSettings.TenantAvatarBorderRadius"
                     Class="admin-titlebar__tenant-avatar" />

        @* The one switcher (docs/shells-and-themes.md › Member sessions and sides): the
           accounts this device signed in to, then this tenant's organizations the user is
           bound to - choosing one opens the member portal with it active. *@
        <GroveShellSwitcher TenantName="@SwitcherTenantName"
                            TenantBase="@Routing.TenantBase"
                            UserName="@(AdminShellState?.IsAuthenticated == true ? UserName : null)"
                            HomeUrl="@Routing.AdminPath"
                            AddAccountUrl="@(Routing.LoginPath + "?switchUser=true")"
                            Organizations="@SwitcherOrganizations"
                            TenantsHeading="@T["Accounts on this device"]"
                            OrganizationsHeading="@T["Organizations"]"
                            AddAccountText="@T["Add an account"]"
                            RemoveText="@T["Remove from this device"]"
                            class="admin-titlebar__tenant-selector" />
    </GroveStack>

    @if (AdminShellState?.Manifest?.AdminSettings.DisplayTitlesInTopbar == true && !string.IsNullOrWhiteSpace(CurrentTitle))
    {
        <div class="admin-titlebar__page-title">@CurrentTitle</div>
    }

    <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem" class="admin-titlebar__right">
        @if (CultureOptions.Length > 1)
        {
            <GroveDropDown TValue="string"
                            Data="CultureOptions"
                            Value="@SelectedCulture"
                            ValueChanged="SelectCultureAsync"
                            TextProperty="@nameof(CultureOption.Label)"
                            ValueProperty="@nameof(CultureOption.Value)"
                            ValueTemplate="CultureValueTemplate"
                            Template="CultureOptionTemplate"
                            FooterTemplate="CultureFooterTemplate"
                            AllowFiltering="true"
                            FilterPlaceholder="@T["Filter cultures"]"
                            class="admin-titlebar__culture-selector"
                            Style="color: var(--grove-color-accent-1, #2f6f4e); border-color: transparent;" />
        }

        @if (AdminShellState?.Manifest?.AdminSettings.DisplayThemeToggler != false)
        {
            <button type="button" class="admin-titlebar__icon-button" @onclick="ToggleThemeAsync" title="@T["Toggle dark/light mode"]" aria-label="@T["Toggle dark/light mode"]">
                <PlatformIcon IconKey="@ThemeToggleIcon" Size="1.25rem" />
            </button>
        }

        @* Portal notifications (docs/media.md requirement 30): renders nothing while the
           tenant has the feature off. *@
        <Grove.Components.Files.GrovePortalNotifications />

        @* Three tiers, always in this order: (1) the native, admin-editable
           MenuPlacement.User AdminMenu, gated purely by each node's own Grove
           permission (no per-user/role targeting beyond that); (2) a hardcoded,
           permission-gated slot, currently empty but always present so future built-in
           items (e.g. impersonation/support tools) have a defined place to land; (3) the
           hardcoded tenant/browser-session slot — the known-signed-in-users list (browser
           localStorage, so this can never be a server-defined nav item), "Sign in as
           another user", then Logout. See docs/localization.md's "User Profile
           Menu" section. *@
        <GroveProfileMenu class="admin-titlebar__avatar-menu" ShowIcon="false" ToggleAriaLabel="@T["Open user menu"]" Click="OnProfileMenuItemClickedAsync">
            <Template>
                <GroveAvatar FallbackText="@UserInitials"
                             AriaLabel="@UserName"
                             BackgroundColor="transparent"
                             ForegroundColor="var(--grove-color-accent-1, #2f6f4e)"
                             Shape="GroveAvatarShape.Circle"
                             Class="admin-titlebar__avatar" />
            </Template>
            <ChildContent>
                @* Tier 1: native MenuPlacement.User menu, editable via Admin Menus. *@
                @if (ProfileMenuItems.Length > 0)
                {
                    @foreach (var item in ProfileMenuItems)
                    {
                        <GroveProfileMenuItem Text="@item.Text" Path="@item.Link" />
                    }
                    <li class="admin-titlebar__profile-separator" aria-hidden="true"></li>
                }

                @* Tier 2: hardcoded, permission-gated slot — always present, currently empty. *@

                @* Tier 3: hardcoded tenant/browser-session slot. *@
                @if (OtherKnownUsers.Any())
                {
                    <li class="admin-titlebar__known-users" role="presentation">
                        <ul class="admin-titlebar__known-users-list">
                            @foreach (var user in OtherKnownUsers)
                            {
                                <GroveProfileMenuItem Text="@UserLabel(user)" Value="@($"switch-user:{user.UserName}")" />
                            }
                        </ul>
                    </li>
                }
                <GroveProfileMenuItem Text="@T["Sign in as another user"]" Value="switch-user" />
                <GroveProfileMenuItem Text="@T["Settings"]" Path="Profile/Settings" />
                <GroveProfileMenuItem Text="@T["Log out"]" Value="logout" class="admin-titlebar__profile-separator" />
            </ChildContent>
        </GroveProfileMenu>
    </GroveStack>
</header>

@code {
    [CascadingParameter]
    public AdminShellState? AdminShellState { get; set; }

    // A dual user's member organizations on this tenant, each opening the member portal at its
    // own path. Server data, from the user's bindings; empty for staff-only users.
    private IReadOnlyList<GroveShellSwitcherOrganization> SwitcherOrganizations =>
        (AdminShellState?.Manifest?.Organizations ?? [])
            .Select(organization => new GroveShellSwitcherOrganization(
                organization.Id,
                organization.Name,
                Routing.MemberPath.TrimEnd('/') + "/" + Uri.EscapeDataString(organization.Slug) + "/"))
            .ToArray();

    private string SelectedTenantName => AdminShellState?.Manifest?.Tenant.Name ?? T["Tenant"];
    // The tenant's display name (docs/branding.md: ISite.SiteName), the same one the member
    // shell shows, so one device entry reads the same from either side.
    private string SwitcherTenantName => AdminShellState?.Manifest?.Site.SiteName is { Length: > 0 } siteName ? siteName : SelectedTenantName;
    private string UserName => AdminShellState?.User.UserName ?? T["User"];
    // Static SSR: IsActive resolves Navigation.Uri against Navigation.BaseUri, and
    // during prerender Uri is the server-side rewritten request path (not the
    // browser URL) while BaseUri is the site root (not this shell's <base href>),
    // so the computed "current page" title would be wrong in the prerendered
    // paint. Skip it there; the interactive phase (circuit or WASM) recomputes it
    // from the real browser URL.
    private string? CurrentTitle => RendererInfo.IsInteractive ? FindCurrentTitle(AdminShellState?.AdminMenu?.Items) : null;
    private DisplayMenuItem[] ProfileMenuItems => AdminShellState?.ProfileMenu?.Items ?? [];
    private string TenantInitial => string.IsNullOrWhiteSpace(SelectedTenantName) ? "?" : SelectedTenantName[..1].ToUpperInvariant();
    private string UserInitials => GetInitials(UserName);
    private LocalUser[] KnownUsers { get; set; } = [];
    private IEnumerable<LocalUser> OtherKnownUsers => KnownUsers
        .Where(user => !user.UserName.Equals(UserName, StringComparison.OrdinalIgnoreCase));
    private string ThemeToggleIcon { get; set; } = "iconify.mdi/current/default/weather-night";
    private string? LastRememberedUserContext { get; set; }
    private CultureOption[] CultureOptions => AdminShellState?.Manifest?.CultureSelector.Cultures ?? [];
    private string? SelectedCulture => AdminShellState?.ResolvedCulture;
    private bool IsSavingDefaultCulture { get; set; }
    private TitleBarSettingsDto TitleBarSettings => AdminShellState?.Manifest?.TitleBarSettings ?? TitleBarSettingsDto.Default;
    private GroveAvatarShape TenantAvatarShape => Enum.TryParse<GroveAvatarShape>(TitleBarSettings.TenantAvatarShape, true, out var shape)
        ? shape
        : GroveAvatarShape.Circle;
    // Trigger-surface rendering: shown for the currently selected value.
    private RenderFragment<dynamic> CultureValueTemplate => item => builder =>
    {
        var culture = (CultureOption)item;
        builder.OpenComponent<PlatformIcon>(0);
        builder.AddAttribute(1, nameof(PlatformIcon.IconKey), culture.Icon);
        builder.AddAttribute(2, nameof(PlatformIcon.Size), "1.1rem");
        builder.CloseComponent();
        if (TitleBarSettings.DisplayCultureLabel)
        {
            builder.OpenElement(3, "span");
            builder.AddAttribute(4, "class", "admin-titlebar__culture-option-label");
            builder.AddContent(5, culture.Label);
            builder.CloseElement();
        }
    };

    // Option-surface rendering: shown for each row in the open popup list.
    private RenderFragment<dynamic> CultureOptionTemplate => item => builder =>
    {
        var culture = (CultureOption)item;
        builder.OpenComponent<PlatformIcon>(0);
        builder.AddAttribute(1, nameof(PlatformIcon.IconKey), culture.Icon);
        builder.AddAttribute(2, nameof(PlatformIcon.Size), "1.1rem");
        builder.CloseComponent();
        builder.OpenElement(3, "span");
        builder.AddAttribute(4, "class", "admin-titlebar__culture-option-label");
        builder.AddContent(5, culture.Label);
        builder.CloseElement();
    };

    // Picking a culture from the list above only changes the current session (today's
    // behavior, unchanged). This is a separate, explicit second action that persists the
    // *currently selected* culture as the user's stored default, via the same self-service
    // endpoint the Settings page's localization section uses — see
    // docs/localization.md's "Culture picker: save-as-default" section.
    private RenderFragment CultureFooterTemplate => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "admin-titlebar__culture-footer");
        builder.OpenComponent<GroveButton>(2);
        builder.AddAttribute(3, nameof(GroveButton.Text), T["Save as default"]);
        builder.AddAttribute(4, nameof(GroveButton.Icon), "bookmark");
        builder.AddAttribute(5, nameof(GroveButton.ButtonStyle), ButtonStyle.Light);
        builder.AddAttribute(6, nameof(GroveButton.Size), ButtonSize.Small);
        builder.AddAttribute(7, nameof(GroveButton.Disabled), IsSavingDefaultCulture || string.IsNullOrWhiteSpace(SelectedCulture));
        builder.AddAttribute(8, nameof(GroveButton.Click), EventCallback.Factory.Create<MouseEventArgs>(this, SaveDefaultCultureAsync));
        builder.CloseComponent();
        builder.CloseElement();
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var shouldRender = false;
        if (firstRender)
        {
            var isDark = await Js.InvokeAsync<bool>("groveTheme.isDarkMode");
            ThemeToggleIcon = isDark
                ? "iconify.mdi/current/default/weather-sunny"
                : "iconify.mdi/current/default/weather-night";
            shouldRender = true;
        }

        if (AdminShellState?.IsAuthenticated == true)
        {
            var tenantPrefix = AdminShellState.Manifest?.Tenant.RequestUrlPrefix ?? string.Empty;
            var context = $"{UserName}|{SelectedTenantName}|{tenantPrefix}";
            if (!string.Equals(context, LastRememberedUserContext, StringComparison.Ordinal))
            {
                KnownUsers = await Js.InvokeAsync<LocalUser[]>("groveTheme.rememberSignedInUser", UserName, SelectedTenantName, tenantPrefix);
                LastRememberedUserContext = context;
                shouldRender = true;
            }
        }

        if (shouldRender)
        {
            StateHasChanged();
        }
    }

    private string? FindCurrentTitle(IEnumerable<DisplayMenuItem>? items)
    {
        if (items is null)
        {
            return null;
        }

        foreach (var item in items)
        {
            var childTitle = FindCurrentTitle(item.Items);
            if (!string.IsNullOrWhiteSpace(childTitle))
            {
                return childTitle;
            }

            if (IsActive(item))
            {
                return item.Text;
            }
        }

        return null;
    }

    private bool IsActive(DisplayMenuItem item)
    {
        if (!item.HasLink)
        {
            return false;
        }

        var current = '/' + Navigation.ToBaseRelativePath(Navigation.Uri).TrimStart('/');
        var link = item.Link!.StartsWith('/') ? item.Link : '/' + item.Link;
        return current.Equals(link, StringComparison.OrdinalIgnoreCase)
            || current.StartsWith(link.TrimEnd('/') + '/', StringComparison.OrdinalIgnoreCase);
    }

    private async Task ToggleThemeAsync()
    {
        var isDark = await Js.InvokeAsync<bool>("groveTheme.toggleMode");
        ThemeToggleIcon = isDark
            ? "iconify.mdi/current/default/weather-sunny"
            : "iconify.mdi/current/default/weather-night";
    }

    private async Task SelectCultureAsync(string? culture)
    {
        var selector = AdminShellState?.Manifest?.CultureSelector;
        if (selector is null || string.IsNullOrWhiteSpace(culture) ||
            string.Equals(culture, SelectedCulture, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        // Rung 1 of the resolution chain (docs/localization.md's "Resolution
        // architecture"): record this as the explicit session override so it wins on every
        // future resolution this browser session, then write the resolved cookie immediately
        // so the reload below (and any legacy same-origin iframe page) picks it up right away
        // rather than waiting for the next manifest refresh to re-derive it.
        await Js.InvokeVoidAsync("groveTheme.setSessionCultureOverride", AdminShellState?.User.UserName, culture);
        await Js.InvokeVoidAsync("groveTheme.setAdminCulture", selector.CookieName, selector.CookiePath, culture);
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private async Task SaveDefaultCultureAsync()
    {
        if (IsSavingDefaultCulture || string.IsNullOrWhiteSpace(SelectedCulture))
        {
            return;
        }

        IsSavingDefaultCulture = true;
        try
        {
            var saved = await Api.Grove.Rest.Localization.SetMyCultureAsync(new UserCulture(SelectedCulture));
            Notifications.Notify(
                saved is null ? NotificationSeverity.Error : NotificationSeverity.Success,
                T["Default language"],
                saved is null ? T["Unable to save your default language."] : T["Saved as your default language."]);
        }
        finally
        {
            IsSavingDefaultCulture = false;
        }
    }

    // GroveProfileMenuItem has no Click parameter of its own — clicks only surface
    // through the parent GroveProfileMenu's single Click EventCallback, dispatched with
    // the clicked item as the argument. This switches on Value to route tier-1 action
    // items to their real handler.
    private async Task OnProfileMenuItemClickedAsync(Grove.Components.Primitives.GroveProfileMenuItem item)
    {
        switch (item.Value)
        {
            case "logout":
                await LogoutAsync();
                break;
            case "switch-user":
                await SignInAsAnotherUserAsync();
                break;
            case { } value when value.StartsWith("switch-user:", StringComparison.Ordinal):
                var userName = value["switch-user:".Length..];
                var user = OtherKnownUsers.FirstOrDefault(candidate => candidate.UserName.Equals(userName, StringComparison.OrdinalIgnoreCase));
                if (user is not null)
                {
                    await SignInAsUserAsync(user);
                }

                break;
        }
    }

    private async Task SignInAsAnotherUserAsync()
    {
        if (AdminShellState is not null)
        {
            await AdminShellState.LogoutAsync();
        }

        Navigation.NavigateTo(BuildLoginPath(AdminShellState?.Manifest?.Tenant.RequestUrlPrefix, null), forceLoad: true);
    }

    private async Task SignInAsUserAsync(LocalUser user)
    {
        if (AdminShellState is not null)
        {
            await AdminShellState.LogoutAsync();
        }

        Navigation.NavigateTo(BuildLoginPath(user.LastTenantPrefix, user.UserName), forceLoad: true);
    }

    private async Task LogoutAsync()
    {
        if (AdminShellState is null)
        {
            return;
        }

        await AdminShellState.LogoutAsync();
        // Crossing from the admin shell (base href = AdminPath) to the login shell
        // (base href = LoginPath) requires a full reload so the browser re-fetches
        // the document with the correct <base> tag - see ShellSelectionMiddleware's
        // PathBase shift and App.razor. A same-document SPA navigation would leave
        // the already-loaded Router trying to match Routing.LoginPath against the
        // admin shell's route table and fail.
        Navigation.NavigateTo(Routing.LoginPath, forceLoad: true);
    }

    // tenantPrefix identifies a *different* tenant than the one this shell was
    // built for, so its real, configured LoginPath is unknowable client-side
    // without an API call - "/login" (Platform/Grove's shared stock default) is the
    // best available fallback for that cross-tenant case. When switching within the
    // current tenant (tenantPrefix is null/empty), Routing.LoginPath is used instead
    // since it reflects this tenant's actual, possibly-customized LoginPath.
    private string BuildLoginPath(string? tenantPrefix, string? userName)
    {
        var path = string.IsNullOrWhiteSpace(tenantPrefix)
            ? Routing.LoginPath
            : $"/{tenantPrefix.Trim('/')}/login";
        // "true", not "1": Login binds switchUser as a bool, and Blazor parses only true/false.
        var query = new List<string> { "switchUser=true" };
        if (!string.IsNullOrWhiteSpace(userName))
        {
            query.Add($"userName={Uri.EscapeDataString(userName)}");
        }

        return path + "?" + string.Join("&", query);
    }

    private static string UserLabel(LocalUser user) => string.IsNullOrWhiteSpace(user.LastTenantName)
        ? user.UserName
        : $"{user.UserName} · {user.LastTenantName}";

    private static string GetInitials(string value)
    {
        var parts = value.Split([' ', '.', '_', '-'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length >= 2)
        {
            return string.Concat(parts[0][0], parts[1][0]).ToUpperInvariant();
        }

        return value.Length switch
        {
            0 => "?",
            1 => value[..1].ToUpperInvariant(),
            _ => value[..2].ToUpperInvariant(),
        };
    }

    private sealed class LocalUser
    {
        public string UserName { get; set; } = string.Empty;
        public string LastTenantName { get; set; } = string.Empty;
        public string LastTenantPrefix { get; set; } = string.Empty;
        public string LastSeenUtc { get; set; } = string.Empty;
        public LocalTenantContext[] Tenants { get; set; } = [];
    }

    private sealed class LocalTenantContext
    {
        public string TenantName { get; set; } = string.Empty;
        public string TenantPrefix { get; set; } = string.Empty;
        public string LastSeenUtc { get; set; } = string.Empty;
    }
}

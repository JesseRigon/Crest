@attribute [Route(MemberRoutePaths.ResetPassword)]
@attribute [AllowAnonymous]
@attribute [Grove.Components.Modules.OrganizationFreePage]
@namespace Grove.MemberTheme.Pages

@* Sets a new password from the code in the emailed link (MemberForgotPassword). It does not
   sign in, so it sets no cookie: the member signs in afterwards on the member login. *@

<PageTitle>Choose a new password</PageTitle>

<div class="grove-member-centred" data-testid="member-reset-password">
    <GroveStack Gap="1rem" Style="width: 22rem; max-width: 100%;">
        <GroveText TextStyle="TextStyle.H5" Text="Choose a new password" />

        @if (_done)
        {
            <GroveText TextStyle="TextStyle.Body2"
                       Text="Your password has been reset."
                       data-testid="member-reset-password-done" />
        }
        else if (string.IsNullOrWhiteSpace(Code))
        {
            <GroveText TextStyle="TextStyle.Body2"
                       Text="This link is not valid. Request a new one."
                       data-testid="member-reset-password-invalid" />
            <GroveLink Path="@MemberShellLinks.Relative(MemberRoutePaths.ForgotPassword)" Text="Reset your password" />
        }
        else
        {
            <GroveTextBox @bind-Value="_userNameOrEmail"
                          Placeholder="User name or email"
                          Disabled="@_busy"
                          data-testid="member-reset-password-username" />

            <GrovePassword @bind-Value="_password"
                           Placeholder="New password"
                           Disabled="@_busy"
                           data-testid="member-reset-password-password" />

            <GrovePassword @bind-Value="_confirm"
                           Placeholder="Confirm the new password"
                           Disabled="@_busy"
                           data-testid="member-reset-password-confirm" />

            <GroveButton Text="Reset password"
                         Click="@ResetAsync"
                         Disabled="@(_busy || !RendererInfo.IsInteractive)"
                         data-testid="member-reset-password-submit" />
        }

        @if (_error is { Length: > 0 })
        {
            <GroveText TextStyle="TextStyle.Caption" Text="@_error" data-testid="member-reset-password-error" />
        }

        <GroveLink Path="@MemberShellLinks.Relative(MemberRoutePaths.Login)" Text="Sign in" />
    </GroveStack>
</div>

@code {
    [CascadingParameter]
    private IMemberAuthenticationService Auth { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "code")]
    public string? Code { get; set; }

    private string _userNameOrEmail = string.Empty;
    private string _password = string.Empty;
    private string _confirm = string.Empty;
    private bool _busy;
    private bool _done;
    private string? _error;

    private async Task ResetAsync()
    {
        if (!string.Equals(_password, _confirm, StringComparison.Ordinal))
        {
            _error = "The two passwords do not match.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var result = await Auth.ResetPasswordAsync(_userNameOrEmail, Code!, _password);
            _done = result.Succeeded;
            _error = result.Succeeded ? null : result.Error ?? "The password could not be reset.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}

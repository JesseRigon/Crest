@attribute [Route(MemberRoutePaths.ForgotPassword)]
@attribute [AllowAnonymous]
@attribute [Grove.Components.Modules.OrganizationFreePage]
@namespace Grove.MemberTheme.Pages

@* Member password recovery, at the member shell's own base: the staff and member account
   pages are separate by construction, like the two login pages. The emailed link opens the
   member reset page, never the tenant's. The answer is the same whether or not the account
   exists - an unauthenticated caller does not get to learn that. *@

<PageTitle>Reset your password</PageTitle>

<div class="grove-member-centred" data-testid="member-forgot-password">
    <GroveStack Gap="1rem" Style="width: 22rem; max-width: 100%;">
        <GroveText TextStyle="TextStyle.H5" Text="Reset your password" />

        @if (_sent)
        {
            <GroveText TextStyle="TextStyle.Body2"
                       Text="If an account matches, a link to reset its password has been sent to its email address."
                       data-testid="member-forgot-password-sent" />
        }
        else
        {
            <GroveTextBox @bind-Value="_userNameOrEmail"
                          Placeholder="User name or email"
                          Disabled="@_busy"
                          data-testid="member-forgot-password-username" />

            <GroveButton Text="Send reset link"
                         Click="@SendAsync"
                         Disabled="@(_busy || !RendererInfo.IsInteractive)"
                         data-testid="member-forgot-password-submit" />
        }

        @if (_error is { Length: > 0 })
        {
            <GroveText TextStyle="TextStyle.Caption" Text="@_error" data-testid="member-forgot-password-error" />
        }

        <GroveLink Path="@MemberShellLinks.Relative(MemberRoutePaths.Login)" Text="Back to sign in" />
    </GroveStack>
</div>

@code {
    [CascadingParameter]
    private IMemberAuthenticationService Auth { get; set; } = default!;

    private string _userNameOrEmail = string.Empty;
    private bool _busy;
    private bool _sent;
    private string? _error;

    private async Task SendAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Auth.RequestPasswordResetAsync(_userNameOrEmail);
            _sent = result.Succeeded;
            _error = result.Succeeded ? null : result.Error;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}

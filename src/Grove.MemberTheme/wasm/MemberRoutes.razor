@using System.Reflection
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.WebAssembly.Services
@using Microsoft.Extensions.DependencyInjection
@using Grove.Components.Modules
@using Grove.Components.Primitives
@using Grove.MemberTheme.Components
@using Grove.Shell
@inject IServiceProvider Services

@* The member shell's Routes component, the member-bucket counterpart of AdminRoutes,
   mounted by Grove.Server's theme-dispatching Components/App.razor. It must live in this
   client assembly rather than in Server: the WASM runtime only has the assemblies it was
   compiled with, so a Routes defined server-side resolves over the circuit and then throws
   the moment InteractiveAuto switches to WASM. See docs/blazor-web.md.

   Before rendering anything it loads the member shell's module libraries, activates the
   seam implementations they supply (IMemberShellContext, IMemberAuthenticationService),
   loads the member's session into the shell context, then cascades them to the layout
   and pages. Those implementations cannot be registered
   in the WASM container the usual way: their libraries are lazy, and the container is
   sealed at builder.Build(), before any lazy assembly can load. *@

<GroveNotification />

@if (_ready)
{
    <CascadingValue Value="_shellContext" IsFixed="true">
        <CascadingValue Value="_authentication" IsFixed="true">
            <Router AppAssembly="@typeof(MemberRoutes).Assembly" AdditionalAssemblies="@_assemblies">
                <Found Context="routeData">
                    @if (IsOrganizationFree(routeData) != IsOrganizationFreeDocument)
                    {
                        @* The same split the server applies: an organization-free page (sign-in,
                           the picker) only at the member base, every other page only under an
                           organization. Client-side navigation must not cross it. *@
                        <MemberNotFound />
                    }
                    else if (IsShelllessRoute(routeData))
                    {
                        <RouteView RouteData="@routeData" />
                    }
                    else
                    {
                        <MemberLayout>
                            <RouteView RouteData="@routeData" />
                        </MemberLayout>
                    }
                </Found>
                <NotFound>
                    @* A member URL with no member page. Deliberately NOT the LegacyAdminFrame
                       that AdminRoutes falls back to: that frame is Grove's admin UI, which
                       a member has no business being shown. *@
                    <MemberNotFound />
                </NotFound>
            </Router>
        </CascadingValue>
    </CascadingValue>
}

@code {
    private Assembly[] _assemblies = [];
    private IMemberShellContext _shellContext = new EmptyMemberShellContext();
    private IMemberAuthenticationService _authentication = new UnavailableMemberAuthenticationService();
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        // Browser: load every member module library. Server (prerender): nothing to load,
        // every assembly is already in the process - the loader is simply not attached.
        if (Services.GetService<LazyModules>() is { } lazyModules)
        {
            if (Services.GetService<LazyAssemblyLoader>() is { } loader)
            {
                lazyModules.Attach(loader);
            }

            await lazyModules.EnsureShellAsync(GroveShells.Member);
        }

        // ONLY member-shell assemblies, and not this theme client itself (whose own pages the
        // Router already gets as AppAssembly, and whose fallbacks must not count as a module's
        // implementation). Handing this Router an admin library would make that library's
        // pages routable inside the member shell on client-side navigation - past the
        // server's route gate. See GroveShellAttribute.
        var themeAssembly = typeof(MemberRoutes).Assembly;
        _assemblies =
        [
            .. AppDomain.CurrentDomain.GetAssemblies()
                .Where(assembly => assembly != themeAssembly
                    && assembly.GetCustomAttribute<GroveShellAttribute>() is not null
                    && ShellAssemblyFilter.BelongsTo(assembly, GroveShells.Member))
        ];

        _shellContext = Activate<IMemberShellContext>() ?? _shellContext;
        _authentication = Activate<IMemberAuthenticationService>() ?? _authentication;

        // Loaded once, here, before any member page renders: every page then reads a
        // loaded context. Loading it later (in the layout) would leave a page that already
        // rendered with an empty context, since a page with no parameters is not
        // re-rendered when its layout is.
        await _shellContext.EnsureLoadedAsync();
        _ready = true;
    }

    // A module's implementation of a shell seam, created against the container so it gets
    // the container's services (HttpClient, options) through its constructor. Grove looks
    // for an implementation of ITS OWN interface and never names the module - the dependency
    // still runs one way, module to Grove.
    private TService? Activate<TService>() where TService : class
    {
        var implementation = _assemblies
            .SelectMany(ExportedTypes)
            .FirstOrDefault(type => type is { IsClass: true, IsAbstract: false } && typeof(TService).IsAssignableFrom(type));

        return implementation is null
            ? null
            : (TService)ActivatorUtilities.CreateInstance(Services, implementation);
    }

    private static Type[] ExportedTypes(Assembly assembly)
    {
        try
        {
            return assembly.GetExportedTypes();
        }
        catch (ReflectionTypeLoadException)
        {
            // A module whose types cannot all be loaded must not take the shell down with it.
            return [];
        }
    }

    // Shell-less: any page declaring [AllowAnonymous] - the same marker the server gate reads,
    // so a public page a module contributes is public end to end.
    // Organization-free pages (sign-in, registration, password reset, the picker) have no
    // active organization to put in a nav, so they render their own centred card too.
    private static bool IsShelllessRoute(RouteData routeData)
        => IsOrganizationFree(routeData)
            || routeData.PageType.IsDefined(typeof(AllowAnonymousAttribute), inherit: false);

    private static bool IsOrganizationFree(RouteData routeData) =>
        routeData.PageType.IsDefined(typeof(OrganizationFreePageAttribute), inherit: false);

    // Whether this document is the member base (no organization in its path).
    private bool IsOrganizationFreeDocument =>
        (Services.GetService<GroveShellContext>()?.OrganizationSlug) is not { Length: > 0 };
}

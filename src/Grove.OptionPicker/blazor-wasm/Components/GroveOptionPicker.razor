@namespace Grove.OptionPicker.Components
@using Grove.Components.Models
@using Grove.Components.Primitives

<div class="grove-option-picker">
    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <GroveAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@Error</GroveAlert>
    }

    @* A multiple picker's value is the list of ids, a single one's the one id: the grid filters
       its rows by comparing ids with the value. *@
    <GroveDropDownDataGrid TValue="object"
                           Data="@Rows"
                           Value="@(Multiple ? SelectedIds : SelectedIds.FirstOrDefault())"
                           Multiple="@Multiple"
                           Chips="@Multiple"
                           AllowFiltering="true"
                           AllowClear="@(!Required)"
                           Disabled="@Disabled"
                           Placeholder="@Placeholder"
                           TextProperty="@nameof(OptionPickerRow.Text)"
                           ValueProperty="Id"
                           LoadData="@OnLoadDataAsync"
                           Change="@OnChangeAsync"
                           Style="width: 100%;"
                           data-testid="@TestId">
        <Columns>
            @foreach (var column in VisibleColumns)
            {
                @* Drawn by the template: a value in Values is not a member a property path can read;
                   the drop-down searches by the row's Text. *@
                <GroveDropDownDataGridColumn Title="@column.Label"
                                             Width="@column.Width">
                    <Template Context="row">
                        @ReadValue((OptionPickerRow)row, column.Path)
                    </Template>
                </GroveDropDownDataGridColumn>
            }
        </Columns>
    </GroveDropDownDataGrid>

    @if (ShowSelectedList && SelectedIds.Count > 0)
    {
        @* The selection in its stored order: edit links where the source gives one (opened in a
           new tab so the item being edited stays open), reordering when several are held. *@
        <ul class="grove-option-picker__selected" data-testid="@(TestId is null ? null : TestId + "-selected")">
            @for (var index = 0; index < SelectedIds.Count; index++)
            {
                var position = index;
                var id = SelectedIds[index];
                var row = Rows.FirstOrDefault(candidate => candidate.Id == id);
                <li @key="id">
                    @if (!string.IsNullOrWhiteSpace(row?.EditUrl))
                    {
                        <a href="@row.EditUrl" target="_blank">@(row.Text ?? id)</a>
                    }
                    else
                    {
                        <span>@(row?.Text ?? id)</span>
                    }
                    @if (Multiple && !Disabled)
                    {
                        <GroveButton Icon="arrow_upward" Variant="Variant.Text" Size="ButtonSize.ExtraSmall" title="Move up"
                                     Disabled="@(position == 0)" Click="@(() => MoveAsync(position, -1))" />
                        <GroveButton Icon="arrow_downward" Variant="Variant.Text" Size="ButtonSize.ExtraSmall" title="Move down"
                                     Disabled="@(position == SelectedIds.Count - 1)" Click="@(() => MoveAsync(position, 1))" />
                    }
                </li>
            }
        </ul>
    }

    @if (!Disabled && CreateLinks.Count > 0)
    {
        <div class="grove-option-picker__create">
            @foreach (var link in CreateLinks)
            {
                <a @key="link.Url" class="rz-button rz-light rz-button-sm" href="@link.Url" target="_blank">@link.Label</a>
            }
        </div>
    }
</div>

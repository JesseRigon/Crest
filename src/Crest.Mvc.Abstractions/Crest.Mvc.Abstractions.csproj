<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Crest.Mvc</RootNamespace>

    <!-- NuGet properties-->
    <Title>Crest Mvc Abstractions</Title>
    <Description>$(OCFrameworkDescription)

    The MVC contracts the display drivers and the admin modules use: model binding (IUpdateModel), tag helper discovery and filter extensions. Kept apart from the display contracts, which also load in the browser.</Description>
    <PackageTags>$(PackageTags) PlatformFramework Mvc Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Razor">
  <Import Project="$(PlatformSrcDir)Crest.Module.Targets\Crest.Module.Targets.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
    <ProjectReference Include="$(PlatformSrcDir)Crest.Contents\Crest.Contents.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Crest.Module.Targets\Crest.Module.Targets.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Crest.ContentManagement\Crest.ContentManagement.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Crest.Title\Crest.Title.csproj" />
  </ItemGroup>

  <ItemGroup Label="Crest.Workflows">
    <ProjectReference Include="..\engine\src\modules\Crest.Workflows.Expressions.JavaScript\Crest.Workflows.Expressions.JavaScript.csproj" />
    <ProjectReference Include="..\engine\src\modules\Crest.Workflows.Core\Crest.Workflows.Core.csproj" />
    <ProjectReference Include="..\engine\src\modules\Crest.Workflows.Management\Crest.Workflows.Management.csproj" />
    <ProjectReference Include="..\engine\src\modules\Crest.Workflows.Runtime\Crest.Workflows.Runtime.csproj" />
    <ProjectReference Include="..\engine\src\modules\Crest.Workflows.Engine\Crest.Workflows.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Server\Crest.Workflows.csproj" />
  </ItemGroup>
</Project>

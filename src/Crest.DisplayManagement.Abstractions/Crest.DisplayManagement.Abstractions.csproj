<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Crest.DisplayManagement</RootNamespace>
    <Nullable>enable</Nullable>

    <!-- NuGet properties-->
    <Title>Crest DisplayManagement Abstractions</Title>
    <Description>$(OCFrameworkDescription)

    The display contracts shared by the server and the browser: the display tree, the component registry and the tree renderer.</Description>
    <PackageTags>$(PackageTags) PlatformFramework DisplayManagement Abstractions</PackageTags>
  </PropertyGroup>

  <!-- No server framework: the display contracts (the display tree, the component registry,
       the tree renderer) load in the browser as well as on the server. The MVC contracts that
       used to live here are in Crest.Mvc.Abstractions. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components" />
  </ItemGroup>

  <!-- The component catalog generator travels with the contracts it implements: consumers of
       this package (directly or through Crest.Components) get it through buildTransitive. See
       buildTransitive/Crest.DisplayManagement.Abstractions.targets. The generator is built
       first through the analyzer reference Crest.Commons.props gives every platform project. -->
  <ItemGroup>
    <None Update="buildTransitive\Crest.DisplayManagement.Abstractions.targets" Pack="true" PackagePath="buildTransitive\" />
    <None Include="$(PlatformSrcDir)Crest.SourceGenerators\bin\$(Configuration)\netstandard2.0\Crest.SourceGenerators.dll" Pack="true" PackagePath="buildTransitive\analyzers\" Visible="false" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <!-- NuGet properties-->
    <Title>Grove DisplayManagement</Title>
    <Description>$(OCFrameworkDescription)

    Library for DisplayManagement. Provides BaseDisplayManager, Shape, Layout and Theming support.</Description>
    <PackageTags>$(PackageTags) PlatformFramework DisplayManagement</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Grove.Tests" />
    <InternalsVisibleTo Include="Grove.Display.Management.Razor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grove.Access.Abstractions\Grove.Access.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Infrastructure.Abstractions\Grove.Infrastructure.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Display.Management.Abstractions\Grove.Display.Management.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Display.Liquid.Abstractions\Grove.Display.Liquid.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Data.Localization.Abstractions\Grove.Data.Localization.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Castle.Core" />
  </ItemGroup>

</Project>

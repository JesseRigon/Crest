@* The document of the pre-database setup shell: static SSR only (no interactivity, no Grove
   theme). The setup shell maps it while the tenant is uninitialized (Startup). *@
@inject NavigationManager Navigation

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name" dir="@(CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="@Navigation.BaseUri" />
    <link rel="icon" href="Grove.Infrastructure.Setup/favicon.ico" />
    <link rel="stylesheet" href="Grove.Infrastructure.Setup/Styles/setup.min.css" />
    <HeadOutlet />
</head>
<body>
    <div class="container">
        <Router AppAssembly="typeof(SetupDocument).Assembly">
            <Found Context="route">
                <RouteView RouteData="route" />
            </Found>
            <NotFound>
                <p>Not found.</p>
            </NotFound>
        </Router>
    </div>
</body>
</html>

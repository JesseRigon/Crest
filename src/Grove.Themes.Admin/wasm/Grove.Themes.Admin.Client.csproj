<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Phase 8: converted from Microsoft.NET.Sdk.BlazorWebAssembly (a standalone WASM
       app entry with its own index.html + Program.Main) to a Razor class library. A
       Blazor Web App has exactly ONE WASM entry project - the host app's -
       which references this library (and Site's and Member's) and runs
       ClientWebAssemblyHost. This project is the admin theme's UI - pages, components,
       AdminRoutes - and loads only when the admin shell is opened. Its services (the
       boot path, AddAdminClient, the module registry) are
       client-services/Grove.Themes.Admin.Client.Services, loaded at boot. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Grove.Themes.Admin.Client</AssemblyName>
    <RootNamespace>Grove.Themes.Admin</RootNamespace>
    <PlatformCompatibilityVersion>4.0.0</PlatformCompatibilityVersion>
    <GroveSecurityPatch>0</GroveSecurityPatch>
    <GroveBugPatch>0</GroveBugPatch>
    <GroveVersion>$(PlatformCompatibilityVersion).$(GroveSecurityPatch).$(GroveBugPatch)</GroveVersion>
    <VersionPrefix>$(PlatformCompatibilityVersion)</VersionPrefix>
    <PackageVersion>$(PlatformCompatibilityVersion)</PackageVersion>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>
    <AssemblyInformationalVersion>$(GroveVersion)</AssemblyInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDK default items discover C#, Razor components, colocated .razor.css, and wwwroot assets. -->
    <Watch Include="**\*.cs;**\*.razor;wwwroot\**\*" Exclude="bin\**;obj\**;**\bin\**;**\obj\**" />
    <Watch Remove="bin\**;obj\**;**\bin\**;**\obj\**" />
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Grove.Themes.Admin.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- WebAssembly package (not the full BlazorWebAssembly SDK): WASM-side service
         classes here still use browser-only APIs (AntiforgeryHandler's
         IJSInProcessRuntime + SetBrowserRequestCredentials). Those code paths only ever
         execute in the browser; the assembly itself also loads server-side for SSR
         route discovery, which is fine - referencing the package doesn't require a
         browser host, invoking those APIs does. -->
    <PackageReference Include="Microsoft.AspNetCore.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Grove.Display.Components\Grove.Display.Components.csproj" />
    <!-- The shell runtime: the lazy-module loader every shell shares. -->
    <ProjectReference Include="..\..\Grove.Infrastructure.Shell\Grove.Infrastructure.Shell.csproj" />
    <!-- The admin theme's services (eager): the boot path, the HTTP pipeline, the API client,
         the shell state. This project is the admin UI, loaded when the admin shell opens. -->
    <ProjectReference Include="..\client-services\Grove.Themes.Admin.Client.Services.csproj" />
    <ProjectReference Include="..\..\Grove.Display.Icons\Grove.Display.Icons.csproj" />
    <!-- Grove's own opt-in modules' admin libraries. A host's modules are never referenced
         here: the host app's WASM entry project references the module client libraries it
         ships (source or packages), see ClientWebAssemblyHost, and ModuleAssemblyRegistry
         finds them at runtime. -->
    <!-- The Users module's shared components (the sign-in form, the account security part):
         not a module client library, it loads with this theme UI. -->
    <ProjectReference Include="..\..\Grove.Access.Users\components\Grove.Access.Users.Components.csproj" />
    <ProjectReference Include="..\..\Grove.Data.Protocols.GraphQL\blazor-wasm\Grove.Data.Protocols.GraphQL.BlazorWasm.csproj" />
    <ProjectReference Include="..\..\Grove.AuditTrail\blazor-wasm\Grove.AuditTrail.BlazorWasm.csproj" />
    <ProjectReference Include="..\..\Grove.Contents\blazor-wasm\Grove.Contents.OptionLists.BlazorWasm.csproj" />
    <ProjectReference Include="..\..\Grove.Contents.OptionPicker\blazor-wasm\Grove.Contents.OptionPicker.BlazorWasm.csproj" />
    <ProjectReference Include="..\..\Grove.Parties\blazor-wasm\Grove.Parties.BlazorWasm.csproj" />
    <ProjectReference Include="..\..\Grove.Routes\blazor-wasm\Grove.Routes.BlazorWasm.csproj" />
    <ProjectReference Include="..\..\Grove.Data.Connectors\blazor-wasm\Grove.Data.Connectors.BlazorWasm.csproj" />
    <ProjectReference Include="..\..\Grove.Shortcodes\blazor-wasm\Grove.Shortcodes.BlazorWasm.csproj" />
    <ProjectReference Include="..\..\Grove.Seo.Sitemaps\blazor-wasm\Grove.Seo.Sitemaps.BlazorWasm.csproj" />
    <ProjectReference Include="..\..\Grove.Communications\blazor-wasm\Grove.Communications.BlazorWasm.csproj" />
    <ProjectReference Include="..\..\Grove.Communications.Email\blazor-wasm\Grove.Communications.Email.BlazorWasm.csproj" />
    <ProjectReference Include="..\..\Grove.Communications.Sms\blazor-wasm\Grove.Communications.Sms.BlazorWasm.csproj" />
    <ProjectReference Include="..\..\Grove.Workflows\blazor-wasm\Grove.Workflows.BlazorWasm.csproj" />
  </ItemGroup>

</Project>

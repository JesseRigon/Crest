@using Grove.Themes.Admin.State
@using Grove.Themes.Admin.Options
@using Grove.Display.Components.Primitives
@using Grove.Display.Components.Primitives
@implements IDisposable
@inject AdminShellState AdminShellState
@inject RoutingOptions Routing
@inject NavigationManager Navigation
@inject Grove.Display.Components.Theme.GroveApiLocalizer T

@if (!AdminShellState.IsInitialized)
{
    <GroveStack Gap="1rem" Style="padding: 2rem;">
        <GroveText Text="@T["Loading..."]" />
    </GroveStack>
}
else if (AdminShellState.IsAuthenticated)
{
    <CascadingValue Value="AdminShellState">
        <div class="admin-shell">
            <AdminTitleBar />
            <div class="@DashboardClass">
                <Sidebar IsMobileOpen="@IsPrimaryNavMenuOpen">
                    <PrimaryNavMenu />
                </Sidebar>
                @if (IsPrimaryNavMenuOpen)
                {
                    <button type="button" class="admin-dashboard__backdrop" aria-label="@T["Close navigation menu"]" @onclick="ClosePrimaryNavMenu"></button>
                }
                <main class="admin-dashboard__main" @onclick="ClosePrimaryNavMenu">
                    @ChildContent
                </main>
            </div>
        </div>
    </CascadingValue>
}

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool IsPrimaryNavMenuOpen { get; set; }

    private string DashboardClass => IsPrimaryNavMenuOpen ? "admin-dashboard admin-dashboard--primary-nav-menu-open" : "admin-dashboard";

    protected override async Task OnInitializedAsync()
    {
        AdminShellState.Changed += StateHasChanged;
        await AdminShellState.EnsureInitializedAsync();
        EnsureAuthenticated();
    }

    public void Dispose()
    {
        AdminShellState.Changed -= StateHasChanged;
    }

    private void ClosePrimaryNavMenu() => IsPrimaryNavMenuOpen = false;

    private void EnsureAuthenticated()
    {
        if (!AdminShellState.IsAuthenticated)
        {
            // Crossing from the admin shell (base href = AdminPath) to the login
            // shell (base href = LoginPath) requires a full reload - see
            // AdminTitleBar.LogoutAsync for the same rationale.
            Navigation.NavigateTo(Routing.LoginPath, forceLoad: true);
        }
    }
}

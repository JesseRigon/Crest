@namespace Grove.Themes.Admin.Components.Admin
@using System.Net.Http.Json
@using Grove.Display.Components.Primitives
@inject HttpClient Http
@inject NotificationService Notifications
@inject Grove.Display.Components.Theme.GroveApiLocalizer T

@* Declarative show/hide condition for any field type: the field renders only while its
   condition over sibling fields holds; the server clears a hidden field's value on save.
   Definition work, gated server-side by EditContentTypes, stored on the field set's field
   definition (shared across every type carrying the field set, like the field itself). *@
<GroveCard data-testid="field-visibility-editor">
    <GroveStack Gap="1rem">
        <GroveStack Gap="0.25rem">
            <GroveText TextStyle="TextStyle.H6" Text="@T["Visibility: {0}", FieldName]" />
            <GroveText TextStyle="TextStyle.Caption" Text="@($"{FieldSetName} · {FieldName}")" />
        </GroveStack>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <GroveAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</GroveAlert>
        }

        @if (IsLoading)
        {
            <GroveProgressBar Mode="ProgressBarMode.Indeterminate" />
        }
        else
        {
            <GroveText TextStyle="TextStyle.Caption" Text="@T["The field shows only while its condition holds; with no condition it is always visible. While hidden it is exempt from required-validation, and its value is cleared when the item is saved."]" />
            <FieldConditionEditor @bind-Value="When" Fields="@SiblingFieldChoices" Disabled="@IsBusy" />

            <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                <GroveButton Text="@T["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="@(() => OnClose.InvokeAsync())" Disabled="@IsBusy" />
                <GroveButton Text="@T["Save"]" Icon="save" Click="SaveAsync" Disabled="@IsBusy" data-testid="visibility-save" />
            </GroveStack>
        }
    </GroveStack>
</GroveCard>

@code {
    [Parameter] public string FieldSetName { get; set; } = string.Empty;
    [Parameter] public string FieldName { get; set; } = string.Empty;

    /// <summary>The names of the field set's fields, offered to the condition.</summary>
    [Parameter] public string[] SiblingFields { get; set; } = [];

    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private DisplayBinding? When;

    private bool IsLoading;
    private bool IsSaving;
    private bool IsBusy => IsLoading || IsSaving;
    private string? ErrorMessage;

    private sealed record VisibilityModel(bool FieldExists, VisibilitySettings Settings);
    private sealed class VisibilitySettings
    {
        public DisplayBinding? When { get; set; }
    }

    // The field set is shared: its conditions name siblings by bare name, read from the same
    // attachment wherever the field set is attached.
    private FieldConditionEditor.FieldChoice[] SiblingFieldChoices => [.. SiblingFields
        .Where(name => !string.Equals(name, FieldName, StringComparison.OrdinalIgnoreCase))
        .Select(name => new FieldConditionEditor.FieldChoice(name, name))];

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        try
        {
            var model = await Http.GetFromJsonAsync<VisibilityModel>(
                $"api/grove/field-visibility?fieldSet={Uri.EscapeDataString(FieldSetName)}&field={Uri.EscapeDataString(FieldName)}");
            When = model?.Settings.When;
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        IsSaving = true;
        ErrorMessage = null;
        try
        {
            using var response = await Http.PutAsJsonAsync("api/grove/field-visibility", new
            {
                FieldSet = FieldSetName,
                Field = FieldName,
                Settings = new { When },
            });

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            Notifications.Notify(NotificationSeverity.Success, T["Field visibility"], T["Visibility condition saved."]);
            await OnSaved.InvokeAsync();
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }
}

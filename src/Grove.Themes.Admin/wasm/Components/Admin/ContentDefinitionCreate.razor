@namespace Grove.Themes.Admin.Components.Admin
@using System.Net.Http.Json
@inject HttpClient Http
@inject Grove.Display.Components.Theme.GroveApiLocalizer T

@* Creates a content type (with its own part, named alike) or a content part. *@
<GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap" data-testid="@($"create-content-{Kind}")">
    <GroveFormField Text="@(Kind == "type" ? T["New content type (technical name)"] : T["New content part (technical name)"])">
        <GroveTextBox @bind-Value="Name" Style="width: 12rem" />
    </GroveFormField>
    <GroveFormField Text="@T["Display name"]"><GroveTextBox @bind-Value="DisplayName" Style="width: 12rem" /></GroveFormField>
    <GroveButton Text="@T["Create"]" Icon="add" Size="ButtonSize.Small" Click="CreateAsync" Disabled="@(Busy || string.IsNullOrWhiteSpace(Name))" />
    @if (Error is { } error) { <GroveText TextStyle="TextStyle.Caption" Style="color: var(--rz-danger)">@error</GroveText> }
</GroveStack>

@code {
    /// <summary>"type" or "part".</summary>
    [Parameter] public string Kind { get; set; } = "type";

    [Parameter] public EventCallback<string> Created { get; set; }

    private string? Name;
    private string? DisplayName;
    private string? Error;
    private bool Busy;

    private async Task CreateAsync()
    {
        Busy = true;
        Error = null;
        try
        {
            var url = Kind == "type" ? "api/grove/content-types" : "api/grove/content-types/parts";
            using var response = await Http.PostAsJsonAsync(url, new { Name = Name!.Trim(), DisplayName });
            if (!response.IsSuccessStatusCode) { Error = await response.Content.ReadAsStringAsync(); return; }
            var created = Name.Trim();
            Name = null;
            DisplayName = null;
            await Created.InvokeAsync(created);
        }
        finally { Busy = false; }
    }
}

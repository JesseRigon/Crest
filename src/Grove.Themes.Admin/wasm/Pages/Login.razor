@page "/login"
@attribute [Grove.Display.Components.Modules.SetsAuthenticationCookie]
@using Grove.Themes.Admin.State
@using Grove.Themes.Admin.Options
@using Grove.Access.Users.Components
@using Microsoft.AspNetCore.Components
@using Grove.Display.Components.Primitives
@inject AdminShellState AdminShellState
@inject RoutingOptions Routing
@inject NavigationManager Navigation
@inject Grove.Display.Components.Theme.GroveApiLocalizer T

@* The admin shell's sign-in page (docs/shells-and-themes.md › Required pages): the theme lays it
   out - the tenant's branding, the signed-in state - and the sign-in itself is the Users module's
   (SignInForm: credentials, the form's extensions, the second step). *@

@* The login shell has no admin chrome, so the page owns the viewport: full-height
   flex centering, both axes. *@
<div style="min-height: 100dvh; display: flex; align-items: center; justify-content: center; padding: 2rem;">
<GroveStack Gap="1rem" AlignItems="AlignItems.Center">
    @* The tenant's own name (ISite.SiteName), not the platform's: each tenant has its own
       users and its own login page. *@
    @* The login rendition (site › branding.login) when one is set; the name as text otherwise. *@
    @if (AdminShellState.Branding?.Rendition("login") is { Length: > 0 } loginLogo)
    {
        <img src="@loginLogo" alt="@AdminShellState.Branding.SiteName" style="max-width: 320px; max-height: 96px;" data-testid="login-logo" />
    }
    else if (!string.IsNullOrWhiteSpace(AdminShellState.Branding?.SiteName))
    {
        <GroveText TextStyle="TextStyle.H3" Text="@AdminShellState.Branding.SiteName" />
    }

    @if (AdminShellState.IsAuthenticated)
    {
        <GroveText Text="@T["Signed in as {0}", AdminShellState.User.UserName]" />
        <GroveButton Text="@T["Log out"]" Click="LogoutAsync" Disabled="@AdminShellState.IsBusy" />
    }
    else
    {
        <SignInForm UserName="@UserName" ReturnUrl="@ReturnUrl" Error="@Error" ExternalLoginError="@ExternalLoginError" SignedIn="@SignedInAsync" />
    }
</GroveStack>
</div>

@code {
    // A string, not a bool: Blazor's query binding throws on anything but true/false, so a
    // "switchUser=1" link (the title bar sent that once) was a 500 instead of a login page.
    [SupplyParameterFromQuery(Name = "switchUser")]
    public string? SwitchUserQuery { get; set; }

    private bool SwitchUser => IsTrue(SwitchUserQuery);

    [SupplyParameterFromQuery(Name = "userName")]
    public string? UserName { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    /// <summary>A refusal met before this page (a failed external sign-in, a disabled account).</summary>
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "externalLoginError")]
    public string? ExternalLoginErrorQuery { get; set; }

    private bool ExternalLoginError => IsTrue(ExternalLoginErrorQuery);

    protected override async Task OnInitializedAsync()
    {
        await AdminShellState.EnsureInitializedAsync();

        // Static SSR prerender: paint the form (or signed-in state) and stop - the
        // redirect/logout policy below belongs to the interactive phase, which re-runs
        // this init with the browser in the loop (see Home.razor for the same pattern).
        // LogoutAsync in particular is a cookie mutation: server-side it would POST over
        // the forwarded-cookie loopback client, whose Set-Cookie response never reaches
        // the browser, so the user would not actually be signed out - only the
        // browser-issued interactive request can clear the Grove auth cookie.
        // EnsureInitializedAsync above still runs during prerender (it is
        // prerender-safe) so the form's culture/theme state renders correctly.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        if (AdminShellState.IsAuthenticated && SwitchUser)
        {
            await AdminShellState.LogoutAsync();
        }
        else if (AdminShellState.IsAuthenticated)
        {
            // Crossing from the login shell (base href = LoginPath) to the admin
            // shell (base href = AdminPath) requires a full reload so the browser
            // re-fetches the document with the correct <base> tag - see
            // ShellSelectionMiddleware's PathBase shift and App.razor.
            Navigation.NavigateTo(Routing.AdminPath, forceLoad: true);
        }
    }

    // Signed in: where the sign-in says to go first (the two-factor page for a user who must set
    // it up), else the admin. A full reload: the session was just issued.
    private Task SignedInAsync(SignInAnswer answer)
    {
        Navigation.NavigateTo(answer.Redirect is { Length: > 0 } redirect ? redirect : Routing.AdminPath, forceLoad: true);
        return Task.CompletedTask;
    }

    private async Task LogoutAsync()
    {
        await AdminShellState.LogoutAsync();
        Navigation.NavigateTo(Routing.LoginPath);
    }

    private static bool IsTrue(string? value) =>
        value is { } text && (text == "1" || string.Equals(text, "true", StringComparison.OrdinalIgnoreCase));
}

@page "/MediaProfiles"
@attribute [PageEntry("ManageMediaProfiles", Id = "profiles", Parent = "media", Caption = "Profiles", Position = "5", Icon = "@iconify:mdi:image-size-select-large")]
@using Grove.Themes.Admin.Api
@using Grove.Display.Components.Primitives
@using Grove.Display.Components.Primitives
@inject IApi Api
@inject NotificationService Notifications
@inject Grove.Display.Components.Theme.GroveApiLocalizer T

<GroveStack Gap="1rem" data-testid="media-profiles-page">
 <GroveStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"><GroveStack Gap=".25rem"><GroveText TextStyle="TextStyle.H4" Text="@T["Media Profiles"]"/><GroveText TextStyle="TextStyle.Body2" Text="@T["Define reusable image transformations."]"/></GroveStack><GroveButton Text="@T["New profile"]" Icon="add" Click="NewProfile"/></GroveStack>
 @if (!string.IsNullOrWhiteSpace(Error)) { <GroveAlert AlertStyle="AlertStyle.Danger">@Error</GroveAlert> }
 @if (Editing) { <GroveCard><GroveStack Gap=".75rem"><GroveText TextStyle="TextStyle.H5" Text="@((SelectedName is null) ? T["New media profile"] : T["Edit {0}", SelectedName])"/><GroveTextBox @bind-Value="Name" Placeholder="@T["Profile name"]" Disabled="@(SelectedName is not null)"/><GroveTextBox @bind-Value="Hint" Placeholder="@T["Hint"]"/><GroveRow><GroveColumn><GroveNumeric @bind-Value="Width" Placeholder="@T["Width"]" Style="width:100%"/></GroveColumn><GroveColumn><GroveNumeric @bind-Value="Height" Placeholder="@T["Height"]" Style="width:100%"/></GroveColumn><GroveColumn><GroveNumeric @bind-Value="Quality" Placeholder="@T["Quality"]" Style="width:100%"/></GroveColumn></GroveRow><GroveTextBox @bind-Value="Background" Placeholder="@T["Background Color"]"/><GroveCheckBox @bind-Value="AutoOrient"/> <span>@T["Auto Orient"]</span><GroveStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End"><GroveButton Text="@T["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="Cancel"/><GroveButton Text="@T["Save"]" Click="SaveAsync" Disabled="@string.IsNullOrWhiteSpace(Name)"/></GroveStack></GroveStack></GroveCard> }
 @if (Loading) { <GroveProgressBar Mode="ProgressBarMode.Indeterminate"/> } else { <GroveDataGrid Data="@Profiles" TItem="MediaProfile" data-testid="media-profiles-grid"><Columns><GroveDataGridColumn TItem="MediaProfile" Property="Name" Title="@T["Name"]"/><GroveDataGridColumn TItem="MediaProfile" Property="Hint" Title="@T["Hint"]"/><GroveDataGridColumn TItem="MediaProfile" Title="@T["Size"]"><Template Context="p">@p.Width × @p.Height</Template></GroveDataGridColumn><GroveDataGridColumn TItem="MediaProfile" Property="Quality" Title="@T["Quality"]"/><GroveDataGridColumn TItem="MediaProfile" Title="@T["Actions"]"><Template Context="p"><GroveButton Icon="edit" Variant="Variant.Text" Click="@(()=>Edit(p))"/><GroveButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Click="@(()=>DeleteAsync(p))"/></Template></GroveDataGridColumn></Columns></GroveDataGrid> }
</GroveStack>
@code { MediaProfile[] Profiles=[]; bool Loading=true, Editing; string? Error,SelectedName,Name,Hint,Background; int Width,Height,Quality=80; bool AutoOrient=true; protected override Task OnInitializedAsync()=>LoadAsync(); async Task LoadAsync(){Loading=true;try{Profiles=await Api.Grove.Rest.MediaProfiles.ListAsync();}catch(Exception e){Error=e.Message;}finally{Loading=false;}} void NewProfile(){SelectedName=null;Name=Hint=Background=null;Width=Height=0;Quality=80;AutoOrient=true;Editing=true;} void Edit(MediaProfile p){SelectedName=Name=p.Name;Hint=p.Hint;Width=p.Width;Height=p.Height;Quality=p.Quality;Background=p.BackgroundColor;AutoOrient=p.AutoOrient;Editing=true;} void Cancel()=>Editing=false; async Task SaveAsync(){var saved=await Api.Grove.Rest.MediaProfiles.SaveAsync(Name!,new(Hint,Width,Height,0,0,Quality,Background,AutoOrient));if(saved is null){Error=T["The profile could not be saved."];return;}Editing=false;Notifications.Notify(NotificationSeverity.Success,T["Media Profiles"],T["Profile saved."]);await LoadAsync();} async Task DeleteAsync(MediaProfile p){if(await Api.Grove.Rest.MediaProfiles.DeleteAsync(p.Name)){Notifications.Notify(NotificationSeverity.Success,T["Media Profiles"],T["Profile deleted."]);await LoadAsync();}} }

@page "/Settings/admin"
@attribute [PageEntry("ManageAdminSettings", Id = "admin", Parent = "settings", Caption = "Admin", Icon = "@iconify:mdi:shield-crown")]
@using Grove.Themes.Admin.Api
@using Grove.Themes.Admin.Components.Shared
@using Grove.Themes.Admin.State
@using Grove.Display.Components.Primitives
@using Grove.Display.Components.Primitives
@inject IApi Api
@inject NotificationService Notifications
@inject AdminShellState AdminShellState
@inject Grove.Display.Components.Theme.GroveApiLocalizer T

<GroveStack Gap="1rem">
    <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
        <GroveStack Gap="0.25rem">
            <GroveText TextStyle="TextStyle.H4" Text="@T["Admin settings"]" />
            <GroveText TextStyle="TextStyle.Body2" Text="@T["Manage admin UI options and route access planning."]" />
        </GroveStack>
        <GroveButton Text="@T["Refresh"]" ButtonStyle="ButtonStyle.Light" Icon="refresh" Click="@LoadAsync" Disabled="@IsBusy" />
    </GroveStack>

    <GroveCard>
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <GroveAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</GroveAlert>
        }
        else if (IsLoading)
        {
            <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                <GroveProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                <GroveText Text="@T["Loading settings..."]" />
            </GroveStack>
        }
        else
        {
            <GroveMainContentTabs @bind-SelectedIndex="SelectedTabIndex" aria-label="@T["Admin settings sections"]">
                <GroveTabsItem Text="@T["Admin"]" Icon="admin_panel_settings">
                    <GroveTemplateForm TItem="AdminSettingsModel" Data="@Model" Submit="@(_ => SaveAsync())">
                        <GroveStack Gap="1rem">
                            <GroveText TextStyle="TextStyle.H5" Text="@T["Admin"]" />
                            <SettingsSwitch Label="@T["Enable theme toggler"]" Hint="@T["Whether or not to display a theme toggler."]" @bind-Value="Model.DisplayThemeToggler" />
                            <SettingsSwitch Label="@T["Enable Admin Menu filter"]" Hint="@T["Whether a quick search to filter the admin menu is displayed."]" @bind-Value="Model.DisplayMenuFilter" />
                            <SettingsSwitch Label="@T["Display titles in top bar"]" Hint="@T["Whether the titles are displayed in the top bar."]" @bind-Value="Model.DisplayTitlesInTopbar" />
                            <SettingsSwitch Label="@T["Content group pages in menu"]" Hint="@T["Add a Content menu entry per content group (Members, Parties, ...) listing everything the group covers, alongside the per-type entries."]" @bind-Value="Model.ContentGroupPages" />
                            <GroveFieldset Text="@T["Title bar"]">
                                <GroveStack Gap="0.75rem">
                                    <SettingsSwitch Label="@T["Display culture label"]" Hint="@T["Show the culture name beside its flag. The default is the flag icon only."]" @bind-Value="TitleBarModel.DisplayCultureLabel" />
                                    <GroveDropDown Data="@AvatarShapes" @bind-Value="TitleBarModel.TenantAvatarShape" TextProperty="Label" ValueProperty="Value" Placeholder="@T["Tenant avatar shape"]" Style="width: 100%;" />
                                    <GroveTextBox @bind-Value="TitleBarModel.TenantAvatarImageUrl" Placeholder="@T["Tenant avatar image URL (optional)"]" Style="width: 100%;" />
                                    @if (string.Equals(TitleBarModel.TenantAvatarShape, "Custom", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <GroveTextBox @bind-Value="TitleBarModel.TenantAvatarClipPath" Placeholder="@T["CSS/SVG clip-path, for example polygon(...) or url(#clip)"]" Style="width: 100%;" />
                                        <GroveTextBox @bind-Value="TitleBarModel.TenantAvatarBorderRadius" Placeholder="@T["Optional border radius"]" Style="width: 100%;" />
                                    }
                                </GroveStack>
                            </GroveFieldset>
                            <GroveStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                                <GroveButton Text="@T["Save settings"]" Icon="save" ButtonType="ButtonType.Submit" Disabled="@IsSaving" />
                            </GroveStack>
                        </GroveStack>
                    </GroveTemplateForm>
                </GroveTabsItem>
                <GroveTabsItem Text="@T["Sitemap"]" Icon="account_tree">
                    <GroveStack Gap="1rem">
                        <GroveStack Gap="0.25rem">
                            <GroveText TextStyle="TextStyle.H5" Text="@T["Sitemap"]" />
                            <GroveText TextStyle="TextStyle.Body2" Text="@T["Route access management placeholder. This uses the admin menu tree editor presentation for now; route permissions and access-control editors will be added here as requirements firm up."]" />
                        </GroveStack>
                        @if (RouteNodes.Length == 0)
                        {
                            <GroveAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">@T["No routes were discovered for the admin site map."]</GroveAlert>
                        }
                        else
                        {
                            <ol class="admin-menu-tree__list admin-menu-tree__list--root">
                                @foreach (var node in RouteNodes)
                                {
                                    @RenderRouteNode(node)
                                }
                            </ol>
                        }
                    </GroveStack>
                </GroveTabsItem>
            </GroveMainContentTabs>
        }
    </GroveCard>
</GroveStack>

<style>
    .admin-menu-tree__list { list-style: none; margin: 0; padding-left: 1.25rem; }
    .admin-menu-tree__list--root { padding-left: 0; }
    .admin-menu-tree__item { margin: 0.45rem 0; }
    .admin-menu-node { border: 1px solid var(--rz-border-color); border-radius: var(--rz-border-radius); background: var(--rz-base-background-color); padding: 0.65rem; }
    .admin-menu-node__handle { color: var(--rz-text-secondary-color); border: 1px dashed var(--rz-border-color); border-radius: 999px; padding: 0.15rem 0.35rem; user-select: none; display: inline-flex; align-items: center; }
    .admin-menu-node__spacer { display: inline-block; width: 2rem; }
</style>

@code {
    private int SelectedTabIndex { get; set; }
    private AdminSettingsModel Model { get; set; } = new();
    private TitleBarSettingsModel TitleBarModel { get; set; } = new();
    private static TitleBarShapeOption[] AvatarShapes { get; } =
    [new("Circle", "Circle"), new("RoundedSquare", "Rounded square"), new("Square", "Square"), new("Custom", "Custom clip path")];
    private RouteNode[] RouteNodes { get; set; } = [];
    private bool IsLoading { get; set; }
    private bool IsSaving { get; set; }
    private bool IsBusy => IsLoading || IsSaving;
    private string? ErrorMessage { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            Model = AdminSettingsModel.From(await Api.Grove.Rest.AdminSettings.GetAsync());
            Model.ContentGroupPages = (await Api.Grove.Rest.ContentGroups.GetSettingsAsync()).AutoMenuPages;
            TitleBarModel = TitleBarSettingsModel.From(await Api.Grove.Rest.TitleBarSettings.GetAsync());
            var manifest = await Api.Grove.Rest.App.GetManifestAsync();
            RouteNodes = manifest?.AdminMenu.Items.Select((item, index) => RouteNode.From(T, item, null, 0, index)).ToArray() ?? [];
        }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { IsLoading = false; }
    }

    private async Task SaveAsync()
    {
        IsSaving = true;
        try
        {
            var saved = await Api.Grove.Rest.AdminSettings.UpdateAsync(Model.ToUpdate());
            var titleBarSaved = await Api.Grove.Rest.TitleBarSettings.UpdateAsync(TitleBarModel.ToUpdate());
            var groupsSaved = await Api.Grove.Rest.ContentGroups.UpdateSettingsAsync(new ContentGroupsSettings(Model.ContentGroupPages));
            if (saved is not null && titleBarSaved is not null && groupsSaved is not null)
            {
                Model = AdminSettingsModel.From(saved);
                Model.ContentGroupPages = groupsSaved.AutoMenuPages;
                TitleBarModel = TitleBarSettingsModel.From(titleBarSaved);
                await AdminShellState.RefreshAdminStateAsync();
                Notifications.Notify(NotificationSeverity.Success, T["Settings saved"], T["Admin settings were updated."]);
            }
        }
        finally { IsSaving = false; }
    }

    private RenderFragment RenderRouteNode(RouteNode node) => @<li class="admin-menu-tree__item">
        <div class="admin-menu-node">
            <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.75rem">
                <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.65rem">
                    <span class="admin-menu-node__handle" title="@T["Drag to move"]"><GroveIcon IconKey="iconify.mdi/current/default/drag" /></span>
                    @if (node.Items.Length > 0)
                    {
                        <GroveButton Size="ButtonSize.Small" Icon="expand_more" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Disabled="true" title="@T["Expand/collapse coming soon"]" />
                    }
                    else
                    {
                        <span class="admin-menu-node__spacer"></span>
                    }
                    <GroveStack Gap="0.1rem" Style="flex: 1; min-width: 0;">
                        <GroveText TextStyle="TextStyle.Subtitle2" Text="@node.Text" />
                        <GroveText TextStyle="TextStyle.Caption" Text="@node.Meta" />
                    </GroveStack>
                </GroveStack>
                <GroveStack Orientation="Orientation.Horizontal" Gap="0.35rem">
                    <GroveButton Size="ButtonSize.Small" Icon="edit" ButtonStyle="ButtonStyle.Light" Disabled="true" title="@T["Edit route permissions coming soon"]" />
                    <GroveButton Size="ButtonSize.Small" Icon="visibility_off" ButtonStyle="ButtonStyle.Light" Disabled="true" title="@T["Toggle route access coming soon"]" />
                    <GroveButton Size="ButtonSize.Small" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Disabled="true" title="@T["Delete route override coming soon"]" />
                </GroveStack>
            </GroveStack>
        </div>
        @if (node.Items.Length > 0)
        {
            <ol class="admin-menu-tree__list">
                @foreach (var child in node.Items)
                {
                    @RenderRouteNode(child)
                }
            </ol>
        }
    </li>;

    private sealed class AdminSettingsModel
    {
        public bool DisplayThemeToggler { get; set; }
        public bool DisplayMenuFilter { get; set; }
        public bool DisplayTitlesInTopbar { get; set; }
        public bool ContentGroupPages { get; set; }

        public static AdminSettingsModel From(AdminSettingsDto settings) => new()
        {
            DisplayThemeToggler = settings.DisplayThemeToggler,
            DisplayMenuFilter = settings.DisplayMenuFilter,
            DisplayTitlesInTopbar = settings.DisplayTitlesInTopbar,
        };

        public AdminSettingsUpdate ToUpdate() => new(DisplayThemeToggler, DisplayMenuFilter, true, DisplayTitlesInTopbar);
    }

    private sealed class TitleBarSettingsModel
    {
        public bool DisplayCultureLabel { get; set; }
        public string? TenantAvatarImageUrl { get; set; }
        public string TenantAvatarShape { get; set; } = "Circle";
        public string? TenantAvatarClipPath { get; set; }
        public string? TenantAvatarBorderRadius { get; set; }

        public static TitleBarSettingsModel From(TitleBarSettingsDto settings) => new()
        {
            DisplayCultureLabel = settings.DisplayCultureLabel,
            TenantAvatarImageUrl = settings.TenantAvatarImageUrl,
            TenantAvatarShape = settings.TenantAvatarShape,
            TenantAvatarClipPath = settings.TenantAvatarClipPath,
            TenantAvatarBorderRadius = settings.TenantAvatarBorderRadius,
        };

        public TitleBarSettingsUpdate ToUpdate() => new(DisplayCultureLabel, TenantAvatarImageUrl, TenantAvatarShape, TenantAvatarClipPath, TenantAvatarBorderRadius);
    }

    private sealed record TitleBarShapeOption(string Value, string Label);

    private sealed record RouteNode(string Id, string Text, string Meta, RouteNode[] Items)
    {
        public static RouteNode From(Grove.Display.Components.Theme.GroveApiLocalizer t, NavigationItem item, string? parentId, int depth, int order)
        {
            var id = item.Key ?? "(no id)";
            var metaValues = new List<string>();
            if (!string.IsNullOrWhiteSpace(item.Link)) metaValues.Add(item.Link!);
            if (item.Classes.Length > 0) metaValues.Add(t["Classes: {0}", string.Join(" ", item.Classes)]);
            if (!string.IsNullOrWhiteSpace(parentId)) metaValues.Add(t["Parent: {0}", parentId]);

            return new(id, item.Text, metaValues.Count == 0 ? t["Route group • depth {0} • order {1}", depth, order] : string.Join(" • ", metaValues), item.Items.Select((child, index) => From(t, child, id, depth + 1, index)).ToArray());
        }
    }
}

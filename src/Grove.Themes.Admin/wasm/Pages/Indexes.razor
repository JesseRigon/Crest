@page "/indexing"
@attribute [PageEntry("ManageIndexes", Id = "indexes", Parent = "search", Caption = "Indexes", Icon = "@iconify:mdi:database-search")]
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Nodes
@using Grove.Display.Components.Primitives
@inject HttpClient Http
@inject Grove.Display.Components.Theme.GroveApiLocalizer T

@* Index profiles (Grove.Data.Indexing): every index the providers keep, with rebuild, reset,
   synchronize and delete; create one of a provider's kinds, and edit a profile as its JSON (the
   shape its recipe step writes - provider-specific forms come later). *@
<GroveStack Gap="1rem" data-testid="indexes-page">
    <GroveText TextStyle="TextStyle.H4" Text="@T["Indexes"]" />
    @if (Error is { } error) { <GroveAlert AlertStyle="AlertStyle.Danger" AllowClose="false">@error</GroveAlert> }
    @if (Message is { } message) { <GroveAlert AlertStyle="AlertStyle.Info" AllowClose="false">@message</GroveAlert> }

    <GroveCard data-testid="index-create">
        <GroveStack Gap="0.5rem">
            <GroveText TextStyle="TextStyle.Subtitle1" Text="@T["New index"]" />
            <GroveDropDown TValue="string" @bind-Value="NewSource" Data="@SourceChoices" TextProperty="Label" ValueProperty="Value" Placeholder="@T["Kind of index"]" Style="max-width: 24rem" />
            <GroveTextArea @bind-Value="NewJson" Rows="6" Style="width: 100%; font-family: monospace" Placeholder="@T["The profile as JSON, e.g. { \"Name\": \"Search\", \"IndexName\": \"search\" }"]" />
            <div><GroveButton Text="@T["Create"]" Icon="add" Click="CreateAsync" Disabled="@(Busy || string.IsNullOrWhiteSpace(NewSource))" /></div>
        </GroveStack>
    </GroveCard>

    @if (Profiles is null)
    {
        <GroveProgressBar Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
        @foreach (var profile in Profiles)
        {
            <GroveCard data-index="@profile.Id">
                <GroveStack Gap="0.5rem">
                    <GroveStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                        <div>
                            <GroveText TextStyle="TextStyle.Subtitle1" class="rz-m-0">@profile.Name</GroveText>
                            <GroveText TextStyle="TextStyle.Caption">@profile.Provider · @profile.Type · @profile.IndexName</GroveText>
                        </div>
                        <GroveStack Orientation="Orientation.Horizontal" Gap="0.25rem" Wrap="FlexWrap.Wrap">
                            <GroveButton Text="@T["Rebuild"]" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => PostAsync(profile, "rebuild", T["Rebuilt."]))" Disabled="Busy" />
                            <GroveButton Text="@T["Reset"]" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => PostAsync(profile, "reset", T["Reset; synchronizing in the background."]))" Disabled="Busy" />
                            <GroveButton Text="@T["Synchronize"]" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => PostAsync(profile, "synchronize", T["Synchronizing in the background."]))" Disabled="Busy" />
                            <GroveButton Text="@T["Edit"]" Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => EditAsync(profile))" Disabled="Busy" />
                            @if (QueryApi(profile) is not null)
                            {
                                <GroveButton Text="@T["Query"]" Icon="search" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => ToggleQuery(profile))" Disabled="Busy" data-testid="index-query-toggle" />
                            }
                            <GroveButton Text="@T["Delete"]" Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Click="@(() => DeleteAsync(profile, false))" Disabled="Busy" />
                            <GroveButton Text="@T["Force delete"]" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="@(() => DeleteAsync(profile, true))" Disabled="Busy" />
                        </GroveStack>
                    </GroveStack>
                    @if (QueryingId == profile.Id)
                    {
                        @* The provider's query runner, on the SqlQuery page's pattern: a query (a Liquid
                           template of the provider's query JSON), its JSON parameters, and the hits. *@
                        <GroveStack Gap="0.5rem" data-testid="index-query">
                            @if (profile.Provider == ElasticsearchProvider && ElasticConfigured == false)
                            {
                                <GroveAlert AlertStyle="AlertStyle.Warning" AllowClose="false">@T["Elasticsearch is not configured: set its connection in the tenant's configuration."]</GroveAlert>
                            }
                            else
                            {
                                <GroveFormField Text="@T["Query"]" Style="width: 100%;">
                                    <GroveTextArea @bind-Value="QueryText" Rows="8" Style="width: 100%; font-family: monospace" data-testid="index-query-text" />
                                </GroveFormField>
                                <GroveFormField Text="@T["Parameters (JSON object)"]" Style="width: 100%;">
                                    <GroveTextArea @bind-Value="QueryParameters" Rows="3" Style="width: 100%; font-family: monospace" />
                                </GroveFormField>
                                <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                    <GroveButton Text="@T["Run query"]" Icon="play_arrow" Click="@(() => RunQueryAsync(profile))" Disabled="Busy" data-testid="index-query-run" />
                                    @if (profile.Provider == ElasticsearchProvider)
                                    {
                                        <GroveButton Text="@T["Index information"]" Icon="info" ButtonStyle="ButtonStyle.Light" Click="@(() => IndexInfoAsync(profile))" Disabled="Busy" />
                                    }
                                </GroveStack>
                                @if (QueryResult is { } result)
                                {
                                    <GroveText TextStyle="TextStyle.Caption" Text="@T["{0} results in {1} ms", result.Count, result.ElapsedMilliseconds]" />
                                    @if (profile.Provider == LuceneProvider)
                                    {
                                        <GroveText TextStyle="TextStyle.Caption" Text="@T["The results displayed are coming from the stored fields in Lucene."]" />
                                    }
                                    @if (result.Documents.Length > 0)
                                    {
                                        var columns = result.Documents.SelectMany(document => document.Select(field => field.Key)).Distinct().ToArray();
                                        <div style="overflow: auto; max-height: 50vh;">
                                            <table class="rz-grid-table" data-testid="index-query-results">
                                                <thead><tr>@foreach (var column in columns) { <th>@column</th> }</tr></thead>
                                                <tbody>
                                                    @foreach (var document in result.Documents)
                                                    {
                                                        <tr>@foreach (var column in columns) { <td>@(document[column] is { } value ? (value is JsonValue ? value.ToString() : value.ToJsonString()) : string.Empty)</td> }</tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                }
                                @if (IndexInfo is not null)
                                {
                                    <pre style="max-height: 50vh; overflow: auto; margin: 0;" data-testid="index-info">@IndexInfo</pre>
                                }
                            }
                        </GroveStack>
                    }
                    @if (EditingId == profile.Id)
                    {
                        <GroveTextArea @bind-Value="EditJson" Rows="12" Style="width: 100%; font-family: monospace" />
                        <div><GroveButton Text="@T["Save"]" Icon="save" Click="@(() => SaveAsync(profile))" Disabled="Busy" /></div>
                    }
                </GroveStack>
            </GroveCard>
        }
    }
</GroveStack>

@code {
    private const string Api = "api/grove/indexes";
    private static readonly JsonSerializerOptions s_indented = new() { WriteIndented = true };

    private Summary[]? Profiles;
    private Source[] Sources = [];
    private string? NewSource;
    private string? NewJson = "{}";
    private string? EditingId;
    private string? EditJson;
    private string? Error;
    private string? Message;
    private bool Busy;

    private Choice[] SourceChoices => Sources.Select(source => new Choice($"{source.ProviderName}|{source.Type}", $"{source.DisplayName} ({source.ProviderName})")).ToArray();

    protected override async Task OnInitializedAsync()
    {
        try { Sources = await Http.GetFromJsonAsync<Source[]>($"{Api}/sources") ?? []; }
        catch (Exception exception) { Error = exception.Message; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try { Profiles = await Http.GetFromJsonAsync<Summary[]>(Api); }
        catch (Exception exception) { Error = exception.Message; }
    }

    private async Task CreateAsync()
    {
        if (ParseJson(NewJson) is not { } data) return;
        var parts = NewSource!.Split('|', 2);
        await SendAsync(() => Http.PostAsJsonAsync(Api, new { ProviderName = parts[0], Type = parts[1], Data = data }), T["Created; synchronizing in the background."]);
        if (Error is null) NewJson = "{}";
    }

    private async Task EditAsync(Summary profile)
    {
        if (EditingId == profile.Id) { EditingId = null; return; }
        try
        {
            var node = await Http.GetFromJsonAsync<JsonNode>($"{Api}/{Uri.EscapeDataString(profile.Id)}");
            EditJson = node?.ToJsonString(s_indented);
            EditingId = profile.Id;
        }
        catch (Exception exception) { Error = exception.Message; }
    }

    private async Task SaveAsync(Summary profile)
    {
        if (ParseJson(EditJson) is not { } data) return;
        await SendAsync(() => Http.PutAsJsonAsync($"{Api}/{Uri.EscapeDataString(profile.Id)}", new { Data = data }), T["Saved."]);
        if (Error is null) EditingId = null;
    }

    private Task PostAsync(Summary profile, string action, string done) => SendAsync(() => Http.PostAsync($"{Api}/{Uri.EscapeDataString(profile.Id)}/{action}", null), done);

    private Task DeleteAsync(Summary profile, bool force) => SendAsync(() => Http.DeleteAsync($"{Api}/{Uri.EscapeDataString(profile.Id)}?force={force.ToString().ToLowerInvariant()}"), T["Deleted."]);

    private JsonObject? ParseJson(string? text)
    {
        try
        {
            if (JsonNode.Parse(string.IsNullOrWhiteSpace(text) ? "{}" : text) is JsonObject value) return value;
            Error = T["The profile must be a JSON object."];
        }
        catch (JsonException exception) { Error = exception.Message; }
        return null;
    }

    private async Task SendAsync(Func<Task<HttpResponseMessage>> call, string done)
    {
        Busy = true;
        Error = null;
        Message = null;
        try
        {
            using var response = await call();
            if (!response.IsSuccessStatusCode) { Error = await response.Content.ReadAsStringAsync(); return; }
            Message = done;
            await LoadAsync();
        }
        finally { Busy = false; }
    }

    private sealed record Summary(string Id, string? Name, string? Provider, string? IndexName, string? Type, string? CreatedUtc);

    // The query runners of the Lucene and Elasticsearch providers (their modules' query APIs).
    private const string LuceneProvider = "Lucene";
    private const string ElasticsearchProvider = "Elasticsearch";
    private const string MatchAllQuery = "{\n  \"query\": {\n    \"match_all\": { }\n  },\n  \"size\": 10\n}";

    private string? QueryingId;
    private string? QueryText = MatchAllQuery;
    private string? QueryParameters = "{ }";
    private QueryResultModel? QueryResult;
    private string? IndexInfo;
    private bool? ElasticConfigured;

    private static string? QueryApi(Summary profile) => profile.Provider switch
    {
        LuceneProvider => $"api/grove/lucene/indexes/{Uri.EscapeDataString(profile.Id)}/query",
        ElasticsearchProvider => $"api/grove/elasticsearch/indexes/{Uri.EscapeDataString(profile.Id)}/query",
        _ => null,
    };

    private async Task ToggleQuery(Summary profile)
    {
        QueryResult = null;
        IndexInfo = null;
        if (QueryingId == profile.Id) { QueryingId = null; return; }
        QueryingId = profile.Id;
        if (profile.Provider == ElasticsearchProvider && ElasticConfigured is null)
        {
            try { ElasticConfigured = (await Http.GetFromJsonAsync<ElasticStatus>("api/grove/elasticsearch/status"))?.IsConfigured; }
            catch (HttpRequestException) { ElasticConfigured = false; }
        }
    }

    private async Task RunQueryAsync(Summary profile)
    {
        Busy = true;
        Error = null;
        QueryResult = null;
        IndexInfo = null;
        try
        {
            using var response = await Http.PostAsJsonAsync(QueryApi(profile)!, new { Query = QueryText, Parameters = QueryParameters });
            if (!response.IsSuccessStatusCode) { Error = await response.Content.ReadAsStringAsync(); return; }
            QueryResult = await response.Content.ReadFromJsonAsync<QueryResultModel>();
        }
        finally { Busy = false; }
    }

    private async Task IndexInfoAsync(Summary profile)
    {
        Busy = true;
        Error = null;
        try
        {
            using var response = await Http.GetAsync($"api/grove/elasticsearch/indexes/{Uri.EscapeDataString(profile.Id)}/info");
            if (!response.IsSuccessStatusCode) { Error = await response.Content.ReadAsStringAsync(); return; }
            IndexInfo = await response.Content.ReadAsStringAsync();
        }
        finally { Busy = false; }
    }

    private sealed record QueryResultModel(long Count, long ElapsedMilliseconds, JsonObject[] Documents);
    private sealed record ElasticStatus(bool IsConfigured);
    private sealed record Source(string ProviderName, string Type, string DisplayName, string? Description);
    private sealed record Choice(string Value, string Label);
}

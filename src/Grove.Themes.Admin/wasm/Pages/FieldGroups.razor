@page "/ContentTypes/FieldGroups"
@attribute [PageEntry("ViewContentTypes", Id = "field-groups", Parent = "content-definition", Caption = "Field groups", Position = "2")]
@using System.Net.Http.Json
@using Grove.Themes.Admin.Api
@using Grove.Display.Components.Model
@using Grove.Display.Components.Primitives
@inject HttpClient Http
@inject NotificationService Notifications
@inject Grove.Display.Components.Theme.GroveApiLocalizer T

@* Field DEFINITIONS are edited here, on the part, because a part is shared: a field
   added or converted on Address lands on every content type carrying it. The
   Content Types screen manages which types carry which parts (and the attachment's
   instance settings); it never edits fields. *@
<GroveStack Gap="1rem" data-testid="field-groups-page" Style="height: 100%;">
    <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Wrap="FlexWrap.Wrap">
        <GroveStack Gap="0.25rem">
            <GroveText TextStyle="TextStyle.H4" Text="@T["Field groups"]" />
            <GroveText TextStyle="TextStyle.Body2" Text="@T["Reusable field groups and their fields. Fields are defined here and appear on every content type the field group is attached to."]" />
        </GroveStack>
        <GroveButton Text="@T["Refresh"]" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="LoadAsync" Disabled="@IsLoading" />
    </GroveStack>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <GroveAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</GroveAlert>
    }

    <ContentDefinitionCreate Kind="part" Created="OnFieldSetCreatedAsync" />

    @* Standard master-detail structure: this region takes the page's remaining
       height; the list's items and the detail pane's body do the scrolling. *@
    <div style="display: flex; flex-wrap: wrap; gap: 1rem; flex: 1 1 auto; min-height: 0; align-items: stretch;">
        <div style="flex: 0 1 350px; min-width: 16rem; min-height: 0; display: flex;">
            <GroveModelList TItem="FieldSetDefinition"
                            Title="@T["Field groups"]"
                            Items="@FieldSets"
                            SelectedKey="@SelectedFieldSetName"
                            KeySelector="@(part => part.Name)"
                            TextSelector="@(part => part.Name)"
                            DescriptionSelector="@(part => T["{0} fields · {1} types", part.FieldSet.Fields.Length, part.UsedByTypes.Length])"
                            SearchPredicate="MatchesSearch"
                            Select="SelectFieldSetAsync"
                            ShowCreate="false"
                            IsBusy="@IsLoading"
                            MinWidth="16rem"
                            MaxWidth="350px"
                            EmptyText="@T["No field groups are defined."]" />
        </div>
        <div style="flex: 1 1 480px; min-width: 0; min-height: 0; display: flex;">
            @if (IsLoading)
            {
                <GroveCard><GroveProgressBar Mode="ProgressBarMode.Indeterminate" /></GroveCard>
            }
            else if (SelectedFieldSet is null)
            {
                <GroveCard><GroveText Text="@T["Select a field group to manage its fields."]" /></GroveCard>
            }
            else
            {
                <GroveDetailPane TestId="content-part-detail" Style="flex: 1 1 auto;">
                    <Header>
                        <GroveStack Gap="0.25rem">
                            <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <GroveText TextStyle="TextStyle.H5" Text="@SelectedFieldSet.Name" />
                                @if (IsLocked(SelectedFieldSet.FieldSet.Lock))
                                {
                                    <GroveBadge Text="@LockLabel(SelectedFieldSet.FieldSet.Lock)" BadgeStyle="BadgeStyle.Warning" data-testid="field-set-lock" />
                                }
                            </GroveStack>
                            <GroveText TextStyle="TextStyle.Body2" Text="@TypeUsageText(SelectedFieldSet)" />
                        </GroveStack>
                    </Header>
                    <ChildContent>
                        <GroveFieldset Text="@T["Fields"]" AllowCollapse="true" Collapsed="false">
                            <GroveStack Gap="0.7rem">
                                @if (SelectedFieldSet.FieldSet.Fields.Length == 0)
                                {
                                    <GroveText Text="@T["No fields are defined in this field group."]" />
                                }
                                else
                                {
                                    <div class="content-part-fields">
                                        @foreach (var field in SelectedFieldSet.FieldSet.Fields.OrderBy(field => field.Name, StringComparer.OrdinalIgnoreCase))
                                        {
                                            var fieldName = field.Name;
                                            var fieldType = field.FieldType.Name;
                                            var locked = IsLocked(field.Lock);
                                            <div class="content-part-field" data-field-lock="@field.Lock">
                                                <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                                    <GroveText TextStyle="TextStyle.Subtitle2" Text="@field.Name" />
                                                    @if (locked)
                                                    {
                                                        @* A locked field keeps its existence and shape - type, source, required, visibility; its values stay editable (docs/content-engine.md › Definition locks). *@
                                                        <GroveBadge Text="@LockLabel(field.Lock)" BadgeStyle="BadgeStyle.Warning" data-testid="field-lock" />
                                                    }
                                                </GroveStack>
                                                @* The field's TYPE is the dropdown. Picking most types
                                                   converts immediately; picking Option picker opens the
                                                   settings editor first, so the conversion and the source
                                                   binding are one Save. *@
                                                <GroveDropDown TValue="string"
                                                               Value="@fieldType"
                                                               Data="@FieldTypeChoicesFor(fieldType)"
                                                               TextProperty="Label" ValueProperty="Value"
                                                               Change="@(value => OnFieldTypeChangedAsync(fieldName, fieldType, value as string))"
                                                               Disabled="@(IsLoading || locked)"
                                                               Style="width: 100%;"
                                                               data-testid="field-type-dropdown" />
                                                @if (fieldType == "OptionListField")
                                                {
                                                    <GroveButton Text="@T["Picker settings"]" Icon="tune" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                                 Click="@(() => OpenPickerEditor(fieldName))" Disabled="@locked"
                                                                 data-testid="configure-picker" />
                                                }
                                                @* Every field type can carry a visibility condition. *@
                                                <GroveButton Text="@T["Visibility"]" Icon="visibility" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                             Click="@(() => OpenVisibilityEditor(fieldName))" Disabled="@locked"
                                                             data-testid="configure-visibility" />
                                            </div>
                                        }
                                    </div>
                                }

                                @if (EditingField is not null)
                                {
                                    <OptionPickerAttachmentEditor FieldSetName="@SelectedFieldSet.Name"
                                                                  FieldName="@EditingField"
                                                                  SiblingFields="@SelectedFieldSet.FieldSet.Fields.Select(field => field.Name).ToArray()"
                                                                  OnSaved="OnPickerSavedAsync"
                                                                  OnClose="@(() => EditingField = null)" />
                                }

                                @if (EditingVisibilityField is not null)
                                {
                                    <FieldVisibilityEditor FieldSetName="@SelectedFieldSet.Name"
                                                           FieldName="@EditingVisibilityField"
                                                           SiblingFields="@SelectedFieldSet.FieldSet.Fields.Select(field => field.Name).ToArray()"
                                                           OnSaved="OnVisibilitySavedAsync"
                                                           OnClose="@(() => EditingVisibilityField = null)" />
                                }

                                <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
                                    <GroveFormField Text="@T["New field"]">
                                        <GroveTextBox @bind-Value="NewFieldName" Placeholder="@T["e.g. Country"]" Disabled="@IsLoading" />
                                    </GroveFormField>
                                    <GroveFormField Text="@T["Field type"]">
                                        <GroveDropDown @bind-Value="NewFieldType" TValue="string" Data="@FieldTypeChoices"
                                                       TextProperty="Label" ValueProperty="Value" Disabled="@IsLoading" Style="min-width: 11rem;" />
                                    </GroveFormField>
                                    <GroveButton Text="@T["Add field"]" Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                 Click="AddFieldAsync"
                                                 Disabled="@(IsLoading || string.IsNullOrWhiteSpace(NewFieldName) || string.IsNullOrWhiteSpace(NewFieldType))"
                                                 data-testid="add-picker-field" />
                                </GroveStack>
                            </GroveStack>
                        </GroveFieldset>

                        <ContentFieldSetDefinitionEditor FieldSetName="@SelectedFieldSet.Name" Changed="LoadAsync" Deleted="OnFieldSetDeletedAsync" />

                        <GroveFieldset Text="@T["Used by content types"]" AllowCollapse="true" Collapsed="false">
                            @if (SelectedFieldSet.UsedByTypes.Length == 0)
                            {
                                <GroveText Text="@T["Not attached to any content type yet. Attach it from the Content Types screen."]" />
                            }
                            else
                            {
                                <GroveStack Orientation="Orientation.Horizontal" Gap="0.45rem" Wrap="FlexWrap.Wrap">
                                    @foreach (var contentType in SelectedFieldSet.UsedByTypes)
                                    {
                                        <GroveBadge Text="@contentType" BadgeStyle="BadgeStyle.Info" />
                                    }
                                </GroveStack>
                            }
                        </GroveFieldset>
                    </ChildContent>
                </GroveDetailPane>
            }
        </div>
    </div>
</GroveStack>

@code {
    private async Task OnFieldSetCreatedAsync(string name)
    {
        SelectedFieldSetName = name;
        await LoadAsync();
    }

    private async Task OnFieldSetDeletedAsync()
    {
        SelectedFieldSetName = null;
        await LoadAsync();
    }

    private FieldSetDefinition[] FieldSets { get; set; } = [];
    private string? SelectedFieldSetName { get; set; }
    private bool IsLoading { get; set; }
    private string? ErrorMessage { get; set; }

    private string? EditingField { get; set; }
    private string? EditingVisibilityField { get; set; }
    private string NewFieldName { get; set; } = string.Empty;
    private string NewFieldType { get; set; } = "TextField";
    private string[] FieldTypes { get; set; } = [];

    private FieldSetDefinition? SelectedFieldSet => FieldSets.FirstOrDefault(part => string.Equals(part.Name, SelectedFieldSetName, StringComparison.OrdinalIgnoreCase));

    private sealed record FieldSetDefinition(string Name, ContentFieldSet FieldSet, string[] UsedByTypes);

    private static bool IsLocked(string? lockSource) => !string.IsNullOrEmpty(lockSource) && lockSource != "None";
    private string LockLabel(string lockSource) => lockSource == "Module" ? T["Locked by module"] : T["Locked"];
    private sealed record Choice(string Label, string Value);

    private Choice[] FieldTypeChoices => [.. FieldTypes.Select(type => new Choice(FieldTypeLabel(type), type))];

    // The current type stays pickable even when no longer registered (a disabled
    // feature's field), so the dropdown never shows an empty value.
    private Choice[] FieldTypeChoicesFor(string currentType) => FieldTypes.Contains(currentType, StringComparer.Ordinal)
        ? FieldTypeChoices
        : [new(FieldTypeLabel(currentType), currentType), .. FieldTypeChoices];

    private string FieldTypeLabel(string type) =>
        type == "OptionListField" ? T["Option picker"]
        : type.EndsWith("Field", StringComparison.Ordinal) ? type[..^"Field".Length] : type;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            FieldTypes = await Http.GetFromJsonAsync<string[]>("api/grove/content-types/field-types") ?? [];
        }
        catch
        {
            FieldTypes = [];
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            FieldSets = await Http.GetFromJsonAsync<FieldSetDefinition[]>("api/grove/content-types/field-sets") ?? [];
            SelectedFieldSetName = FieldSets.Any(part => string.Equals(part.Name, SelectedFieldSetName, StringComparison.OrdinalIgnoreCase))
                ? SelectedFieldSetName
                : FieldSets.FirstOrDefault()?.Name;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private Task SelectFieldSetAsync(FieldSetDefinition part)
    {
        SelectedFieldSetName = part.Name;
        EditingField = null;
        EditingVisibilityField = null;
        return Task.CompletedTask;
    }

    private static bool MatchesSearch(FieldSetDefinition part, string term) =>
        part.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
        || part.FieldSet.Fields.Any(field => field.Name.Contains(term, StringComparison.OrdinalIgnoreCase))
        || part.UsedByTypes.Any(contentType => contentType.Contains(term, StringComparison.OrdinalIgnoreCase));

    private string TypeUsageText(FieldSetDefinition part) => part.UsedByTypes.Length switch
    {
        0 => T["Not attached to any content type."],
        1 => T["Attached to 1 content type - field changes land there."],
        _ => T["Attached to {0} content types - field changes land on all of them.", part.UsedByTypes.Length],
    };

    private async Task OnFieldTypeChangedAsync(string fieldName, string currentType, string? newType)
    {
        if (SelectedFieldSet is null || string.IsNullOrWhiteSpace(newType) || newType == currentType)
        {
            return;
        }

        // Option picker conversion goes through the settings editor: the type change
        // and the source binding are one Save, never a half-configured picker.
        if (newType == "OptionListField")
        {
            OpenPickerEditor(fieldName);
            return;
        }

        await SetFieldTypeAsync(fieldName, newType);
    }

    private async Task AddFieldAsync()
    {
        if (SelectedFieldSet is null || string.IsNullOrWhiteSpace(NewFieldName) || string.IsNullOrWhiteSpace(NewFieldType))
        {
            return;
        }

        var fieldName = NewFieldName.Trim();
        if (NewFieldType == "OptionListField")
        {
            EditingField = fieldName;
            return;
        }

        await SetFieldTypeAsync(fieldName, NewFieldType);
        NewFieldName = string.Empty;
    }

    private async Task SetFieldTypeAsync(string fieldName, string fieldType)
    {
        if (SelectedFieldSet is null)
        {
            return;
        }

        ErrorMessage = null;
        try
        {
            using var response = await Http.PutAsJsonAsync("api/grove/content-types/fields",
                new { FieldSet = SelectedFieldSet.Name, Field = fieldName, FieldType = fieldType });
            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            Notifications.Notify(NotificationSeverity.Success, T["Field groups"], T["{0} is now a {1}.", fieldName, FieldTypeLabel(fieldType)]);
            await LoadAsync();
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
    }

    private void OpenPickerEditor(string fieldName)
    {
        EditingField = fieldName;
        EditingVisibilityField = null;
    }

    private async Task OnPickerSavedAsync()
    {
        EditingField = null;
        NewFieldName = string.Empty;
        await LoadAsync();
    }

    private void OpenVisibilityEditor(string fieldName)
    {
        EditingVisibilityField = fieldName;
        EditingField = null;
    }

    private async Task OnVisibilitySavedAsync()
    {
        EditingVisibilityField = null;
        await LoadAsync();
    }
}

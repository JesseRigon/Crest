@page "/Users/Create"
@page "/Users/Edit/{Id}"
@attribute [PageEntry("EditUsers")]
@using Grove.Themes.Admin.Api
@using Grove.Display.Components.Primitives
@using Grove.Display.Components.Primitives
@inject IApi Api
@inject NavigationManager Navigation
@inject Grove.Display.Components.Theme.GroveApiLocalizer T
@inject HttpClient Http
@inject NotificationService Notifications
@using System.Text.Json.Nodes
@using Grove.Themes.Admin.Display

<GroveStack Gap="1rem" data-testid="user-editor-page">
    <GroveText TextStyle="TextStyle.H4" Text="@(IsNew ? T["Add User"] : T["Edit User"])" />
    @if (Model is null) { <GroveProgressBar Mode="ProgressBarMode.Indeterminate" /> }
    else
    {
        <GroveLabel Text="@T["User Name"]" Component="username" /><GroveTextBox Name="username" @bind-Value="Model.UserName" Style="width:100%" />
        <GroveLabel Text="@T["Email"]" Component="email" /><GroveTextBox Name="email" @bind-Value="Model.Email" Style="width:100%" />
        <GroveLabel Text="@T["Phone Number"]" Component="phone" /><GroveTextBox Name="phone" @bind-Value="Model.PhoneNumber" Style="width:100%" />
        <GroveLabel Text="@(IsNew ? T["Password"] : T["New password (leave blank to retain)"])" Component="password" /><GrovePassword Name="password" @bind-Value="Model.Password" Style="width:100%" />
        <GroveCheckBox @bind-Value="Model.EmailConfirmed" Name="email-confirmed" /><label for="email-confirmed"> @T["Email confirmed"]</label><br />
        <GroveCheckBox @bind-Value="Model.IsEnabled" Name="user-enabled" /><label for="user-enabled"> @T["Enabled"]</label>
        <GroveLabel Text="@T["Roles (comma-separated)"]" Component="roles" /><GroveTextBox Name="roles" @bind-Value="Roles" Style="width:100%" />
        @* Derived (business) roles, read-only beneath the assigned ones (docs/sharing.md, requirement 47). *@
        @if (!IsNew) { <Grove.Display.Components.Sharing.GroveDerivedRoles UserId="@(Id ?? string.Empty)" /> }
        @if (!IsNew) { <UserAccountActions UserId="@(Id ?? string.Empty)" EmailConfirmed="Model.EmailConfirmed" EmailConfirmedChanged="@(() => Model.EmailConfirmed = true)" /> }
        <GroveStack Orientation="Orientation.Horizontal"><GroveButton Text="@T["Save"]" Icon="save" Click="SaveAsync" /><GroveButton Text="@T["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="Cancel" /></GroveStack>
        @if (!string.IsNullOrWhiteSpace(Error)) { <GroveText Style="color: var(--rz-danger)">@Error</GroveText> }

        @if (!IsNew) { <NotificationPreferences UserId="@Id" /> }

        @* Custom user settings (Grove.Access.Users.CustomUserSettings): a section per settings type the
           caller may manage, each the content editor of the item kept on the user, saved on its own. *@
        @foreach (var section in SettingsSections)
        {
            <GroveCard data-testid="@($"custom-user-settings-{section.Type.Name}")">
                <GroveStack Gap="0.5rem">
                    <GroveText TextStyle="TextStyle.Subtitle1" Text="@section.Type.DisplayName" />
                    @if (section.Tree is { } tree)
                    {
                        <DisplayTreeRenderer @key="section.State" Node="tree.Root" State="section.State" />
                        <GroveStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                            <GroveButton Text="@T["Save {0}", section.Type.DisplayName]" Icon="save" Click="@(() => SaveSettingsAsync(section))" Disabled="section.IsSaving" />
                        </GroveStack>
                    }
                    else
                    {
                        <GroveProgressBar Mode="ProgressBarMode.Indeterminate" />
                    }
                </GroveStack>
            </GroveCard>
        }
    }
</GroveStack>

@code {
    [Parameter] public string? Id { get; set; }
    private bool IsNew => string.IsNullOrWhiteSpace(Id);
    private UserWrite? Model;
    private string? Roles;
    private string? Error;
    protected override async Task OnParametersSetAsync()
    {
        if (IsNew) { Model = new UserWrite(null, null, null, false, true, [], null); SettingsSections.Clear(); return; }
        var user = await Api.Grove.Rest.Users.GetAsync(Id!);
        Model = user is null ? null : new UserWrite(user.UserName, user.Email, user.PhoneNumber, user.EmailConfirmed, user.IsEnabled, user.Roles, null);
        Roles = user is null ? null : string.Join(", ", user.Roles);
        await LoadSettingsAsync();
    }

    private List<SettingsSection> SettingsSections { get; } = [];

    private string SettingsApi => $"api/grove/users/{Uri.EscapeDataString(Id!)}/custom-settings";

    private async Task LoadSettingsAsync()
    {
        SettingsSections.Clear();
        SettingsType[] types;
        try
        {
            // 404 while the custom user settings feature is disabled.
            using var response = await Http.GetAsync(SettingsApi);
            types = response.IsSuccessStatusCode ? await response.Content.ReadFromJsonAsync<SettingsType[]>() ?? [] : [];
        }
        catch (HttpRequestException) { types = []; }

        foreach (var type in types)
        {
            var section = new SettingsSection(type);
            SettingsSections.Add(section);
            try { section.Tree = await Http.GetFromJsonAsync<DisplayTree>($"{SettingsApi}/{Uri.EscapeDataString(type.Name)}/editor"); }
            catch (Exception exception) { Error = exception.Message; }
        }
    }

    private async Task SaveSettingsAsync(SettingsSection section)
    {
        var editor = section.Tree is null ? null : DisplayTreeValidator.Walk(section.Tree.Root).FirstOrDefault(node => node.Component == "ContentEditor");
        if (editor is null) return;
        var content = (section.State.GetOutput(editor.Id, "ContentChanged") ?? (editor.Properties.TryGetValue("Content", out var stored) ? stored?.DeepClone() : null)) as JsonObject;

        section.IsSaving = true;
        Error = null;
        try
        {
            using var response = await Http.PutAsJsonAsync($"{SettingsApi}/{Uri.EscapeDataString(section.Type.Name)}", new { Content = content });
            if (!response.IsSuccessStatusCode) { Error = await response.Content.ReadAsStringAsync(); return; }
            Notifications.Notify(NotificationSeverity.Success, T["Settings saved"], T["{0} was saved.", section.Type.DisplayName]);
        }
        finally { section.IsSaving = false; }
    }

    private sealed record SettingsType(string Name, string DisplayName);

    private sealed class SettingsSection(SettingsType type)
    {
        public SettingsType Type { get; } = type;
        public DisplayTree? Tree { get; set; }
        public DisplayState State { get; } = new();
        public bool IsSaving { get; set; }
    }
    private async Task SaveAsync()
    {
        if (Model is null) return;
        Error = null;
        Model.Roles = (Roles ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var saved = IsNew ? await Api.Grove.Rest.Users.CreateAsync(Model) : await Api.Grove.Rest.Users.SaveAsync(Id!, Model);
        if (saved is null) { Error = T["The user could not be saved. Check the supplied values."]; return; }
        Navigation.NavigateTo("Users/Index");
    }
    private void Cancel() => Navigation.NavigateTo("Users/Index");
}

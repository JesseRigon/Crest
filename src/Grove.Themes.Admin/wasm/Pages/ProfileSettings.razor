@page "/Profile/Settings"
@attribute [PageEntry("AccessAdminPanel")]
@attribute [Grove.Display.Components.Modules.SetsAuthenticationCookie]
@using Grove.Themes.Admin.Api
@using Grove.Themes.Admin.State
@using Grove.Display.Components.Primitives
@inject IApi Api
@inject NotificationService Notifications
@inject Grove.Display.Components.Theme.GroveApiLocalizer T
@inject HttpClient Http

<GroveStack Gap="1rem" class="profile-settings-page" data-testid="profile-settings-page">
    <div>
        <GroveText TextStyle="TextStyle.H4" Text="@T["Settings"]" />
        <GroveText TextStyle="TextStyle.Body2" Text="@T["Preferences for your own account. These never affect other users or tenant-wide settings."]" />
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <GroveAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</GroveAlert>
    }

    <GroveCard>
        <GroveStack Gap="0.75rem">
            <GroveText TextStyle="TextStyle.Subtitle1" Text="@T["Localization"]" />
            <GroveText TextStyle="TextStyle.Body2" Text="@T["Your default language. This is used whenever you sign in, unless you switch languages temporarily from the culture picker in the title bar."]" />

            @if (IsLoading)
            {
                <GroveProgressBar Mode="ProgressBarMode.Indeterminate" />
            }
            else
            {
                <GroveDropDown TValue="string"
                                Data="CultureOptions"
                                Value="@SelectedCulture"
                                ValueChanged="SelectCultureAsync"
                                TextProperty="@nameof(CultureOption.Label)"
                                ValueProperty="@nameof(CultureOption.Value)"
                                Placeholder="@T["Use the tenant default"]"
                                AllowFiltering="true"
                                FilterPlaceholder="@T["Filter cultures"]"
                                class="profile-settings-page__culture-dropdown" />
                <GroveText TextStyle="TextStyle.Caption" Text="@T["Leave unset to follow the tenant's default culture."]" />
            }
        </GroveStack>
    </GroveCard>

    @if (TimeZone is not null)
    {
        @* Grove.Access.Users.TimeZone: the user's own time zone (api/grove/time-zone/me). *@
        <GroveCard data-testid="profile-settings-time-zone">
            <GroveStack Gap="0.75rem">
                <GroveText TextStyle="TextStyle.Subtitle1" Text="@T["Default Time Zone"]" />
                <GroveDropDown TValue="string"
                                Data="TimeZone.TimeZones"
                                Value="@TimeZone.TimeZoneId"
                                ValueChanged="SelectTimeZoneAsync"
                                TextProperty="Name"
                                ValueProperty="Id"
                                Placeholder="@T["Use the site's time zone"]"
                                AllowClear="true"
                                AllowFiltering="true"
                                FilterPlaceholder="@T["Filter time zones"]"
                                Style="max-width: 32rem; width: 100%;" />
            </GroveStack>
        </GroveCard>
    }

    <NotificationPreferences />

    @* Password, email and external logins (step 7: the MVC account screens are retired). *@
    <GroveCard data-testid="profile-settings-account">
        <Grove.Access.Users.Components.GroveAccountSecurity />
    </GroveCard>
</GroveStack>

@code {
    [CascadingParameter] public AdminShellState? AdminShellState { get; set; }

    private bool IsLoading { get; set; } = true;
    private bool IsSaving { get; set; }
    private string? ErrorMessage { get; set; }
    private string? SelectedCulture { get; set; }

    private TimeZoneModel? TimeZone { get; set; }

    private CultureOption[] CultureOptions => AdminShellState?.Manifest?.CultureSelector.Cultures ?? [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var current = await Api.Grove.Rest.Localization.GetMyCultureAsync();
            SelectedCulture = current?.Culture;

            // Absent (404) while the user time zone feature is disabled.
            using var response = await Http.GetAsync("api/grove/time-zone/me");
            TimeZone = response.IsSuccessStatusCode ? await response.Content.ReadFromJsonAsync<TimeZoneModel>() : null;
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SelectCultureAsync(string? value)
    {
        if (IsSaving)
        {
            return;
        }

        IsSaving = true;
        ErrorMessage = null;
        try
        {
            var saved = await Api.Grove.Rest.Localization.SetMyCultureAsync(new UserCulture(value));
            if (saved is null)
            {
                throw new InvalidOperationException(T["Unable to save your default culture."]);
            }

            SelectedCulture = saved.Culture;
            Notifications.Notify(NotificationSeverity.Success, T["Settings"], T["Your default language was saved."]);
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task SelectTimeZoneAsync(string? value)
    {
        if (IsSaving || TimeZone is null)
        {
            return;
        }

        IsSaving = true;
        ErrorMessage = null;
        try
        {
            using var response = await Http.PutAsJsonAsync("api/grove/time-zone/me", new { TimeZoneId = value });
            if (!response.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(T["Unable to save your time zone."]);
            }

            TimeZone = await response.Content.ReadFromJsonAsync<TimeZoneModel>();
            Notifications.Notify(NotificationSeverity.Success, T["Settings"], T["Your time zone was saved."]);
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private sealed record TimeZoneModel(string? TimeZoneId, TimeZoneOption[] TimeZones);
    private sealed record TimeZoneOption(string Id, string Name);
}

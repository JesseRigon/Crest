@page "/TenantFeatureProfiles"
@attribute [PageEntry("ManageTenantFeatureProfiles", Id = "feature-profiles", Parent = "multitenancy", Caption = "Feature Profiles", DefaultTenantOnly = true)]
@using Grove.Display.Components.Primitives
@using System.Net.Http.Json
@inject HttpClient Http
@inject Grove.Display.Components.Theme.GroveApiLocalizer T

@* The feature profiles a tenant can be given on the Tenants page (Grove.Infrastructure.Tenants.FeatureProfiles,
   Default tenant): each profile's rules include or exclude the features whose ids an expression
   matches, in order. *@

<PageTitle>@T["Feature Profiles"]</PageTitle>

<GroveStack Gap="1rem" data-testid="feature-profiles-page">
    <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Wrap="FlexWrap.Wrap">
        <GroveStack Gap="0.25rem">
            <GroveText TextStyle="TextStyle.H4" class="rz-m-0">@T["Feature Profiles"]</GroveText>
            <GroveText TextStyle="TextStyle.Body2">@T["Which features a tenant given the profile may enable."]</GroveText>
        </GroveStack>
        <GroveButton Icon="add" Text="@T["Add feature profile"]" Click="New" Disabled="IsBusy" data-testid="feature-profiles-add" />
    </GroveStack>

    @if (Error is not null)
    {
        <GroveAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="true">@Error</GroveAlert>
    }

    @if (Draft is not null)
    {
        <GroveCard data-testid="feature-profile-editor">
            <GroveStack Gap="0.75rem">
                <GroveText TextStyle="TextStyle.H5" class="rz-m-0">@(DraftId is null ? T["New feature profile"] : T["Edit {0}", Draft.Name])</GroveText>
                <GroveRow Gap="1rem">
                    <GroveColumn Size="12" SizeMD="6">
                        <GroveFormField Text="@T["Id"]" Style="width: 100%;"><GroveTextBox @bind-Value="Draft.Id" Disabled="@(DraftId is not null)" Style="width: 100%;" Name="id" /></GroveFormField>
                        @FieldError("id")
                    </GroveColumn>
                    <GroveColumn Size="12" SizeMD="6">
                        <GroveFormField Text="@T["Name"]" Style="width: 100%;"><GroveTextBox @bind-Value="Draft.Name" Style="width: 100%;" Name="name" /></GroveFormField>
                        @FieldError("name")
                    </GroveColumn>
                </GroveRow>
                <GroveText TextStyle="TextStyle.Subtitle1" class="rz-m-0">@T["Feature rules"]</GroveText>
                @for (var index = 0; index < Rules.Count; index++)
                {
                    var rule = Rules[index];
                    var at = index;
                    <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                        <GroveDropDown TValue="string" @bind-Value="rule.Rule" Data="@RuleNames" Style="width: 10rem" />
                        <GroveTextBox @bind-Value="rule.Expression" Placeholder="@T["Feature id expression, e.g. Grove.*"]" Style="width: 24rem" />
                        <GroveButton Icon="arrow_upward" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Disabled="@(at == 0)" Click="@(() => Move(at, -1))" title="@T["Move up"]" />
                        <GroveButton Icon="arrow_downward" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Disabled="@(at == Rules.Count - 1)" Click="@(() => Move(at, 1))" title="@T["Move down"]" />
                        <GroveButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="@(() => Rules.RemoveAt(at))" title="@T["Remove"]" />
                    </GroveStack>
                    @FieldError($"featureRules[{index}].rule")
                    @FieldError($"featureRules[{index}].expression")
                }
                <div><GroveButton Icon="add" Text="@T["Add rule"]" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => Rules.Add(new RuleDraft { Rule = RuleNames.FirstOrDefault() ?? "Include" }))" /></div>
                <GroveStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <GroveButton Text="@T["Cancel"]" ButtonStyle="ButtonStyle.Light" Click="@(() => Draft = null)" Disabled="IsBusy" />
                    <GroveButton Text="@T["Save"]" Icon="save" Click="SaveAsync" Disabled="IsBusy" data-testid="feature-profile-save" />
                </GroveStack>
            </GroveStack>
        </GroveCard>
    }

    <GroveCard>
        @if (Model is null)
        {
            <GroveProgressBar Mode="ProgressBarMode.Indeterminate" />
        }
        else if (Model.Profiles.Length == 0)
        {
            <GroveText TextStyle="TextStyle.Body2">@T["No feature profiles yet."]</GroveText>
        }
        else
        {
            <GroveDataGrid Data="@Model.Profiles" TItem="ProfileModel" AllowPaging="true" PageSize="20" Density="Density.Compact">
                <Columns>
                    <GroveDataGridColumn TItem="ProfileModel" Property="Name" Title="@T["Name"]" />
                    <GroveDataGridColumn TItem="ProfileModel" Property="Id" Title="@T["Id"]" Width="12rem" />
                    <GroveDataGridColumn TItem="ProfileModel" Title="@T["Rules"]">
                        <Template Context="profile">@string.Join("; ", profile.FeatureRules.Select(rule => $"{rule.Rule} {rule.Expression}"))</Template>
                    </GroveDataGridColumn>
                    <GroveDataGridColumn TItem="ProfileModel" Title="@T["Actions"]" Width="8rem">
                        <Template Context="profile">
                            <GroveStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                                <GroveButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => Edit(profile))" title="@T["Edit"]" />
                                <GroveButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="@(() => DeleteAsync(profile))" Disabled="IsBusy" title="@T["Delete"]" />
                            </GroveStack>
                        </Template>
                    </GroveDataGridColumn>
                </Columns>
            </GroveDataGrid>
        }
    </GroveCard>
</GroveStack>

@code {
    private const string Api = "api/grove/tenants/feature-profiles";

    private ProfilesModel? Model;
    private ProfileWrite? Draft;
    private string? DraftId;
    private List<RuleDraft> Rules = [];
    private Dictionary<string, string[]> Errors = new(StringComparer.OrdinalIgnoreCase);
    private bool IsBusy;
    private string? Error;

    private string[] RuleNames => Model?.Rules is { Length: > 0 } rules ? rules : ["Include", "Exclude"];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try { Model = await Http.GetFromJsonAsync<ProfilesModel>(Api); }
        catch (Exception exception) { Error = exception.Message; }
    }

    private void New()
    {
        Draft = new ProfileWrite();
        DraftId = null;
        Rules = [];
        Errors.Clear();
    }

    private void Edit(ProfileModel profile)
    {
        Draft = new ProfileWrite { Id = profile.Id, Name = profile.Name };
        DraftId = profile.Id;
        Rules = [.. profile.FeatureRules.Select(rule => new RuleDraft { Rule = rule.Rule, Expression = rule.Expression })];
        Errors.Clear();
    }

    private void Move(int index, int by)
    {
        var rule = Rules[index];
        Rules.RemoveAt(index);
        Rules.Insert(index + by, rule);
    }

    private async Task SaveAsync()
    {
        if (Draft is null) return;
        Draft.FeatureRules = [.. Rules.Select(rule => new RuleModel(rule.Rule, rule.Expression))];
        IsBusy = true;
        Error = null;
        Errors.Clear();
        try
        {
            using var response = DraftId is null
                ? await Http.PostAsJsonAsync(Api, Draft)
                : await Http.PutAsJsonAsync($"{Api}/{Uri.EscapeDataString(DraftId)}", Draft);
            if (!response.IsSuccessStatusCode)
            {
                var problem = await ReadProblemAsync(response);
                if (problem?.Errors is { Count: > 0 } errors) Errors = new(errors, StringComparer.OrdinalIgnoreCase);
                else Error = problem?.Detail ?? T["The feature profile could not be saved."];
                return;
            }

            Draft = null;
            await LoadAsync();
        }
        finally { IsBusy = false; }
    }

    private async Task DeleteAsync(ProfileModel profile)
    {
        IsBusy = true;
        try
        {
            using var response = await Http.DeleteAsync($"{Api}/{Uri.EscapeDataString(profile.Id)}");
            if (!response.IsSuccessStatusCode) Error = T["{0} could not be deleted.", profile.Name];
            await LoadAsync();
        }
        finally { IsBusy = false; }
    }

    private RenderFragment? FieldError(string key) => Errors.TryGetValue(key, out var messages)
        ? @<GroveText TextStyle="TextStyle.Caption" class="rz-color-danger">@string.Join(" ", messages)</GroveText>
        : null;

    private static async Task<Problem?> ReadProblemAsync(HttpResponseMessage response)
    {
        try { return await response.Content.ReadFromJsonAsync<Problem>(); }
        catch { return null; }
    }

    private sealed record Problem(string? Title, string? Detail, Dictionary<string, string[]>? Errors);

    private sealed record RuleModel(string Rule, string Expression);

    private sealed record ProfileModel(string Id, string Name, RuleModel[] FeatureRules);

    private sealed record ProfilesModel(ProfileModel[] Profiles, string[] Rules);

    private sealed class ProfileWrite
    {
        public string? Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public RuleModel[] FeatureRules { get; set; } = [];
    }

    private sealed class RuleDraft
    {
        public string Rule { get; set; } = "Include";
        public string Expression { get; set; } = string.Empty;
    }
}

@page "/ContentTypes/List"
@attribute [PageEntry("ViewContentTypes", Id = "content-types", Parent = "content-definition", Caption = "Content Types", Position = "1")]
@using System.Net.Http.Json
@using Grove.Themes.Admin.Api
@using Grove.Display.Components.Model
@using Grove.Display.Components.Primitives
@inject IApi Api
@inject HttpClient Http
@inject NotificationService Notifications
@inject NavigationManager Navigation
@inject Grove.Display.Components.Theme.GroveApiLocalizer T

@* This screen manages which content types carry which PARTS, and the attachment's
   instance settings (display name, description, position). Fields are deliberately
   read-only here: they belong to the part definition and are edited on the Content
   Parts screen, because a part is shared - a field change lands on every type
   carrying it. *@
<GroveStack Gap="1rem" data-testid="content-types-page" Style="height: 100%;">
    <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Wrap="FlexWrap.Wrap">
        <GroveStack Gap="0.25rem">
            <GroveText TextStyle="TextStyle.H4" Text="@T["Content Types"]" />
            <GroveText TextStyle="TextStyle.Body2" Text="@T["Manage which parts each content type carries. Fields live on the parts - edit them on the Content Parts screen."]" />
        </GroveStack>
        <GroveButton Text="@T["Refresh"]" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="LoadAsync" Disabled="@IsLoading" />
    </GroveStack>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <GroveAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@ErrorMessage</GroveAlert>
    }

    <ContentDefinitionCreate Kind="type" Created="OnTypeCreatedAsync" />

    @* Standard master-detail structure: this region takes the page's remaining
       height; the list's items and the detail pane's body do the scrolling. *@
    <div style="display: flex; flex-wrap: wrap; gap: 1rem; flex: 1 1 auto; min-height: 0; align-items: stretch;">
        <div style="flex: 0 1 350px; min-width: 16rem; min-height: 0; display: flex;">
            <GroveModelList TItem="ContentType"
                            Title="@T["Content Types"]"
                            Items="@AllContentTypes"
                            SelectedKey="@SelectedTypeName"
                            KeySelector="@(type => type.Name)"
                            TextSelector="@(type => type.DisplayName)"
                            DescriptionSelector="@(type => T["{0} · {1} parts", type.Name, type.Parts.Length])"
                            SearchPredicate="MatchesSearch"
                            Select="SelectTypeAsync"
                            ShowCreate="false"
                            IsBusy="@IsLoading"
                            MinWidth="16rem"
                            MaxWidth="350px"
                            EmptyText="@T["No content types are available."]" />
        </div>
        <div style="flex: 1 1 480px; min-width: 0; min-height: 0; display: flex;">
            @if (IsLoading)
            {
                <GroveCard><GroveProgressBar Mode="ProgressBarMode.Indeterminate" /></GroveCard>
            }
            else if (SelectedType is null)
            {
                <GroveCard><GroveText Text="@T["Select a content type to manage its parts."]" /></GroveCard>
            }
            else
            {
                <GroveDetailPane TestId="content-type-detail" Style="flex: 1 1 auto;">
                    <Header>
                        <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Wrap="FlexWrap.Wrap">
                            <GroveStack Gap="0.25rem">
                                <GroveText TextStyle="TextStyle.H5" Text="@SelectedType.DisplayName" />
                                <GroveText TextStyle="TextStyle.Caption" Text="@SelectedType.Name" />
                            </GroveStack>
                            <GroveStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                                @* Designation, not data: puts the type in the Content menu,
                                   linking to the content-items page filtered to it. *@
                                <GroveFormField Text="@T["Show in Content menu"]">
                                    <GroveSwitch Value="@ShowInContentMenu" Change="@(value => SetMenuAsync((bool)value))" Disabled="@IsLoading" data-testid="show-in-content-menu" />
                                </GroveFormField>
                                <GroveButton Text="@T["Create content item"]" Icon="add" Size="ButtonSize.Small" Click="CreateContentItem" />
                            </GroveStack>
                        </GroveStack>
                    </Header>
                    <ChildContent>
                        @if (SelectedType.Parts.Length == 0)
                        {
                            <GroveAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">@T["This type has no attached parts."]</GroveAlert>
                        }
                        else
                        {
                            @foreach (var part in SelectedType.Parts.OrderBy(part => part.Name, StringComparer.OrdinalIgnoreCase))
                            {
                                var attachedName = part.Name;
                                <GroveFieldset Text="@part.Name" AllowCollapse="true" Collapsed="true" class="content-definition-part">
                                    <GroveStack Gap="0.7rem">
                                        <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap">
                                            <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                                <GroveBadge Text="@part.Part.Name" BadgeStyle="BadgeStyle.Secondary" />
                                                <GroveBadge Text="@T["{0} fields", part.Part.Fields.Length]" BadgeStyle="BadgeStyle.Info" />
                                                @if (part.Lock != "None")
                                                {
                                                    @* A locked attachment stays on the type (docs/content-items.md › Definition locks). *@
                                                    <GroveBadge Text="@(part.Lock == "Module" ? T["Locked by module"] : T["Locked"])" BadgeStyle="BadgeStyle.Warning" data-testid="attachment-lock" />
                                                }
                                            </GroveStack>
                                            <GroveButton Text="@T["Detach"]" Icon="link_off" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                                         Click="@(() => DetachPartAsync(attachedName))" Disabled="@(IsLoading || part.Lock != "None")" data-testid="detach-part" />
                                        </GroveStack>

                                        @* The ATTACHMENT's instance settings - how this part presents
                                           on THIS type. The part's fields stay shared. *@
                                        <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap" data-testid="part-attachment-settings">
                                            <GroveFormField Text="@T["Display name"]">
                                                <GroveTextBox Value="@AttachmentDraft(attachedName, "DisplayName", PartSetting(part, "DisplayName"))"
                                                              ValueChanged="@(value => SetAttachmentDraft(attachedName, "DisplayName", value))"
                                                              Disabled="@IsLoading" />
                                            </GroveFormField>
                                            <GroveFormField Text="@T["Description"]">
                                                <GroveTextBox Value="@AttachmentDraft(attachedName, "Description", PartSetting(part, "Description"))"
                                                              ValueChanged="@(value => SetAttachmentDraft(attachedName, "Description", value))"
                                                              Disabled="@IsLoading" Style="min-width: 16rem;" />
                                            </GroveFormField>
                                            <GroveFormField Text="@T["Position"]">
                                                <GroveTextBox Value="@AttachmentDraft(attachedName, "Position", PartSetting(part, "Position"))"
                                                              ValueChanged="@(value => SetAttachmentDraft(attachedName, "Position", value))"
                                                              Disabled="@IsLoading" Style="width: 5rem;" />
                                            </GroveFormField>
                                            <GroveButton Text="@T["Save"]" Icon="save" Size="ButtonSize.Small"
                                                         Click="@(() => SaveAttachmentAsync(attachedName))" Disabled="@IsLoading" data-testid="save-part-attachment" />
                                        </GroveStack>

                                        @if (part.Part.Fields.Length > 0)
                                        {
                                            <div class="content-definition-fields">
                                                @foreach (var field in part.Part.Fields.OrderBy(field => field.Name, StringComparer.OrdinalIgnoreCase))
                                                {
                                                    <div class="content-definition-field">
                                                        <GroveText TextStyle="TextStyle.Subtitle2" Text="@field.Name" />
                                                        <GroveText TextStyle="TextStyle.Caption" Text="@field.Field.Name" />
                                                    </div>
                                                }
                                            </div>
                                            <GroveText TextStyle="TextStyle.Caption" Text="@T["Fields are shared by every type carrying this part - edit them on the Content Parts screen."]" />
                                        }
                                    </GroveStack>
                                </GroveFieldset>
                            }
                        }

                        <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
                            <GroveFormField Text="@T["Attach part"]">
                                <GroveDropDown @bind-Value="PartToAttach" TValue="string" Data="@AttachablePartChoices"
                                               TextProperty="Label" ValueProperty="Value" Disabled="@IsLoading" Style="min-width: 14rem;" data-testid="attach-part-dropdown" />
                            </GroveFormField>
                            <GroveButton Text="@T["Attach"]" Icon="add_link" Size="ButtonSize.Small"
                                         Click="AttachPartAsync" Disabled="@(IsLoading || string.IsNullOrWhiteSpace(PartToAttach))" data-testid="attach-part" />
                        </GroveStack>

                        <ContentTypeDefinitionEditor TypeName="@SelectedType.Name" Changed="LoadAsync" Deleted="OnTypeDeletedAsync" />
                    </ChildContent>
                </GroveDetailPane>
            }
        </div>
    </div>
</GroveStack>

@code {
    private async Task OnTypeCreatedAsync(string name)
    {
        SelectedTypeName = name;
        await LoadAsync();
    }

    private async Task OnTypeDeletedAsync()
    {
        SelectedTypeName = null;
        await LoadAsync();
    }

    private ContentType[] AllContentTypes { get; set; } = [];
    private string[] AllPartNames { get; set; } = [];
    private string? SelectedTypeName { get; set; }
    private bool IsLoading { get; set; }
    private string? ErrorMessage { get; set; }
    private string PartToAttach { get; set; } = string.Empty;

    private ContentType? SelectedType => AllContentTypes.FirstOrDefault(type => string.Equals(type.Name, SelectedTypeName, StringComparison.OrdinalIgnoreCase));

    private sealed record Choice(string Label, string Value);
    private sealed record PartDefinitionSummary(string Name);

    private Choice[] AttachablePartChoices => SelectedType is null
        ? []
        : [.. AllPartNames
            .Where(name => !SelectedType.Parts.Any(part => string.Equals(part.Name, name, StringComparison.OrdinalIgnoreCase)))
            .Select(name => new Choice(name, name))];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            AllContentTypes = (await Api.Grove.Rest.Content.Types.ListAsync())
                .OrderBy(type => type.DisplayName, StringComparer.OrdinalIgnoreCase)
                .ToArray();
            SelectedTypeName = AllContentTypes.Any(type => string.Equals(type.Name, SelectedTypeName, StringComparison.OrdinalIgnoreCase))
                ? SelectedTypeName
                : AllContentTypes.FirstOrDefault()?.Name;

            var parts = await Http.GetFromJsonAsync<PartDefinitionSummary[]>("api/grove/content-types/parts") ?? [];
            AllPartNames = [.. parts.Select(part => part.Name)];
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private Task SelectTypeAsync(ContentType contentType)
    {
        SelectedTypeName = contentType.Name;
        AttachmentDrafts.Clear();
        return Task.CompletedTask;
    }

    private static bool MatchesSearch(ContentType contentType, string term) =>
        contentType.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
        || contentType.DisplayName.Contains(term, StringComparison.OrdinalIgnoreCase)
        || contentType.Parts.Any(part => part.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
            || part.Part.Fields.Any(field => field.Name.Contains(term, StringComparison.OrdinalIgnoreCase)));

    // The designation is stored on the type definition's settings bag under the
    // POCO's type name; the serializer omits default values, so absent = false.
    private bool ShowInContentMenu =>
        bool.TryParse(SelectedType?.Settings?["GroveContentTypeMenuSettings"]?["ShowInContentMenu"]?.ToString(), out var value) && value;

    private async Task SetMenuAsync(bool show)
    {
        if (SelectedType is null)
        {
            return;
        }

        await SendAsync(
            () => Http.PutAsJsonAsync($"api/grove/content-types/{Uri.EscapeDataString(SelectedType.Name)}/menu", new { ShowInContentMenu = show }),
            show ? T["Added to the Content menu."] : T["Removed from the Content menu."]);
    }

    private void CreateContentItem()
    {
        if (SelectedType is not null)
        {
            Navigation.NavigateTo($"Contents/ContentTypes/{Uri.EscapeDataString(SelectedType.Name)}/Create");
        }
    }

    // The type-part attachment's stored settings live in the part attachment's
    // Settings JSON under ContentTypePartSettings.
    private static string PartSetting(ContentTypePart part, string key) =>
        part.Settings?["ContentTypePartSettings"]?[key]?.ToString() ?? string.Empty;

    // Draft buffer per (part, setting): the boxes re-render on every keystroke.
    private Dictionary<string, string> AttachmentDrafts { get; } = new(StringComparer.Ordinal);

    private string AttachmentDraft(string part, string key, string stored) =>
        AttachmentDrafts.TryGetValue($"{part}{key}", out var draft) ? draft : stored;

    private void SetAttachmentDraft(string part, string key, string? value) =>
        AttachmentDrafts[$"{part}{key}"] = value ?? string.Empty;

    private async Task SaveAttachmentAsync(string partName)
    {
        if (SelectedType is null)
        {
            return;
        }

        var part = SelectedType.Parts.FirstOrDefault(candidate => string.Equals(candidate.Name, partName, StringComparison.OrdinalIgnoreCase));
        if (part is null)
        {
            return;
        }

        await SendAsync(
            () => Http.PutAsJsonAsync($"api/grove/content-types/{Uri.EscapeDataString(SelectedType.Name)}/parts", new
            {
                Part = partName,
                DisplayName = AttachmentDraft(partName, "DisplayName", PartSetting(part, "DisplayName")),
                Description = AttachmentDraft(partName, "Description", PartSetting(part, "Description")),
                Position = AttachmentDraft(partName, "Position", PartSetting(part, "Position")),
            }),
            T["Part settings saved."]);
    }

    private async Task AttachPartAsync()
    {
        if (SelectedType is null || string.IsNullOrWhiteSpace(PartToAttach))
        {
            return;
        }

        var partName = PartToAttach;
        await SendAsync(
            () => Http.PutAsJsonAsync($"api/grove/content-types/{Uri.EscapeDataString(SelectedType.Name)}/parts", new { Part = partName }),
            T["Part attached."]);
        PartToAttach = string.Empty;
    }

    private async Task DetachPartAsync(string partName)
    {
        if (SelectedType is null)
        {
            return;
        }

        await SendAsync(
            () => Http.DeleteAsync($"api/grove/content-types/{Uri.EscapeDataString(SelectedType.Name)}/parts/{Uri.EscapeDataString(partName)}"),
            T["Part detached."]);
    }

    private async Task SendAsync(Func<Task<HttpResponseMessage>> send, string successMessage)
    {
        ErrorMessage = null;
        try
        {
            using var response = await send();
            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            Notifications.Notify(NotificationSeverity.Success, T["Content Types"], successMessage);
            AttachmentDrafts.Clear();
            await LoadAsync();
        }
        catch (Exception exception)
        {
            ErrorMessage = exception.Message;
        }
    }
}

@page "/Email/Test"
@attribute [PageEntry("ManageEmailSettings", Id = "emailtest", Parent = "communications", Caption = "Email Test", Position = "3")]
@using System.Net.Http.Json
@using Grove.Display.Components.Primitives
@inject HttpClient Http
@inject Grove.Display.Components.Theme.GroveApiLocalizer T

@* Tools › Testing › Email Test (Grove.Communications.Email): sends a test message through an
   enabled provider, the default one when none is chosen. The channel's settings (the default
   provider and each provider's section) are the "email" settings group at /Settings/email. *@
<PageTitle>@T["Email Test"]</PageTitle>

<GroveStack Gap="1rem" data-testid="email-test-page">
    <GroveStack Gap="0.25rem">
        <GroveText TextStyle="TextStyle.H4" class="rz-m-0">@T["Email Test"]</GroveText>
        <GroveText TextStyle="TextStyle.Body2">@T["Send a test message to check the email settings."]</GroveText>
    </GroveStack>
    @if (Error is { } error) { <GroveAlert AlertStyle="AlertStyle.Danger" AllowClose="false">@error</GroveAlert> }

    <GroveCard data-testid="email-test">
        <GroveStack Gap="0.5rem">
            @if (Providers is { Providers.Length: 0 })
            {
                <GroveAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">@T["No email provider is enabled. Enable one in the email settings."]</GroveAlert>
            }
            <GroveDropDown TValue="string" @bind-Value="Test.Provider" Data="@(Providers?.Providers ?? [])" TextProperty="DisplayName" ValueProperty="Name" AllowClear="true" Placeholder="@T["The default provider"]" Style="max-width: 24rem" Name="test-provider" />
            <GroveLabel Text="@T["To"]" Component="test-to" />
            <GroveTextBox @bind-Value="Test.To" Name="test-to" Style="max-width: 24rem" />
            <GroveLabel Text="@T["From (optional)"]" Component="test-from" />
            <GroveTextBox @bind-Value="Test.From" Name="test-from" Style="max-width: 24rem" />
            <GroveLabel Text="@T["Cc, Bcc, Reply to (optional)"]" Component="test-cc" />
            <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <GroveTextBox @bind-Value="Test.Cc" Name="test-cc" Placeholder="Cc" />
                <GroveTextBox @bind-Value="Test.Bcc" Placeholder="Bcc" />
                <GroveTextBox @bind-Value="Test.ReplyTo" Placeholder="@T["Reply to"]" />
            </GroveStack>
            <GroveLabel Text="@T["Subject"]" Component="test-subject" />
            <GroveTextBox @bind-Value="Test.Subject" Name="test-subject" Style="width: 100%" />
            <GroveLabel Text="@T["Body"]" Component="test-body" />
            <GroveTextArea @bind-Value="Test.Body" Name="test-body" Rows="4" Style="width: 100%" />
            <div><GroveButton Text="@T["Send"]" Icon="send" Click="SendTestAsync" Disabled="IsSending" data-testid="email-test-send" /></div>
            @if (TestResult is { } result)
            {
                <GroveAlert AlertStyle="@(result.Succeeded ? AlertStyle.Success : AlertStyle.Danger)" AllowClose="false">
                    @(result.Succeeded ? T["Message sent."] : string.Join(" ", result.Errors))
                </GroveAlert>
            }
        </GroveStack>
    </GroveCard>
</GroveStack>

@code {
    private const string Api = "api/grove/email";

    private ProvidersModel? Providers;
    private TestModel Test = new();
    private TestResultModel? TestResult;
    private string? Error;
    private bool IsSending;

    protected override async Task OnInitializedAsync()
    {
        try { Providers = await Http.GetFromJsonAsync<ProvidersModel>($"{Api}/providers"); }
        catch (Exception exception) { Error = exception.Message; }
    }

    private async Task SendTestAsync()
    {
        IsSending = true;
        try
        {
            var response = await Http.PostAsJsonAsync($"{Api}/test", Test);
            TestResult = response.IsSuccessStatusCode
                ? await response.Content.ReadFromJsonAsync<TestResultModel>()
                : new TestResultModel(false, [await response.Content.ReadAsStringAsync()]);
        }
        finally { IsSending = false; }
    }

    private sealed record EmailProvider(string Name, string DisplayName);
    private sealed record ProvidersModel(string? DefaultProvider, EmailProvider[] Providers);
    private sealed record TestResultModel(bool Succeeded, string[] Errors);

    private sealed class TestModel
    {
        public string? Provider { get; set; }
        public string? To { get; set; }
        public string? From { get; set; }
        public string? Cc { get; set; }
        public string? Bcc { get; set; }
        public string? ReplyTo { get; set; }
        public string? Subject { get; set; } = "Test message";
        public string? Body { get; set; } = "This is a test message.";
    }
}

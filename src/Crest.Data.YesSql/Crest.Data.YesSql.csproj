<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Crest.Data</RootNamespace>
    <!-- NuGet properties-->
    <Title>Crest Data YesSql</Title>
    <Description>
      $(OCCMSDescription)

      Provides data access functionality using YesSql
    </Description>
    <PackageTags>$(PackageTags) PlatformCMS Data</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Crest.Data\Crest.Data.csproj" />
    <ProjectReference Include="..\Crest.Data.YesSql.Abstractions\Crest.Data.YesSql.Abstractions.csproj" />
    <ProjectReference Include="..\Crest.Abstractions\Crest.Abstractions.csproj" />
    <ProjectReference Include="..\Crest.Access.Abstractions\Crest.Access.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YesSql" />
  </ItemGroup>

</Project>

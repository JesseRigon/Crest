<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- NuGet properties-->
    <Title>Grove Sms</Title>
    <Description>
      $(OCCMSDescription)

      The Azure Communication SMS feature enables sending SMS messages via Azure Communication Services (ACS).
    </Description>
    <PackageTags>$(PackageTags) PlatformCMS</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Communication.Sms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grove.Display.Management\Grove.Display.Management.csproj" />
    <ProjectReference Include="..\Grove.Module.Targets\Grove.Module.Targets.csproj" />
    <ProjectReference Include="..\Grove.Display.Resources.Management\Grove.Display.Resources.Management.csproj" />
    <ProjectReference Include="..\Grove.Communications.Sms\Grove.Communications.Sms.csproj" />
  </ItemGroup>
</Project>

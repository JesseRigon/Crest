<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <RootNamespace>Crest.Sharing</RootNamespace>
    <Nullable>enable</Nullable>
    <!-- NuGet properties-->
    <Title>Crest Sharing</Title>
    <Description>$(OCCMSDescription)

    Sharing for any module's items: grants and blocks that flow down a tree, ordered rules, and their resolution, registered with the access gate.</Description>
    <PackageTags>$(PackageTags) PlatformCMS Sharing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="YesSql.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Crest.Sharing.Abstractions\Crest.Sharing.Abstractions.csproj" />
    <ProjectReference Include="..\Crest.Access.Abstractions\Crest.Access.Abstractions.csproj" />
    <ProjectReference Include="..\Crest.Module.Targets\Crest.Module.Targets.csproj" />
    <ProjectReference Include="..\Crest.Infrastructure.Abstractions\Crest.Infrastructure.Abstractions.csproj" />
    <ProjectReference Include="..\Crest.Data.YesSql.Abstractions\Crest.Data.YesSql.Abstractions.csproj" />
    <ProjectReference Include="..\Crest.Recipes.Abstractions\Crest.Recipes.Abstractions.csproj" />
    <ProjectReference Include="..\Crest.Roles.Abstractions\Crest.Roles.Abstractions.csproj" />
    <ProjectReference Include="..\Crest.Users.Abstractions\Crest.Users.Abstractions.csproj" />
    <ProjectReference Include="..\Crest.Admin.Abstractions\Crest.Admin.Abstractions.csproj" />
    <ProjectReference Include="..\Crest.Navigation\Crest.Navigation.csproj" />
  </ItemGroup>

</Project>

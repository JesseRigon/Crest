<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- Grove.Search's site-shell library: the site search page (SearchBox and the results) over
       the search API. Declares [assembly: GroveShell(GroveShells.Site)] in GroveShell.cs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Grove.Search.BlazorWasm</AssemblyName>
    <RootNamespace>Grove.Search.Client</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Grove.Display.Components\Grove.Display.Components.csproj" />
  </ItemGroup>

  <!-- The API's wire types are shared with the server module without referencing it. -->
  <ItemGroup>
    <Compile Include="..\Api\SearchApiModels.cs" Link="SearchApiModels.cs" />
  </ItemGroup>
</Project>

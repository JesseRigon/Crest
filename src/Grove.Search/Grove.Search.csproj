<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- NuGet properties-->
    <Title>Grove Search</Title>
    <Description>$(OCCMSDescription)

    Creates a frontend search that can be used with multiple search providers.</Description>
    <PackageTags>$(PackageTags) PlatformCMS</PackageTags>
  </PropertyGroup>

  <!-- The site search page is its own WASM library (site-wasm/, Grove.Search.BlazorWasm). -->
  <ItemGroup>
    <Compile Remove="site-wasm/**/*.cs" />
    <Content Remove="site-wasm/**" />
    <None Remove="site-wasm/**" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grove.Contents.Management\Grove.Contents.Management.csproj" />
    <ProjectReference Include="..\Grove.Contents.Types.Abstractions\Grove.Contents.Types.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Display.Management\Grove.Display.Management.csproj" />
    <ProjectReference Include="..\Grove.Data.Indexing.Abstractions\Grove.Data.Indexing.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Data.Indexing\Grove.Data.Indexing.csproj" />
    <ProjectReference Include="..\Grove.Module.Targets\Grove.Module.Targets.csproj" />
    <ProjectReference Include="..\Grove.Display.Navigation\Grove.Display.Navigation.csproj" />
    <ProjectReference Include="..\Grove.Search.Abstractions\Grove.Search.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Infrastructure.Server.Abstractions\Grove.Infrastructure.Server.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Deployment.Abstractions\Grove.Deployment.Abstractions.csproj" />
  </ItemGroup>

</Project>

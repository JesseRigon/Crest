<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <!-- NuGet properties-->
    <Title>Grove Azure AI Search</Title>
    <Description>
      $(OCCMSDescription)

      Creates Azure AI Search indexes to support search scenarios, introduces a preconfigured container-enabled content type.
    </Description>
    <PackageTags>$(PackageTags) PlatformCMS</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grove.Admin.Abstractions\Grove.Admin.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.DisplayManagement\Grove.DisplayManagement.csproj" />
    <ProjectReference Include="..\Grove.Flows\Grove.Flows.csproj" />
    <ProjectReference Include="..\Grove.Navigation\Grove.Navigation.csproj" />
    <ProjectReference Include="..\Grove.Module.Targets\Grove.Module.Targets.csproj" />
    <ProjectReference Include="..\Grove.Roles.Abstractions\Grove.Roles.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Indexing\Grove.Indexing.csproj" />
    <ProjectReference Include="..\Grove.Abstractions\Grove.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.ContentLocalization.Abstractions\Grove.ContentLocalization.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.ContentManagement.Abstractions\Grove.ContentManagement.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.ContentPreview.Abstractions\Grove.ContentPreview.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Contents.Abstractions\Grove.Contents.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.ContentManagement\Grove.ContentManagement.csproj" />
    <ProjectReference Include="..\Grove.Deployment.Abstractions\Grove.Deployment.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Infrastructure.Abstractions\Grove.Infrastructure.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Search.Abstractions\Grove.Search.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.AzureAI.Abstractions\Grove.AzureAI.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Search.Documents" />
    <PackageReference Include="Microsoft.Extensions.Azure" />
  </ItemGroup>

</Project>

@model Crest.ContentFields.ViewModels.DisplayContentPickerFieldViewModel
@using Crest.ContentFields
@using Crest.ContentManagement
@using Crest.Mvc.Utilities
@using Crest.ContentManagement.Metadata.Models
@using Crest.Localization.Data

@inject Crest.ContentManagement.IContentManager ContentManager
@inject IDataLocalizer D

@{
    var name = (Model.PartFieldDefinition.PartDefinition.Name + "-" + Model.PartFieldDefinition.Name).HtmlClassify();
    var contentItems = await ContentManager.GetAsync(Model.ContentItemIds);
    string localizedFieldName = D[Model.PartFieldDefinition.DisplayName(), DataLocalizationContext.ContentField(Model.PartFieldDefinition.PartDefinition.Name)];
}

<div class="field field-type-contentpickerfield field-name-@name">
    <span class="name">@localizedFieldName</span>
    @if (contentItems.Any())
    {
        foreach (var contentItem in contentItems)
        {
            <span class="value"><a display-for="@contentItem">@contentItem.DisplayText</a></span>
            if (contentItem != contentItems.Last())
            {
                <span>,</span>
            }
        }
    }
    else
    {
        <span class="value">@T["No content items."]</span>
    }
</div>

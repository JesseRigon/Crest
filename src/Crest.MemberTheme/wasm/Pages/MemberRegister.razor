@attribute [Route(MemberRoutePaths.Register)]
@attribute [AllowAnonymous]
@namespace Crest.MemberTheme.Pages
@inject NavigationManager Navigation

@* Member self-registration. An auth-cookie page like the login: registration signs the
   new account in, so App.razor renders it InteractiveWebAssembly for the same reason. *@

<PageTitle>Create an account</PageTitle>

<div class="crest-member-centred" data-testid="member-register">
    <CrestStack Gap="1rem" Style="width: 22rem; max-width: 100%;">
        <CrestText TextStyle="TextStyle.H5" Text="Create an account" />

        <CrestTextBox @bind-Value="_userName"
                      Placeholder="User name"
                      Disabled="@_busy"
                      data-testid="member-register-username" />

        <CrestTextBox @bind-Value="_email"
                      Placeholder="Email"
                      Disabled="@_busy"
                      data-testid="member-register-email" />

        <CrestPassword @bind-Value="_password"
                       Placeholder="Password"
                       Disabled="@_busy"
                       data-testid="member-register-password" />

        <CrestButton Text="Create account"
                     Click="@RegisterAsync"
                     Disabled="@(_busy || !RendererInfo.IsInteractive)"
                     data-testid="member-register-submit" />

        @if (_error is { Length: > 0 })
        {
            <CrestText TextStyle="TextStyle.Caption" Text="@_error" data-testid="member-register-error" />
        }

        <CrestLink Path="@MemberRoutePaths.Login" Text="Already have an account? Sign in" />
    </CrestStack>
</div>

@code {
    // Supplied by MemberRoutes, which activates the implementation a member module provides
    // (its library is lazy, so it cannot be registered in the sealed WASM container).
    [CascadingParameter]
    private IMemberAuthenticationService Auth { get; set; } = default!;

    private string _userName = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private bool _busy;
    private string? _error;

    // Which organization a self-registered account joins is the module's decision (a
    // default group, an invitation, a single-tenant household): the surface passes null
    // and lets the implementation decide, rather than inventing a policy here.
    private async Task RegisterAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Auth.RegisterAsync(_userName, _email, _password, organizationId: null);
            if (!result.Succeeded)
            {
                _error = result.Error ?? "Could not create the account.";
                return;
            }

            Navigation.NavigateTo(Navigation.BaseUri, forceLoad: true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}

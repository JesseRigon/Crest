@using Grove.DisplayManagement.Views
@using Grove.Indexing.Models

@model ShapeViewModel<Grove.Indexing.Models.IndexProfile>

<a asp-controller="Admin"
   asp-action="QueryIndex"
   asp-route-indexName="@Model.Value.Name"
   asp-area="Grove.Elasticsearch"
   class="dropdown-item btn-sm">@T["Query Index"]</a>

<a asp-controller="Admin"
   asp-action="IndexInfo"
   asp-route-id="@Model.Value.Id"
   asp-controller="Admin"
   asp-area="Grove.Elasticsearch"
   class="dropdown-item btn-sm">@T["Index Info"]</a>

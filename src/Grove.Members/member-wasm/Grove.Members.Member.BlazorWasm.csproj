<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- The Members module's member-shell library: everything this module contributes to the
       member shell, and nothing it contributes to the admin one. One library per shell,
       because a shell's router routes every page in the assemblies it is handed - see
       GroveShellAttribute. Declares [assembly: GroveShell(GroveShells.Member)] in
       GroveShell.cs.

       The shell's seams: IMemberShellContext (who this member is, which organizations they are
       bound to, which one is active) and IMemberAuthenticationService (what signing in means).
       Grove owns the shell and the interfaces; this module owns what a member IS and supplies
       them. Lazily loaded: the member shell loads its modules before it renders and activates
       these against the container. And the member's access pages: sign-in, registration,
       password recovery, external sign-in and the account page (members are an Access concern),
       the account part from the Users module's shared components. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Grove.Members.Member.BlazorWasm</AssemblyName>
    <RootNamespace>Grove.Members.Member</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\Grove.Members.Domain.csproj" />
    <ProjectReference Include="..\..\Grove.Components\Grove.Components.csproj" />
    <ProjectReference Include="..\..\Grove.MemberTheme\wasm\Grove.MemberTheme.Client.csproj" />
    <ProjectReference Include="..\..\Grove.Users\components\Grove.Users.Components.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Grove.Members.Tests" />
  </ItemGroup>
</Project>

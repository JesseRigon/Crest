@namespace Grove.Parties.BlazorWasm.Components
@using Grove.Display.Components.Regions
@using Grove.Parties.PartyTypes
@using Grove.Parties.Constants
@using Grove.Parties.ViewModels
@inject HttpClient Http
@inject Grove.Display.Components.Theme.GroveApiLocalizer T

@* The list/detail/editor pane for one party type - the shape Customers.razor established,
   generalised over the descriptor. A tenant kind lists its content type through the generic
   content-items API and edits inline; a global kind renders nothing of its own and lets
   the owning module's page-region contributor fill the pane. Either way the pane is the
   same on All Parties and on the type's dedicated page. *@

@if (Type.Kind == PartyTypeKinds.Global)
{
    <GrovePageRegion Key="@PartiesPageRegions.Pane(Type.Key)" Context="@Type" />
    return;
}

<GroveStack Gap="1rem" class="party-type-pane" data-party-type="@Type.Key">
    <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
        <div>
            <GroveText TextStyle="TextStyle.H4" class="rz-m-0">@T[Type.DisplayName]</GroveText>
            <GroveText TextStyle="TextStyle.Body2" class="rz-color-secondary">@T["Manage {0}.", T[Type.DisplayName].ToLowerInvariant()]</GroveText>
        </div>
        <GroveButton Icon="refresh" Text="@T["Refresh"]" ButtonStyle="ButtonStyle.Light" Click="LoadAsync" Disabled="IsLoading" />
    </GroveStack>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <GroveAlert AlertStyle="AlertStyle.Danger" Summary="@T["Action failed"]" Detail="@Error" />
    }

    <GroveStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Stretch" class="party-type-pane__layout">
        <GroveModelList TItem="GroveModel"
                        Title="@T[Type.DisplayName]"
                        Items="@Items"
                        SelectedKey="@SelectedId"
                        KeySelector="@(item => item.ContentItem?.ContentItemId)"
                        TextSelector="@(item => item.ContentItem?.DisplayText)"
                        DescriptionSelector="@Describe"
                        SearchPredicate="MatchesSearch"
                        Select="Select"
                        Create="CreateAsync"
                        CreateText="@T["Create"]"
                        EmptyText="@T["Nothing here yet. Create one to start."]"
                        IsBusy="IsLoading || IsSaving"
                        Actions="ItemActions" />

        <GroveCard class="party-type-pane__detail" Style="flex: 1;">
            @if (IsLoading)
            {
                <GroveProgressBar Mode="ProgressBarMode.Indeterminate" />
            }
            else if (Selected is null)
            {
                <GroveText TextStyle="TextStyle.Body1">@T["Select or create one."]</GroveText>
            }
            else
            {
                <GroveStack Gap="1rem">
                    <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
                        <div>
                            <GroveText TextStyle="TextStyle.H5" class="rz-m-0">@Selected.ContentItem?.DisplayText</GroveText>
                            <GroveText TextStyle="TextStyle.Body2" class="rz-color-secondary">@Selected.ContentItem?.ContentItemId</GroveText>
                        </div>
                        <GroveStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                            <GroveButton Icon="edit" Text="@T["Edit"]" ButtonStyle="ButtonStyle.Light" Click="@(() => Edit(Selected))" />
                            <GroveButton Icon="content_copy" Text="@T["Duplicate"]" ButtonStyle="ButtonStyle.Light" Click="@(() => DuplicateAsync(Selected))" Disabled="IsSaving" />
                            <GroveButton Icon="delete" Text="@T["Delete"]" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="@(() => DeleteAsync(Selected))" Disabled="IsSaving" />
                        </GroveStack>
                    </GroveStack>

                    <GroveStack Gap="0.5rem">
                        @foreach (var field in SummaryFields(Selected))
                        {
                            <GroveText><strong>@field.Label:</strong> @field.Value</GroveText>
                        }
                        @if (PartyReference is not null)
                        {
                            <GroveText><strong>@T["Party"]:</strong> @PartyReference</GroveText>
                        }
                    </GroveStack>

                    @if (ContentType is PartiesConstants.ContentTypes.Person or PartiesConstants.ContentTypes.Organization && SelectedId is not null)
                    {
                        <PartyRecordActions PartyId="@SelectedId" ContentType="@ContentType" Content="@(Selected.ContentItem?.Content as JsonObject)" Changed="LoadAsync" />
                    }

                    <GrovePageRegion Key="@PartiesPageRegions.Detail(Type.Key)" Context="@SelectedId" />

                    @if (IsEditing)
                    {
                        <GroveContentItemEditor ContentItemId="@SelectedId"
                                                Title="@T["Edit"]"
                                                Saved="OnEditorSavedAsync"
                                                Duplicated="OnEditorDuplicatedAsync"
                                                Deleted="OnEditorDeletedAsync"
                                                Closed="CloseEditor" />
                    }
                </GroveStack>
            }
        </GroveCard>
    </GroveStack>
</GroveStack>

@code {
    [Parameter, EditorRequired]
    public PartyTypeModel Type { get; set; } = default!;

    private string ContentType => Type.ContentType ?? Type.Key;
    private GroveModel[] Items { get; set; } = [];
    private string? SelectedId { get; set; }
    private GroveModel? Selected => Items.FirstOrDefault(item => item.ContentItem?.ContentItemId == SelectedId);
    private string? PartyReference { get; set; }
    private bool IsLoading { get; set; }
    private bool IsSaving { get; set; }
    private bool IsEditing { get; set; }
    private string? Error { get; set; }
    private string? _loadedType;

    private IReadOnlyList<GroveModelListAction<GroveModel>> ItemActions =>
    [
        new() { Icon = "edit", Title = T["Edit"], Callback = EventCallback.Factory.Create<GroveModel>(this, Edit) },
        new() { Icon = "content_copy", Title = T["Duplicate"], Callback = EventCallback.Factory.Create<GroveModel>(this, DuplicateAsync) },
        new() { Icon = "delete", Title = T["Delete"], ButtonStyle = ButtonStyle.Danger, Callback = EventCallback.Factory.Create<GroveModel>(this, DeleteAsync) },
    ];

    protected override async Task OnParametersSetAsync()
    {
        if (Type.Kind == PartyTypeKinds.Global || string.Equals(_loadedType, Type.Key, StringComparison.Ordinal))
        {
            return;
        }

        _loadedType = Type.Key;
        SelectedId = null;
        IsEditing = false;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        Error = null;
        try
        {
            var state = await Http.GetFromJsonAsync<GroveContentItemPage>($"api/grove/content-items?contentType={Uri.EscapeDataString(ContentType)}&pageSize=100");
            Items = state?.Items.Select(GroveModel.FromContentItem).OfType<GroveModel>().ToArray() ?? [];
            SelectedId = Items.Any(item => item.ContentItem?.ContentItemId == SelectedId)
                ? SelectedId
                : Items.FirstOrDefault()?.ContentItem?.ContentItemId;
            await ResolvePartyReferenceAsync();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task Select(GroveModel item)
    {
        SelectedId = item.ContentItem?.ContentItemId;
        await ResolvePartyReferenceAsync();
    }

    // A role's Party picker holds an id; the person or organization behind it is what a
    // reader wants to see. The base parties have no Party field and skip this.
    private async Task ResolvePartyReferenceAsync()
    {
        PartyReference = null;
        var ids = Selected?.GetPickerIds(ContentType, "Party");
        var partyId = ids?.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).FirstOrDefault();
        if (string.IsNullOrWhiteSpace(partyId))
        {
            return;
        }

        try
        {
            var view = await Http.GetFromJsonAsync<Dictionary<string, JsonNode?>>($"api/grove/content-items/{Uri.EscapeDataString(partyId)}/view");
            var text = view is not null && view.TryGetValue("DisplayText", out var node) ? node?.ToString() : null;
            var type = view is not null && view.TryGetValue("ContentType", out var typeNode) ? typeNode?.ToString() : null;
            var content = view is not null && view.TryGetValue("Content", out var contentNode) ? contentNode as JsonObject : null;
            // An Individual organization reads as its person (ruling 2026-10-14).
            PartyReference = string.IsNullOrWhiteSpace(text) ? partyId : $"{text} ({T[PartyDisplay.KindLabel(type, content)]}, {partyId})";
        }
        catch
        {
            PartyReference = partyId;
        }
    }

    // The role part is named after its type (PartyRoleDefinitions); the base parties' own
    // part likewise. Scalars come out as "label: value" without the pane knowing the type.
    private IEnumerable<(string Label, string Value)> SummaryFields(GroveModel item)
    {
        if (item.ContentItem?.Content?[ContentType] is not JsonObject part)
        {
            yield break;
        }

        foreach (var (name, node) in part)
        {
            if (name == "Party" || node is not JsonObject field)
            {
                continue;
            }

            var value = field["Text"]?.ToString() ?? field["Value"]?.ToString();
            if (value is null && field["SelectedIds"] is JsonArray ids)
            {
                value = string.Join(", ", ids.Select(id => id?.ToString()));
            }

            if (!string.IsNullOrWhiteSpace(value))
            {
                yield return (name, value);
            }
        }
    }

    private async Task CreateAsync()
    {
        var created = GroveModel.FromContentItem(
            await SendJsonAsync<GroveContentItem>(HttpMethod.Post, "api/grove/content-items", new CreateGroveContentItemRequest(ContentType, T["New {0}", T[Type.DisplayName].ToLowerInvariant()])));
        if (created is not null)
        {
            await LoadAsync();
            SelectedId = created.ContentItem?.ContentItemId;
            Edit(created);
        }
    }

    private async Task DuplicateAsync(GroveModel item)
    {
        var id = item.ContentItem?.ContentItemId;
        if (string.IsNullOrWhiteSpace(id))
        {
            return;
        }

        // The content-items API has no duplicate endpoint: duplicate = create a new draft
        // of the same type carrying a copy of the source item's content.
        var duplicate = GroveModel.FromContentItem(
            await SendJsonAsync<GroveContentItem>(HttpMethod.Post, "api/grove/content-items",
                new CreateGroveContentItemRequest(
                    item.ContentItem?.ContentType ?? ContentType,
                    $"{item.ContentItem?.DisplayText} (copy)",
                    item.ContentItem?.Content?.DeepClone() as JsonObject)));
        await LoadAsync();
        SelectedId = duplicate?.ContentItem?.ContentItemId ?? SelectedId;
    }

    private async Task DeleteAsync(GroveModel item)
    {
        var id = item.ContentItem?.ContentItemId;
        if (string.IsNullOrWhiteSpace(id))
        {
            return;
        }

        await SendAsync(HttpMethod.Delete, $"api/grove/content-items/{Uri.EscapeDataString(id)}", null);
        if (SelectedId == id)
        {
            SelectedId = null;
            IsEditing = false;
        }

        await LoadAsync();
    }

    private void Edit(GroveModel item)
    {
        SelectedId = item.ContentItem?.ContentItemId;
        IsEditing = !string.IsNullOrWhiteSpace(SelectedId);
    }

    private async Task OnEditorSavedAsync(GroveModel item)
    {
        await LoadAsync();
        SelectedId = item.ContentItem?.ContentItemId ?? SelectedId;
        IsEditing = true;
    }

    private async Task OnEditorDuplicatedAsync(GroveModel item)
    {
        await LoadAsync();
        SelectedId = item.ContentItem?.ContentItemId ?? SelectedId;
        IsEditing = true;
    }

    private async Task OnEditorDeletedAsync(string deletedContentItemId)
    {
        if (SelectedId == deletedContentItemId)
        {
            SelectedId = null;
        }

        IsEditing = false;
        await LoadAsync();
    }

    private void CloseEditor() => IsEditing = false;

    // An Individual organization is listed as its person: its name is the person's, and the
    // description says "Individual" rather than presenting a company.
    private string? Describe(GroveModel item) =>
        PartyDisplay.IsIndividual(item.ContentItem?.ContentType, item.ContentItem?.Content as JsonObject)
            ? $"{T["Individual"]} · {item.ContentItem?.ContentItemId}"
            : item.ContentItem?.ContentItemId;

    private bool MatchesSearch(GroveModel item, string search) =>
        item.ContentItem?.DisplayText?.Contains(search, StringComparison.OrdinalIgnoreCase) == true
        || item.ContentItem?.ContentItemId?.Contains(search, StringComparison.OrdinalIgnoreCase) == true
        || SummaryFields(item).Any(field => field.Value.Contains(search, StringComparison.OrdinalIgnoreCase));

    private async Task<TResult?> SendJsonAsync<TResult>(HttpMethod method, string url, object? body)
    {
        using var response = await SendAsync(method, url, body);
        return response.IsSuccessStatusCode ? await response.Content.ReadFromJsonAsync<TResult>() : default;
    }

    // Credentials and the antiforgery token are attached by the registered HttpClient's
    // handler (WASM: AntiforgeryHandler; SSR/InteractiveServer: ForwardedAuthHandler),
    // never per request here - that keeps the pane portable across all three render contexts.
    private async Task<HttpResponseMessage> SendAsync(HttpMethod method, string url, object? body)
    {
        IsSaving = true;
        Error = null;
        try
        {
            var request = new HttpRequestMessage(method, url);
            if (body is not null)
            {
                request.Content = JsonContent.Create(body);
            }

            var response = await Http.SendAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                Error = await response.Content.ReadAsStringAsync();
            }

            return response;
        }
        catch (Exception ex)
        {
            Error = ex.Message;
            throw;
        }
        finally
        {
            IsSaving = false;
        }
    }
}

<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <!-- NuGet properties-->
    <Title>Crest AuditTrail</Title>
    <Description>
      $(OCCMSDescription)

      Provides a log for recording and viewing back-end changes.
    </Description>
    <PackageTags>$(PackageTags) PlatformCMS</PackageTags>
  </PropertyGroup>

  <!-- The admin pages are their own WASM library (blazor-wasm/, Crest.AuditTrail.BlazorWasm). -->
  <ItemGroup>
    <Compile Remove="blazor-wasm/**/*.cs;tests/**/*.cs" />
    <Content Remove="blazor-wasm/**" />
    <None Remove="blazor-wasm/**" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Crest.Access.Abstractions\Crest.Access.Abstractions.csproj" />
    <ProjectReference Include="..\Crest.Admin.Abstractions\Crest.Admin.Abstractions.csproj" />
    <ProjectReference Include="..\Crest.AuditTrail.Abstractions\Crest.AuditTrail.Abstractions.csproj" />
    <ProjectReference Include="..\Crest.Data.YesSql.Abstractions\Crest.Data.YesSql.Abstractions.csproj" />
    <ProjectReference Include="..\Crest.Module.Targets\Crest.Module.Targets.csproj" />
    <ProjectReference Include="..\Crest.Navigation\Crest.Navigation.csproj" />
    <ProjectReference Include="..\Crest.ResourceManagement\Crest.ResourceManagement.csproj" />
    <ProjectReference Include="..\Crest.Roles.Abstractions\Crest.Roles.Abstractions.csproj" />
    <ProjectReference Include="..\Crest.Settings\Crest.Settings.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YesSql.Core" />
    <PackageReference Include="YesSql.Filters.Query" />
  </ItemGroup>

</Project>

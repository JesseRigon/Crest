@inject HttpClient Http
@inject Crest.Components.Theme.CrestApiLocalizer T

@* The trail as a table: one row per event, newest first, impersonated actions marked; a row
   opens the event's details (both attributions, the subject and the recorded data). Shared by
   the audit page, a record's history and an impersonation session. *@

<CrestStack Gap="0.75rem" data-testid="audit-event-table">
    <CrestTable GridLines="DataGridGridLines.Horizontal" AllowAlternatingRows="false">
        <CrestTableHeader>
            <CrestTableHeaderRow>
                <CrestTableHeaderCell>@T["When"]</CrestTableHeaderCell>
                <CrestTableHeaderCell>@T["Event"]</CrestTableHeaderCell>
                <CrestTableHeaderCell>@T["Acted by"]</CrestTableHeaderCell>
                <CrestTableHeaderCell>@T["Organization"]</CrestTableHeaderCell>
                <CrestTableHeaderCell>@T["Side"]</CrestTableHeaderCell>
                <CrestTableHeaderCell></CrestTableHeaderCell>
            </CrestTableHeaderRow>
        </CrestTableHeader>
        <CrestTableBody>
            @foreach (var item in Page.Items)
            {
                <CrestTableRow data-testid="audit-event" data-event-id="@item.EventId">
                    <CrestTableCell>@item.CreatedUtc.ToLocalTime().ToString("g")</CrestTableCell>
                    <CrestTableCell>
                        <div>@item.Summary</div>
                        @if (!string.IsNullOrEmpty(item.RecordId) && ShowRecordLinks)
                        {
                            <CrestLink Path="@RecordPath(item.RecordId)" Text="@T["History"]" />
                        }
                    </CrestTableCell>
                    <CrestTableCell>
                        @item.Actor
                        @if (item.IsImpersonated)
                        {
                            <CrestBadge BadgeStyle="BadgeStyle.Warning" Text="@T["impersonating"]" class="rz-ml-1" data-testid="audit-impersonated" />
                        }
                    </CrestTableCell>
                    <CrestTableCell>@item.OrganizationId</CrestTableCell>
                    <CrestTableCell>@item.Side</CrestTableCell>
                    <CrestTableCell>
                        <CrestButton Icon="info" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => OpenAsync(item))" />
                    </CrestTableCell>
                </CrestTableRow>
            }
        </CrestTableBody>
    </CrestTable>

    @if (Page.Items.Count == 0)
    {
        <CrestText TextStyle="TextStyle.Body2">@T["No events."]</CrestText>
    }

    <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <CrestButton Icon="chevron_left" ButtonStyle="ButtonStyle.Light" Disabled="@(Page.Skip == 0)" Click="@(() => PageChanged.InvokeAsync(Math.Max(0, Page.Skip - Page.Take)))" />
        <CrestText TextStyle="TextStyle.Caption">@T["{0}-{1} of {2}", Page.Total == 0 ? 0 : Page.Skip + 1, Page.Skip + Page.Items.Count, Page.Total]</CrestText>
        <CrestButton Icon="chevron_right" ButtonStyle="ButtonStyle.Light" Disabled="@(Page.Skip + Page.Items.Count >= Page.Total)" Click="@(() => PageChanged.InvokeAsync(Page.Skip + Page.Take))" />
    </CrestStack>

    @if (Selected is not null)
    {
        <CrestCard data-testid="audit-event-detail">
            <CrestStack Gap="0.5rem">
                <CrestStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                    <CrestText TextStyle="TextStyle.H6" class="rz-m-0">@Selected.Summary</CrestText>
                    <CrestButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => Selected = null)" />
                </CrestStack>
                <dl class="audit-detail">
                    <dt>@T["Acted by (audit)"]</dt><dd>@(Selected.UserName ?? Selected.UserId) (@Selected.ActorKind@(Selected.ClientId is null ? "" : $", {Selected.ClientId}"))</dd>
                    <dt>@T["On behalf of (functional)"]</dt><dd>@(Selected.FunctionalUserName ?? Selected.FunctionalUserId)</dd>
                    @if (Selected.IsImpersonated)
                    {
                        <dt>@T["Impersonating"]</dt><dd>@(Selected.ImpersonatedUserName ?? Selected.ImpersonatedUserId)</dd>
                        <dt>@T["Session"]</dt><dd>@Selected.SessionId</dd>
                    }
                    <dt>@T["Organization"]</dt><dd>@Selected.OrganizationId</dd>
                    <dt>@T["Record"]</dt><dd>@Selected.RecordType @Selected.RecordId</dd>
                    <dt>@T["Owner"]</dt><dd>@Selected.OwnerId</dd>
                    <dt>@T["Correlation"]</dt><dd>@Selected.CorrelationId</dd>
                    <dt>@T["Client IP"]</dt><dd>@Selected.ClientIpAddress</dd>
                </dl>
                @if (Selected.Category == "Content")
                {
                    @* The version this event recorded, as the site would display it, and its
                       restore (rework step 7: replaces the MVC AuditTrail/Content screen). *@
                    <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                        <CrestButton Icon="visibility" Text="@T["Show this version"]" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="ShowVersionAsync" Disabled="@VersionBusy" />
                        <CrestButton Icon="restore" Text="@T["Restore this version"]" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small" Click="RestoreAsync" Disabled="@VersionBusy" />
                    </CrestStack>
                    @if (!string.IsNullOrEmpty(VersionMessage))
                    {
                        <CrestAlert AlertStyle="@(VersionFailed ? AlertStyle.Danger : AlertStyle.Success)" Detail="@VersionMessage" />
                    }
                    @if (Version is not null)
                    {
                        <div class="audit-version" data-testid="audit-content-version">
                            <CrestText TextStyle="TextStyle.Subtitle2">@T["Version {0}", Version.VersionNumber]</CrestText>
                            <Crest.DisplayManagement.Components.DisplayTreeRenderer Node="Version.Tree.Root" />
                        </div>
                    }
                }
                @if (Selected.Data is not null)
                {
                    <pre class="audit-data" style="max-height: 24rem; overflow: auto; white-space: pre-wrap;">@Selected.Data.ToJsonString(new System.Text.Json.JsonSerializerOptions { WriteIndented = true })</pre>
                }
            </CrestStack>
        </CrestCard>
    }
</CrestStack>

@code {
    [Parameter, EditorRequired] public AuditEventPage Page { get; set; } = new([], 0, 0, 50);

    [Parameter] public EventCallback<int> PageChanged { get; set; }

    [Parameter] public bool ShowRecordLinks { get; set; } = true;

    private AuditEvent? Selected { get; set; }

    private static string RecordPath(string recordId) =>
        AuditTrailRoutes.RecordAdmin.TrimStart('/').Replace("{RecordId}", Uri.EscapeDataString(recordId));

    private AuditContentVersion? Version { get; set; }
    private bool VersionBusy { get; set; }
    private string? VersionMessage { get; set; }
    private bool VersionFailed { get; set; }

    private string VersionApi => $"api/crest/audit/content/{Uri.EscapeDataString(Selected!.EventId)}";

    private async Task ShowVersionAsync()
    {
        VersionBusy = true;
        VersionMessage = null;
        try
        {
            Version = await Http.GetFromJsonAsync<AuditContentVersion>(VersionApi);
        }
        catch (HttpRequestException exception)
        {
            (VersionFailed, VersionMessage) = (true, exception.Message);
        }
        finally
        {
            VersionBusy = false;
        }
    }

    private async Task RestoreAsync()
    {
        VersionBusy = true;
        try
        {
            using var response = await Http.PostAsync(VersionApi + "/restore", null);
            var result = await response.Content.ReadFromJsonAsync<AuditContentRestoreResult>();
            (VersionFailed, VersionMessage) = response.IsSuccessStatusCode
                ? (false, T["The version has been restored."].ToString())
                : (true, T["The version was not restored: {0}", string.Join(", ", result?.Errors ?? [])].ToString());
        }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException)
        {
            (VersionFailed, VersionMessage) = (true, exception.Message);
        }
        finally
        {
            VersionBusy = false;
        }
    }

    private async Task OpenAsync(AuditEvent item)
    {
        Version = null;
        VersionMessage = null;
        Selected = await Http.GetFromJsonAsync<AuditEvent>($"{AuditTrailRoutes.Api}/events/{Uri.EscapeDataString(item.EventId)}") ?? item;
    }
}

@page "/Audit/Sessions"
@attribute [PageEntry("ViewAuditTrail", Id = "audittrail-sessions", Parent = "audittrail", Caption = "Impersonation sessions", Position = "10")]
@inject HttpClient Http
@inject Crest.Components.Theme.CrestApiLocalizer T

@* Impersonation sessions (docs/audit.md › step 4): each session as one unit - the staff user,
   the member, the organization, when it started and stopped - with its events grouped under it
   through the session id. *@

<PageTitle>@T["Impersonation sessions"]</PageTitle>

<CrestStack Gap="1rem" data-testid="audit-sessions">
    <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
        <div>
            <CrestText TextStyle="TextStyle.H4" class="rz-m-0">@T["Impersonation sessions"]</CrestText>
            <CrestText TextStyle="TextStyle.Body2" class="rz-color-secondary">@T["Staff support access to member portals, and everything done inside it."]</CrestText>
        </div>
        <CrestStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <CrestLink Path="@AuditTrailRoutes.TrailAdmin.TrimStart('/')" Text="@T["Audit trail"]" />
            <CrestButton Icon="refresh" Text="@T["Refresh"]" ButtonStyle="ButtonStyle.Light" Click="@(() => LoadAsync(0))" Disabled="IsBusy" />
        </CrestStack>
    </CrestStack>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <CrestAlert AlertStyle="AlertStyle.Danger" Summary="@T["Could not load the sessions"]" Detail="@Error" />
    }

    <CrestTable GridLines="DataGridGridLines.Horizontal" AllowAlternatingRows="false">
        <CrestTableHeader>
            <CrestTableHeaderRow>
                <CrestTableHeaderCell>@T["Started"]</CrestTableHeaderCell>
                <CrestTableHeaderCell>@T["Stopped"]</CrestTableHeaderCell>
                <CrestTableHeaderCell>@T["Staff user"]</CrestTableHeaderCell>
                <CrestTableHeaderCell>@T["Member"]</CrestTableHeaderCell>
                <CrestTableHeaderCell>@T["Organization"]</CrestTableHeaderCell>
                <CrestTableHeaderCell>@T["Events"]</CrestTableHeaderCell>
                <CrestTableHeaderCell></CrestTableHeaderCell>
            </CrestTableHeaderRow>
        </CrestTableHeader>
        <CrestTableBody>
            @foreach (var session in Sessions.Items)
            {
                <CrestTableRow data-testid="audit-session" data-session-id="@session.SessionId">
                    <CrestTableCell>@session.StartedUtc.ToLocalTime().ToString("g")</CrestTableCell>
                    <CrestTableCell>@(session.StoppedUtc?.ToLocalTime().ToString("g") ?? T["open"])</CrestTableCell>
                    <CrestTableCell>@(session.StaffUserName ?? session.StaffUserId)</CrestTableCell>
                    <CrestTableCell>@(session.MemberUserName ?? session.MemberUserId)</CrestTableCell>
                    <CrestTableCell>@session.OrganizationId</CrestTableCell>
                    <CrestTableCell>@session.EventCount</CrestTableCell>
                    <CrestTableCell><CrestButton Icon="list" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => OpenAsync(session, 0))" /></CrestTableCell>
                </CrestTableRow>
            }
        </CrestTableBody>
    </CrestTable>

    @if (Sessions.Items.Count == 0 && !IsBusy)
    {
        <CrestText TextStyle="TextStyle.Body2">@T["No impersonation sessions."]</CrestText>
    }

    <CrestStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <CrestButton Icon="chevron_left" ButtonStyle="ButtonStyle.Light" Disabled="@(Sessions.Skip == 0)" Click="@(() => LoadAsync(Math.Max(0, Sessions.Skip - Sessions.Take)))" />
        <CrestText TextStyle="TextStyle.Caption">@T["{0}-{1} of {2}", Sessions.Total == 0 ? 0 : Sessions.Skip + 1, Sessions.Skip + Sessions.Items.Count, Sessions.Total]</CrestText>
        <CrestButton Icon="chevron_right" ButtonStyle="ButtonStyle.Light" Disabled="@(Sessions.Skip + Sessions.Items.Count >= Sessions.Total)" Click="@(() => LoadAsync(Sessions.Skip + Sessions.Take))" />
    </CrestStack>

    @if (Selected is not null)
    {
        <CrestCard data-testid="audit-session-events">
            <CrestStack Gap="0.5rem">
                <CrestText TextStyle="TextStyle.H6" class="rz-m-0">
                    @T["{0} impersonating {1}", Selected.StaffUserName ?? Selected.StaffUserId ?? "", Selected.MemberUserName ?? Selected.MemberUserId ?? ""]
                </CrestText>
                <AuditEventTable Page="SessionEvents" PageChanged="@(skip => OpenAsync(Selected, skip))" />
            </CrestStack>
        </CrestCard>
    }
</CrestStack>

@code {
    private AuditSessionPage Sessions { get; set; } = new([], 0, 0, 25);
    private AuditSession? Selected { get; set; }
    private AuditEventPage SessionEvents { get; set; } = new([], 0, 0, 50);
    private bool IsBusy { get; set; }
    private string? Error { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync(0);

    private async Task LoadAsync(int skip)
    {
        IsBusy = true;
        Error = null;
        try
        {
            Sessions = await Http.GetFromJsonAsync<AuditSessionPage>($"{AuditTrailRoutes.Api}/sessions?skip={skip}&take=25") ?? Sessions;
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task OpenAsync(AuditSession session, int skip)
    {
        Selected = session;
        try
        {
            SessionEvents = await Http.GetFromJsonAsync<AuditEventPage>($"{AuditTrailRoutes.Api}/events?sessionId={Uri.EscapeDataString(session.SessionId)}&skip={skip}&take=50") ?? SessionEvents;
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
    }
}

<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The *.BlazorWasm suffix is the routing convention the server and the admin client load
         module pages by (see Crest.ContentPartLists.BlazorWasm). The audit pages live here,
         isolated with the module they depend on (docs/architecture.md › Rules that hold). -->
    <AssemblyName>Crest.AuditTrail.BlazorWasm</AssemblyName>
    <RootNamespace>Crest.AuditTrail.BlazorWasm</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Crest.Components\Crest.Components.csproj" />
  </ItemGroup>

  <!-- The routes are shared with the server module without referencing it. -->
  <ItemGroup>
    <Compile Include="..\Api\AuditTrailRoutes.cs" Link="AuditTrailRoutes.cs" />
  </ItemGroup>
</Project>

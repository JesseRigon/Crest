<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <!-- NuGet properties-->
    <Title>Grove Shortcodes</Title>
    <Description>$(OCCMSDescription)

    The Shortcodes module adds shortcode capabilities to content editor.</Description>
    <PackageTags>$(PackageTags) PlatformCMS</PackageTags>
  </PropertyGroup>

  <!-- The shortcode templates page is its own WASM library (blazor-wasm/, Grove.Shortcodes.BlazorWasm). -->
  <ItemGroup>
    <Compile Remove="blazor-wasm/**/*.cs" />
    <Content Remove="blazor-wasm/**" />
    <None Remove="blazor-wasm/**" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grove.Admin.Abstractions\Grove.Admin.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Data.Abstractions\Grove.Data.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Deployment.Abstractions\Grove.Deployment.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.DisplayManagement\Grove.DisplayManagement.csproj" />
    <ProjectReference Include="..\Grove.Liquid.Abstractions\Grove.Liquid.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Module.Targets\Grove.Module.Targets.csproj" />
    <ProjectReference Include="..\Grove.Navigation\Grove.Navigation.csproj" />
    <ProjectReference Include="..\Grove.Shortcodes.Abstractions\Grove.Shortcodes.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Server.Abstractions\Grove.Server.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.ResourceManagement\Grove.ResourceManagement.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Razor">
  <Import Project="$(PlatformSrcDir)Crest.Module.Targets\Crest.Module.Targets.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Crest.Global</AssemblyName>
    <RootNamespace>Crest.Global</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs;blazor-wasm/**/*.cs" />
  </ItemGroup>

  <!-- The tenant-less reference-data store (plans/global.md). Host-level: the store is
       built once per process and shared by every shell, on Crest's own
       DatabaseShellsSettingsSources pattern. Crest.Data.YesSql is referenced for
       the provider extensions (UseSqLite/UsePostgreSql/...) and SqliteHelper. -->
  <ItemGroup>
    <ProjectReference Include="$(PlatformSrcDir)Crest.Data\Crest.Data.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Crest.Data.YesSql\Crest.Data.YesSql.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Crest.Module.Targets\Crest.Module.Targets.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Crest.Security\Crest.Security.csproj" />
    <PackageReference Include="YesSql.Abstractions" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk.Razor">
  <Import Project="$(PlatformSrcDir)Crest.Theme.Targets\Crest.Theme.Targets.props" />
  <Import Project="$(PlatformSrcDir)Crest.Module.Targets\Crest.Module.Targets.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformCompatibilityVersion>4.0.0</PlatformCompatibilityVersion>
    <CrestSecurityPatch>0</CrestSecurityPatch>
    <CrestBugPatch>0</CrestBugPatch>
    <CrestVersion>$(PlatformCompatibilityVersion).$(CrestSecurityPatch).$(CrestBugPatch)</CrestVersion>
    <VersionPrefix>$(PlatformCompatibilityVersion)</VersionPrefix>
    <PackageVersion>$(PlatformCompatibilityVersion)</PackageVersion>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>
    <AssemblyInformationalVersion>$(CrestVersion)</AssemblyInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="wwwroot\node_modules\**" />
    <EmbeddedResource Remove="wwwroot\node_modules\**" />
    <None Remove="wwwroot\node_modules\**" />
    <Compile Remove="tests\**\*.cs" />
    <!-- wasm\ is a sibling project (Crest.SiteTheme.Client), not part of this
         one - without this, the SDK's default **/*.cs glob also sweeps in its
         generated obj\ output (duplicate AssemblyInfo/TargetFramework attributes,
         CS0579) and its own .razor/.cs sources. -->
    <Compile Remove="wasm\**\*.cs" />
    <Content Remove="wasm\**" />
    <EmbeddedResource Remove="wasm\**" />
    <None Remove="wasm\**" />
    <RazorGenerate Remove="wasm\**" />
    <RazorComponent Remove="wasm\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Theme.Targets, not Module.Targets: sets ModuleType=Theme so IsTheme() is true at
         runtime and ThemeViewLocationExpanderProvider contributes this theme's Views/
         paths. See the same note in Crest.LegacyFrame.csproj. -->
    <ProjectReference Include="$(PlatformSrcDir)Crest.Theme.Targets\Crest.Theme.Targets.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Crest.Admin.Abstractions\Crest.Admin.Abstractions.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Crest.ContentManagement\Crest.ContentManagement.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Crest.ResourceManagement\Crest.ResourceManagement.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Crest.DisplayManagement\Crest.DisplayManagement.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Crest.Users.Abstractions\Crest.Users.Abstractions.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Crest.Users\Crest.Users.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Crest.Menu\Crest.Menu.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Crest.Email.Abstractions\Crest.Email.Abstractions.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Crest.Setup.Abstractions\Crest.Setup.Abstractions.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Crest.Setup\Crest.Setup.csproj" />
  </ItemGroup>

  <!-- Crest.Server is the single Blazor Web App host (API + SSR) for every Crest theme -
       it, not this project, calls AddRazorComponents()/AddInteractiveWebAssemblyComponents()
       and owns the App.razor/Routes.razor roots (see plans/blazor hybrid conversion.md).
       This project keeps its own page/layout components (Phase 5) and references
       Components/Icons to build them, plus its WASM half
       (wasm/Crest.SiteTheme.Client.csproj) for @rendermode
       InteractiveWebAssembly/InteractiveAuto components - it just doesn't self-host. -->
  <ItemGroup>
    <ProjectReference Include="..\Crest.Components\Crest.Components.csproj" />
    <ProjectReference Include="..\Crest.Icons\Crest.Icons.csproj" />
    <ProjectReference Include="wasm\Crest.SiteTheme.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="**\*.less;**\*.scss;" />
    <EmbeddedResource Remove="wwwroot\about.html" />
    <EmbeddedResource Remove="wwwroot\contact.html" />
    <EmbeddedResource Remove="wwwroot\gulpfile.js" />
    <EmbeddedResource Remove="wwwroot\index.html" />
    <EmbeddedResource Remove="wwwroot\package-lock.json" />
    <EmbeddedResource Remove="wwwroot\package.json" />
    <EmbeddedResource Remove="wwwroot\post.html" />
  </ItemGroup>
</Project>

@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@using Crest.Admin
@using Crest.Entities
@using Crest.Environment.Shell
@using Crest.Settings
@using Crest.Users
@using Crest.Users.Models
@inject ISiteService SiteService
@inject SignInManager<IUser> SignInManager
@inject IOptions<AdminOptions> AdminOptions
@inject IShellFeaturesManager ShellFeaturesManager

@{
    var siteSettings = await SiteService.GetSiteSettingsAsync();
    var allowChangeEmail = siteSettings.TryGet<ChangeEmailSettings>(out var changeEmailSettings) && changeEmailSettings.AllowChangeEmail;
    var externalAuthenticationSchemes = await SignInManager.GetExternalAuthenticationSchemesAsync();
    var userCanRegister = await ShellFeaturesManager.IsFeatureEnabledAsync("Crest.Users.Registration");
}
<ul class="navbar-nav">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item dropdown">
            <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown"><i class="fa fa-user fa-fw"></i> @User.Identity.Name<b class="caret"></b></a>
            <div class="dropdown-menu dropdown-menu-right">
                <a class="dropdown-item" asp-route-area="Crest.Admin" asp-controller="Admin" asp-action="Index"><i class="fa fa-desktop fa-fw"></i> @T["Dashboard"]</a>
                @if (allowChangeEmail)
                {
                    <a class="dropdown-item" asp-route-area="Crest.Users" asp-controller="ChangeEmail" asp-action="Index"><i class="fa fa-envelope fa-fw"></i> @T["Change Email"]</a>
                }
                <a class="dropdown-item" asp-route-area="Crest.Users" asp-controller="Account" asp-action="ChangePassword"><i class="fa fa-lock fa-fw"></i> @T["Change Password"]</a>
                @if (externalAuthenticationSchemes.Count() > 0)
                {
                    <a class="dropdown-item" asp-route-area="Crest.Users" asp-controller="Account" asp-action="ExternalLogins"><i class="fa fa-user-lock fa-fw"></i> @T["External Logins"]</a>
                }
                <form class="form-inline" asp-route-area="Crest.Users" asp-controller="Account" asp-action="LogOff" method="post">
                    <button type="submit" class="btn btn-link navbar-btn dropdown-item"><i class="fa fa-sign-out-alt fa-fw"></i> @T["Log off"]</button>
                </form>
            </div>
        </li>
    }
    else
    {
        <li class="nav-item"><a class="nav-link" asp-route-area="Crest.Users" asp-controller="Account" asp-action="Login"><i class="fa fa-sign-in-alt fa-fw"></i> @T["Log in"]</a></li>
        if (userCanRegister)
        {
            <li class="nav-item"><a class="nav-link" asp-area="Crest.Users" asp-controller="Registration" asp-action="Register" asp-route-returnurl="@ViewData["ReturnUrl"]"><i class="fa fa-user-plus fa-fw"></i> @T["Register"]</a></li>
        }
    }
</ul>
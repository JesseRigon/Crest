@* The transition layout (docs/blazor-display.md rework step 7): the site renders on the display
   tree, but some modules still serve MVC pages on the site (account screens). They get this
   frame, the same design system and CrestSite.css, until each is replaced by a component page. *@
<!DOCTYPE html>
<html lang="@Platform.CultureName()" dir="@Platform.CultureDir()">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@RenderTitleSegments(Site.SiteName, "before")</title>
    <link rel="stylesheet" href="~/_content/Crest.Components/css/material-base.css" />
    <link rel="stylesheet" href="~/_content/Crest.AdminTheme.Client/CrestAdmin.DesignSystem.Default.css" />
    <link rel="stylesheet" href="~/_content/Crest.Components/CrestComponents.css" />
    <link rel="stylesheet" href="~/_content/Crest.SiteTheme.Client/CrestSite.css" />
    <resources type="Meta" />
    <resources type="HeadLink" />
    <resources type="Stylesheet" />
    <resources type="HeadScript" />
</head>
<body>
    <div class="crest-site">
        <header class="crest-site__bar"><a class="crest-site__brand" href="~/">@Site.SiteName</a></header>
        <div class="crest-site__body">
            <main class="crest-site__main">
                @await RenderSectionAsync("Messages", required: false)
                @await RenderBodyAsync()
            </main>
        </div>
        <footer class="crest-site__footer">@await RenderSectionAsync("Footer", required: false)</footer>
    </div>
    <resources type="FootScript" />
</body>
</html>

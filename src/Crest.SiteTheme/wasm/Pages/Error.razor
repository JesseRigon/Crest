@page "/Error"
@page "/Error/{Status:int}"

@* The site's error page (step 7: the MVC Diagnostics error view is retired): the status code
   pages re-execute "/Error/{status}" for a site URL, and the access-denied path is
   "/Error/403" (CrestErrorPage). *@

<PageTitle>Error</PageTitle>

<Crest.Components.Errors.CrestErrorPage Status="@Status" />

@code {
    [Parameter]
    public int? Status { get; set; }
}

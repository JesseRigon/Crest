<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Phase 8: converted from Microsoft.NET.Sdk.BlazorWebAssembly to a Razor class
       library - a Blazor Web App has exactly ONE WASM entry project
       (the host app's, see CrestWebAssemblyHost), which references this library. Routable @page
       components (Routes.razor, Pages/*) stay here, per docs/blazor-web.md. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Crest.SiteTheme.Client</AssemblyName>
    <RootNamespace>Crest.SiteTheme.Client</RootNamespace>
    <PlatformCompatibilityVersion>4.0.0</PlatformCompatibilityVersion>
    <CrestSecurityPatch>0</CrestSecurityPatch>
    <CrestBugPatch>0</CrestBugPatch>
    <CrestVersion>$(PlatformCompatibilityVersion).$(CrestSecurityPatch).$(CrestBugPatch)</CrestVersion>
    <VersionPrefix>$(PlatformCompatibilityVersion)</VersionPrefix>
    <PackageVersion>$(PlatformCompatibilityVersion)</PackageVersion>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>
    <AssemblyInformationalVersion>$(CrestVersion)</AssemblyInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Crest.Components\Crest.Components.csproj" />
    <ProjectReference Include="..\..\Crest.Icons\Crest.Icons.csproj" />
    <ProjectReference Include="..\..\Crest.Shell\Crest.Shell.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>

     <!-- NuGet properties-->
    <Title>Grove SafeMode theme</Title>
    <Description>$(OCCMSDescription)

    A fail-safe theme when no other themes are available.</Description>
    <PackageTags>$(PackageTags) PlatformCMS Theme</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grove.Theme.Targets\Grove.Theme.Targets.csproj" />
    <ProjectReference Include="..\Grove.DisplayManagement\Grove.DisplayManagement.csproj" />
  </ItemGroup>

</Project>

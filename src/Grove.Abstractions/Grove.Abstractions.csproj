<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Grove</RootNamespace>
    <!-- NuGet properties-->
    <Title>Grove Abstractions</Title>
    <Description>$(OCFrameworkDescription)

    Abstractions of Grove ShellHost.</Description>
    <PackageTags>$(PackageTags) PlatformFramework</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="Grove.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AnyAscii" />
    <PackageReference Include="JsonPath.Net" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
    <PackageReference Include="ZString" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Grove.Infrastructure</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Grove.Abstractions.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>

@model dynamic

<script asp-src="~/Grove.Rules/Scripts/rules.min.js" debug-src="~/Grove.Rules/Scripts/rules.js" depends-on="sortable" at="Foot"></script>
<style asp-src="~/Grove.Rules/Styles/rules.min.css" debug-src="~/Grove.Rules/Styles/rules.css"></style>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="w-100">
            <div class="float-end">
                <!-- Button trigger modal -->
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalConditions" data-condition-group-id="@Model.ConditionId">
                    @T["Add"]
                </button>
            </div>

            @await DisplayAsync(Model.Content)
        </div>
    </div>
</div>

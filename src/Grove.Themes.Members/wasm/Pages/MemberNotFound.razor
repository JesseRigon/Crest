@attribute [Route(MemberRoutePaths.NotFound)]
@attribute [AllowAnonymous]
@attribute [Grove.Display.Components.Modules.OrganizationFreePage]
@namespace Grove.Themes.Members.Pages
@using Grove.Display.Components.Primitives
@using Grove.Themes.Members.Services

@* A member URL with no member page. Deliberately its own page rather than the
   LegacyAdminFrame AdminRoutes falls back to: that frame is Grove's admin UI, and a
   member has no business being shown it.

   [AllowAnonymous] because a 404 must not depend on being signed in - an unauthenticated
   visitor hitting a bad member URL should see "not found", not a login redirect that
   implies the page exists. *@

<PageTitle>Not found</PageTitle>

<div class="grove-member-centred" data-testid="member-not-found">
    <GroveStack Gap="1rem" AlignItems="AlignItems.Center">
        <GroveText TextStyle="TextStyle.H4" Text="Not found" />
        <GroveText TextStyle="TextStyle.Body1" Text="This page does not exist." />
        <GroveLink Path="./" Text="Go to the portal" />
    </GroveStack>
</div>

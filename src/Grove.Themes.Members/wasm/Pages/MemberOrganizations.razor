@attribute [Route(MemberRoutePaths.Organizations)]
@attribute [Grove.Display.Components.Modules.OrganizationFreePage]
@namespace Grove.Themes.Members.Pages
@inject NavigationManager Navigation
@inject IServiceProvider Services

@* The organization picker, at the member base: where a member lands who has not named an
   organization (after sign-in, a bare member URL). Member pages carry the organization in
   their path (/{member prefix}/{slug}/…), so choosing one is a navigation - a bookmark then
   opens the right organization, and two tabs can act in two organizations. A member with
   exactly one organization goes straight in.

   The list is the member's own bindings, as the server returned them; nothing here decides
   access - the server refuses a path naming an organization the member is not bound to. *@

<PageTitle>Choose an organization</PageTitle>

<div class="grove-member-centred" data-testid="member-organizations">
    <GroveStack Gap="1rem" Style="width: 22rem; max-width: 100%;">
        <GroveText TextStyle="TextStyle.H5" Text="Choose an organization" />

        @if (ShellContext.Organizations.Count == 0)
        {
            <GroveText TextStyle="TextStyle.Body2"
                       Text="This account is not a member of any organization."
                       data-testid="member-organizations-empty" />
        }

        @foreach (var organization in ShellContext.Organizations)
        {
            <GroveButton ButtonStyle="ButtonStyle.Light"
                         Text="@organization.Name"
                         Click="@(() => OpenAsync(organization))"
                         Disabled="@(!RendererInfo.IsInteractive)"
                         data-testid="member-organizations-option" />
        }

        <GroveButton ButtonStyle="ButtonStyle.Light"
                     Text="@ShellContext.SignOutText"
                     Click="@SignOutAsync"
                     data-testid="member-organizations-signout" />
    </GroveStack>
</div>

@code {
    [CascadingParameter]
    private IMemberShellContext ShellContext { get; set; } = default!;

    private Grove.Display.Components.Modules.GroveShellContext? Shell =>
        Services.GetService(typeof(Grove.Display.Components.Modules.GroveShellContext)) as Grove.Display.Components.Modules.GroveShellContext;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RendererInfo.IsInteractive && ShellContext.Organizations.Count == 1)
        {
            await OpenAsync(ShellContext.Organizations[0]);
        }
    }

    // The choice is remembered as the session's last one (what a request naming no
    // organization falls back to), then the organization's path is opened: a new document,
    // whose base names the organization.
    private async Task OpenAsync(MemberShellOrganization organization)
    {
        await ShellContext.SetActiveOrganizationAsync(organization.Id);
        Navigation.NavigateTo(MemberShellLinks.Organization(Navigation, Shell, organization.Slug), forceLoad: true);
    }

    private async Task SignOutAsync()
    {
        await ShellContext.SignOutAsync();
        Navigation.NavigateTo(MemberShellLinks.OrganizationFree(Navigation, Shell, MemberRoutePaths.Login), forceLoad: true);
    }
}

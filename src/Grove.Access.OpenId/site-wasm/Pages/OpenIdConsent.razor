@page "/connect/consent"
@page "/connect/logout-confirm"
@attribute [Grove.Display.Components.Modules.SetsAuthenticationCookie]
@using System.Net.Http.Json
@using Grove.Display.Components.Primitives
@inject HttpClient Http
@inject NavigationManager Navigation

@* The OpenID Connect consent and logout confirmation (step 7: the MVC Authorize and Logout views
   are retired). The authorization and logout endpoints send the browser here with the request's
   parameters; the decision is a plain form post of those parameters back to the endpoint, with
   submit.Accept or submit.Deny and an antiforgery token - OpenIddict answers the request in that
   post, so it cannot be a fetch. The page only names the application and the scopes. *@

<PageTitle>@(IsLogout ? "Log out" : "Authorization")</PageTitle>

<div style="max-width: 32rem; margin: 2rem auto; padding: 0 1rem;" data-testid="openid-consent-page">
    @* The form appears once interactive in the browser: the antiforgery token it carries
       pairs with the cookie the browser's own fetch received (hence [SetsAuthenticationCookie]:
       a server circuit's fetch would leave that cookie in the server's handler). *@
    @if (Action is null || !RendererInfo.IsInteractive)
    {
        <GroveText TextStyle="TextStyle.Body2" Text="@(Failed ? "This request cannot be completed." : "Loading…")" data-testid="openid-consent-loading" />
    }
    else
    {
        <GroveStack Gap="1rem">
            <GroveText TextStyle="TextStyle.H4" Text="@(IsLogout ? "Log out" : "Authorization")" />
            @if (IsLogout)
            {
                <GroveText TextStyle="TextStyle.Body1" Text="Are you sure you want to log out?" />
            }
            else
            {
                <GroveText TextStyle="TextStyle.Body1" Text="@($"Do you want to grant {ApplicationName} access to your data?")" data-testid="openid-consent-application" />
                @if (Scopes.Length > 0)
                {
                    <GroveText TextStyle="TextStyle.Body2" Text="@($"Requested: {string.Join(", ", Scopes)}")" />
                }
            }

            <form method="post" action="@Action" data-testid="openid-consent-form">
                @foreach (var (name, value) in Parameters)
                {
                    <input type="hidden" name="@name" value="@value" />
                }
                <input type="hidden" name="@TokenField" value="@Token" />
                <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <button type="submit" name="submit.Accept" value="Yes" class="rz-button rz-button-md rz-primary" data-testid="openid-consent-accept">Yes</button>
                    <button type="submit" name="submit.Deny" value="No" class="rz-button rz-button-md rz-light" data-testid="openid-consent-deny">No</button>
                </GroveStack>
            </form>
        </GroveStack>
    }
</div>

@code {
    private string? Action { get; set; }
    private string ApplicationName { get; set; } = string.Empty;
    private string[] Scopes { get; set; } = [];
    private string TokenField { get; set; } = "__RequestVerificationToken";
    private string Token { get; set; } = string.Empty;
    private bool Failed { get; set; }
    private (string Name, string Value)[] Parameters { get; set; } = [];

    private bool IsLogout => new Uri(Navigation.Uri).AbsolutePath.EndsWith("/logout-confirm", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Navigation.Uri);
        Parameters = [.. uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries).Select(Pair)];
        try
        {
            if (IsLogout)
            {
                var logout = await Http.GetFromJsonAsync<LogoutModel>("api/grove/openid/consent/logout");
                (Action, TokenField, Token) = (logout?.Action, logout?.AntiforgeryFieldName ?? TokenField, logout?.AntiforgeryToken ?? string.Empty);
            }
            else
            {
                var clientId = Parameters.FirstOrDefault(parameter => parameter.Name == "client_id").Value;
                var scope = Parameters.FirstOrDefault(parameter => parameter.Name == "scope").Value;
                var consent = await Http.GetFromJsonAsync<ConsentModel>($"api/grove/openid/consent?client_id={Uri.EscapeDataString(clientId ?? string.Empty)}&scope={Uri.EscapeDataString(scope ?? string.Empty)}");
                if (consent is not null)
                {
                    (Action, ApplicationName, Scopes, TokenField, Token) = (consent.Action, consent.ApplicationName, consent.Scopes, consent.AntiforgeryFieldName, consent.AntiforgeryToken);
                }
            }
        }
        catch (HttpRequestException)
        {
        }

        Failed = Action is null;
    }

    private static (string Name, string Value) Pair(string part)
    {
        var equals = part.IndexOf('=');
        return equals < 0
            ? (Uri.UnescapeDataString(part), string.Empty)
            : (Uri.UnescapeDataString(part[..equals].Replace('+', ' ')), Uri.UnescapeDataString(part[(equals + 1)..].Replace('+', ' ')));
    }

    private sealed record ConsentModel(string ApplicationName, string[] Scopes, string Action, string AntiforgeryFieldName, string AntiforgeryToken);

    private sealed record LogoutModel(string Action, string AntiforgeryFieldName, string AntiforgeryToken);
}

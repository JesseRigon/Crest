<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Grove.Contents</RootNamespace>
    <!-- NuGet properties-->
    <Title>Grove Contents Abstractions</Title>
    <Description>$(OCCMSDescription)

    Abstractions for the Contents module: permissions, admin list filter contracts, options and view models.</Description>
    <PackageTags>$(PackageTags) PlatformCMS Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YesSql.Filters.Query" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grove.Contents.Management\Grove.Contents.Management.csproj" />
    <ProjectReference Include="..\Grove.Display.Management.Abstractions\Grove.Display.Management.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Infrastructure.Abstractions\Grove.Infrastructure.Abstractions.csproj" />
  </ItemGroup>

</Project>

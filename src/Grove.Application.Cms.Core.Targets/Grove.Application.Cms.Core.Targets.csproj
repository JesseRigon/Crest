<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- NuGet properties-->
    <Title>Target for Modular Grove CMS Application</Title>
    <Description>
      $(OCCMSDescription)

      Converts the application into a modular Grove CMS application with the Blazor admin theme but without any front-end Themes.
    </Description>
    <PackageTags>$(PackageTags) PlatformCMS CMS</PackageTags>
  </PropertyGroup>

  <!-- Add ".props" and ".targets" files in the package specific to the "Cms.Core" bundle -->

  <ItemGroup>
    <None Include="Grove.Application.Cms.Core.Targets.props" Pack="true">
      <PackagePath>build\Grove.Application.Cms.Core.Targets.props</PackagePath>
    </None>
    <None Include="Grove.Application.Cms.Core.Targets.targets" Pack="true">
      <PackagePath>build\Grove.Application.Cms.Core.Targets.targets</PackagePath>
    </None>
  </ItemGroup>

  <!--
    When a package is not directly referenced, e.g only through the reference of this bundle package,
    the files in its build folder are not evaluated on building if this folder is marked as private.
    This can be defined by using the 'PrivateAssets' attribute.

    Here, only project references are used but when packing the bundle they become package references,
    and with the same 'PrivateAssets' attribute.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Grove.Application.Targets\Grove.Application.Targets.csproj" PrivateAssets="none" />

    <!--
      When adding a reference to this list, please keep it ordered alphabetically, and set PrivateAssets="none"
    -->

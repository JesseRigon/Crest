@page "/SitemapsCache/List"
@attribute [PageEntry("ManageSitemaps", Id = "sitemaps-cache", Parent = "sitemaps-seo", Caption = "Sitemaps Cache", Position = "3")]
@inject HttpClient Http
@inject Grove.Components.Theme.GroveApiLocalizer T

@* The sitemap files built and cached on disk: purge one, or all; a purged sitemap is rebuilt on
   its next request. *@

<PageTitle>@T["Sitemaps Cache"]</PageTitle>

<GroveStack Gap="1rem" data-testid="sitemaps-cache-page">
    <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
        <GroveStack Gap="0.25rem">
            <GroveText TextStyle="TextStyle.H4" class="rz-m-0">@T["Sitemaps Cache"]</GroveText>
            <GroveText TextStyle="TextStyle.Body2">@T["Cached sitemap files. A purged sitemap is rebuilt when it is next requested."]</GroveText>
        </GroveStack>
        <GroveButton Icon="delete_sweep" Text="@T["Purge all"]" ButtonStyle="ButtonStyle.Danger" Click="PurgeAllAsync" Disabled="@(IsBusy || Files is not { Length: > 0 })" data-testid="sitemaps-cache-purge-all" />
    </GroveStack>

    @if (Message is not null)
    {
        <GroveAlert AlertStyle="@(Failed ? AlertStyle.Danger : AlertStyle.Info)" ShowIcon="true" AllowClose="true">@Message</GroveAlert>
    }

    <GroveCard>
        @if (Files is null)
        {
            <GroveProgressBar Mode="ProgressBarMode.Indeterminate" />
        }
        else if (Files.Length == 0)
        {
            <GroveText TextStyle="TextStyle.Body2">@T["No sitemap is cached."]</GroveText>
        }
        else
        {
            <GroveDataGrid Data="@Files" TItem="SitemapCacheFileModel" Density="Density.Compact">
                <Columns>
                    <GroveDataGridColumn TItem="SitemapCacheFileModel" Property="FileName" Title="@T["File"]" />
                    <GroveDataGridColumn TItem="SitemapCacheFileModel" Title="@T["Actions"]" Width="8rem">
                        <Template Context="file"><GroveButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="@(() => PurgeAsync(file))" Disabled="IsBusy" title="@T["Purge"]" /></Template>
                    </GroveDataGridColumn>
                </Columns>
            </GroveDataGrid>
        }
    </GroveCard>
</GroveStack>

@code {
    private SitemapCacheFileModel[]? Files;
    private bool IsBusy;
    private string? Message;
    private bool Failed;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try { Files = await Http.GetFromJsonAsync<SitemapCacheFileModel[]>(SitemapsApiPaths.Cache) ?? []; }
        catch (Exception exception) { Message = exception.Message; Failed = true; }
    }

    private Task PurgeAllAsync() => RunAsync(() => Http.DeleteAsync(SitemapsApiPaths.Cache), T["Sitemap cache purged."]);

    private Task PurgeAsync(SitemapCacheFileModel file) => RunAsync(() => Http.DeleteAsync(SitemapsApiPaths.CacheFile(file.FileName)), T["{0} purged.", file.FileName]);

    private async Task RunAsync(Func<Task<HttpResponseMessage>> call, string success)
    {
        IsBusy = true;
        try
        {
            using var response = await call();
            Failed = !response.IsSuccessStatusCode;
            Message = Failed ? (await ApiProblem.ReadAsync(response)).Message : success;
            await LoadAsync();
        }
        finally { IsBusy = false; }
    }
}

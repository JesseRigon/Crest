<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The *.BlazorWasm suffix is a routing convention, not decoration: the server
         loads and routes assemblies by it (Grove.Server Startup's client assembly
         loading) and Admin.Client's generated ModuleAssemblyRegistry loads the
         same set browser-side. -->
    <AssemblyName>Grove.ContentPartLists.BlazorWasm</AssemblyName>
    <RootNamespace>Grove.ContentPartLists.BlazorWasm</RootNamespace>
  </PropertyGroup>

  <!-- Plain component-model packages, no WASM-only APIs - works under every host:
       WASM, Blazor Server, and SSR (mirrors Grove.Parties.BlazorWasm). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Grove.Components\Grove.Components.csproj" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Grove.Infrastructure</RootNamespace>
    <!-- NuGet properties-->
    <Title>Grove Infrastructure Abstractions</Title>
    <Description>$(OCCMSDescription)

    Abstractions for PlatformCMS Infrastructure </Description>
    <PackageTags>$(PackageTags) PlatformCMS Infrastructure Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Grove.Infrastructure" />
    <InternalsVisibleTo Include="Grove.Tests" />
    <InternalsVisibleTo Include="Grove.Infrastructure.Abstractions.Tests" />
    <InternalsVisibleTo Include="Grove.Data.YesSql" />
    <InternalsVisibleTo Include="Grove.Contents.Management.GraphQL" />
    <InternalsVisibleTo Include="Grove.Display.Management" />
    <InternalsVisibleTo Include="Grove.Data.Cache.Dynamic" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AnyAscii" />
    <PackageReference Include="JsonPath.Net" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
    <PackageReference Include="ZString" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grove.Display.Resources.Management.Abstractions\Grove.Display.Resources.Management.Abstractions.csproj" />
  </ItemGroup>

</Project>

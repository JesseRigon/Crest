<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Grove.Routes.Auto</RootNamespace>
    <!-- NuGet properties-->
    <Title>Grove Autoroute Abstractions</Title>
    <Description>$(OCCMSDescription)

    Abstractions for the Autoroute module.</Description>
    <PackageTags>$(PackageTags) PlatformCMS Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YesSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grove.Contents.Management.Abstractions\Grove.Contents.Management.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Data.Abstractions\Grove.Data.Abstractions.csproj" />
    <ProjectReference Include="..\Grove.Infrastructure.Abstractions\Grove.Infrastructure.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The field set's values are fields. -->
    <ProjectReference Include="..\Grove.Contents.Fields.Abstractions\Grove.Contents.Fields.Abstractions.csproj" />
  </ItemGroup>

</Project>

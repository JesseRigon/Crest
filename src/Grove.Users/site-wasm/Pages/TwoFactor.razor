@page "/TwoFactor"
@page "/Authenticator/Configure/App"
@page "/Authenticator/Reset/App"
@page "/GenerateRecoveryCodes"
@page "/ShowRecoveryCodes"
@page "/DisableTwoFactorAuthentication"
@attribute [Grove.Components.Modules.SetsAuthenticationCookie]
@inject NavigationManager Navigation

@* The signed-in user's two-factor page, at the paths the two-factor screens have always had: each
   opens its part of the one component. Turning two-factor authentication on or off re-issues the
   session, so the page renders InteractiveWebAssembly ([SetsAuthenticationCookie]). *@

<PageTitle>Two-factor authentication</PageTitle>

<div style="max-width: 40rem; margin: 2rem auto; padding: 0 1rem;" data-testid="site-two-factor-page">
    <TwoFactorSetup Section="@Section" />
</div>

@code {
    private string? Section => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant() switch
    {
        "authenticator/configure/app" => "authenticator",
        "authenticator/reset/app" => "authenticator-reset",
        "generaterecoverycodes" or "showrecoverycodes" => "recovery-codes",
        "disabletwofactorauthentication" => "disable",
        _ => null,
    };
}

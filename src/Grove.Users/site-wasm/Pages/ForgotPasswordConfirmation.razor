@page "/ForgotPasswordConfirmation"

@* After a reset link was asked for: the same words whether or not the account exists. *@

<PageTitle>Forgot your password?</PageTitle>

<div style="max-width: 32rem; margin: 2rem auto; padding: 0 1rem;" data-testid="site-forgot-password-confirmation-page">
    <GroveStack Gap="0.75rem">
        <GroveText TextStyle="TextStyle.H5" Text="Check your email" />
        <GroveText TextStyle="TextStyle.Body1" Text="If an account matches what you entered, an email with a link to reset its password is on its way." />
    </GroveStack>
</div>

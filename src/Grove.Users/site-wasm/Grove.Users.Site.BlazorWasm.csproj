<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- The Users module's site-shell library: the account pages a visitor and a signed-in user
       meet on the site (docs/shells-and-themes.md › Account and protocol pages) - account
       security, email confirmation, external sign-in completion, registration, password
       recovery, the two-factor page and the second sign-in step. Declares
       [assembly: GroveShell(GroveShells.Site)] in GroveShell.cs; the parts are the module's
       shared components (components/, Grove.Users.Components). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Grove.Users.Site.BlazorWasm</AssemblyName>
    <RootNamespace>Grove.Users.Site</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Grove.Components\Grove.Components.csproj" />
    <ProjectReference Include="..\components\Grove.Users.Components.csproj" />
  </ItemGroup>
</Project>

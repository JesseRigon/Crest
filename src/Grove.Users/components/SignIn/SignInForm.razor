@namespace Grove.Users.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IServiceProvider Services

@* The staff sign-in (the admin theme's login page lays it out): user name and password, remember
   me, and what the enabled features contribute (api/grove/auth/form/login: the forgot-password
   and register links, a button per external identity provider, sections such as a captcha),
   then - for an account with two-factor authentication - the second step in place
   (TwoFactorChallenge). The page owns where a signed-in user goes (SignedIn). *@

@if (TwoFactorPending)
{
    <TwoFactorChallenge RememberMe="@Credentials.RememberMe" SignedIn="@SignedIn" Restart="@RestartAsync" />
}
else
{
    <GroveStack Gap="0.75rem" Style="width: 22rem; max-width: 100%;" data-testid="sign-in-form">
        @if (Form.LocalLogin)
        {
            <GroveTemplateForm TItem="CredentialsModel" Data="@Credentials" Submit="@((CredentialsModel _) => SignInAsync())">
                <GroveStack Gap="0.75rem">
                    <GroveTextBox Name="UserName" @bind-Value="Credentials.UserName" Placeholder="@L("Username or email")" autocomplete="username" />
                    <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <GroveButton ButtonType="ButtonType.Button"
                                     ButtonStyle="ButtonStyle.Light"
                                     Icon="@(ShowPassword ? "visibility_off" : "visibility")"
                                     title="@(ShowPassword ? L("Hide password") : L("Show password"))"
                                     aria-label="@(ShowPassword ? L("Hide password") : L("Show password"))"
                                     Click="@(() => ShowPassword = !ShowPassword)"
                                     data-testid="toggle-password" />
                        <GrovePassword Name="Password" @bind-Value="Credentials.Password" Placeholder="@L("Password")"
                                       Reveal="@ShowPassword" autocomplete="current-password" Style="flex: 1 1 auto;" />
                    </GroveStack>
                    @if (Form.AllowRememberMe)
                    {
                        <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <GroveCheckBox @bind-Value="Credentials.RememberMe" Name="RememberMe" />
                            @* Unchecked = a session auth cookie: signing in lasts only until the
                               browser session ends. Checked = a persistent cookie. *@
                            <label class="rz-label" for="RememberMe" style="margin: 0; cursor: pointer;">@L("Remember me")</label>
                        </GroveStack>
                    }
                    <AccessFormExtensions Extensions="@Form.Extensions" Part="sections" Headers="@Headers" />
                    @* Disabled until interactive: the statically prerendered form carries the
                       middleware's internal composed URL as its action and no method, so a submit
                       before the runtime attaches would be a native GET that puts the password in
                       the URL. A disabled sole submit button also blocks the Enter-key implicit
                       submission for that window. *@
                    <GroveButton ButtonType="ButtonType.Submit" Text="@L("Log in")" Disabled="@(Busy || !RendererInfo.IsInteractive)" />
                </GroveStack>
            </GroveTemplateForm>
        }

        @foreach (var error in Errors)
        {
            <GroveText TextStyle="TextStyle.Caption" Text="@error" Style="color: var(--grove-color-danger, #b3261e);" data-testid="sign-in-error" />
        }

        <AccessFormExtensions Extensions="@Form.Extensions" Part="providers" />
        <AccessFormExtensions Extensions="@Form.Extensions" Part="links" />
    </GroveStack>
}

@code {
    /// <summary>Where the user came from, passed on to an external sign-in and registration.</summary>
    [Parameter]
    public string? ReturnUrl { get; set; }

    /// <summary>A user name to start with (a "switch user" link).</summary>
    [Parameter]
    public string? UserName { get; set; }

    /// <summary>A refusal met before this page (an external sign-in that failed, a disabled account).</summary>
    [Parameter]
    public string? Error { get; set; }

    /// <summary>The page was reached from a failed external sign-in: do not start the only provider again.</summary>
    [Parameter]
    public bool ExternalLoginError { get; set; }

    /// <summary>Raised with the signed-in user (its <see cref="SignInAnswer.Redirect"/> when it must go somewhere first).</summary>
    [Parameter]
    public EventCallback<SignInAnswer> SignedIn { get; set; }

    private AccessForm Form { get; set; } = AccessForm.Empty;
    private CredentialsModel Credentials { get; } = new();
    private Dictionary<string, string?> Headers { get; } = [];
    private string[] Errors { get; set; } = [];
    private bool ShowPassword { get; set; }
    private bool Busy { get; set; }
    private bool TwoFactorPending { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Credentials.UserName = UserName ?? string.Empty;
        Errors = string.IsNullOrEmpty(Error) ? [] : [Error];

        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        var query = new List<string>();
        if (!string.IsNullOrEmpty(ReturnUrl))
        {
            query.Add("returnUrl=" + Uri.EscapeDataString(ReturnUrl));
        }

        if (ExternalLoginError)
        {
            query.Add("externalLoginError=true");
        }

        Form = await SignInApi.GetAsync<AccessForm>(Http, "api/grove/auth/form/" + AccessForms.Login + (query.Count > 0 ? "?" + string.Join('&', query) : string.Empty)) ?? AccessForm.Empty;
        Credentials.RememberMe = Form.RememberMe;

        // A feature that signs in elsewhere straight away (the only external provider).
        if (Form.Redirect is { Length: > 0 } redirect && !ExternalLoginError)
        {
            Navigation.NavigateTo(redirect, forceLoad: true);
        }
    }

    private async Task SignInAsync()
    {
        Busy = true;
        Errors = [];
        try
        {
            var (answer, refusal) = await SignInApi.PostAsync<SignInAnswer, SignInRefusal>(
                Http,
                "api/grove/auth/login",
                new { Credentials.UserName, Credentials.Password, Credentials.RememberMe },
                Headers);

            if (answer is { RequiresTwoFactor: true })
            {
                TwoFactorPending = true;
                return;
            }

            if (answer is { IsAuthenticated: true })
            {
                await SignedIn.InvokeAsync(answer);
                return;
            }

            Errors = refusal?.Errors is { Length: > 0 } errors ? errors : [L("Login failed")];

            // A refusal that names a page (confirm your email, registration pending) goes there.
            if (refusal?.Redirect is { Length: > 0 } page)
            {
                Navigation.NavigateTo(page, forceLoad: true);
            }
        }
        finally
        {
            Busy = false;
        }
    }

    private Task RestartAsync()
    {
        TwoFactorPending = false;
        Credentials.Password = string.Empty;
        return Task.CompletedTask;
    }

    private string L(string text) => (Services.GetService(typeof(ILocalizer)) as ILocalizer)?.Get(text, CultureInfo.CurrentUICulture) ?? text;

    private sealed class CredentialsModel
    {
        public string UserName { get; set; } = string.Empty;

        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}

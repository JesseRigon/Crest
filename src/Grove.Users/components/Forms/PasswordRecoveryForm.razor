@namespace Grove.Users.Components
@inherits AccountFormBase

@* Asks for a password reset link (api/grove/password/forgot). The answer is the same whether or
   not the account exists, so the confirmation page says only that a link is on its way if it does. *@

<GroveStack Gap="0.75rem" Style="width: 24rem; max-width: 100%;" data-testid="forgot-password-form">
    <GroveText TextStyle="TextStyle.H5" Text="@L("Forgot your password?")" />
    <GroveText TextStyle="TextStyle.Body2" Text="@L("Enter your user name or email address and we will send you a link to reset your password.")" />
    <GroveFormField Text="@L("User name or email")" Style="width: 100%;"><GroveTextBox @bind-Value="UserNameOrEmail" autocomplete="username" Style="width: 100%;" data-testid="forgot-password-identifier" /></GroveFormField>
    <AccessFormExtensions Extensions="@Form.Extensions" Part="sections" Headers="@Headers" />
    <GroveButton Text="@L("Send")" Click="SendAsync" Disabled="@(Busy || !RendererInfo.IsInteractive)" data-testid="forgot-password-submit" />
    <Messages Errors="@Errors" />
</GroveStack>

@code {
    protected override string FormName => AccessForms.ForgotPassword;

    private string? UserNameOrEmail { get; set; }

    private Task SendAsync() => SubmitAsync("api/grove/password/forgot", new { UserNameOrEmail });
}

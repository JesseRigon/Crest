@namespace Grove.Users.Components
@inherits AccountFormBase

@* Sets a new password from the emailed link's code (api/grove/password/reset). *@

<GroveStack Gap="0.75rem" Style="width: 24rem; max-width: 100%;" data-testid="reset-password-form">
    <GroveText TextStyle="TextStyle.H5" Text="@L("Reset your password")" />
    @if (string.IsNullOrEmpty(Code))
    {
        <GroveText TextStyle="TextStyle.Body2" Text="@L("The reset link is not valid. Ask for a new one.")" data-testid="reset-password-no-code" />
    }
    else
    {
        <GroveFormField Text="@L("User name or email")" Style="width: 100%;"><GroveTextBox @bind-Value="UserNameOrEmail" autocomplete="username" Style="width: 100%;" data-testid="reset-password-identifier" /></GroveFormField>
        <GroveFormField Text="@L("New password")" Style="width: 100%;"><GrovePassword @bind-Value="NewPassword" autocomplete="new-password" Style="width: 100%;" data-testid="reset-password-new" /></GroveFormField>
        <GroveFormField Text="@L("Confirm the password")" Style="width: 100%;"><GrovePassword @bind-Value="ConfirmPassword" autocomplete="new-password" Style="width: 100%;" data-testid="reset-password-confirm" /></GroveFormField>
        <AccessFormExtensions Extensions="@Form.Extensions" Part="sections" Headers="@Headers" />
        <GroveButton Text="@L("Reset password")" Click="ResetAsync" Disabled="@(Busy || !RendererInfo.IsInteractive)" data-testid="reset-password-submit" />
        <Messages Errors="@Errors" />
    }
</GroveStack>

@code {
    /// <summary>The reset link's code.</summary>
    [Parameter]
    public string? Code { get; set; }

    protected override string FormName => AccessForms.ResetPassword;

    private string? UserNameOrEmail { get; set; }
    private string? NewPassword { get; set; }
    private string? ConfirmPassword { get; set; }

    private Task ResetAsync() => SubmitAsync("api/grove/password/reset", new { UserNameOrEmail, Code, NewPassword, ConfirmPassword });
}

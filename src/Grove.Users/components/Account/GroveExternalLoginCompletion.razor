@namespace Grove.Users.Components
@using System.Globalization
@using Grove.Components.Primitives
@inject HttpClient Http
@inject IServiceProvider Services
@inject NavigationManager Navigation

@* Completes an external sign-in the platform's callback could not finish on its own (step 7: the
   MVC RegisterExternalLogin and LinkExternalLogin views are retired): registering a new account
   with what the tenant's external registration settings still ask for, or - when an account
   with the provider's email exists - linking to it with that account's password. What the
   provider sent stays in the external cookie; this only reads it back. *@

<GroveStack Gap="1rem" Style="width: 24rem; max-width: 100%;" data-testid="external-login-completion">
    @if (Pending is null)
    {
        <GroveText TextStyle="TextStyle.Body2" Text="@(Loaded ? L("There is no external sign-in to complete. Sign in again.") : L("Loading…"))" data-testid="external-login-none" />
    }
    else if (IsLink)
    {
        <GroveText TextStyle="TextStyle.H5" Text="@L("Link your account")" />
        <GroveText TextStyle="TextStyle.Body2" Text="@string.Format(CultureInfo.CurrentCulture, L("An account with this email already exists ({0}). Enter its password to sign in with {1} from now on."), Pending.LinkUserName ?? string.Empty, Pending.ProviderDisplayName)" />
        <GroveFormField Text="@L("Password")" Style="width: 100%;"><GrovePassword @bind-Value="Password" Style="width: 100%;" data-testid="external-login-password" /></GroveFormField>
        <GroveButton Text="@L("Link and sign in")" Click="LinkAsync" Disabled="@(Busy || !RendererInfo.IsInteractive)" data-testid="external-login-link" />
    }
    else if (Pending.RegistrationDisabled)
    {
        <GroveText TextStyle="TextStyle.Body1" Text="@L("New registrations are disabled for this site.")" />
    }
    else
    {
        <GroveText TextStyle="TextStyle.H5" Text="@string.Format(CultureInfo.CurrentCulture, L("Register with {0}"), Pending.ProviderDisplayName)" />
        @if (!Pending.NoUsername)
        {
            <GroveFormField Text="@L("User name")" Style="width: 100%;"><GroveTextBox @bind-Value="UserName" Style="width: 100%;" data-testid="external-login-username" /></GroveFormField>
        }
        @if (!Pending.NoEmail)
        {
            <GroveFormField Text="@L("Email")" Style="width: 100%;"><GroveTextBox @bind-Value="Email" Style="width: 100%;" data-testid="external-login-email" /></GroveFormField>
        }
        @if (!Pending.NoPassword)
        {
            <GroveFormField Text="@L("Password")" Style="width: 100%;"><GrovePassword @bind-Value="Password" Style="width: 100%;" data-testid="external-login-new-password" /></GroveFormField>
            <GroveFormField Text="@L("Confirm the password")" Style="width: 100%;"><GrovePassword @bind-Value="ConfirmPassword" Style="width: 100%;" /></GroveFormField>
        }
        <GroveButton Text="@L("Register")" Click="RegisterAsync" Disabled="@(Busy || !RendererInfo.IsInteractive)" data-testid="external-login-register" />
    }

    @foreach (var error in Errors)
    {
        <GroveText TextStyle="TextStyle.Caption" Text="@error" Style="color: var(--grove-color-danger, #b3261e);" data-testid="external-login-error" />
    }
</GroveStack>

@code {
    /// <summary>"register" (a new account) or "link" (the existing account with the same email).</summary>
    [Parameter]
    public string Mode { get; set; } = "register";

    [Parameter]
    public string? ReturnUrl { get; set; }

    /// <summary>A refusal the callback already met (an auto-registration that failed).</summary>
    [Parameter]
    public string? Error { get; set; }

    private PendingExternalLogin? Pending { get; set; }
    private bool Loaded { get; set; }
    private bool Busy { get; set; }
    private string? UserName { get; set; }
    private string? Email { get; set; }
    private string? Password { get; set; }
    private string? ConfirmPassword { get; set; }
    private string[] Errors { get; set; } = [];
    private bool IsLink => string.Equals(Mode, "link", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        Errors = string.IsNullOrEmpty(Error) ? [] : [Error];
        Pending = await AccountApi.GetAsync<PendingExternalLogin>(Http, $"{AccountApi.Root}/external-login");
        Loaded = true;
        UserName = Pending?.UserName;
        Email = Pending?.Email;
    }

    private Task RegisterAsync() => CompleteAsync("register", new { UserName, Email, Password, ConfirmPassword });

    private Task LinkAsync() => CompleteAsync("link", new { Password });

    private async Task CompleteAsync(string action, object body)
    {
        Busy = true;
        try
        {
            var query = string.IsNullOrEmpty(ReturnUrl) ? string.Empty : $"?returnUrl={Uri.EscapeDataString(ReturnUrl)}";
            var result = await AccountApi.SendAsync<ExternalLoginResult>(Http, HttpMethod.Post, $"{AccountApi.Root}/external-login/{action}{query}", body);
            Errors = result?.Errors ?? [L("The sign-in could not be completed.")];

            // A signed-in account, or a login veto that redirects (a member portal, a pending
            // confirmation): a new document, since the session changed.
            if (result?.Redirect is { Length: > 0 } redirect && (result.Succeeded || Errors.Length == 0))
            {
                Navigation.NavigateTo(redirect, forceLoad: true);
            }
        }
        finally
        {
            Busy = false;
        }
    }

    private string L(string text) => (Services.GetService(typeof(ILocalizer)) as ILocalizer)?.Get(text, CultureInfo.CurrentUICulture) ?? text;
}

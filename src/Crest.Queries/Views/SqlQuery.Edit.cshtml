@using System.Text.Json
@using Crest.Infrastructure
@model Crest.Queries.Sql.ViewModels.SqlQueryViewModel

@{
    var queryEditorOptions = new
    {
        indentWithTabs = true,
        smartIndent = true,
        matchBrackets = true,
        styleActiveLine = true,
        extraKeys = new Dictionary<string, string> { ["Ctrl-Space"] = "autocomplete" },
        hintOptions = new { tables = new Dictionary<string, string[]> { ["ContentItemIndex"] = ["DocumentId"] } },
    };
}

<style asp-name="codemirror"></style>
<style asp-name="codemirror-addon-hint-show-hint"></style>
<script asp-name="codemirror-addon-selection-active-line" at="Foot"></script>
<script asp-name="codemirror-addon-hint-sql-hint" at="Foot"></script>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="ReturnDocuments" checked="@Model.ReturnDocuments" />
            <label class="form-check-label" asp-for="ReturnDocuments">@T["Return Documents"]</label>
            <span class="hint dashed">@T["Check to return the corresponding documents."]</span>
        </div>
        <span class="hint">@T["When checked, the result has to be a list of document ids."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="alert alert-info" role="alert">
            @T["The query is parsed as written; Liquid is not allowed. Values are bound as SQL parameters (for example '@name' or '@name:default') passed in by the caller, and the caller's scope is applied to every table before the query runs."]
        </div>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Query">
    <label asp-for="Query" class="ocat-label">@T["Query"]</label>
    <div class="ocat-end">
        <textarea asp-for="Query" rows="12" class="form-control codemirror-query-editor" data-mode="@MediaTypeNamesExtended.Text.PostgreSQL" data-options="@JsonSerializer.Serialize(queryEditorOptions)"></textarea>
        <span asp-validation-for="Query"></span>
        <span class="hint">@T["The SQL query to execute."]</span>
    </div>
</div>

<script asp-src="~/Crest.Queries/Scripts/sql-query/sql-query.min.js" debug-src="~/Crest.Queries/Scripts/sql-query/sql-query.js" at="Foot" type="module"></script>

<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Grove.Display.Icons</AssemblyName>
    <RootNamespace>Grove.Display.Icons</RootNamespace>
    <!-- Generates this library's component catalog (Grove.Display.Management.Abstractions' buildTransitive targets). -->
    <ComponentCatalog>true</ComponentCatalog>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Providers\TenantMedia\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Content Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grove.Display.Icons.Iconify\Grove.Display.Icons.Iconify.csproj" />
    <ProjectReference Include="..\Grove.Display.Components\Grove.Display.Components.csproj" />
  </ItemGroup>
</Project>

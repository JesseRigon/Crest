<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- NuGet properties-->
    <Title>Target for Grove Theme</Title>
    <Description>$(OCCMSDescription)

    Converts project/library into an Grove Theme that can be referenced in Grove CMS application.</Description>
    <PackageTags>$(PackageTags) PlatformCMS</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    Add the necessary '.props' and '.targets' files under the 'build\' folder of this package,
    so that a referencing project is built / packed and considered as an 'Grove' theme.

    When packaging a project that references this package, and that targets multiple TFMs, the
    scripts under the 'build\' folder are not executed, so we pack another '.props' file under
    the 'buildMultiTargeting\' folder, that will just import the one under the `build\` folder.
  -->

  <ItemGroup>
    <None Include="Grove.Theme.Targets.props" Pack="true">
      <PackagePath>build\Grove.Theme.Targets.props</PackagePath>
    </None>
    <None Include="buildMultiTargeting\Grove.Theme.Targets.props" Pack="true">
      <PackagePath>buildMultiTargeting\Grove.Theme.Targets.props</PackagePath>
    </None>
    <None Include="Grove.Theme.Targets.targets" Pack="true">
      <PackagePath>build\Grove.Theme.Targets.targets</PackagePath>
    </None>
    <None Include="buildMultiTargeting\Grove.Theme.Targets.targets" Pack="true">
      <PackagePath>buildMultiTargeting\Grove.Theme.Targets.targets</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Grove.Module.Targets\Grove.Module.Targets.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>

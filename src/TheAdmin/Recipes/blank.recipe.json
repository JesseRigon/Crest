{
  "name": "Blank",
  "displayName": "Blank site",
  "description": "Creates a blank site with content management features.",
  "author": "The Grove Team",
  "website": "https://orchardcore.net",
  "version": "1.0.0",
  "issetuprecipe": true,
  "categories": [ "default" ],
  "tags": [ "blank" ],

  // The variables are evaluated the first time they are accessed, and reused across steps
  "variables": {
    // "now": "[js: new Date().toISOString()]"
  },

  "steps": [
    {
      "name": "feature",
      "enable": [
        // SaaS
        "Grove.HomeRoute",
        "Grove.Admin",
        "Grove.Diagnostics",
        "Grove.DynamicCache",
        "Grove.Features",
        "Grove.Navigation",
        "Grove.Recipes",
        "Grove.Resources",
        "Grove.Roles",
        "Grove.Security",
        "Grove.Settings",
        "Grove.Themes",
        "Grove.Users",

        // Content Management
        "Grove.Alias",
        "Grove.Autoroute",
        "Grove.Html",
        "Grove.ContentFields",
        "Grove.ContentPreview",
        "Grove.Contents",
        "Grove.ContentTypes",
        "Grove.CustomSettings",
        "Grove.Deployment",
        "Grove.Deployment.Remote",
        "Grove.Flows",
        "Grove.Indexing",
        "Grove.Layers",
        "Grove.Lists",
        "Grove.Markdown",
        "Grove.Media",
        "Grove.Menu",
        "Grove.Queries",
        "Grove.Shortcodes.Templates",
        "Grove.Title",
        "Grove.Templates",

        // Themes
        "TheAdmin"
      ]
    },
    {
      "name": "themes",
      "admin": "TheAdmin",
      "site": ""
    },
    {
      "name": "Roles",
      "Roles": [
        {
          "Name": "Moderator",
          "Description": "Grants users the ability to moderate content.",
          "Permissions": []
        },
        {
          "Name": "Editor",
          "Description": "Grants users the ability to edit existing content.",
          "Permissions": []
        },
        {
          "Name": "Author",
          "Description": "Grants users the ability to create content.",
          "Permissions": []
        },
        {
          "Name": "Contributor",
          "Description": "Grants users the ability to contribute content.",
          "Permissions": []
        }
      ]
    }
  ]
}

{
  "name": "Headless",
  "displayName": "Headless site",
  "description": "Creates a headless site with content management, GraphQL, and OpenId features.",
  "author": "The Grove Team",
  "website": "https://orchardcore.net",
  "version": "1.0.0",
  "issetuprecipe": true,
  "categories": [ "default" ],
  "tags": [ "headless" ],

  // The variables are evaluated the first time they are accessed, and reused across steps
  "variables": {
    // "now": "[js: new Date().toISOString()]"
  },

  "steps": [
    {
      "name": "feature",
      "enable": [
        // SaaS
        "Grove.HomeRoute",
        "Grove.Admin",
        "Grove.Diagnostics",
        "Grove.Features",
        "Grove.Navigation",
        "Grove.Recipes",
        "Grove.Resources",
        "Grove.Roles",
        "Grove.Security",
        "Grove.Settings",
        "Grove.Themes",
        "Grove.Users",

        // Content Management
        "Grove.Alias",
        "Grove.Html",
        "Grove.ContentFields",
        "Grove.Contents",
        "Grove.ContentTypes",
        "Grove.CustomSettings",
        "Grove.Deployment",
        "Grove.Deployment.Remote",
        "Grove.Apis.GraphQL",
        "Grove.Flows",
        "Grove.Indexing",
        "Grove.Layers",
        "Grove.Lists",
        "Grove.Markdown",
        "Grove.Media",
        "Grove.Menu",
        "Grove.OpenId",
        "Grove.OpenId.Management",
        "Grove.OpenId.Server",
        "Grove.OpenId.Validation",
        "Grove.Queries",
        "Grove.Title",

        // Themes
        "TheAdmin"
      ]
    },
    {
      "name": "Roles",
      "Roles": [
        {
          "Name": "Moderator",
          "Description": "Grants users the ability to moderate content.",
          "Permissions": []
        },
        {
          "Name": "Editor",
          "Description": "Grants users the ability to edit existing content.",
          "Permissions": []
        },
        {
          "Name": "Author",
          "Description": "Grants users the ability to create content.",
          "Permissions": []
        },
        {
          "Name": "Contributor",
          "Description": "Grants users the ability to contribute content.",
          "Permissions": []
        },
        {
          "Name": "Authenticated",
          "Description": "A system role representing all authenticated users.",
          "Permissions": [
            "ViewContent",
            "ExecuteGraphQL",
            "ExecuteApiAll"
          ]
        }
      ]
    },
    {
      "name": "settings",
      "HomeRoute": {
        "Action": "Index",
        "Controller": "Admin",
        "Area": "Grove.Admin"
      }
    },
    {
      "name": "themes",
      "admin": "TheAdmin",
      "site": ""
    }
  ]
}

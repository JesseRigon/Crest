<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Crest</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet properties-->
    <Title>Crest Server Abstractions</Title>
    <Description>$(OCCMSDescription)

    The contracts a module needs to register its surfaces with the server: the API endpoint
    registry (declared contributors and defined entries), the error contract and the request
    access helper; the page registry contracts.</Description>
    <PackageTags>$(PackageTags) PlatformCMS Abstractions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Crest.Abstractions\Crest.Abstractions.csproj" />
    <ProjectReference Include="..\Crest.Infrastructure.Abstractions\Crest.Infrastructure.Abstractions.csproj" />
    <ProjectReference Include="..\Crest.DisplayManagement.Abstractions\Crest.DisplayManagement.Abstractions.csproj" />
    <ProjectReference Include="..\Crest.Kinds\Crest.Kinds.csproj" />
  </ItemGroup>

</Project>

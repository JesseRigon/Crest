@using Grove.Display.Components.Primitives.Documents.Spreadsheet
@using Grove.Display.Components.Primitives.Rendering

@namespace Grove.Display.Components.Primitives.Spreadsheet
<li class="@Class">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        <div class="rz-navigation-item-wrapper" @onclick=@OnClickAsync>
            <div class="rz-navigation-item-link">
                <i class="notranslate rzi rz-navigation-item-icon" aria-hidden="true">@Icon</i>
                <span class="rz-navigation-item-text">@Text</span>
            </div>
        </div>
    }
</li>
@code {
    [Parameter]
    public EventCallback Click { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter] 
    public string? Icon { get; set; }

    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private string Class => ClassList.Create("rz-navigation-item").AddDisabled(Disabled).ToString();

    private async Task OnClickAsync()
    {
        if (!Disabled)
        {
            await Click.InvokeAsync();
        }
    }
}

@namespace Grove.Display.Components.Model
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Nodes
@using Grove.Display.Components.Forms
@using Grove.Display.Components.Models
@using Grove.Display.Components.Primitives
@inject HttpClient Http

<GroveCard class="grove-content-item-editor">
    <GroveStack Gap="1rem">
        <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
            <div>
                <GroveText TextStyle="TextStyle.H6" class="rz-m-0">@EditorTitle</GroveText>
                @if (Model?.ContentItem is not null)
                {
                    <GroveText TextStyle="TextStyle.Caption" class="rz-color-secondary">@Model.ContentItem.ContentType · @Model.ContentItem.ContentItemId</GroveText>
                }
            </div>
            <GroveStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                <GroveButton Icon="refresh" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small" Click="LoadAsync" Disabled="IsBusy" title="Reload" />
                @if (ShowClose)
                {
                    <GroveButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small" Click="CloseAsync" title="Close" />
                }
            </GroveStack>
        </GroveStack>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <GroveAlert AlertStyle="AlertStyle.Danger" Summary="Content item action failed" Detail="@Error" />
        }

        @if (IsLoading)
        {
            <GroveProgressBar Mode="ProgressBarMode.Indeterminate" />
        }
        else if (Model?.ContentItem is null)
        {
            <GroveText TextStyle="TextStyle.Body2" class="rz-color-secondary">Select a content item to edit.</GroveText>
        }
        else
        {
            <GroveStack Gap="0.75rem">
                <GroveFormField Text="Display text" Style="width: 100%;">
                    <GroveTextBox @bind-Value="DisplayText" Style="width: 100%;" Disabled="IsSaving" />
                </GroveFormField>

                <GroveFormManager @ref="FormManager" Content="EditableContent" Metadata="Model.ContentItem.Metadata" Disabled="IsSaving" />

                <GroveFieldset Text="Advanced JSON preview" AllowCollapse="true" Collapsed="true">
                    <GroveTextArea Value="@ContentJson" Rows="12" Style="width: 100%; font-family: monospace;" ReadOnly="true" />
                </GroveFieldset>

                @if (ConfirmDelete)
                {
                    <GroveAlert AlertStyle="AlertStyle.Warning" Summary="Confirm delete" Detail="This removes the content item from latest/published listings. Click Delete again to confirm." />
                }

                <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                    <GroveButton Icon="save" Text="Save draft" ButtonStyle="ButtonStyle.Primary" Click="SaveAsync" Disabled="IsSaving" />
                    <GroveButton Icon="publish" Text="Publish" ButtonStyle="ButtonStyle.Secondary" Click="PublishAsync" Disabled="IsSaving" />
                    <GroveButton Icon="content_copy" Text="Duplicate" ButtonStyle="ButtonStyle.Light" Click="DuplicateAsync" Disabled="IsSaving" />
                    <GroveButton Icon="delete" Text="Delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="DeleteAsync" Disabled="IsSaving" />
                </GroveStack>
            </GroveStack>
        }
    </GroveStack>
</GroveCard>

@code {
    [Parameter] public string? ContentItemId { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool ShowClose { get; set; } = true;
    [Parameter] public EventCallback Closed { get; set; }
    [Parameter] public EventCallback<GroveModel> Saved { get; set; }
    [Parameter] public EventCallback<GroveModel> Duplicated { get; set; }
    [Parameter] public EventCallback<string> Deleted { get; set; }

    private GroveModel? Model { get; set; }
    private string? DisplayText { get; set; }
    private JsonNode? EditableContent { get; set; }
    private string ContentJson => EditableContent?.ToJsonString(new JsonSerializerOptions { WriteIndented = true }) ?? string.Empty;
    private string? LoadedContentItemId { get; set; }
    private bool IsLoading { get; set; }
    private bool IsSaving { get; set; }
    private bool ConfirmDelete { get; set; }
    private string? Error { get; set; }
    private GroveFormManager? FormManager { get; set; }

    private bool IsBusy => IsLoading || IsSaving;

    private string EditorTitle => !string.IsNullOrWhiteSpace(Title)
        ? Title!
        : Model?.ContentItem?.DisplayText ?? "Edit content item";

    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(LoadedContentItemId, ContentItemId, StringComparison.Ordinal))
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        LoadedContentItemId = ContentItemId;
        Model = null;
        DisplayText = null;
        EditableContent = null;
        ConfirmDelete = false;
        Error = null;

        if (string.IsNullOrWhiteSpace(ContentItemId))
        {
            return;
        }

        IsLoading = true;
        try
        {
            var item = await Http.GetFromJsonAsync<GroveContentItem>($"api/grove/content-items/{Uri.EscapeDataString(ContentItemId)}");
            if (item?.Metadata is null && !string.IsNullOrWhiteSpace(item?.ContentType))
            {
                // The content-items API returns raw items; the definition-driven form
                // derives its editor metadata from the content-type definition.
                var definition = await Http.GetFromJsonAsync<JsonNode>($"api/grove/content-types/{Uri.EscapeDataString(item.ContentType)}");
                item = item with { Metadata = GroveContentTypeMetadata.FromTypeDefinition(definition) };
            }

            Model = GroveModel.FromContentItem(item);
            DisplayText = Model?.ContentItem?.DisplayText;
            EditableContent = Model?.ContentItem?.Content?.DeepClone();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SaveAsync() => await SaveAsync(publish: false);

    private async Task PublishAsync() => await SaveAsync(publish: true);

    private async Task SaveAsync(bool publish)
    {
        if (string.IsNullOrWhiteSpace(ContentItemId))
        {
            return;
        }

        if (FormManager?.Validate() == false)
        {
            return;
        }

        var contentType = Model?.ContentItem?.ContentType;
        if (string.IsNullOrWhiteSpace(contentType))
        {
            return;
        }

        var savedItem = await SendJsonAsync<GroveContentItem>(HttpMethod.Put, $"api/grove/content-items/{Uri.EscapeDataString(ContentItemId)}",
            new UpdateGroveContentItemRequest(contentType, DisplayText, EditableContent?.DeepClone() as JsonObject, publish));
        if (savedItem is { Metadata: null })
        {
            // Keep the already-derived editor metadata; the write response is raw.
            savedItem = savedItem with { Metadata = Model?.ContentItem?.Metadata };
        }

        var saved = GroveModel.FromContentItem(savedItem);
        if (saved is not null)
        {
            Model = saved;
            DisplayText = saved.ContentItem?.DisplayText;
            EditableContent = saved.ContentItem?.Content?.DeepClone();
            await Saved.InvokeAsync(saved);
        }
    }

    private async Task DuplicateAsync()
    {
        if (string.IsNullOrWhiteSpace(ContentItemId))
        {
            return;
        }

        // The content-items API has no duplicate endpoint: duplicate = create a new
        // draft of the same type carrying a copy of the loaded content.
        var source = Model?.ContentItem;
        if (source?.ContentType is null)
        {
            return;
        }

        var duplicatedItem = await SendJsonAsync<GroveContentItem>(HttpMethod.Post, "api/grove/content-items",
            new CreateGroveContentItemRequest(source.ContentType, $"{source.DisplayText} (copy)", EditableContent?.DeepClone() as JsonObject));
        var duplicate = GroveModel.FromContentItem(duplicatedItem);
        if (duplicate is not null)
        {
            await Duplicated.InvokeAsync(duplicate);
        }
    }

    private async Task DeleteAsync()
    {
        if (string.IsNullOrWhiteSpace(ContentItemId))
        {
            return;
        }

        if (!ConfirmDelete)
        {
            ConfirmDelete = true;
            return;
        }

        using var response = await SendAsync(HttpMethod.Delete, $"api/grove/content-items/{Uri.EscapeDataString(ContentItemId)}", null);
        if (response.IsSuccessStatusCode)
        {
            var deletedId = ContentItemId;
            Model = null;
            LoadedContentItemId = null;
            ConfirmDelete = false;
            await Deleted.InvokeAsync(deletedId);
        }
    }

    private async Task CloseAsync() => await Closed.InvokeAsync();

    private async Task<T?> SendJsonAsync<T>(HttpMethod method, string url, object? body)
    {
        using var response = await SendAsync(method, url, body);
        return response.IsSuccessStatusCode
            ? await response.Content.ReadFromJsonAsync<T>()
            : default;
    }

    private async Task<HttpResponseMessage> SendAsync(HttpMethod method, string url, object? body)
    {
        IsSaving = true;
        Error = null;

        try
        {
            var request = new HttpRequestMessage(method, url);

            if (body is not null)
            {
                request.Content = JsonContent.Create(body);
            }

            // The antiforgery token is added by the HttpClient's own handler
            // (AntiforgeryHandler) for every unsafe request. Adding it here too
            // produced a comma-joined pair of tokens in the header, which the server
            // cannot parse - the request failed validation with a bodiless 400.
            var response = await Http.SendAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                Error = await response.Content.ReadAsStringAsync();
            }

            return response;
        }
        catch (Exception ex)
        {
            Error = ex.Message;
            throw;
        }
        finally
        {
            IsSaving = false;
        }
    }

}

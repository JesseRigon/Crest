@using System.Globalization
@using Grove.Display.Components.Primitives
@using Grove.Display.Components.Primitives.Spreadsheet
@using Grove.Display.Components.Primitives.Documents.Spreadsheet
@inherits SpreadsheetDialogBase

@namespace Grove.Display.Components.Primitives.Spreadsheet.Tools
<GroveStack Gap="1rem" Style="min-width: 350px">
    <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
        <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_RuleType)) Component="ruleType" class="rz-text-subtitle2"
                    Style="width: 8rem; text-align: end" />
        <GroveDropDown @bind-Value=@RuleType Data=@RuleTypes TextProperty="Name" ValueProperty="Value" Name="ruleType"
                       Style="flex: 1" />
    </GroveStack>

    @if (RuleType == ConditionalFormatRuleType.GreaterThan || RuleType == ConditionalFormatRuleType.LessThan || RuleType
    == ConditionalFormatRuleType.EqualTo)
    {
        <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
            <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_Value)) Component="value" class="rz-text-subtitle2"
                        Style="width: 8rem; text-align: end" />
            <GroveTextBox @bind-Value=@Value1 Name="value" Style="flex: 1" />
        </GroveStack>
    }

    @if (RuleType == ConditionalFormatRuleType.Between)
    {
        <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
            <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_Minimum)) Component="minimum" class="rz-text-subtitle2"
                        Style="width: 8rem; text-align: end" />
            <GroveTextBox @bind-Value=@Value1 Name="minimum" Style="flex: 1" />
        </GroveStack>
        <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
            <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_Maximum)) Component="maximum" class="rz-text-subtitle2"
                        Style="width: 8rem; text-align: end" />
            <GroveTextBox @bind-Value=@Value2 Name="maximum" Style="flex: 1" />
        </GroveStack>
    }

    @if (RuleType == ConditionalFormatRuleType.TextContains)
    {
        <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
            <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_Text)) Component="text" class="rz-text-subtitle2"
                        Style="width: 8rem; text-align: end" />
            <GroveTextBox @bind-Value=@Value1 Name="text" Style="flex: 1" />
        </GroveStack>
    }

    <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
        <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_BackgroundColor)) Component="backgroundColor"
                    class="rz-text-subtitle2" Style="width: 8rem; text-align: end" />
        <GroveColorPicker @bind-Value=@BackgroundColor Name="backgroundColor" Style="flex: 1" />
    </GroveStack>

    <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
        <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_TextColor)) Component="textColor" class="rz-text-subtitle2"
                    Style="width: 8rem; text-align: end" />
        <GroveColorPicker @bind-Value=@TextColor Name="textColor" Style="flex: 1" />
    </GroveStack>

    <GroveStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem"
                class="rz-spreadsheet-dialog-actions">
        <GroveButton Text=@L(nameof(GroveStrings.Spreadsheet_Cancel)) Click=@OnCancel ButtonStyle="ButtonStyle.Base"
                     Variant="Variant.Outlined" />
        <GroveButton Text=@L(nameof(GroveStrings.Spreadsheet_OK)) Click=@OnOk ButtonStyle="ButtonStyle.Primary"
                     Variant="Variant.Flat" />
    </GroveStack>
</GroveStack>

@code {
#nullable enable
    [Parameter]
    public ConditionalFormatRuleType RuleType { get; set; } = ConditionalFormatRuleType.GreaterThan;

    private string Value1 { get; set; } = "";
    private string Value2 { get; set; } = "";
    private string BackgroundColor { get; set; } = "#FFEB9C";
    private string TextColor { get; set; } = "#9C5700";

    private List<DropDownItem<ConditionalFormatRuleType>>? ruleTypes;
    private List<DropDownItem<ConditionalFormatRuleType>> RuleTypes => ruleTypes ??=
    [
        new(L(nameof(GroveStrings.Spreadsheet_RuleGreaterThan)), ConditionalFormatRuleType.GreaterThan),
        new(L(nameof(GroveStrings.Spreadsheet_RuleLessThan)), ConditionalFormatRuleType.LessThan),
        new(L(nameof(GroveStrings.Spreadsheet_RuleBetween)), ConditionalFormatRuleType.Between),
        new(L(nameof(GroveStrings.Spreadsheet_RuleEqualTo)), ConditionalFormatRuleType.EqualTo),
        new(L(nameof(GroveStrings.Spreadsheet_RuleTextContains)), ConditionalFormatRuleType.TextContains)
    ];

    private void OnOk()
    {
        var format = new Format { BackgroundColor = BackgroundColor, Color = TextColor };
        ConditionalFormatBase? rule = RuleType switch
        {
            ConditionalFormatRuleType.GreaterThan when double.TryParse(Value1, NumberStyles.Any, Culture, out var v) =>
                new GreaterThanRule { Value = v, Format = format },
            ConditionalFormatRuleType.LessThan when double.TryParse(Value1, NumberStyles.Any, Culture, out var v) =>
                new LessThanRule { Value = v, Format = format },
            ConditionalFormatRuleType.Between when double.TryParse(Value1, NumberStyles.Any, Culture, out var min) &&
                double.TryParse(Value2, NumberStyles.Any, Culture, out var max) =>
                new BetweenRule { Minimum = min, Maximum = max, Format = format },
            ConditionalFormatRuleType.EqualTo => new EqualToRule { Value = Value1, Format = format },
            ConditionalFormatRuleType.TextContains => new TextContainsRule { Text = Value1, Format = format },
            _ => null
        };

        if (rule is not null)
        {
            DialogService.Close(rule);
        }
    }


    private sealed class DropDownItem<T>(string name, T value)
    {
        public string Name { get; } = name;
        public T Value { get; } = value;
    }
}

@using Grove.Display.Components.Primitives.Documents.Spreadsheet
@inherits GroveSpreadsheetFormatToggleToolBase

@namespace Grove.Display.Components.Primitives.Spreadsheet.Tools
<GroveToggleButton AriaLabel=@(Spreadsheet?.Localize(nameof(GroveStrings.Spreadsheet_TextWrap))) title=@(Spreadsheet?.Localize(nameof(GroveStrings.Spreadsheet_TextWrap))) Value=@IsToggled ValueChanged=@OnToggledChangedAsync Icon="wrap_text" Disabled=@IsDisabled Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
    ToggleVariant="Variant.Flat" ToggleButtonStyle="ButtonStyle.Primary" ToggleShade="Shade.Lighter" />

@code {
    protected override bool GetValue(Format format) => format.WrapText;
    protected override Format WithValue(Format format, bool value) => format.WithWrapText(value);
}

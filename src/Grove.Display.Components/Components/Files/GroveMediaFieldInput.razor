@namespace Grove.Display.Components.Files
@using System.Globalization
@using System.Text.Json.Nodes
@using Grove.Display.Components.Primitives
@inject IServiceProvider Services

@* A media field's value edited with the drive-aware picker: placement ids are stored
   (ruling F1), position for position with the field's paths, texts and anchors; a file picked
   from outside the media library has no library path, so its path is empty and the id decides. *@

<div class="grove-media-field" data-testid="media-field-input">
    @if (Items.Count == 0)
    {
        <span class="grove-media-field__empty">@L("No files chosen.")</span>
    }
    else
    {
        <ul>
            @for (var i = 0; i < Items.Count; i++)
            {
                var index = i;
                <li>
                    <span>@Items[index].Label</span>
                    <GroveButton Size="ButtonSize.ExtraSmall" Variant="Variant.Text" Icon="arrow_upward" Disabled="@(Disabled || index == 0)" Click="@(() => MoveAsync(index, -1))" title="@L("Move up")" />
                    <GroveButton Size="ButtonSize.ExtraSmall" Variant="Variant.Text" Icon="delete" Disabled="@Disabled" Click="@(() => RemoveAsync(index))" title="@L("Remove")" />
                </li>
            }
        </ul>
    }
    <GroveButton Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Icon="attach_file" Text="@L("Choose a file")" Disabled="@Disabled" Click="@(() => PickerOpen = true)" />
    <GroveDrivePicker @bind-Open="PickerOpen" Picked="AddAsync" />
</div>

@code {
    /// <summary>The stored field (<c>Paths</c>, <c>PlacementIds</c>, <c>MediaTexts</c>, <c>Anchors</c>).</summary>
    [Parameter] public JsonObject? Value { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>A property of the field changed: its name and new array.</summary>
    [Parameter] public EventCallback<(string Property, JsonArray Value)> Changed { get; set; }

    private bool PickerOpen;
    private readonly Dictionary<string, string> _names = new(StringComparer.Ordinal);

    private static readonly string[] Parallel = ["Paths", "PlacementIds", "MediaTexts", "Anchors"];

    private sealed record Entry(string? Id, string? Path, string Label);

    private List<Entry> Items
    {
        get
        {
            var ids = Strings("PlacementIds");
            var paths = Strings("Paths");
            var count = Math.Max(ids.Count, paths.Count);
            return [.. Enumerable.Range(0, count).Select(index =>
            {
                var id = index < ids.Count ? ids[index] : null;
                var path = index < paths.Count ? paths[index] : null;
                var label = !string.IsNullOrEmpty(path) ? path! : id is not null && _names.TryGetValue(id, out var name) ? name : id ?? string.Empty;
                return new Entry(id, path, label);
            })];
        }
    }

    private List<string?> Strings(string property) =>
        Value?[property] is JsonArray array ? [.. array.Select(node => node?.GetValue<string>())] : [];

    private async Task AddAsync(GroveFileItem item)
    {
        _names[item.Id] = item.Name;
        var count = Items.Count;
        foreach (var property in Parallel)
        {
            var values = Strings(property);
            if (values.Count == 0 && property is "MediaTexts" or "Anchors")
            {
                continue;
            }

            while (values.Count < count)
            {
                values.Add(property == "Anchors" ? null : string.Empty);
            }

            values.Add(property switch
            {
                "PlacementIds" => item.Id,
                "Paths" => string.Empty,
                "MediaTexts" => item.Metadata.AlternativeText ?? string.Empty,
                _ => null,
            });
            await SetAsync(property, values);
        }
    }

    private async Task RemoveAsync(int index)
    {
        foreach (var property in Parallel)
        {
            var values = Strings(property);
            if (index < values.Count)
            {
                values.RemoveAt(index);
                await SetAsync(property, values);
            }
        }
    }

    private async Task MoveAsync(int index, int by)
    {
        var target = index + by;
        foreach (var property in Parallel)
        {
            var values = Strings(property);
            if (index < values.Count && target >= 0 && target < values.Count)
            {
                (values[index], values[target]) = (values[target], values[index]);
                await SetAsync(property, values);
            }
        }
    }

    private Task SetAsync(string property, List<string?> values) =>
        Changed.InvokeAsync((property, new JsonArray([.. values.Select(value => (JsonNode?)JsonValue.Create(value))])));

    private string L(string text) => (Services.GetService(typeof(ILocalizer)) as ILocalizer)?.Get(text, CultureInfo.CurrentUICulture) ?? text;
}

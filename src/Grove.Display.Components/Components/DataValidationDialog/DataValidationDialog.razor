@using System.Globalization
@using Grove.Display.Components.Primitives
@using Grove.Display.Components.Primitives.Spreadsheet
@using Grove.Display.Components.Primitives.Documents.Spreadsheet
@inherits SpreadsheetDialogBase

@namespace Grove.Display.Components.Primitives.Spreadsheet.Tools
<GroveStack Gap="0.5rem" Style="min-width: 400px">
    <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
        <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_ValidationType)) Component="validationType"
                    class="rz-text-subtitle2" Style="width: 8rem; text-align: end" />
        <GroveDropDown @bind-Value=@ValidationType Data=@ValidationTypes TextProperty="Name" ValueProperty="Value"
                       Name="validationType" InputSize="InputSize.Small" Style="flex: 1" Change=@OnTypeChanged />
    </GroveStack>

    @if (ValidationType != DataValidationType.List && ValidationType != DataValidationType.Custom)
    {
        <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
            <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_Operator)) Component="operator" class="rz-text-subtitle2"
                        Style="width: 8rem; text-align: end" />
            <GroveDropDown @bind-Value=@Operator Data=@Operators TextProperty="Name" ValueProperty="Value" Name="operator"
                           InputSize="InputSize.Small" Style="flex: 1" />
        </GroveStack>
    }

    @if (ValidationType == DataValidationType.Custom)
    {
        <GroveStack Orientation="Orientation.Vertical" Gap="0.25rem">
            <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_Formula)) Component="formula" class="rz-text-subtitle2"
                        Style="align-self: start" />
            <GroveTextBox @bind-Value=@Formula1 Name="formula" InputSize="InputSize.Small" Style="width: 100%" />
        </GroveStack>
    }
    else if (ValidationType == DataValidationType.List)
    {
        <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Start">
            <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_ValuesCommaSeparated)) Component="valuesList"
                        class="rz-text-subtitle2" Style="width: 8rem; text-align: end" />
            <GroveTextArea @bind-Value=@Formula1 Name="valuesList" Rows="3" InputSize="InputSize.Small" Style="flex: 1" />
        </GroveStack>
    }
    else if (Operator == DataValidationOperator.Between || Operator == DataValidationOperator.NotBetween)
    {
        @if (ValidationType == DataValidationType.Date)
        {
            <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_Minimum)) Component="minimum" class="rz-text-subtitle2"
                            Style="width: 8rem; text-align: end" />
                <GroveDatePicker @bind-Value=@Formula1Date DateFormat="yyyy-MM-dd" Name="minimum" InputSize="InputSize.Small"
                                 Style="flex: 1" />
            </GroveStack>
            <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_Maximum)) Component="maximum" class="rz-text-subtitle2"
                            Style="width: 8rem; text-align: end" />
                <GroveDatePicker @bind-Value=@Formula2Date DateFormat="yyyy-MM-dd" Name="maximum" InputSize="InputSize.Small"
                                 Style="flex: 1" />
            </GroveStack>
        }
        else if (ValidationType == DataValidationType.Time)
        {
            <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_Minimum)) Component="minimum" class="rz-text-subtitle2"
                            Style="width: 8rem; text-align: end" />
                <GroveDatePicker @bind-Value=@Formula1Date ShowTime="true" TimeOnly="true" Name="minimum"
                                 InputSize="InputSize.Small" Style="flex: 1" />
            </GroveStack>
            <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_Maximum)) Component="maximum" class="rz-text-subtitle2"
                            Style="width: 8rem; text-align: end" />
                <GroveDatePicker @bind-Value=@Formula2Date ShowTime="true" TimeOnly="true" Name="maximum"
                                 InputSize="InputSize.Small" Style="flex: 1" />
            </GroveStack>
        }
        else
        {
            <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_Minimum)) Component="minimum" class="rz-text-subtitle2"
                            Style="width: 8rem; text-align: end" />
                <GroveTextBox @bind-Value=@Formula1 Name="minimum" InputSize="InputSize.Small" Style="flex: 1" />
            </GroveStack>
            <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_Maximum)) Component="maximum" class="rz-text-subtitle2"
                            Style="width: 8rem; text-align: end" />
                <GroveTextBox @bind-Value=@Formula2 Name="maximum" InputSize="InputSize.Small" Style="flex: 1" />
            </GroveStack>
        }
    }
    else
    {
        @if (ValidationType == DataValidationType.Date)
        {
            <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_Value)) Component="value" class="rz-text-subtitle2"
                            Style="width: 8rem; text-align: end" />
                <GroveDatePicker @bind-Value=@Formula1Date DateFormat="yyyy-MM-dd" Name="value" InputSize="InputSize.Small"
                                 Style="flex: 1" />
            </GroveStack>
        }
        else if (ValidationType == DataValidationType.Time)
        {
            <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_Value)) Component="value" class="rz-text-subtitle2"
                            Style="width: 8rem; text-align: end" />
                <GroveDatePicker @bind-Value=@Formula1Date ShowTime="true" TimeOnly="true" Name="value"
                                 InputSize="InputSize.Small" Style="flex: 1" />
            </GroveStack>
        }
        else
        {
            <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_Value)) Component="value" class="rz-text-subtitle2"
                            Style="width: 8rem; text-align: end" />
                <GroveTextBox @bind-Value=@Formula1 Name="value" InputSize="InputSize.Small" Style="flex: 1" />
            </GroveStack>
        }
    }

    <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"
                Style="padding-inline-start: 8.5rem">
        <GroveCheckBox @bind-Value=@AllowBlank TValue="bool" Name="allowBlank" />
        <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_AllowBlank)) Component="allowBlank"
                    class="rz-text-subtitle2" />
    </GroveStack>

    <GroveFieldset Text=@L(nameof(GroveStrings.Spreadsheet_ErrorAlert))>
        <GroveStack Gap="0.5rem">
            <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_Style)) Component="errorStyle"
                            class="rz-text-subtitle2" Style="width: 7rem; text-align: end" />
                <GroveDropDown @bind-Value=@ErrorStyle Data=@ErrorStyles TextProperty="Name" ValueProperty="Value"
                               Name="errorStyle" InputSize="InputSize.Small" Style="flex: 1" />
            </GroveStack>
            <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_Title)) Component="errorTitle"
                            class="rz-text-subtitle2" Style="width: 7rem; text-align: end" />
                <GroveTextBox @bind-Value=@ErrorTitle Name="errorTitle" InputSize="InputSize.Small" Style="flex: 1" />
            </GroveStack>
            <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Start">
                <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_Message)) Component="errorMessage"
                            class="rz-text-subtitle2" Style="width: 7rem; text-align: end" />
                <GroveTextArea @bind-Value=@ErrorMessage Name="errorMessage" Rows="2" InputSize="InputSize.Small"
                               Style="flex: 1" />
            </GroveStack>
        </GroveStack>
    </GroveFieldset>

    <GroveFieldset Text=@L(nameof(GroveStrings.Spreadsheet_InputPrompt))>
        <GroveStack Gap="0.5rem">
            <GroveStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"
                        Style="padding-inline-start: 7.5rem">
                <GroveCheckBox @bind-Value=@ShowInputMessage TValue="bool" Name="showInputMessage" />
                <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_ShowInputMessage)) Component="showInputMessage"
                            class="rz-text-subtitle2" />
            </GroveStack>
            <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_Title)) Component="inputTitle"
                            class="rz-text-subtitle2" Style="width: 7rem; text-align: end" />
                <GroveTextBox @bind-Value=@InputTitle Name="inputTitle" InputSize="InputSize.Small" Style="flex: 1" />
            </GroveStack>
            <GroveStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Start">
                <GroveLabel Text=@L(nameof(GroveStrings.Spreadsheet_Message)) Component="inputMessage"
                            class="rz-text-subtitle2" Style="width: 7rem; text-align: end" />
                <GroveTextArea @bind-Value=@InputMessage Name="inputMessage" Rows="2" InputSize="InputSize.Small"
                               Style="flex: 1" />
            </GroveStack>
        </GroveStack>
    </GroveFieldset>

    <GroveStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem"
                class="rz-spreadsheet-dialog-actions">
        <GroveButton Text=@L(nameof(GroveStrings.Spreadsheet_Cancel)) Click=@OnCancel ButtonStyle="ButtonStyle.Base"
                     Variant="Variant.Outlined" />
        <GroveButton Text=@L(nameof(GroveStrings.Spreadsheet_OK)) Click=@OnOk ButtonStyle="ButtonStyle.Primary"
                     Variant="Variant.Flat" />
    </GroveStack>
</GroveStack>

@code {
#nullable enable
    private DataValidationType ValidationType { get; set; } = DataValidationType.WholeNumber;
    private DataValidationOperator Operator { get; set; } = DataValidationOperator.Between;
    private string Formula1 { get; set; } = "";
    private string Formula2 { get; set; } = "";
    private bool AllowBlank { get; set; } = true;
    private DataValidationErrorStyle ErrorStyle { get; set; } = DataValidationErrorStyle.Stop;
    private string ErrorTitle { get; set; } = "";
    private string ErrorMessage { get; set; } = "";
    private bool ShowInputMessage { get; set; }
    private string InputTitle { get; set; } = "";
    private string InputMessage { get; set; } = "";
    private DateTime? Formula1Date { get; set; }
    private DateTime? Formula2Date { get; set; }

    protected override void OnInitialized()
    {
        ErrorMessage = L(nameof(GroveStrings.Spreadsheet_DefaultValidationError));
    }

    private List<DropDownItem<DataValidationType>>? validationTypes;
    private List<DropDownItem<DataValidationType>> ValidationTypes => validationTypes ??=
    [
        new(L(nameof(GroveStrings.Spreadsheet_ValidationWholeNumber)), DataValidationType.WholeNumber),
        new(L(nameof(GroveStrings.Spreadsheet_ValidationDecimal)), DataValidationType.Decimal),
        new(L(nameof(GroveStrings.Spreadsheet_ValidationList)), DataValidationType.List),
        new(L(nameof(GroveStrings.Spreadsheet_ValidationDate)), DataValidationType.Date),
        new(L(nameof(GroveStrings.Spreadsheet_ValidationTime)), DataValidationType.Time),
        new(L(nameof(GroveStrings.Spreadsheet_ValidationTextLength)), DataValidationType.TextLength),
        new(L(nameof(GroveStrings.Spreadsheet_ValidationCustom)), DataValidationType.Custom)
    ];

    private List<DropDownItem<DataValidationOperator>>? allOperators;
    private List<DropDownItem<DataValidationOperator>> AllOperators => allOperators ??=
    [
        new(L(nameof(GroveStrings.Spreadsheet_OperatorBetween)), DataValidationOperator.Between),
        new(L(nameof(GroveStrings.Spreadsheet_OperatorNotBetween)), DataValidationOperator.NotBetween),
        new(L(nameof(GroveStrings.Spreadsheet_OperatorEqualTo)), DataValidationOperator.Equal),
        new(L(nameof(GroveStrings.Spreadsheet_OperatorNotEqualTo)), DataValidationOperator.NotEqual),
        new(L(nameof(GroveStrings.Spreadsheet_OperatorGreaterThan)), DataValidationOperator.GreaterThan),
        new(L(nameof(GroveStrings.Spreadsheet_OperatorLessThan)), DataValidationOperator.LessThan),
        new(L(nameof(GroveStrings.Spreadsheet_OperatorGreaterThanOrEqual)), DataValidationOperator.GreaterThanOrEqual),
        new(L(nameof(GroveStrings.Spreadsheet_OperatorLessThanOrEqual)), DataValidationOperator.LessThanOrEqual)
    ];

    private List<DropDownItem<DataValidationErrorStyle>>? errorStyles;
    private List<DropDownItem<DataValidationErrorStyle>> ErrorStyles => errorStyles ??=
    [
        new(L(nameof(GroveStrings.Spreadsheet_ErrorStyleStop)), DataValidationErrorStyle.Stop),
        new(L(nameof(GroveStrings.Spreadsheet_ErrorStyleWarning)), DataValidationErrorStyle.Warning),
        new(L(nameof(GroveStrings.Spreadsheet_ErrorStyleInformation)), DataValidationErrorStyle.Information)
    ];

    private List<DropDownItem<DataValidationOperator>> Operators => AllOperators;

    private void OnTypeChanged()
    {
        if (ValidationType == DataValidationType.List)
        {
            Operator = DataValidationOperator.Equal;
        }
    }

    private void OnOk()
    {
        var formula1 = Formula1;
        var formula2 = Formula2;

        if (ValidationType == DataValidationType.Date)
        {
            if (Formula1Date.HasValue)
            {
                formula1 = Formula1Date.Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
            }
            if (Formula2Date.HasValue)
            {
                formula2 = Formula2Date.Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
            }
        }
        else if (ValidationType == DataValidationType.Time)
        {
            if (Formula1Date.HasValue)
            {
                formula1 = (Formula1Date.Value.TimeOfDay.TotalDays).ToString(CultureInfo.InvariantCulture);
            }
            if (Formula2Date.HasValue)
            {
                formula2 = (Formula2Date.Value.TimeOfDay.TotalDays).ToString(CultureInfo.InvariantCulture);
            }
        }
        else if (ValidationType is DataValidationType.WholeNumber or DataValidationType.Decimal or
DataValidationType.TextLength)
        {
            // Bounds are typed in the workbook culture but stored as canonical invariant fragments.
            formula1 = NormalizeNumericBound(formula1);
            formula2 = NormalizeNumericBound(formula2);
        }
        else if (ValidationType == DataValidationType.Custom && formula1.StartsWith('='))
        {
            formula1 = FormulaLocalizer.ToInvariant(formula1, Culture);
        }

        var rule = new DataValidationRule
        {
            Type = ValidationType,
            Operator = Operator,
            Formula1 = formula1,
            Formula2 = formula2,
            AllowBlank = AllowBlank,
            ErrorStyle = ErrorStyle,
            ErrorTitle = string.IsNullOrEmpty(ErrorTitle) ? null : ErrorTitle,
            Error = string.IsNullOrEmpty(ErrorMessage) ? L(nameof(GroveStrings.Spreadsheet_DefaultValidationError)) : ErrorMessage,
            ShowErrorMessage = true,
            ShowInputMessage = ShowInputMessage,
            InputTitle = string.IsNullOrEmpty(InputTitle) ? null : InputTitle,
            InputMessage = string.IsNullOrEmpty(InputMessage) ? null : InputMessage
        };

        DialogService.Close(rule);
    }

    private string NormalizeNumericBound(string value)
    {
        if (string.IsNullOrEmpty(value) || value.StartsWith('='))
        {
            return value;
        }

        return ToInvariantNumber(value);
    }

    private sealed class DropDownItem<T>(string name, T value)
    {
        public string Name { get; } = name;
        public T Value { get; } = value;
    }
}

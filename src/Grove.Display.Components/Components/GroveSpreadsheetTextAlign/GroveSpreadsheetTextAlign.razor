@using Grove.Display.Components.Primitives.Spreadsheet
@using Grove.Display.Components.Primitives.Documents.Spreadsheet
@implements IDisposable

@namespace Grove.Display.Components.Primitives.Spreadsheet.Tools
<GroveSelectBar Value=@CurrentTextAlign ValueChanged=@OnTextAlignChangedAsync TValue="Grove.Display.Components.Primitives.TextAlign" Disabled=@IsDisabled Size="ButtonSize.Small">
    <Items>
        <GroveSelectBarItem Value=@Grove.Display.Components.Primitives.TextAlign.Left Icon="format_align_left" AriaLabel=@(Spreadsheet?.Localize(nameof(GroveStrings.Spreadsheet_AlignLeft))) />
        <GroveSelectBarItem Value=@Grove.Display.Components.Primitives.TextAlign.Center Icon="format_align_center" AriaLabel=@(Spreadsheet?.Localize(nameof(GroveStrings.Spreadsheet_AlignCenter))) />
        <GroveSelectBarItem Value=@Grove.Display.Components.Primitives.TextAlign.Right Icon="format_align_right" AriaLabel=@(Spreadsheet?.Localize(nameof(GroveStrings.Spreadsheet_AlignRight))) />
    </Items>
</GroveSelectBar>

@code {
#nullable enable

    [CascadingParameter]
    public Worksheet? Worksheet { get; set; }

    [CascadingParameter]
    public ISpreadsheet? Spreadsheet { get; set; }

    private Grove.Display.Components.Primitives.TextAlign CurrentTextAlign
    {
        get
        {
            if (Worksheet?.Cells.TryGet(Worksheet.Selection.Cell.Row, Worksheet.Selection.Cell.Column, out var cell) == true)
            {
                return cell.Format.TextAlign ?? Grove.Display.Components.Primitives.TextAlign.Left;
            }
            return Grove.Display.Components.Primitives.TextAlign.Left;
        }
    }

    private async Task OnTextAlignChangedAsync(Grove.Display.Components.Primitives.TextAlign value)
    {
        if (Worksheet is null || Worksheet.Selection.Cell == CellRef.Invalid || Spreadsheet is null)
        {
            return;
        }

        if (!Worksheet.Cells.TryGet(Worksheet.Selection.Cell.Row, Worksheet.Selection.Cell.Column, out var cell))
        {
            return;
        }

        var command = new FormatCommand(Worksheet, Worksheet.Selection.Range, cell.Format.WithTextAlign(value));
        await Spreadsheet.ExecuteAsync(command);
    }

    private bool IsDisabled
        => Worksheet?.Selection.Cell == CellRef.Invalid
        || Spreadsheet?.IsFeatureAllowed(SpreadsheetFeature.CellFormatting) == false;

    private readonly EventBinding<Selection> selectionBinding;

    public GroveSpreadsheetTextAlign()
    {
        selectionBinding = new EventBinding<Selection>(
            s => s.Changed += OnSelectionChanged,
            s => s.Changed -= OnSelectionChanged);
    }

    protected override void OnParametersSet()
    {
        selectionBinding.Bind(Worksheet?.Selection);
    }

    private void OnSelectionChanged()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        selectionBinding.Dispose();
    }
}

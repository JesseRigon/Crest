@using Grove.Display.Components.Primitives.Spreadsheet
@using Grove.Display.Components.Primitives.Documents.Spreadsheet
@implements IDisposable

@namespace Grove.Display.Components.Primitives.Spreadsheet.Tools
<GroveSelectBar Value=@CurrentVerticalAlign ValueChanged=@OnVerticalAlignChangedAsync TValue="Grove.Display.Components.Primitives.VerticalAlign" Disabled=@IsDisabled Size="ButtonSize.Small">
    <Items>
        <GroveSelectBarItem Value=@Grove.Display.Components.Primitives.VerticalAlign.Top Icon="align_vertical_top" AriaLabel=@(Spreadsheet?.Localize(nameof(GroveStrings.Spreadsheet_AlignTop))) />
        <GroveSelectBarItem Value=@Grove.Display.Components.Primitives.VerticalAlign.Middle Icon="align_vertical_center" AriaLabel=@(Spreadsheet?.Localize(nameof(GroveStrings.Spreadsheet_AlignMiddle))) />
        <GroveSelectBarItem Value=@Grove.Display.Components.Primitives.VerticalAlign.Bottom Icon="align_vertical_bottom" AriaLabel=@(Spreadsheet?.Localize(nameof(GroveStrings.Spreadsheet_AlignBottom))) />
    </Items>
</GroveSelectBar>

@code {
#nullable enable

    [CascadingParameter]
    public Worksheet? Worksheet { get; set; }

    [CascadingParameter]
    public ISpreadsheet? Spreadsheet { get; set; }

    private Grove.Display.Components.Primitives.VerticalAlign CurrentVerticalAlign
    {
        get
        {
            if (Worksheet?.Cells.TryGet(Worksheet.Selection.Cell.Row, Worksheet.Selection.Cell.Column, out var cell) == true)
            {
                return cell.Format.VerticalAlign ?? Grove.Display.Components.Primitives.VerticalAlign.Top;
            }
            return Grove.Display.Components.Primitives.VerticalAlign.Top;
        }
    }

    private async Task OnVerticalAlignChangedAsync(Grove.Display.Components.Primitives.VerticalAlign value)
    {
        if (Worksheet is null || Worksheet.Selection.Cell == CellRef.Invalid || Spreadsheet is null)
        {
            return;
        }

        if (!Worksheet.Cells.TryGet(Worksheet.Selection.Cell.Row, Worksheet.Selection.Cell.Column, out var cell))
        {
            return;
        }

        var command = new FormatCommand(Worksheet, Worksheet.Selection.Range, cell.Format.WithVerticalAlign(value));
        await Spreadsheet.ExecuteAsync(command);
    }

    private bool IsDisabled
        => Worksheet?.Selection.Cell == CellRef.Invalid
        || Spreadsheet?.IsFeatureAllowed(SpreadsheetFeature.CellFormatting) == false;

    private readonly EventBinding<Selection> selectionBinding;

    public GroveSpreadsheetVerticalAlign()
    {
        selectionBinding = new EventBinding<Selection>(
            s => s.Changed += OnSelectionChanged,
            s => s.Changed -= OnSelectionChanged);
    }

    protected override void OnParametersSet()
    {
        selectionBinding.Bind(Worksheet?.Selection);
    }

    private void OnSelectionChanged()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        selectionBinding.Dispose();
    }
}

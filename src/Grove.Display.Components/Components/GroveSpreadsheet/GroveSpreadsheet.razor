@using Grove.Display.Components.Overlay
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Grove.Display.Components.Primitives
@using Grove.Display.Components.Primitives.Spreadsheet
@using Grove.Display.Components.Primitives.Documents.Spreadsheet
@using Grove.Display.Components.Primitives.Rendering
@inject DialogService DialogService
@inject ContextMenuService ContextMenuService
@inherits GroveComponent

@namespace Grove.Display.Components.Primitives
<div @ref=@Element class=@GetCssClass() style=@Style tabindex="0" @attributes=@Attributes id=@GetId() role="application"
     aria-label=@(AriaLabel ?? Localize(nameof(GroveStrings.Spreadsheet_A11yGridLabel))) aria-keyshortcuts="F6 Shift+F6"
     aria-describedby=@($"{GetId()}-a11y-instructions")>
    <CascadingValue TValue="ISpreadsheet" Value=this IsFixed="true">
        <CascadingValue Value=@Worksheet TValue="Worksheet">
            <CascadingValue Value=@ActiveView?.Commands TValue="UndoRedoStack">
                @if (ShowToolbar)
                {
                    <GroveTabs SelectedIndex=@SelectedToolsetIndex SelectedIndexChanged=@SelectedToolsetIndexChanged>
                        <Tabs>
                            @if (ChildContent != null)
                            {
                                @ChildContent
                            }
                            else
                            {
                                <GroveTabsItem Text=@Localize(nameof(GroveStrings.Spreadsheet_FileTab))>
                                    <GroveStack class="rz-toolbar" role="group"
                                                aria-label=@Localize(nameof(GroveStrings.Spreadsheet_FileTab))
                                                Orientation="Orientation.Horizontal" Gap="0.125rem" AlignItems="AlignItems.Center">
                                        <GroveSpreadsheetOpen CsvImportOptions=@CsvImportOptions />
                                        <div class="rz-toolbar-separator"></div>
                                        <GroveSpreadsheetSave FileName=@ExportFileName CsvExportOptions=@CsvExportOptions />
                                    </GroveStack>
                                </GroveTabsItem>
                                <GroveTabsItem Text=@Localize(nameof(GroveStrings.Spreadsheet_HomeTab))>
                                    <GroveStack class="rz-toolbar" role="group"
                                                aria-label=@Localize(nameof(GroveStrings.Spreadsheet_HomeTab))
                                                Orientation="Orientation.Horizontal" Gap="0.125rem" AlignItems="AlignItems.Center">
                                        <GroveStack Orientation="Orientation.Horizontal" Gap="0.125rem"
                                                    AlignItems="AlignItems.Center">
                                            <GroveSpreadsheetUndo />
                                            <GroveSpreadsheetRedo />
                                        </GroveStack>
                                        <div class="rz-toolbar-separator"></div>
                                        <GroveStack Orientation="Orientation.Horizontal" Gap="0.125rem"
                                                    AlignItems="AlignItems.Center">
                                            <GroveSpreadsheetFontFamily />
                                            <GroveSpreadsheetFontSize />
                                        </GroveStack>
                                        <div class="rz-toolbar-separator"></div>
                                        <GroveStack Orientation="Orientation.Horizontal" Gap="0.125rem"
                                                    AlignItems="AlignItems.Center">
                                            <GroveSpreadsheetBold />
                                            <GroveSpreadsheetItalic />
                                            <GroveSpreadsheetUnderline />
                                            <GroveSpreadsheetStrikethrough />
                                            <GroveSpreadsheetColor />
                                            <GroveSpreadsheetBackgroundColor />
                                            <GroveSpreadsheetCellBorders />
                                        </GroveStack>
                                        <div class="rz-toolbar-separator"></div>
                                        <GroveStack Orientation="Orientation.Horizontal" Gap="0.125rem"
                                                    AlignItems="AlignItems.Center">
                                            <GroveSpreadsheetTextAlign />
                                            <GroveSpreadsheetVerticalAlign />
                                            <GroveSpreadsheetTextWrap />
                                            <GroveSpreadsheetMergeCells />
                                        </GroveStack>
                                        <div class="rz-toolbar-separator"></div>
                                        <GroveStack Orientation="Orientation.Horizontal" Gap="0.125rem"
                                                    AlignItems="AlignItems.Center">
                                            <GroveSpreadsheetConditionalFormat />
                                        </GroveStack>
                                    </GroveStack>
                                </GroveTabsItem>
                                <GroveTabsItem Text=@Localize(nameof(GroveStrings.Spreadsheet_FormatTab))>
                                    <GroveStack class="rz-toolbar" role="group"
                                                aria-label=@Localize(nameof(GroveStrings.Spreadsheet_FormatTab))
                                                Orientation="Orientation.Horizontal" Gap="0.125rem" AlignItems="AlignItems.Center">
                                        <GroveSpreadsheetDataFormat />
                                        <GroveSpreadsheetIncreaseDecimals />
                                        <GroveSpreadsheetDecreaseDecimals />
                                        <div class="rz-toolbar-separator"></div>
                                        <GroveButton Text=@Localize(nameof(GroveStrings.Spreadsheet_FormatCells))
                                                     Click=@OnFormatCellsAsync Variant="Variant.Text" ButtonStyle="ButtonStyle.Base"
                                                     Size="ButtonSize.Small" Disabled=@(Worksheet?.Selection.Cell == CellRef.Invalid ||
                                                                                         !IsFeatureAllowed(SpreadsheetFeature.CellFormatting)) />
                                    </GroveStack>
                                </GroveTabsItem>
                                <GroveTabsItem Text=@Localize(nameof(GroveStrings.Spreadsheet_InsertTab))>
                                    <GroveStack class="rz-toolbar" role="group"
                                                aria-label=@Localize(nameof(GroveStrings.Spreadsheet_InsertTab))
                                                Orientation="Orientation.Horizontal" Gap="0.125rem" AlignItems="AlignItems.Center">
                                        <GroveStack Orientation="Orientation.Horizontal" Gap="0.125rem"
                                                    AlignItems="AlignItems.Center">
                                            <GroveSpreadsheetInsertRowAfter />
                                            <GroveSpreadsheetInsertRowBefore />
                                        </GroveStack>
                                        <div class="rz-toolbar-separator"></div>
                                        <GroveStack Orientation="Orientation.Horizontal" Gap="0.125rem"
                                                    AlignItems="AlignItems.Center">
                                            <GroveSpreadsheetInsertColumnAfter />
                                            <GroveSpreadsheetInsertColumnBefore />
                                        </GroveStack>
                                        <div class="rz-toolbar-separator"></div>
                                        <GroveStack Orientation="Orientation.Horizontal" Gap="0.125rem"
                                                    AlignItems="AlignItems.Center">
                                            <GroveSpreadsheetInsertHyperlink />
                                            <GroveSpreadsheetInsertImage />
                                            <GroveSpreadsheetInsertTable />
                                            <GroveSpreadsheetInsertChart />
                                        </GroveStack>
                                    </GroveStack>
                                </GroveTabsItem>
                                <GroveTabsItem Text=@Localize(nameof(GroveStrings.Spreadsheet_ViewTab))>
                                    <GroveStack class="rz-toolbar" role="group"
                                                aria-label=@Localize(nameof(GroveStrings.Spreadsheet_ViewTab))
                                                Orientation="Orientation.Horizontal" Gap="0.125rem" AlignItems="AlignItems.Center">
                                        <GroveSpreadsheetFreeze />
                                    </GroveStack>
                                </GroveTabsItem>
                                <GroveTabsItem Text=@Localize(nameof(GroveStrings.Spreadsheet_DataTab))>
                                    <GroveStack class="rz-toolbar" role="group"
                                                aria-label=@Localize(nameof(GroveStrings.Spreadsheet_DataTab))
                                                Orientation="Orientation.Horizontal" Gap="0.125rem" AlignItems="AlignItems.Center">
                                        <GroveSpreadsheetAutoFilter />
                                        <GroveSpreadsheetCustomSort />
                                        <div class="rz-toolbar-separator"></div>
                                        <GroveSpreadsheetDataValidation />
                                    </GroveStack>
                                </GroveTabsItem>
                                <GroveSpreadsheetTableDesignToolset />
                            }
                        </Tabs>
                    </GroveTabs>
                    <GroveButton Icon="help" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base"
                                 Size="ButtonSize.ExtraSmall"
                                 Style="position: absolute; inset-block-start: 0.25rem; inset-inline-end: 0.25rem; z-index: 1"
                                 Click=@(_ => OpenShortcutsHelpAsync())
                                 title=@Localize(nameof(GroveStrings.Spreadsheet_HelpShowShortcuts))
                                 aria-label=@Localize(nameof(GroveStrings.Spreadsheet_HelpShowShortcuts)) />
                }
                @if (Worksheet != null)
                {
                    <span id=@($"{GetId()}-a11y-instructions")
                          class="rz-sr-only">@Localize(nameof(GroveStrings.Spreadsheet_A11yInstructions))</span>
                    <SpreadsheetAccessibility @ref=@accessibility Worksheet=@Worksheet Spreadsheet=this />
                    <CascadingValue Value="@CellTypes">
                        @if (ShowFormulaBar)
                        {
                            <FormulaEditor Worksheet=@Worksheet Editor=@Editor />
                        }
                        <VirtualGrid @ref=@grid style="flex: 1" View=@ActiveView>
                            <Template>
                                @switch (context)
                                {
                                    case VirtualCorner corner:
                                        <CornerHeaderCell Rect=@context.Rect />
                                        break;
                                    case VirtualColumnHeader column:
                                        <ColumnHeader Worksheet=@Worksheet FrozenState=@column.FrozenState Column=@column.Column
                                                      Rect=@context.Rect />
                                        break;
                                    case VirtualRowHeader row:
                                        <RowHeader Worksheet=@Worksheet FrozenState=@row.FrozenState Row=@row.Row
                                                   Rect=@context.Rect />
                                        break;
                                    case VirtualDataItem item:
                                        <CellView Worksheet=@Worksheet Column=@item.Column Row=@item.Row
                                                  FrozenState=@item.FrozenState Rect=@context.Rect Toggle=@OnCellToggleAsync />
                                        break;
                                    case VirtualHorizontalSplitter horizontalSplitter:
                                        <Splitter class="rz-spreadsheet-horizontal-splitter" Rect=@horizontalSplitter.Rect />
                                        break;
                                    case VirtualVerticalSplitter verticalSplitter:
                                        <Splitter class="rz-spreadsheet-vertical-splitter" Rect=@verticalSplitter.Rect />
                                        break;
                                }
                            </Template>
                            <ChildContent>
                                <SelectionOverlay Worksheet=@Worksheet Context=@context />
                                <AutofillOverlay Worksheet=@Worksheet Context=@context />
                                <ImageOverlay Worksheet=@Worksheet Context=@context />
                                <ChartOverlay Worksheet=@Worksheet Context=@context />
                                <CellEditor Worksheet=@Worksheet Editor=@Editor Context=@context />
                                @foreach (var table in Worksheet.Tables)
                                {
                                    <TableFrame Worksheet=@Worksheet Table=@table Context=@context />
                                }
                                <InputPrompt Worksheet=@Worksheet Context=@context />
                                <ValidationError Worksheet=@Worksheet Context=@context />
                            </ChildContent>
                        </VirtualGrid>
                        @if (ShowSheetTabs)
                        {
                            <div class="rz-spreadsheet-sheet-tabs">
                                <GroveButton Icon="add" Click=@OnAddSheetAsync Variant="Variant.Text"
                                             ButtonStyle="ButtonStyle.Base" Size="ButtonSize.ExtraSmall" class="rz-spreadsheet-add-sheet"
                                             Disabled=@ReadOnly />
                                <GroveTabs SelectedIndex=@sheetIndex Change=@OnSheetTabChanged RenderMode="TabRenderMode.Server"
                                           TabPosition="TabPosition.Bottom">
                                    <Tabs>
                                        @for (var i = 0; i < workbook!.Sheets.Count; i++)
                                        {
                                            var sheet = workbook.Sheets[i];
                                            <GroveTabsItem Text=@sheet.Name>
                                                <Template Context="tab">
                                                    <GroveSplitButton Text=@sheet.Name Click=@(item => OnSheetAction(item, sheet))
                                                                      ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                                                                      Size="ButtonSize.ExtraSmall">
                                                        <ChildContent>
                                                            <GroveSplitButtonItem
                                                            Text=@Localize(nameof(GroveStrings.Spreadsheet_Rename))
                                                            Value="rename" Icon="edit" Disabled=@ReadOnly />
                                                            <GroveSplitButtonItem
                                                            Text=@Localize(nameof(GroveStrings.Spreadsheet_Delete))
                                                            Value="delete" Icon="delete" Disabled=@(ReadOnly ||
                                                                                                                workbook.Sheets.Count <= 1) />
                                        <GroveSplitButtonItem
                                        Text=@Localize(nameof(GroveStrings.Spreadsheet_MoveLeft))
                                        Value="move-left" Icon="chevron_left" Disabled=@(ReadOnly ||
                                                                                            workbook.IndexOf(sheet) == 0) />
                                        <GroveSplitButtonItem
                                        Text=@Localize(nameof(GroveStrings.Spreadsheet_MoveRight))
                                        Value="move-right" Icon="chevron_right" Disabled=@(ReadOnly ||
                                                                                            workbook.IndexOf(sheet) == workbook.Sheets.Count - 1) />
                                    </ChildContent>
                                </GroveSplitButton>
                            </Template>
                        </GroveTabsItem>
                    }
                </Tabs>
            </GroveTabs>
        </div>
    }
    <GrovePopup @ref=@cellMenuPopup class="rz-spreadsheet-cell-popup rz-context-menu" Lazy="true">
        @if (cellMenuRow >= 0 && cellMenuColumn >= 0)
        {
            <CellMenu Worksheet=@Worksheet Row=@cellMenuRow Column=@cellMenuColumn
                      Cancel=@OnCellMenuCancelAsync Apply=@OnCellMenuApplyAsync SortAscending=@(() =>
                                                  OnCellMenuSortAsync(SortOrder.Ascending)) SortDescending=@(() =>
                                                  OnCellMenuSortAsync(SortOrder.Descending)) Clear=@OnCellMenuClearAsync
                      CustomFilter=@OnCellMenuCustomFilterAsync Top10Filter=@OnCellMenuTop10FilterAsync
                      DynamicFilter=@OnCellMenuDynamicFilterAsync />
        }
    </GrovePopup>
    <GrovePopup @ref=@validationListPopup class="rz-spreadsheet-cell-popup" Lazy="true">
        @if (validationListItems.Count > 0)
        {
            <ValidationListPopup Items=@validationListItems Value=@GetValidationListValue()
                                 ValueSelected=@OnValidationListValueSelectedAsync />
        }
    </GrovePopup>
</CascadingValue>
}
</CascadingValue>
</CascadingValue>
</CascadingValue>
<RangePickerBar @ref=@rangePickerBar CancelTitle=@Localize(nameof(GroveStrings.Spreadsheet_Cancel)) />
</div>

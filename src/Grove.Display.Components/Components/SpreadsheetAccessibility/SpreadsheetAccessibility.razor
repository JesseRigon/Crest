@using Grove.Display.Components.Primitives

@namespace Grove.Display.Components.Primitives.Spreadsheet
@* Three live regions, present (empty) from first render. nav = cell navigation, action = transient
   action results, alert = assertive validation/error messages. *@
<GroveLiveRegion Text=@navText />
<GroveLiveRegion Text=@actionText />
<GroveLiveRegion Text=@alertText Assertive="true" />

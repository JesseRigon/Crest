<Project>
  <!--
    Every project lives under src/: the platform (the projects imported from OrchardCore) and
    Grove's own modules side by side. src/Grove.Build/Platform.Projects.props lists the platform projects by kind, and
    this file gives them the platform's build settings: Commons (versioning, package metadata,
    the source generators), the analyzer configuration, and the module or theme targets. Grove's
    own projects import the module/theme props themselves and get none of the platform settings.
  -->
  <Import Project="src\Grove.Build\Platform.Projects.props" />
  <PropertyGroup>
    <!-- Grove's modules reference the platform's projects through this, never by relative path. -->
    <PlatformSrcDir>$(MSBuildThisFileDirectory)src\</PlatformSrcDir>
    <_ProjectKey>;$(MSBuildProjectName);</_ProjectKey>
    <_PlatformKind Condition="$(PlatformLibraryProjects.Contains('$(_ProjectKey)'))">Library</_PlatformKind>
    <_PlatformKind Condition="$(PlatformModuleProjects.Contains('$(_ProjectKey)'))">Module</_PlatformKind>
    <_PlatformKind Condition="$(PlatformThemeProjects.Contains('$(_ProjectKey)'))">Theme</_PlatformKind>
    <_PlatformKind Condition="$(PlatformHostProjects.Contains('$(_ProjectKey)'))">Host</_PlatformKind>
    <_PlatformKind Condition="'$(_PlatformKind)' == '' And $(MSBuildProjectDirectory.Replace('\','/').StartsWith('$(MSBuildThisFileDirectory.Replace('\','/'))test/'))">Test</_PlatformKind>
    <_IsPlatformProject Condition="'$(_PlatformKind)' != ''">true</_IsPlatformProject>
  </PropertyGroup>
  <Import Project="src\Grove.Build\Platform.Build.props" Condition="'$(_IsPlatformProject)' == 'true'" />
  <ItemGroup Condition="'$(_IsPlatformProject)' == 'true'">
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)src\Grove.Build\Platform.globalconfig" />
  </ItemGroup>
  <Import Project="src\Grove.Build\Grove.Commons.props" Condition="'$(_PlatformKind)' == 'Library' Or '$(_PlatformKind)' == 'Module' Or '$(_PlatformKind)' == 'Theme'" />
  <Import Project="src\Grove.Theme.Targets\Grove.Theme.Targets.props" Condition="'$(_PlatformKind)' == 'Theme'" />
  <Import Project="src\Grove.Module.Targets\Grove.Module.Targets.props" Condition="'$(_PlatformKind)' == 'Module' Or '$(_PlatformKind)' == 'Theme'" />
  <PropertyGroup Condition="'$(_PlatformKind)' == 'Library' Or '$(_PlatformKind)' == 'Module' Or '$(_PlatformKind)' == 'Theme'">
    <TargetFrameworks>$(CommonTargetFrameworks)</TargetFrameworks>
  </PropertyGroup>
</Project>

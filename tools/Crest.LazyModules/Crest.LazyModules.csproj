<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build-time tool for the host app's WASM entry project (build/Crest.LazyModules.targets).
       Packed as a build-only package: the targets in build/, the tool in tools/net10.0/, no lib/
       and no dependencies - a host references it with PrivateAssets="all" and nothing of it
       reaches the app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="build\Crest.LazyModules.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

  <Target Name="PackCrestLazyModulesTool" BeforeTargets="_GetPackageFiles" DependsOnTargets="Build">
    <ItemGroup>
      <None Include="$(TargetPath);$(TargetDir)$(TargetName).runtimeconfig.json;$(TargetDir)$(TargetName).deps.json" Pack="true" PackagePath="tools\net10.0" />
    </ItemGroup>
  </Target>
</Project>

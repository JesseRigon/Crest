<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(PlatformSrcDir)Crest.Module.Targets\Crest.Module.Targets.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Crest.ContentPartLists</AssemblyName>
    <RootNamespace>Crest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs;blazor-wasm/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(PlatformSrcDir)Crest.ContentFields\Crest.ContentFields.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Crest.ContentManagement\Crest.ContentManagement.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Crest.Contents\Crest.Contents.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Crest.Data\Crest.Data.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)Crest.Module.Targets\Crest.Module.Targets.csproj" />
    <PackageReference Include="YesSql.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- The picker abstraction (IOptionSourceProvider, OptionRow,
         CrestOptionSourceKeys) and OptionPickerField live in Crest.Server; this module
         plugs Content Part Lists in as one provider among several. -->
    <ProjectReference Include="../Crest.Server/Crest.Server.csproj" />
    <ProjectReference Include="../Crest.Global/Crest.Global.csproj" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk.Razor">
  <Import Project="$(PlatformSrcDir)OrchardCore\OrchardCore.Module.Targets\OrchardCore.Module.Targets.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Crest.Global</AssemblyName>
    <RootNamespace>Crest.Global</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs;blazor-wasm/**/*.cs" />
  </ItemGroup>

  <!-- The tenant-less reference-data store (plans/global.md). Host-level: the store is
       built once per process and shared by every shell, on Orchard's own
       DatabaseShellsSettingsSources pattern. OrchardCore.Data.YesSql is referenced for
       the provider extensions (UseSqLite/UsePostgreSql/...) and SqliteHelper. -->
  <ItemGroup>
    <ProjectReference Include="$(PlatformSrcDir)OrchardCore\OrchardCore.Data\OrchardCore.Data.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)OrchardCore\OrchardCore.Data.YesSql\OrchardCore.Data.YesSql.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)OrchardCore\OrchardCore.Module.Targets\OrchardCore.Module.Targets.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)OrchardCore.Modules\OrchardCore.Security\OrchardCore.Security.csproj" />
    <PackageReference Include="YesSql.Abstractions" />
  </ItemGroup>

  <Import Project="$(PlatformSrcDir)OrchardCore\OrchardCore.Module.Targets\OrchardCore.Module.Targets.targets" />
</Project>

<Project>
  <!-- Module pages load on demand. Every module client library (a blazor-wasm project) is
       lazy, with the assemblies only it needs; the admin router loads a route's module
       before it matches (Crest.Admin's CrestLazyModules), and a page region loads the
       modules that contribute to regions before it renders. Worked out at build time from
       the referenced assemblies' metadata by tools/Crest.LazyModules, so nothing is listed
       by hand:
       - lazy roots: every referenced blazor-wasm project, plus any assembly a module lists
         in its crest-lazy-assemblies.txt (a library it loads itself, e.g. the workflow designer);
       - kept eager: a module assembly declaring [CrestJSComponent] (JS components register
         at startup), and everything the app itself reaches;
       - framework and Microsoft.* assemblies always stay eager.
       Produces BlazorWebAssemblyLazyLoad items and CrestLazyModules.g.cs (routes, per-module
       dependencies, region contributors) that Program.cs hands to the loader. -->
  <PropertyGroup>
    <_CrestLazyTool>$(MSBuildThisFileDirectory)..\tools\Crest.LazyModules\Crest.LazyModules.csproj</_CrestLazyTool>
    <!-- The tool is run by the build, not deployed with the app. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <!-- Built before the app (restored with it); its output is run, not referenced. -->
  <ItemGroup>
    <ProjectReference Include="$(_CrestLazyTool)" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <CrestLazyAssemblyList Include="$(MSBuildThisFileDirectory)..\..\**\blazor-wasm\crest-lazy-assemblies.txt" />
  </ItemGroup>

  <Target Name="CrestLazyModules" AfterTargets="ResolveReferences" BeforeTargets="CoreCompile">
    <!-- Here, not at evaluation: IntermediateOutputPath is set after this file is imported. -->
    <PropertyGroup>
      <_CrestLazyDir>$(IntermediateOutputPath)CrestLazyModules/</_CrestLazyDir>
    </PropertyGroup>
    <MSBuild Projects="$(_CrestLazyTool)" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_CrestLazyToolOutput" />
    </MSBuild>
    <ReadLinesFromFile File="%(CrestLazyAssemblyList.FullPath)" Condition="'@(CrestLazyAssemblyList)' != ''">
      <Output TaskParameter="Lines" ItemName="_CrestExtraLazy" />
    </ReadLinesFromFile>
    <MakeDir Directories="$(_CrestLazyDir)" />
    <WriteLinesToFile File="$(_CrestLazyDir)references.txt" Lines="@(ReferencePath->'%(FullPath)|%(MSBuildSourceProjectFile)')" Overwrite="true" />
    <WriteLinesToFile File="$(_CrestLazyDir)extra.txt" Lines="@(_CrestExtraLazy)" Overwrite="true" />
    <Exec Command="dotnet &quot;@(_CrestLazyToolOutput)&quot; &quot;$(_CrestLazyDir)references.txt&quot; &quot;$(_CrestLazyDir)extra.txt&quot; $(AssemblyName) &quot;$(_CrestLazyDir)CrestLazyModules.g.cs&quot; &quot;$(_CrestLazyDir)lazy.txt&quot;" />
    <ReadLinesFromFile File="$(_CrestLazyDir)lazy.txt">
      <Output TaskParameter="Lines" ItemName="BlazorWebAssemblyLazyLoad" />
    </ReadLinesFromFile>
    <ItemGroup>
      <Compile Include="$(_CrestLazyDir)CrestLazyModules.g.cs" />
    </ItemGroup>
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk.Razor">
  <Import Project="$(PlatformSrcDir)OrchardCore\OrchardCore.Theme.Targets\OrchardCore.Theme.Targets.props" />
  <Import Project="$(PlatformSrcDir)OrchardCore\OrchardCore.Module.Targets\OrchardCore.Module.Targets.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Crest.MemberTheme</AssemblyName>
    <RootNamespace>Crest.MemberTheme</RootNamespace>
    <OrchardCoreCompatibilityVersion>4.0.0</OrchardCoreCompatibilityVersion>
    <CrestSecurityPatch>0</CrestSecurityPatch>
    <CrestBugPatch>0</CrestBugPatch>
    <CrestVersion>$(OrchardCoreCompatibilityVersion).$(CrestSecurityPatch).$(CrestBugPatch)</CrestVersion>
    <VersionPrefix>$(OrchardCoreCompatibilityVersion)</VersionPrefix>
    <PackageVersion>$(OrchardCoreCompatibilityVersion)</PackageVersion>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>
    <AssemblyInformationalVersion>$(CrestVersion)</AssemblyInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="wasm\**" />
    <Content Remove="wasm\**" />
    <EmbeddedResource Remove="wasm\**" />
    <None Remove="wasm\**" />
    <RazorGenerate Remove="wasm\**" />
    <RazorComponent Remove="wasm\**" />
    <Compile Remove="tests\**" />
    <Content Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Theme.Targets, not Module.Targets: sets ModuleType=Theme so IsTheme() is true at
         runtime and ThemeViewLocationExpanderProvider contributes this theme's Views/
         paths. Same note as Crest.AdminTheme.csproj. -->
    <ProjectReference Include="$(PlatformSrcDir)OrchardCore\OrchardCore.Theme.Targets\OrchardCore.Theme.Targets.csproj" />
    <ProjectReference Include="$(PlatformSrcDir)OrchardCore\OrchardCore.DisplayManagement\OrchardCore.DisplayManagement.csproj" />
  </ItemGroup>

  <Import Project="$(PlatformSrcDir)OrchardCore\OrchardCore.Module.Targets\OrchardCore.Module.Targets.targets" />
  <Import Project="$(PlatformSrcDir)OrchardCore\OrchardCore.Theme.Targets\OrchardCore.Theme.Targets.targets" />
</Project>

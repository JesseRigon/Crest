{
  "name": "Blank",
  "displayName": "Blank site",
  "description": "Creates a blank site with content management features.",
  "author": "The Crest Team",
  "website": "https://orchardcore.net",
  "version": "1.0.0",
  "issetuprecipe": true,
  "categories": [ "default" ],
  "tags": [ "blank" ],

  // The variables are evaluated the first time they are accessed, and reused across steps
  "variables": {
    // "now": "[js: new Date().toISOString()]"
  },

  "steps": [
    {
      "name": "feature",
      "enable": [
        // SaaS
        "Crest.HomeRoute",
        "Crest.Admin",
        "Crest.Diagnostics",
        "Crest.DynamicCache",
        "Crest.Features",
        "Crest.Navigation",
        "Crest.Recipes",
        "Crest.Resources",
        "Crest.Roles",
        "Crest.Security",
        "Crest.Settings",
        "Crest.Themes",
        "Crest.Users",

        // Content Management
        "Crest.Alias",
        "Crest.Autoroute",
        "Crest.Html",
        "Crest.ContentFields",
        "Crest.ContentPreview",
        "Crest.Contents",
        "Crest.ContentTypes",
        "Crest.CustomSettings",
        "Crest.Deployment",
        "Crest.Deployment.Remote",
        "Crest.Flows",
        "Crest.Indexing",
        "Crest.Layers",
        "Crest.Lists",
        "Crest.Markdown",
        "Crest.Media",
        "Crest.Menu",
        "Crest.Queries",
        "Crest.Shortcodes.Templates",
        "Crest.Title",
        "Crest.Templates",
        "Crest.Widgets",

        // Themes
        "TheAdmin"
      ]
    },
    {
      "name": "themes",
      "admin": "TheAdmin",
      "site": ""
    },
    {
      "name": "Roles",
      "Roles": [
        {
          "Name": "Moderator",
          "Description": "Grants users the ability to moderate content.",
          "Permissions": []
        },
        {
          "Name": "Editor",
          "Description": "Grants users the ability to edit existing content.",
          "Permissions": []
        },
        {
          "Name": "Author",
          "Description": "Grants users the ability to create content.",
          "Permissions": []
        },
        {
          "Name": "Contributor",
          "Description": "Grants users the ability to contribute content.",
          "Permissions": []
        }
      ]
    }
  ]
}

  <ItemGroup Label="Crest.Workflows (engine is vendored source under Crest.Workflows/engine; see its UPSTREAM.md)">
    <!-- Snappier 1.2.0 arrives transitively (IronCompress, via the engine) with a known
         vulnerability (GHSA-pggp-6c3x-2xmx); transitive pinning lifts it for every project
         that references the engine. Bump with the engine. -->
    <PackageVersion Include="Snappier" Version="1.3.1" />
    <PackageVersion Include="JetBrains.Annotations" Version="2025.2.2" />
    <PackageVersion Include="System.Linq.Dynamic.Core" Version="1.7.1" />
  </ItemGroup>

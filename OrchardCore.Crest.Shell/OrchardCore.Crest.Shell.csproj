<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The shell runtime: what every shell needs at boot, regardless of which shell a
       request is served by - the lazy-module loader and its per-shell manifests. Always
       eager: theme clients reference it, it references no theme, and a module library
       only ever reaches it through a theme client. Kept small on purpose, because every
       browser downloads it whatever shell it lands in. See plans/shells-and-themes.md,
       "The shell runtime is eager; shell UIs and module UIs load per shell". -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>OrchardCore.Crest.Shell</AssemblyName>
    <RootNamespace>Crest.Shell</RootNamespace>
    <OrchardCoreCompatibilityVersion>4.0.0</OrchardCoreCompatibilityVersion>
    <CrestSecurityPatch>0</CrestSecurityPatch>
    <CrestBugPatch>0</CrestBugPatch>
    <CrestVersion>$(OrchardCoreCompatibilityVersion).$(CrestSecurityPatch).$(CrestBugPatch)</CrestVersion>
    <VersionPrefix>$(OrchardCoreCompatibilityVersion)</VersionPrefix>
    <PackageVersion>$(OrchardCoreCompatibilityVersion)</PackageVersion>
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.0.0.0</FileVersion>
    <AssemblyInformationalVersion>$(CrestVersion)</AssemblyInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- LazyAssemblyLoader. The WebAssembly package, not the BlazorWebAssembly SDK: this
         assembly also loads server-side, where the loader is simply never attached. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrchardCore.Crest.Components\OrchardCore.Crest.Components.csproj" />
  </ItemGroup>

</Project>

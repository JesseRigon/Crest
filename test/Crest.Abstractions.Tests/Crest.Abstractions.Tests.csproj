    <ProjectReference Include="..\Crest.Tests.Modules\Examples.Modules.AssyAttrib.Bravo\Examples.Modules.AssyAttrib.Bravo.csproj" />
    <ProjectReference Include="..\Crest.Tests.Modules\Examples.Modules.AssyAttrib.Charlie\Examples.Modules.AssyAttrib.Charlie.csproj" />
    <ProjectReference Include="..\Crest.Tests.Modules\Examples.PlatformModules.Alpha\Examples.PlatformModules.Alpha.csproj" />
    <ProjectReference Include="..\Crest.Tests.Themes\Examples.Themes.AssyAttrib.Alpha\Examples.Themes.AssyAttrib.Alpha.csproj" />
    <ProjectReference Include="..\Crest.Tests.Themes\Examples.Themes.AssyAttrib.Bravo\Examples.Themes.AssyAttrib.Bravo.csproj" />
    <ProjectReference Include="..\Crest.Tests.Themes\Examples.Themes.AssyAttrib.Charlie\Examples.Themes.AssyAttrib.Charlie.csproj" />

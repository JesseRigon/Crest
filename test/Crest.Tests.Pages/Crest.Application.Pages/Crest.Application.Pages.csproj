<Project ToolsVersion="15.0" Sdk="Microsoft.NET.Sdk.Web">

  <!-- Necessary as we reference the Project and not the Package -->
  <Import Project="..\..\..\src\Crest.Application.Cms.Core.Targets\Crest.Application.Cms.Core.Targets.props" />

  <PropertyGroup>
    <TargetFrameworks>$(CommonTargetFrameworks)</TargetFrameworks>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <RazorRuntimeCompilation>false</RazorRuntimeCompilation>
    <NoWarn>$(NoWarn);EnableGenerateDocumentationFile</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
    <Folder Include="Localization\" />
  </ItemGroup>

  <Target Name="EnsureWwwRootExists" BeforeTargets="Build;Publish">
    <MakeDir Directories="$(MSBuildProjectDirectory)\wwwroot;$(MSBuildProjectDirectory)\Localization" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Condition="'$(RazorRuntimeCompilation)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Crest.Application.Cms.Core.Targets\Crest.Application.Cms.Core.Targets.csproj" />
    <ProjectReference Include="..\Crest.Modules.Pages\Module.Pages\Module.Pages.csproj" />
    <ProjectReference Include="..\Crest.Themes.Pages\Theme.Pages\Theme.Pages.csproj" />
  </ItemGroup>

  <!-- Necessary as we reference the Project and not the Package -->
  <Import Project="..\..\..\src\Crest.Application.Cms.Core.Targets\Crest.Application.Cms.Core.Targets.targets" />
  <Import Project="..\..\..\src\Crest.Application.Targets\Crest.Application.Targets.targets" />

  <Import Project="..\..\..\src\Crest.Build\Crest.Commons.targets" />

</Project>

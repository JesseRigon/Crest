{
  "name": "EsModuleTests",
  "displayName": "EsModuleTests",
  "description": "Testing the ES-module-converted field/part editors (TextField-IconPicker, TextField-Color, HtmlField-Wysiwyg/Trumbowyg/(default CodeMirror), HtmlBodyPart-Wysiwyg/Trumbowyg, LiquidPart) on both a normal full page load and when injected via the FlowPart 'Add Widget' AJAX flow.",
  "author": "The Crest Team",
  "website": "https://orchardcore.net",
  "version": "1.0.0",
  "issetuprecipe": true,
  "categories": [
    "tests"
  ],
  "tags": [
    "tests"
  ],
  "variables": {
    "seededPageId": "[js:uuid()]",
    "seededWidgetId": "[js:uuid()]",
    "seededLiquidWidgetId": "[js:uuid()]"
  },
  "steps": [
    {
      "name": "feature",
      "enable": [
        "Crest.HomeRoute",
        "Crest.Admin",
        "Crest.Navigation",
        "Crest.Recipes",
        "Crest.Resources",
        "Crest.Roles",
        "Crest.Security",
        "Crest.Settings",
        "Crest.Themes",
        "Crest.Users",
        "Crest.ContentFields",
        "Crest.Contents",
        "Crest.ContentTypes",
        "Crest.Flows",
        "Crest.Html",
        "Crest.Liquid",
        "Crest.Title",
        "TheAdmin",
        "SafeMode"
      ]
    },
    {
      "name": "themes",
      "admin": "TheAdmin",
      "site": "TheAdmin"
    },
    {
      "name": "ContentDefinition",
      "ContentTypes": [
        {
          "Name": "EsModuleTestPage",
          "DisplayName": "Es Module Test Page",
          "Settings": {
            "ContentTypeSettings": {
              "Creatable": true,
              "Draftable": true,
              "Versionable": true,
              "Listable": true,
              "Securable": true
            }
          },
          "ContentTypePartDefinitionRecords": [
            {
              "PartName": "TitlePart",
              "Name": "TitlePart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "0"
                }
              }
            }
          ]
        }
      ],
      "ContentParts": []
    },
    {
      "name": "content",
      "Data": [
        {
          "ContentItemId": "[js: variables('seededPageId')]",
          "ContentType": "EsModuleTestPage",
          "DisplayText": "ES Module Test Page",
          "Latest": true,
          "Published": true,
          "Owner": "[js: parameters('AdminUserId')]",
          "Author": "[js: parameters('AdminUsername')]",
          "TitlePart": {
            "Title": "ES Module Test Page"
          }
        }
      ],
      "data": []
    }
  ]
}

{
  "name": "AliasPartEditorTests",
  "displayName": "AliasPartEditorTests",
  "description": "Testing Crest.Alias's alias-part-settings.ts (CodeMirror liquid pattern editor init on the AliasPart type-part settings editor).",
  "author": "The Crest Team",
  "website": "https://orchardcore.net",
  "version": "1.0.0",
  "issetuprecipe": true,
  "categories": [ "tests" ],
  "tags": [ "tests" ],

  "steps": [
    {
      "name": "feature",
      "enable": [
        "Crest.HomeRoute",
        "Crest.Admin",
        "Crest.Navigation",
        "Crest.Recipes",
        "Crest.Resources",
        "Crest.Roles",
        "Crest.Security",
        "Crest.Settings",
        "Crest.Themes",
        "Crest.Users",

        "Crest.Contents",
        "Crest.ContentTypes",
        "Crest.Alias",
        "Crest.Title",

        "TheAdmin",
        "SafeMode"
      ]
    },
    {
      "name": "themes",
      "admin": "TheAdmin",
      "site": "TheAdmin"
    },
    {
      "name": "ContentDefinition",
      "ContentTypes": [
        {
          "Name": "AliasEditorTestType",
          "DisplayName": "Alias Editor Test Type",
          "Settings": {
            "ContentTypeSettings": {
              "Creatable": true,
              "Draftable": true,
              "Versionable": true,
              "Listable": true,
              "Securable": true
            }
          },
          "ContentTypePartDefinitionRecords": [
            {
              "PartName": "TitlePart",
              "Name": "TitlePart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "0"
                }
              }
            },
            {
              "PartName": "AliasPart",
              "Name": "AliasPart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "1"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}

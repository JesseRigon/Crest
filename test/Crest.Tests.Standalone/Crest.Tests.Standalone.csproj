<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Necessary as we reference the projects and not the packages (see Crest.Cms.Web). -->
  <Import Project="..\..\src\Crest.Application.Cms.Core.Targets\Crest.Application.Cms.Core.Targets.props" />

  <!-- A host with Crest's application layer and no line-of-business module, installed fresh
       from its own setup recipe into a throwaway data root: proves Crest stands alone
       (docs/architecture.md › Still to build, item 5). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="Recipes\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Crest.Application.Cms.Targets\Crest.Application.Cms.Targets.csproj" />
    <ProjectReference Include="..\..\src\Crest.Server\Crest.Server.csproj" />
    <ProjectReference Include="..\..\src\Crest.Server\Themes\Crest.LegacyFrame\Crest.LegacyFrame.csproj" />
    <ProjectReference Include="..\..\src\Crest.AdminTheme\Crest.AdminTheme.csproj" />
    <ProjectReference Include="..\..\src\Crest.SiteTheme\Crest.SiteTheme.csproj" />
    <ProjectReference Include="..\..\src\Crest.MemberTheme\Crest.MemberTheme.csproj" />
    <ProjectReference Include="..\..\src\Crest.Icons\Crest.Icons.csproj" />
    <ProjectReference Include="..\..\src\Crest.ContentPartLists\Crest.ContentPartLists.csproj" />
    <ProjectReference Include="..\..\src\Crest.Data.Global\Crest.Data.Global.csproj" />
    <ProjectReference Include="..\..\src\Crest.Regions\Crest.Regions.csproj" />
    <ProjectReference Include="..\..\src\Crest.Money\Crest.Money.csproj" />
    <ProjectReference Include="..\..\src\Crest.Parties\Server\Crest.Parties.csproj" />
    <ProjectReference Include="..\..\src\Crest.Members\Server\Crest.Members.csproj" />
    <ProjectReference Include="..\..\src\Crest.Workflows\Server\Crest.Workflows.csproj" />
    <ProjectReference Include="..\..\src\Crest.Workflows\Contents\Crest.Workflows.Contents.csproj" />
  </ItemGroup>

  <!-- Necessary as we reference the projects and not the packages (see Crest.Cms.Web). -->
  <Import Project="..\..\src\Crest.Application.Cms.Core.Targets\Crest.Application.Cms.Core.Targets.targets" />
  <Import Project="..\..\src\Crest.Application.Targets\Crest.Application.Targets.targets" />

</Project>

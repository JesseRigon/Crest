                },
                "LuceneContentIndexSettings": {
                  "Included": true,
                  "Stored": false,
                  "Keyword": false
                }
              }
            },
            {
              "FieldSetName": "Article",
              "Name": "Article",
              "Settings": {
                "ContentTypeFieldSetSettings": {
                  "Position": "2"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "lucene-index",
      "Indices": [
        {
          "ArticleIndex": {
            "AnalyzerName": "standardanalyzer",
            "IndexLatest": false,
            "IndexedContentTypes": [
              "Article"
            ]
          }
        }
      ]
    },

{
  "name": "ContentTypesEditorTests",
  "displayName": "ContentTypesEditorTests",
  "description": "Testing Grove.ContentTypes' field/part drag-reorder (content-type-sortable.ts) and Grove.Contents' ContentTypesSitemapSource cascading show/hide toggle (content-types-sitemap-source.ts).",
  "author": "The Grove Team",
  "website": "https://orchardcore.net",
  "version": "1.0.0",
  "issetuprecipe": true,
  "categories": [ "tests" ],
  "tags": [ "tests" ],

  "steps": [
    {
      "name": "feature",
      "enable": [
        "Grove.HomeRoute",
        "Grove.Admin",
        "Grove.Navigation",
        "Grove.Recipes",
        "Grove.Resources",
        "Grove.Roles",
        "Grove.Security",
        "Grove.Settings",
        "Grove.Themes",
        "Grove.Users",

        "Grove.Contents",
        "Grove.ContentTypes",
        "Grove.Autoroute",
        "Grove.Html",
        "Grove.Sitemaps",
        "Grove.Title",

        "TheAdmin",
        "SafeMode"
      ]
    },
    {
      "name": "themes",
      "admin": "TheAdmin",
      "site": "TheAdmin"
    },
    {
      "name": "ContentDefinition",
      "ContentTypes": [
        {
          "Name": "ReorderTestType",
          "DisplayName": "Reorder Test Type",
          "Settings": {
            "ContentTypeSettings": {
              "Creatable": true,
              "Draftable": true,
              "Versionable": true,
              "Listable": true,
              "Securable": true
            }
          },
          "ContentTypePartDefinitionRecords": [
            {
              "PartName": "TitlePart",
              "Name": "TitlePart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "0"
                }
              }
            },
            {
              "PartName": "HtmlBodyPart",
              "Name": "HtmlBodyPart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "1"
                }
              }
            },
            {
              "PartName": "AutoroutePart",
              "Name": "AutoroutePart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "2"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Sitemaps",
      "Data": [
        {
          "$type": "Grove.Sitemaps.Models.Sitemap, Grove.Sitemaps.Abstractions",
          "SitemapId": "contenttypeseditortestsitemap",
          "Name": "ContentTypesEditor Test Sitemap",
          "Enabled": true,
          "Path": "content-types-editor-test-sitemap",
          "SitemapSources": []
        }
      ]
    }
  ]
}

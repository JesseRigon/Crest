{
  "name": "ContentTypesEditorTests",
  "displayName": "ContentTypesEditorTests",
  "description": "Testing Grove.Contents.Types' field/part drag-reorder (content-type-sortable.ts) and Grove.Contents' ContentTypesSitemapSource cascading show/hide toggle (content-types-sitemap-source.ts).",
  "author": "The Grove Team",
  "website": "https://orchardcore.net",
  "version": "1.0.0",
  "issetuprecipe": true,
  "categories": [ "tests" ],
  "tags": [ "tests" ],

  "steps": [
    {
      "name": "feature",
      "enable": [
        "Grove.HomeRoute",
        "Grove.Infrastructure.Shells.Admin",
        "Grove.Display.Navigation",
        "Grove.Infrastructure.Recipes",
        "Grove.Display.Resources",
        "Grove.Access.Roles",
        "Grove.Security",
        "Grove.Infrastructure.Settings",
        "Grove.Themes",
        "Grove.Access.Users",

        "Grove.Contents",
        "Grove.Contents.Types",
        "Grove.Routes.Auto",
        "Grove.Data.Protocols.Html",
        "Grove.Seo.Sitemaps",
        "Grove.Contents.Title"

      ]
    },
    {
      "name": "themes",
      "admin": "Grove.Themes.Admin",
      "site": "Grove.Themes.Site"
    },
    {
      "name": "ContentDefinition",
      "ContentTypes": [
        {
          "Name": "ReorderTestType",
          "DisplayName": "Reorder Test Type",
          "Settings": {
            "ContentTypeSettings": {
              "Creatable": true,
              "Draftable": true,
              "Versionable": true,
              "Listable": true,
              "Securable": true
            }
          },
          "ContentTypeFieldSetDefinitionRecords": [
            {
              "FieldSetName": "Title",
              "Name": "Title",
              "Settings": {
                "ContentTypeFieldSetSettings": {
                  "Position": "0"
                }
              }
            },
            {
              "FieldSetName": "HtmlBody",
              "Name": "HtmlBody",
              "Settings": {
                "ContentTypeFieldSetSettings": {
                  "Position": "1"
                }
              }
            },
            {
              "FieldSetName": "Autoroute",
              "Name": "Autoroute",
              "Settings": {
                "ContentTypeFieldSetSettings": {
                  "Position": "2"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Sitemaps",
      "Data": [
        {
          "$type": "Grove.Seo.Sitemaps.Models.Sitemap, Grove.Seo.Sitemaps.Abstractions",
          "SitemapId": "contenttypeseditortestsitemap",
          "Name": "ContentTypesEditor Test Sitemap",
          "Enabled": true,
          "Path": "content-types-editor-test-sitemap",
          "SitemapSources": []
        }
      ]
    }
  ]
}

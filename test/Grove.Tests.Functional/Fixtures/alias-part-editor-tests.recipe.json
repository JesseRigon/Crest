{
  "name": "AliasPartEditorTests",
  "displayName": "AliasPartEditorTests",
  "description": "Testing Grove.Alias's alias-part-settings.ts (CodeMirror liquid pattern editor init on the AliasPart type-part settings editor).",
  "author": "The Grove Team",
  "website": "https://orchardcore.net",
  "version": "1.0.0",
  "issetuprecipe": true,
  "categories": [ "tests" ],
  "tags": [ "tests" ],

  "steps": [
    {
      "name": "feature",
      "enable": [
        "Grove.HomeRoute",
        "Grove.Admin",
        "Grove.Navigation",
        "Grove.Recipes",
        "Grove.Resources",
        "Grove.Roles",
        "Grove.Security",
        "Grove.Settings",
        "Grove.Themes",
        "Grove.Users",

        "Grove.Contents",
        "Grove.ContentTypes",
        "Grove.Alias",
        "Grove.Title",

        "TheAdmin",
        "SafeMode"
      ]
    },
    {
      "name": "themes",
      "admin": "TheAdmin",
      "site": "TheAdmin"
    },
    {
      "name": "ContentDefinition",
      "ContentTypes": [
        {
          "Name": "AliasEditorTestType",
          "DisplayName": "Alias Editor Test Type",
          "Settings": {
            "ContentTypeSettings": {
              "Creatable": true,
              "Draftable": true,
              "Versionable": true,
              "Listable": true,
              "Securable": true
            }
          },
          "ContentTypePartDefinitionRecords": [
            {
              "PartName": "TitlePart",
              "Name": "TitlePart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "0"
                }
              }
            },
            {
              "PartName": "AliasPart",
              "Name": "AliasPart",
              "Settings": {
                "ContentTypePartSettings": {
                  "Position": "1"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}

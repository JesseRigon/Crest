<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authorization" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Components" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Forms" Version="10.0.11" />
    <PackageVersion Include="OrchardCore.Admin.Abstractions" Version="4.0.0-local" />
    <PackageVersion Include="OrchardCore.ContentManagement" Version="4.0.0-local" />
    <PackageVersion Include="OrchardCore.DisplayManagement" Version="4.0.0-local" />
    <PackageVersion Include="OrchardCore.Email.Abstractions" Version="4.0.0-local" />
    <PackageVersion Include="OrchardCore.Menu" Version="4.0.0-local" />
    <PackageVersion Include="OrchardCore.Module.Targets" Version="4.0.0-local" />
    <PackageVersion Include="OrchardCore.ResourceManagement" Version="4.0.0-local" />
    <PackageVersion Include="OrchardCore.Setup" Version="4.0.0-local" />
    <PackageVersion Include="OrchardCore.Setup.Abstractions" Version="4.0.0-local" />
    <PackageVersion Include="OrchardCore.Users" Version="4.0.0-local" />
    <PackageVersion Include="OrchardCore.Users.Abstractions" Version="4.0.0-local" />
    <PackageVersion Include="Radzen.Blazor" Version="11.0.4" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="Verify.XunitV3" Version="31.27.0" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <IsPackable>true</IsPackable>
        <PackageId>Crest.Workflows.Timers</PackageId>
        <PackageTags>OrchardCore;Crest;Workflows;Timers</PackageTags>
        <Description>Provides timer services and scheduling activities for Crest.Workflows workflows in Orchard Core. Includes Quartz.NET-based scheduling for clustered deployments.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations"/>
        <PackageReference Include="ncrontab"/>
        <PackageReference Include="OrchardCore.Module.Targets"/>
        <PackageReference Include="Quartz"/>
    </ItemGroup>

    <ItemGroup Label="Crest.Workflows">
        <PackageReference Include="Crest.Workflows.Scheduling"/>
        <PackageReference Include="Crest.Workflows.Scheduling.Quartz"/>
        <PackageReference Include="Crest.Workflows.Engine"/>
    </ItemGroup>

</Project>

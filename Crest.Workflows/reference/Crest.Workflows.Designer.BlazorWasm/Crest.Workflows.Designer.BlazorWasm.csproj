<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>Crest.Workflows.Designer.BlazorWasm</PackageId>
    <PackageTags>Crest;Crest;Workflows;Designer;BlazorWasm</PackageTags>
    <Description>Blazor WebAssembly implementation of the Crest.Workflows Studio workflow designer for Crest. Provides client-side rendering of the visual workflow designer.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Crest.Workflows.Studio.Core.BlazorWasm" />
    <PackageReference Include="Crest.Workflows.Studio.Login.BlazorWasm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Crest.Workflows.Designer\Crest.Workflows.Designer.csproj" />
  </ItemGroup>

</Project>

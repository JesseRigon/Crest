@using Microsoft.AspNetCore.Components.Routing
@using Crest.Components.Primitives
@using Crest.Member.Components
@using System.Reflection
@using Microsoft.AspNetCore.Components.WebAssembly.Services
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services

@* The member shell's Routes component, the member-bucket counterpart of AdminRoutes,
   mounted by Crest.Server's theme-dispatching Components/App.razor. It must live in this
   client assembly rather than in Server: the WASM runtime only has the assemblies it was
   compiled with, so a Routes defined server-side resolves over the circuit and then throws
   the moment InteractiveAuto switches to WASM. See docs/BlazorWeb.md. *@

<CrestNotification />

<Router AppAssembly="@typeof(MemberRoutes).Assembly" AdditionalAssemblies="@_assemblies" OnNavigateAsync="OnNavigateAsync">
    <Found Context="routeData">
        @if (IsShelllessRoute(routeData))
        {
            <RouteView RouteData="@routeData" />
        }
        else
        {
            <MemberLayout>
                <RouteView RouteData="@routeData" />
            </MemberLayout>
        }
    </Found>
    <NotFound>
        @* A member URL with no member page. Deliberately NOT the LegacyAdminFrame that
           AdminRoutes falls back to: that frame is Orchard's admin UI, which a member has
           no business being shown. *@
        <MemberNotFound />
    </NotFound>
</Router>

@code {
    // Shell-less: the pages that establish a session (they render their own centred card,
    // not the member chrome, and there is no active organization to put in a nav yet),
    // plus any page declaring [AllowAnonymous] - the same marker the server gate reads,
    // so a public page a module contributes is public end to end.
    private static bool IsShelllessRoute(RouteData routeData)
        => string.Equals(routeData.PageType.Name, "MemberLogin", StringComparison.Ordinal)
            || string.Equals(routeData.PageType.Name, "MemberRegister", StringComparison.Ordinal)
            || routeData.PageType.IsDefined(typeof(Microsoft.AspNetCore.Authorization.AllowAnonymousAttribute), inherit: false);

    // The module assemblies the router knows. A module contributes member pages exactly
    // the way it contributes admin pages: a blazor-wasm library whose [Route]-attributed
    // components are scanned into a bucket.
    //
    // Those libraries are referenced once (by the admin client) and compiled into the one
    // WASM payload, so they are already loaded - this reads them off the current
    // AssemblyLoadContext rather than from the admin client's own generated registry,
    // which is internal to that assembly. Taking a member -> admin project reference to
    // reach it would invert the shells' independence for nothing: either shell must work
    // with the other's theme inactive.
    [Inject]
    private ICrestMemberModuleAssemblies ModuleAssemblies { get; set; } = default!;

    private List<Assembly> _assemblies = [];
    private CrestLazyModules? _lazyModules;

    protected override void OnInitialized()
    {
        _assemblies = [.. ModuleAssemblies.Assemblies];
        _lazyModules = Services.GetService<CrestLazyModules>();
        if (_lazyModules is not null && Services.GetService<LazyAssemblyLoader>() is { } loader)
        {
            _lazyModules.Attach(loader);
            _lazyModules.ModulesLoaded += SyncAssemblies;
        }

        base.OnInitialized();
    }

    private async Task OnNavigateAsync(NavigationContext context)
    {
        if (_lazyModules is not null && await _lazyModules.EnsureForPathAsync(context.Path))
        {
            SyncAssemblies();
        }
    }

    private void SyncAssemblies()
    {
        foreach (var assembly in _lazyModules!.LoadedModules.Where(assembly => !_assemblies.Contains(assembly)))
        {
            _assemblies.Add(assembly);
        }
    }
}

<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The member shell's client half: a Razor class library, not a WASM app entry. A
       Blazor Web App has exactly ONE WASM entry project (OrchardCore.Crest.Client), which
       references this library alongside Admin's and Site's and runs the one Program.cs.
       A third shell is therefore a theme, a client library, a route bucket and an
       App.razor branch - NOT a third build output. See plans/shells-and-themes.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>OrchardCore.Crest.Member.Client</AssemblyName>
    <RootNamespace>Crest.Member</RootNamespace>
    <OrchardCoreCompatibilityVersion>3.0.0</OrchardCoreCompatibilityVersion>
    <CrestSecurityPatch>0</CrestSecurityPatch>
    <CrestBugPatch>0</CrestBugPatch>
    <CrestVersion>$(OrchardCoreCompatibilityVersion).$(CrestSecurityPatch).$(CrestBugPatch)</CrestVersion>
    <VersionPrefix>$(OrchardCoreCompatibilityVersion)</VersionPrefix>
    <PackageVersion>$(OrchardCoreCompatibilityVersion)</PackageVersion>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <AssemblyInformationalVersion>$(CrestVersion)</AssemblyInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Watch Include="**\*.cs;**\*.razor;wwwroot\**\*" Exclude="bin\**;obj\**;**\bin\**;**\obj\**" />
    <Watch Remove="bin\**;obj\**;**\bin\**;**\obj\**" />
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OrchardCore.Crest.Member.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same rationale as the admin client: the WebAssembly package (not the full
         BlazorWebAssembly SDK), because this assembly also loads server-side for SSR
         route discovery. -->
    <PackageReference Include="Microsoft.AspNetCore.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OrchardCore.Crest.Components\OrchardCore.Crest.Components.csproj" />
    <ProjectReference Include="..\..\OrchardCore.Crest.Icons\OrchardCore.Crest.Icons.csproj" />
    <!-- No CrestModuleWasmProject glob here, unlike the admin client. A module's
         blazor-wasm library is referenced once, by the admin client, and compiled into
         the single WASM payload; the member router reaches those same assemblies through
         the shared registry rather than referencing them a second time. -->
  </ItemGroup>

</Project>

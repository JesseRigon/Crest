@attribute [Route(MemberRoutePaths.Home)]
@namespace Crest.Member.Pages

@* The member's landing page, inside the member chrome (MemberLayout supplies the header,
   the organization switcher and the nav).

   No [AllowAnonymous]: the middleware requires authentication for member pages and
   redirects to the member login. What this page SHOWS is whatever the server already
   scoped for this member - the shell renders returned data and makes no access decision
   of its own. *@

<PageTitle>@ShellContext.SiteName</PageTitle>

<div data-testid="member-home">
    <CrestStack Gap="1rem">
        <CrestText TextStyle="TextStyle.H4" Text="@Greeting" />

        @if (ShellContext.ActiveOrganizationName is { Length: > 0 } organization)
        {
            <CrestText TextStyle="TextStyle.Body2"
                       Text="@organization"
                       data-testid="member-home-active-org" />
        }

        @* Where a product's own member pages appear. Venti's accounts and transactions,
           a club's events: each is a module contributing member-bucket pages and nav
           entries, exactly as modules contribute admin pages. The shell ships no
           product surface of its own. *@
        <CrestText TextStyle="TextStyle.Body1" Text="@EmptyStateText" data-testid="member-home-empty" />
    </CrestStack>
</div>

@code {
    // Supplied by MemberRoutes, which activates the implementation a member module provides
    // (its library is lazy, so it cannot be registered in the sealed WASM container).
    [CascadingParameter]
    private IMemberShellContext ShellContext { get; set; } = default!;

    private string Greeting => ShellContext.UserName is { Length: > 0 } name
        ? $"Welcome, {name}"
        : "Welcome";

    private string EmptyStateText => ShellContext.NavigationEntries.Count == 0
        ? "There is nothing here yet."
        : "Choose where to go from the menu.";
}
